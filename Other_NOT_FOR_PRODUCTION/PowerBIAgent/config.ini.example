; ---------------------------------------------------------------------------
; config.ini.example — template for the Fishbowl → Power BI Agent.
;
; The Windows Service (service.py) reads config.ini from the install directory.
; Normally you do NOT hand-edit this — run the "Configure Agent" wizard
; (wizard.py), which writes config.ini and encrypts the Fishbowl password into
; [secrets] password_enc using machine-scope DPAPI (see credentials.py).
;
; To configure by hand instead: copy this file to `config.ini`, fill in the
; placeholders, and leave `password_enc` blank (the wizard/setup step writes it).
; `config.ini` is git-ignored — never commit a filled-in copy.
; ---------------------------------------------------------------------------

[fishbowl]
base_url = http://localhost:2456
; App identity registered in Fishbowl → Setup → Settings → Integrated Apps.
; An admin must approve it before the first login succeeds.
app_name = PowerBI Agent
app_id   = 200
username = <fishbowl-username>

[powerbi]
; Streaming/push dataset URL from app.powerbi.com (Datasets → API Info).
; Keep the whole URL including the ?key=... query string.
push_url = https://api.powerbi.com/beta/<AAD_TENANT_ID>/datasets/<DATASET_ID>/rows?experience=power-bi&key=<PUSH_KEY>

[agent]
sync_interval_minutes = 15
log_file = agent.log

[secrets]
; DPAPI-encrypted Fishbowl password. Written by the wizard / setup step —
; leave blank here. Requires agent.key (per-install entropy) to decrypt.
password_enc =
