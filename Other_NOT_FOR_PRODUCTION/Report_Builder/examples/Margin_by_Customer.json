{
  "name": "Margin by Customer",
  "key": "cdx.bi.rbMarginByCustomer",
  "folder": "Custom",
  "description": "Posted revenue, cost and margin by customer and month: the first Report Builder example.",
  "spec": {
    "kind": "fb-report-spec",
    "v": 1,
    "catalog": { "id": "fb.core", "version": 1 },
    "subject": "sales.posted",
    "title": "Margin by Customer",
    "description": "Posted revenue, cost of goods and margin for each customer, month by month.",
    "calcs": [],
    "params": [
      { "id": "p.date", "label": "Posted", "field": "posted.date", "op": "between", "value": { "preset": "current_fy" }, "ask": true },
      { "id": "p.group", "label": "Customer group", "field": "customer.group", "op": "in", "value": [], "ask": true }
    ],
    "steps": [
      { "id": "src", "type": "source", "subject": "sales.posted" },
      { "id": "flt", "type": "filter", "in": "src", "all": [ { "param": "p.date" }, { "param": "p.group" } ] },
      { "id": "grp", "type": "group", "in": "flt", "detail": false,
        "levels": [ { "field": "customer.name" }, { "field": "posted.date", "bucket": "month" } ] },
      { "id": "tbl", "type": "table", "in": "grp",
        "columns": [
          { "id": "customer", "ref": "customer.name" },
          { "id": "month", "ref": "posted.date", "bucket": "month", "label": "Month" },
          { "id": "orders", "ref": "posted.orders" },
          { "id": "revenue", "ref": "posted.revenue" },
          { "id": "cogs", "ref": "posted.cogs" },
          { "id": "margin", "ref": "posted.margin" },
          { "id": "marginPct", "ref": "posted.marginPct", "format": { "type": "percent", "dp": 1 } }
        ],
        "sort": [] }
    ],
    "page": { "size": "Letter", "orientation": "portrait" },
    "ui": { "flow": { "positions": {} } }
  }
}
