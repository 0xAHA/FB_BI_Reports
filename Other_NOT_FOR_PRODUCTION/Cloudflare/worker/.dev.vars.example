# Local development secrets for `wrangler dev`.
#
# Copy this file to `.dev.vars` (which MUST be git-ignored) and fill in real
# values. In production these are set with `wrangler secret put ... --env production`
# instead — never commit real secrets.

# 256-bit AES-GCM key (base64) used to encrypt stored Fishbowl passwords in the
# KEYS KV namespace. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEYS_ENC_KEY = "<base64-encoded-32-byte-key>"

# Non-secret vars normally live in wrangler.toml ([env.production.vars]); they're
# repeated here only if you want to override them locally:
# FB_URL = "https://fb-api.example.com"
# WORKER_VERSION = "dev"
