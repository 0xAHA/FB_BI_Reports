# Editor / local tooling
.vscode/

# Cloudflare Wrangler build cache
**/.wrangler/

# PowerBI agent — build artifacts, runtime state, and secrets (never commit)
PowerBIAgent/dist/
PowerBIAgent/build/
PowerBIAgent/installer_output/
PowerBIAgent/config.ini
PowerBIAgent/agent.key
PowerBIAgent/agent.log
PowerBIAgent/state.json

# Test / scratch artifacts (Playwright MCP output, dashboard scratch previews)
.playwright-mcp/
Dashboards/Temp/

# Python build junk
__pycache__/
*.pyc

# Customer data exports (PII)
Other_NOT_FOR_PRODUCTION/Data Imports/

# OneDrive conflict copies
*-DESKTOP-*

# Node test-harness dependencies
node_modules/

# .NET build output for the desktop tools (tools/fb-api-tool, tools/fb-report-host).
# dist/ holds the published single-file executables — 60 MB each, rebuilt by
# tools/fb-api-tool/build-release.ps1, and not something to carry in history.
**/bin/
**/obj/
tools/fb-api-tool/dist/
