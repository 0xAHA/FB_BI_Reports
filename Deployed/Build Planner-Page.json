[ {
  "name" : "Build Planner",
  "description" : "Build Planner",
  "data" : "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <title>Build Planner - Fishbowl BI</title>\r\n\r\n  <!-- Google Fonts - Inter -->\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\r\n\r\n  <!-- Shared Fishbowl BI lib (Settings layer + Common formatting/debug helpers).\r\n       Inlined by Fishbowl from the saved script named \"fb-lib\". Source of truth\r\n       lives at scripts/fb-lib.js. This report uses FBLib.Common + FBLib.Settings. -->\r\n  <script>\r\n    {% Script fb-lib %}\r\n  </script>\r\n\r\n  <style>\r\n    * { box-sizing: border-box; }\r\n    html, body { margin: 0; padding: 0; }\r\n    body {\r\n      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\r\n      font-size: 13px; color: #1e293b; background: #f8fafc;\r\n    }\r\n\r\n    /* ── HEADER BAR ── */\r\n    header {\r\n      position: sticky; top: 0; z-index: 50;\r\n      background: #fff; border-bottom: 1px solid #e2e8f0;\r\n      box-shadow: 0 1px 2px rgba(0,0,0,0.04);\r\n      display: flex; align-items: center; justify-content: space-between;\r\n      padding: 0 20px; height: 56px;\r\n    }\r\n    header h1 { font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.15; }\r\n    #statusLine { font-size: 12px; color: #94a3b8; line-height: 1.15; margin: 0; }\r\n    .hdr-actions { display: flex; align-items: center; gap: 8px; }\r\n    .hdr-btn {\r\n      display: flex; align-items: center; gap: 5px;\r\n      padding: 6px 10px; border-radius: 8px; font-size: 12px; font-weight: 500;\r\n      border: 1px solid #e2e8f0; background: #fff; color: #475569;\r\n      cursor: pointer; transition: all 0.15s; white-space: nowrap; font-family: inherit;\r\n    }\r\n    .hdr-btn:hover { background: #f8fafc; border-color: #cbd5e1; }\r\n    .hdr-btn:disabled { opacity: 0.5; cursor: not-allowed; }\r\n    .hdr-btn svg { width: 14px; height: 14px; flex-shrink: 0; }\r\n    .hdr-btn-icon { padding: 7px; border-radius: 8px; }\r\n    .hdr-btn-primary { background: #2563eb; border-color: #2563eb; color: #fff; }\r\n    .hdr-btn-primary:hover { background: #1d4ed8; border-color: #1d4ed8; }\r\n    .hdr-sep { width: 1px; height: 24px; background: #e2e8f0; margin: 0 2px; }\r\n\r\n    /* ── PAGE ── */\r\n    .wrap { max-width: 1320px; margin: 0 auto; padding: 16px 20px 60px; }\r\n    .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); margin-bottom: 16px; }\r\n    .card-body { padding: 14px 16px; }\r\n\r\n    /* ── CONTROLS STRIP ── */\r\n    .controls { display: flex; flex-wrap: wrap; gap: 14px 20px; padding: 14px 16px; align-items: flex-end; }\r\n    .field { display: flex; flex-direction: column; gap: 4px; }\r\n    .field label { font-size: 10px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; }\r\n    .field select, .field input {\r\n      padding: 7px 9px; border: 1px solid #cbd5e1; border-radius: 6px;\r\n      font-size: 13px; color: #1e293b; background: #fff; font-family: inherit; min-width: 200px;\r\n    }\r\n    .field input[type=number] { min-width: 120px; text-align: right; }\r\n    .field select:focus, .field input:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }\r\n    .caption { padding: 0 16px 12px; font-size: 11px; color: #94a3b8; }\r\n    .caption code { background: #f1f5f9; color: #475569; padding: 1px 5px; border-radius: 4px; }\r\n\r\n    /* ── DATA TABLE ── */\r\n    .data-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }\r\n    .data-table th {\r\n      background: #1e3a5f; color: #fff; font-weight: 500; font-size: 11px;\r\n      text-align: left; padding: 8px 10px; white-space: nowrap; position: sticky; top: 56px; z-index: 5;\r\n      text-transform: uppercase; letter-spacing: 0.03em;\r\n    }\r\n    .data-table th.nr { text-align: right; }\r\n    .data-table td { padding: 6px 10px; border-bottom: 1px solid #eef2f7; white-space: nowrap; vertical-align: middle; }\r\n    .data-table tbody tr:nth-child(even) td { background: #f9fafb; }\r\n    .data-table tbody tr:hover td { background: #eff6ff; }\r\n    .num-cell { text-align: right; font-variant-numeric: tabular-nums; }\r\n    .muted { color: #94a3b8; }\r\n    .ph { color: #b45309; font-style: italic; }              /* placeholder (pending CF) */\r\n    .need { color: #b91c1c; font-weight: 600; }              /* shortfall */\r\n    .covered { color: #047857; font-weight: 600; }           /* surplus / covered */\r\n    .row-link { color: #2563eb; cursor: pointer; text-decoration: none; font-weight: 600; }\r\n    .row-link:hover { text-decoration: underline; }\r\n    .lvl-tag { display: inline-block; min-width: 22px; text-align: center; font-size: 10px; font-weight: 600; color: #64748b; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 4px; padding: 1px 4px; margin-right: 2px; }\r\n    .empty { padding: 36px; text-align: center; color: #94a3b8; font-style: italic; }\r\n\r\n    /* ── SPINNER ── */\r\n    #spinner { display: none; padding: 40px; text-align: center; color: #64748b; }\r\n    @keyframes spin { to { transform: rotate(360deg); } }\r\n    .spin { animation: spin 0.8s linear infinite; }\r\n\r\n    /* ── DEBUG ── */\r\n    #debugConsole { display: none; }\r\n    #debugConsole .dc-head { display: flex; justify-content: space-between; align-items: center; background: #0f172a; padding: 10px 14px; border-radius: 10px 10px 0 0; }\r\n    #debugConsole .dc-head h3 { margin: 0; font-size: 12px; color: #e2e8f0; }\r\n    #debugLog { background: #0f172a; border-radius: 0 0 10px 10px; padding: 12px; max-height: 240px; overflow-y: auto; font-family: ui-monospace, monospace; font-size: 11px; color: #e2e8f0; white-space: pre-wrap; }\r\n    .mini-btn { padding: 4px 9px; font-size: 11px; border-radius: 6px; border: 1px solid #334155; background: #1e293b; color: #cbd5e1; cursor: pointer; font-family: inherit; }\r\n\r\n    /* ── SETTINGS PANEL (fb-lib consumer) ── */\r\n    #setOverlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1001; display: none; justify-content: flex-end; }\r\n    #setPanel { background: #f8fafc; width: 360px; max-width: 95vw; height: 100%; overflow-y: auto; box-shadow: -2px 0 12px rgba(0,0,0,0.25); display: flex; flex-direction: column; }\r\n    #setPanel .ds-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-bottom: 1px solid #e2e8f0; background: #fff; }\r\n    #setPanel .ds-header h2 { margin: 0; font-size: 15px; }\r\n    #setPanel .ds-close { background: transparent; border: none; font-size: 24px; cursor: pointer; color: #64748b; line-height: 1; }\r\n    #setPanel .ds-body { padding: 16px 18px; flex: 1; }\r\n    #setPanel .ds-section { margin-bottom: 20px; }\r\n    #setPanel .ds-label { display: block; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: #475569; margin-bottom: 8px; }\r\n    #setPanel input, #setPanel select { width: 100%; padding: 7px 9px; font-size: 13px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; font-family: inherit; }\r\n    #setPanel .ds-checks label { display: block; padding: 5px 0; font-size: 13px; cursor: pointer; }\r\n    #setPanel .ds-checks input { width: auto; margin-right: 7px; }\r\n    #setPanel .ds-footer { padding: 12px 18px; border-top: 1px solid #e2e8f0; background: #fff; display: flex; gap: 8px; justify-content: flex-end; }\r\n    #setPanel .ds-btn { padding: 7px 14px; font-size: 13px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; cursor: pointer; font-family: inherit; }\r\n    #setPanel .ds-btn-primary { background: #2563eb; color: #fff; border-color: #2563eb; }\r\n    #setPanel .ds-admin { border-top: 1px dashed #cbd5e1; padding-top: 16px; }\r\n    #setPanel .ds-btn-admin { display: block; width: 100%; margin-bottom: 6px; background: #fef3c7; border-color: #f59e0b; color: #7c2d12; }\r\n    #setPanel .ds-lock-badge { background: #fef3c7; color: #92400e; border: 1px solid #f59e0b; padding: 6px 10px; border-radius: 6px; font-size: 12px; margin-bottom: 14px; }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n  <header>\r\n    <div>\r\n      <h1>Build Planner</h1>\r\n      <p id=\"statusLine\">Initialising…</p>\r\n    </div>\r\n    <div class=\"hdr-actions\">\r\n      <button class=\"hdr-btn\" onclick=\"generate()\" title=\"Re-run the plan\">\r\n        <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\r\n        Refresh\r\n      </button>\r\n      <button class=\"hdr-btn\" onclick=\"exportCSV()\" title=\"Export plan as CSV\">\r\n        <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"/></svg>\r\n        CSV\r\n      </button>\r\n      <button class=\"hdr-btn hdr-btn-icon\" onclick=\"PageSettings.openPanel()\" title=\"Settings\">\r\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M19.14 12.94c.04-.31.06-.62.06-.94 0-.32-.02-.63-.06-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96a7.03 7.03 0 00-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94 0 .32.02.63.06.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 018.4 12 3.6 3.6 0 0112 8.4a3.6 3.6 0 013.6 3.6 3.6 3.6 0 01-3.6 3.6z\"/></svg>\r\n      </button>\r\n      <div class=\"hdr-sep\"></div>\r\n      <button class=\"hdr-btn hdr-btn-primary\" onclick=\"generate()\">\r\n        <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>\r\n        Generate Plan\r\n      </button>\r\n    </div>\r\n  </header>\r\n\r\n  <div class=\"wrap\">\r\n\r\n    <!-- CONTROLS -->\r\n    <div class=\"card\">\r\n      <div class=\"controls\">\r\n        <div class=\"field\">\r\n          <label>Custom Field</label>\r\n          <select id=\"cfField\" onchange=\"onCfFieldChange()\"></select>\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Value</label>\r\n          <select id=\"cfValue\" onchange=\"onCfValueChange()\"><option value=\"\">Any value</option></select>\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Build Qty</label>\r\n          <input type=\"number\" id=\"buildQty\" min=\"1\" step=\"1\" value=\"100\" onchange=\"persistControls()\" />\r\n        </div>\r\n      </div>\r\n      <div class=\"caption\" id=\"caption\"></div>\r\n    </div>\r\n\r\n    <!-- RESULTS -->\r\n    <div class=\"card\">\r\n      <div id=\"spinner\"><svg class=\"spin\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"#e2e8f0\" stroke-width=\"3\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke=\"#2563eb\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg><div style=\"margin-top:8px;\">Exploding BOMs…</div></div>\r\n      <table class=\"data-table\" id=\"planTable\">\r\n        <thead>\r\n          <tr>\r\n            <th>BOM #</th>\r\n            <th>Part #</th>\r\n            <th>Description</th>\r\n            <th class=\"nr\">Parts / Unit</th>\r\n            <th class=\"nr\">Part Qty Total</th>\r\n            <th class=\"nr\">Inv Qty (Avail)</th>\r\n            <th class=\"nr\">Actual Req'd</th>\r\n            <th class=\"nr\">No. Per Blank</th>\r\n            <th class=\"nr\">No. Blanks Req'd</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody id=\"planBody\">\r\n          <tr><td class=\"empty\" colspan=\"9\">Choose a custom field / value and a build quantity, then Generate Plan.</td></tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <!-- DEBUG -->\r\n    <div class=\"card\" id=\"debugConsole\">\r\n      <div class=\"dc-head\"><h3>Debug Console</h3><button class=\"mini-btn\" onclick=\"clearDebug()\">Clear</button></div>\r\n      <div id=\"debugLog\"></div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <!-- SETTINGS PANEL -->\r\n  <div id=\"setOverlay\" onclick=\"PageSettings.closeIfOverlay(event)\">\r\n    <div id=\"setPanel\" onclick=\"event.stopPropagation()\">\r\n      <div class=\"ds-header\">\r\n        <h2>Settings — Build Planner</h2>\r\n        <button type=\"button\" class=\"ds-close\" onclick=\"PageSettings.closePanel()\">&times;</button>\r\n      </div>\r\n      <div class=\"ds-body\">\r\n        <div id=\"dsLockBadge\" class=\"ds-lock-badge\" style=\"display:none;\">Locked by admin — your changes won't be saved.</div>\r\n        <div class=\"ds-section\">\r\n          <label class=\"ds-label\">Default build quantity</label>\r\n          <input type=\"number\" id=\"dsBuildQty\" min=\"1\" step=\"1\" />\r\n        </div>\r\n        <div class=\"ds-section\">\r\n          <label class=\"ds-label\">BOM \"No. Per Blank\" custom-field name</label>\r\n          <input type=\"text\" id=\"dsPerBlankCF\" placeholder=\"No. Per Blank\" />\r\n          <div style=\"font-size:11px;color:#94a3b8;margin-top:6px;\">Placeholder — name of the BOM custom field that holds parts-per-blank. The columns stay blank until this field exists on your BOMs.</div>\r\n        </div>\r\n        <div class=\"ds-section ds-checks\">\r\n          <label class=\"ds-label\">Options</label>\r\n          <label><input type=\"checkbox\" id=\"dsDebug\" /> Show debug console</label>\r\n        </div>\r\n        <div id=\"dsAdminSection\" class=\"ds-section ds-admin\" style=\"display:none;\">\r\n          <label class=\"ds-label\">Admin</label>\r\n          <button type=\"button\" class=\"ds-btn ds-btn-admin\" onclick=\"PageSettings.publishMaster()\">Publish as default for everyone</button>\r\n          <button type=\"button\" class=\"ds-btn ds-btn-admin\" id=\"dsLockBtn\" onclick=\"PageSettings.toggleLock()\">Lock user editing</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"ds-footer\">\r\n        <button type=\"button\" class=\"ds-btn\" onclick=\"PageSettings.resetToDefaults()\">Reset to defaults</button>\r\n        <button type=\"button\" class=\"ds-btn ds-btn-primary\" onclick=\"PageSettings.saveUser()\">Save (just me)</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n<script>\r\n/* ── RUNTIME GUARD ── */\r\nif (typeof runQuery !== 'function' && typeof runQueryAsync !== 'function') {\r\n  document.body.innerHTML = '<div style=\"padding:40px;font-family:sans-serif;color:#475569;\"><h2>Not running inside Fishbowl</h2><p>This report requires the Fishbowl BI environment.</p></div>';\r\n  throw new Error('Fishbowl API not available');\r\n}\r\n\r\n/* ── FB-LIB SETTINGS ── */\r\nFBLib.Settings.init({\r\n  userKey:   'cdx.bi.buildPlanner.user.v1',\r\n  masterKey: 'cdx.bi.buildPlanner.master.v1',\r\n  defaults: {\r\n    v: 1,\r\n    buildQty: 100,\r\n    cfField: '',\r\n    cfValue: '',\r\n    perBlankCF: 'No. Per Blank',   // placeholder BOM custom field (not created yet)\r\n    debug: false\r\n  },\r\n  propFallback: {\r\n    debug: { name: 'BI_SHOW_DEBUG', dflt: 'false', parse: v => (v === 'true' || v === true) }\r\n  }\r\n});\r\n\r\n/* ── THIN HELPERS (prefer FBLib.Common; local fallback if saved fb-lib is behind) ── */\r\nconst _C = (window.FBLib && FBLib.Common) ? FBLib.Common : null;\r\nfunction fmtQty(v) {\r\n  if (_C && _C.formatQty) return _C.formatQty(v);\r\n  const n = parseFloat(v); if (isNaN(n)) return '';\r\n  return n % 1 === 0 ? String(Math.round(n)) : n.toFixed(4).replace(/\\.?0+$/, '');\r\n}\r\nfunction esc(s) {\r\n  if (_C && _C.escSQL) return _C.escSQL(s);\r\n  return String(s == null ? '' : s).replace(/'/g, \"''\");\r\n}\r\nfunction escHtml(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }\r\nfunction setStatus(m) { document.getElementById('statusLine').textContent = m; }\r\n\r\n/* ── QUERY HELPERS ── */\r\nfunction norm(r) {\r\n  if (r == null) return [];\r\n  if (typeof r === 'string') { try { const p = JSON.parse(r); return Array.isArray(p) ? p : []; } catch (_) { return []; } }\r\n  return Array.isArray(r) ? r : [];\r\n}\r\nasync function qp(sql) {\r\n  try { return norm(await runQueryAsync(sql)); }\r\n  catch (e) { try { return norm(runQuery(sql)); } catch (e2) { throw e2; } }\r\n}\r\n\r\n/* ── STATE ── */\r\nconst state = {\r\n  cfField: FBLib.Settings.resolve('cfField') || '',\r\n  cfValue: FBLib.Settings.resolve('cfValue') || '',\r\n  perBlankCF: FBLib.Settings.resolve('perBlankCF') || 'No. Per Blank',\r\n  demo: false\r\n};\r\nlet _lastRows = [];\r\n\r\n/* ── DEBUG ── */\r\nfunction dbg(msg, type) { try { if (FBLib.Common.DEBUG_MODE) FBLib.Common.debugLog(msg, type || 'info'); } catch (_) {} }\r\nfunction clearDebug() { try { FBLib.Common.clearDebugLog(); } catch (_) {} if (!FBLib.Common.DEBUG_MODE) document.getElementById('debugConsole').style.display = 'none'; }\r\n\r\n/* ── CUSTOM-FIELD DROPDOWNS ── */\r\nasync function loadCfFields() {\r\n  let fields = [];\r\n  try {\r\n    const rows = await qp(\r\n      \"SELECT cf.name AS name FROM tablereference tr \" +\r\n      \"JOIN customfield cf ON cf.tableid = tr.tableid \" +\r\n      \"WHERE tr.tablerefname = 'part' AND cf.activeflag = 1 ORDER BY cf.sortorder, cf.name\");\r\n    fields = rows.map(r => r.name).filter(Boolean);\r\n  } catch (e) { dbg('Custom-field lookup failed: ' + e.message, 'warning'); }\r\n\r\n  const sel = document.getElementById('cfField');\r\n  sel.innerHTML = '';\r\n  if (!fields.length) {\r\n    // No part custom fields yet → demo mode (plan all manufacturable parts).\r\n    state.demo = true;\r\n    const o = document.createElement('option');\r\n    o.value = ''; o.textContent = '(no part custom fields yet — demo: all manufacturable parts)';\r\n    sel.appendChild(o);\r\n    document.getElementById('cfValue').disabled = true;\r\n  } else {\r\n    state.demo = false;\r\n    const o0 = document.createElement('option');\r\n    o0.value = ''; o0.textContent = '-- Select custom field --';\r\n    sel.appendChild(o0);\r\n    fields.forEach(function (f) {\r\n      const o = document.createElement('option');\r\n      o.value = f; o.textContent = f;\r\n      if (f === state.cfField) o.selected = true;\r\n      sel.appendChild(o);\r\n    });\r\n    if (state.cfField) await loadCfValues();\r\n  }\r\n  updateCaption();\r\n}\r\n\r\nasync function loadCfValues() {\r\n  const valSel = document.getElementById('cfValue');\r\n  valSel.innerHTML = '<option value=\"\">Any value</option>';\r\n  if (!state.cfField) { valSel.disabled = true; return; }\r\n  valSel.disabled = false;\r\n  try {\r\n    const rows = await qp(\r\n      \"SELECT DISTINCT CustomFieldByName(part.customfields, '\" + esc(state.cfField) + \"') AS v \" +\r\n      \"FROM part WHERE part.activeflag = 1 \" +\r\n      \"AND CustomFieldByName(part.customfields, '\" + esc(state.cfField) + \"') IS NOT NULL \" +\r\n      \"AND CustomFieldByName(part.customfields, '\" + esc(state.cfField) + \"') <> '' ORDER BY 1 LIMIT 500\");\r\n    rows.forEach(function (r) {\r\n      if (r.v == null || r.v === '') return;\r\n      const o = document.createElement('option');\r\n      o.value = r.v; o.textContent = r.v;\r\n      if (String(r.v) === String(state.cfValue)) o.selected = true;\r\n      valSel.appendChild(o);\r\n    });\r\n  } catch (e) { dbg('Value lookup failed: ' + e.message, 'warning'); }\r\n}\r\n\r\nfunction onCfFieldChange() { state.cfField = document.getElementById('cfField').value; state.cfValue = ''; persistControls(); loadCfValues(); updateCaption(); }\r\nfunction onCfValueChange() { state.cfValue = document.getElementById('cfValue').value; persistControls(); }\r\n\r\nfunction updateCaption() {\r\n  const cf = state.perBlankCF || 'No. Per Blank';\r\n  const mode = state.demo\r\n    ? 'No part custom fields exist yet, so the planner is in <b>demo mode</b> — it plans all manufacturable parts.'\r\n    : 'Pick the custom field + value that identify the finished goods to build.';\r\n  document.getElementById('caption').innerHTML =\r\n    mode + ' Build quantity applies to <b>each</b> matching finished good. ' +\r\n    '“No. Per Blank” / “No. Blanks Req’d” read the BOM custom field <code>' + escHtml(cf) + '</code> ' +\r\n    '(placeholder — blank until that field is created).';\r\n}\r\n\r\n/* ── TOP-LEVEL FINISHED GOODS ── */\r\nasync function findTopParts() {\r\n  if (state.demo || !state.cfField) {\r\n    return await qp(\r\n      \"SELECT p.id AS id, p.num AS num, p.description AS description, p.defaultbomid AS defaultbomid \" +\r\n      \"FROM part p WHERE p.activeflag = 1 AND p.defaultbomid IS NOT NULL ORDER BY p.num LIMIT 25\");\r\n  }\r\n  let where = \"p.activeflag = 1 AND p.defaultbomid IS NOT NULL \" +\r\n    \"AND CustomFieldByName(p.customfields, '\" + esc(state.cfField) + \"') IS NOT NULL \" +\r\n    \"AND CustomFieldByName(p.customfields, '\" + esc(state.cfField) + \"') <> ''\";\r\n  if (state.cfValue) where += \" AND CustomFieldByName(p.customfields, '\" + esc(state.cfField) + \"') = '\" + esc(state.cfValue) + \"'\";\r\n  return await qp(\r\n    \"SELECT p.id AS id, p.num AS num, p.description AS description, p.defaultbomid AS defaultbomid \" +\r\n    \"FROM part p WHERE \" + where + \" ORDER BY p.num LIMIT 200\");\r\n}\r\n\r\n/* ── BOM EXPLOSION (multi-level, in JS) ──\r\n   For each finished good we walk its default BOM. A component becomes its own\r\n   row (a Work Order to create) when it is itself manufactured — i.e. the\r\n   bom item is staged from a BOM (stageBomId) OR the component part has its own\r\n   defaultBomId. Quantities multiply down the tree; shared sub-assemblies\r\n   aggregate. Component quantities are assumed to be per 1 finished-good unit\r\n   (the common case); a finished-good output qty > 1 is not divided out here. */\r\nconst _bomCache = new Map();   // bomId -> components[]\r\nconst _rows = new Map();       // bomId -> row accumulator\r\nlet _queryCount = 0;\r\nconst MAX_QUERIES = 1500;\r\n\r\nasync function getComponents(bomId, fgPartId) {\r\n  if (_bomCache.has(bomId)) return _bomCache.get(bomId);\r\n  _queryCount++;\r\n  const rows = await qp(\r\n    \"SELECT bi.partid AS partid, bi.quantity AS quantity, bi.stagebomid AS stagebomid, \" +\r\n    \"p.num AS partnum, p.description AS partdesc, p.defaultbomid AS partbomid \" +\r\n    \"FROM bomitem bi JOIN part p ON p.id = bi.partid \" +\r\n    \"WHERE bi.bomid = \" + bomId + \" AND bi.partid IS NOT NULL AND bi.partid <> \" + fgPartId + \" AND bi.quantity > 0\");\r\n  _bomCache.set(bomId, rows);\r\n  return rows;\r\n}\r\n\r\nfunction addRow(bomId, partId, partNum, partDesc, addQty, level) {\r\n  let r = _rows.get(bomId);\r\n  if (!r) { r = { bomid: bomId, partid: partId, partnum: partNum, partdesc: partDesc, total: 0, level: level }; _rows.set(bomId, r); }\r\n  r.total += addQty;\r\n  if (level < r.level) r.level = level;\r\n}\r\n\r\nasync function explode(bomId, fgPartId, multiplier, level, visited) {\r\n  if (_queryCount > MAX_QUERIES || visited.has(bomId)) return;\r\n  const v = new Set(visited); v.add(bomId);\r\n  const comps = await getComponents(bomId, fgPartId);\r\n  for (const c of comps) {\r\n    const qtyTotal = multiplier * (parseFloat(c.quantity) || 0);\r\n    const subBom = c.stagebomid || c.partbomid;   // staged BOM wins, else the component's own BOM\r\n    if (subBom) {\r\n      addRow(subBom, c.partid, c.partnum, c.partdesc, qtyTotal, level + 1);\r\n      await explode(subBom, c.partid, qtyTotal, level + 1, v);\r\n    }\r\n    // Components with no BOM are purchased/raw leaves — not Work Orders, so omitted here.\r\n  }\r\n}\r\n\r\n/* ── GENERATE PLAN ── */\r\nasync function generate() {\r\n  const buildQty = parseFloat(document.getElementById('buildQty').value) || 0;\r\n  if (buildQty <= 0) { setStatus('Enter a build quantity greater than zero.'); return; }\r\n  persistControls();\r\n\r\n  document.getElementById('spinner').style.display = 'block';\r\n  document.getElementById('planTable').style.display = 'none';\r\n  setStatus('Exploding BOMs…');\r\n  _bomCache.clear(); _rows.clear(); _queryCount = 0;\r\n\r\n  try {\r\n    const top = await findTopParts();\r\n    if (!top.length) {\r\n      _lastRows = [];\r\n      render();\r\n      setStatus(state.demo ? 'No manufacturable parts found.' : 'No finished goods match that custom field / value.');\r\n      return;\r\n    }\r\n\r\n    for (const p of top) {\r\n      if (!p.defaultbomid) continue;\r\n      addRow(p.defaultbomid, p.id, p.num, p.description, buildQty, 0);\r\n      await explode(p.defaultbomid, p.id, buildQty, 0, new Set());\r\n    }\r\n\r\n    const bomIds = [...(_rows.keys())];\r\n    const partIds = [...new Set([...(_rows.values())].map(r => r.partid).filter(Boolean))];\r\n\r\n    // Batch: BOM number/description + the (placeholder) \"No. Per Blank\" custom field.\r\n    const bomMeta = {};\r\n    if (bomIds.length) {\r\n      const cf = esc(state.perBlankCF || 'No. Per Blank');\r\n      const rows = await qp(\r\n        \"SELECT b.id AS id, b.num AS num, b.description AS description, \" +\r\n        \"CustomFieldByName(b.customfields, '\" + cf + \"') AS perblank \" +\r\n        \"FROM bom b WHERE b.id IN (\" + bomIds.join(',') + \")\");\r\n      rows.forEach(function (r) { bomMeta[r.id] = r; });\r\n    }\r\n\r\n    // Batch: current on-hand by part (fast tag path; typeid 30,40 = on hand).\r\n    const inv = {};\r\n    if (partIds.length) {\r\n      const rows = await qp(\r\n        \"SELECT t.partid AS partid, COALESCE(SUM(t.qty),0) AS qty \" +\r\n        \"FROM tag t WHERE t.typeid IN (30,40) AND t.partid IN (\" + partIds.join(',') + \") GROUP BY t.partid\");\r\n      rows.forEach(function (r) { inv[r.partid] = parseFloat(r.qty) || 0; });\r\n    }\r\n\r\n    _lastRows = [...(_rows.values())].map(function (r) {\r\n      const meta = bomMeta[r.bomid] || {};\r\n      const avail = inv[r.partid] || 0;\r\n      const actual = r.total - avail;                       // shortfall (negative = surplus)\r\n      const perBlankRaw = meta.perblank;\r\n      const perBlank = parseFloat(perBlankRaw);\r\n      const hasPerBlank = !isNaN(perBlank) && perBlank > 0;\r\n      const blanks = hasPerBlank ? Math.ceil(Math.max(0, actual) / perBlank) : null;\r\n      return {\r\n        bomid: r.bomid, bomnum: meta.num || ('BOM#' + r.bomid), bomdesc: meta.description || '',\r\n        partnum: r.partnum, partdesc: r.partdesc, level: r.level,\r\n        perUnit: r.total / buildQty, total: r.total, avail: avail, actual: actual,\r\n        perBlankRaw: perBlankRaw, hasPerBlank: hasPerBlank, blanks: blanks\r\n      };\r\n    }).sort(function (a, b) {\r\n      return (a.level - b.level) || String(a.bomnum).localeCompare(String(b.bomnum));\r\n    });\r\n\r\n    render();\r\n    const capped = _queryCount > MAX_QUERIES ? ' — explosion truncated at ' + MAX_QUERIES + ' BOM lookups, refine the filter' : '';\r\n    setStatus(_lastRows.length + ' BOM/WO suggestion(s) from ' + top.length + ' finished good(s)' + capped);\r\n  } catch (e) {\r\n    console.error(e);\r\n    setStatus('Error: ' + (e.message || e));\r\n    document.getElementById('debugConsole').style.display = 'block';\r\n    dbg('generate() failed: ' + (e.message || e), 'error');\r\n  } finally {\r\n    document.getElementById('spinner').style.display = 'none';\r\n    document.getElementById('planTable').style.display = '';\r\n  }\r\n}\r\n\r\n/* ── RENDER ── */\r\nfunction render() {\r\n  const tbody = document.getElementById('planBody');\r\n  tbody.innerHTML = '';\r\n  if (!_lastRows.length) {\r\n    tbody.innerHTML = '<tr><td class=\"empty\" colspan=\"9\">No BOM/WO suggestions — nothing to build.</td></tr>';\r\n    return;\r\n  }\r\n  const frag = document.createDocumentFragment();\r\n  _lastRows.forEach(function (r) {\r\n    const tr = document.createElement('tr');\r\n\r\n    const bomTd = document.createElement('td');\r\n    bomTd.innerHTML = '<span class=\"lvl-tag\">L' + r.level + '</span>';\r\n    const a = document.createElement('a');\r\n    a.className = 'row-link'; a.href = '#'; a.textContent = r.bomnum;\r\n    a.style.paddingLeft = (r.level * 12) + 'px';\r\n    a.addEventListener('click', function (e) { e.preventDefault(); openModule('Bill of Materials', r.bomnum); });\r\n    bomTd.appendChild(a);\r\n    tr.appendChild(bomTd);\r\n\r\n    tr.appendChild(cell(r.partnum));\r\n    tr.appendChild(cell(r.partdesc, 'muted'));\r\n    tr.appendChild(numCell(fmtQty(r.perUnit)));\r\n    tr.appendChild(numCell(fmtQty(r.total)));\r\n    tr.appendChild(numCell(fmtQty(r.avail)));\r\n\r\n    const actualTd = numCell(fmtQty(r.actual));\r\n    actualTd.classList.add(r.actual > 0 ? 'need' : 'covered');\r\n    tr.appendChild(actualTd);\r\n\r\n    if (r.hasPerBlank) {\r\n      tr.appendChild(numCell(fmtQty(r.perBlankRaw)));\r\n      tr.appendChild(numCell(fmtQty(r.blanks)));\r\n    } else {\r\n      tr.appendChild(numCell('—', 'ph'));   // placeholder until the BOM CF exists\r\n      tr.appendChild(numCell('—', 'ph'));\r\n    }\r\n    frag.appendChild(tr);\r\n  });\r\n  tbody.appendChild(frag);\r\n}\r\nfunction cell(text, cls) { const td = document.createElement('td'); td.textContent = text == null ? '' : text; if (cls) td.className = cls; if (text) td.title = text; return td; }\r\nfunction numCell(text, cls) { const td = document.createElement('td'); td.className = 'num-cell' + (cls ? ' ' + cls : ''); td.textContent = text == null ? '' : text; return td; }\r\n\r\n/* ── CSV ── */\r\nfunction exportCSV() {\r\n  if (!_lastRows.length) { alert('Generate a plan first.'); return; }\r\n  const q = function (v) { return '\"' + String(v == null ? '' : v).replace(/\"/g, '\"\"') + '\"'; };\r\n  const lines = [\"BOM #,Part #,Description,Parts Per Unit,Part Qty Total,Inv Qty Avail,Actual Req'd,No. Per Blank,No. Blanks Req'd\"];\r\n  _lastRows.forEach(function (r) {\r\n    lines.push([r.bomnum, r.partnum, r.partdesc, r.perUnit, r.total, r.avail, r.actual,\r\n      r.hasPerBlank ? r.perBlankRaw : '', r.hasPerBlank ? r.blanks : ''].map(q).join(','));\r\n  });\r\n  const blob = new Blob(['﻿' + lines.join('\\r\\n')], { type: 'text/csv;charset=utf-8;' });\r\n  const url = URL.createObjectURL(blob);\r\n  const a = document.createElement('a');\r\n  a.href = url; a.download = 'BuildPlan_' + new Date().toISOString().split('T')[0] + '.csv';\r\n  a.click(); URL.revokeObjectURL(url);\r\n}\r\n\r\n/* ── SETTINGS PERSISTENCE ── */\r\nfunction persistControls() {\r\n  state.cfField = document.getElementById('cfField').value;\r\n  state.cfValue = document.getElementById('cfValue').value;\r\n  try {\r\n    FBLib.Settings.setUserKey('cfField', state.cfField);\r\n    FBLib.Settings.setUserKey('cfValue', state.cfValue);\r\n    FBLib.Settings.setUserKey('buildQty', parseFloat(document.getElementById('buildQty').value) || 0);\r\n    FBLib.Settings.saveUser();\r\n  } catch (_) {}\r\n}\r\n\r\n/* ── SETTINGS PANEL CONTROLLER (fb-lib consumer) ── */\r\nwindow.PageSettings = (function () {\r\n  'use strict';\r\n  function init() {\r\n    const admin = document.getElementById('dsAdminSection');\r\n    if (admin) admin.style.display = FBLib.Settings.isAdmin() ? 'block' : 'none';\r\n    refreshLockUI();\r\n  }\r\n  function refreshLockUI() {\r\n    const allowed = FBLib.Settings.userEditingAllowed();\r\n    const badge = document.getElementById('dsLockBadge');\r\n    if (badge) badge.style.display = (!allowed && !FBLib.Settings.isAdmin()) ? 'block' : 'none';\r\n    const lockBtn = document.getElementById('dsLockBtn');\r\n    if (lockBtn) lockBtn.textContent = allowed ? 'Lock user editing' : 'Unlock user editing';\r\n  }\r\n  function openPanel() {\r\n    const eff = FBLib.Settings.effective();\r\n    document.getElementById('dsBuildQty').value = eff.buildQty || 100;\r\n    document.getElementById('dsPerBlankCF').value = eff.perBlankCF || 'No. Per Blank';\r\n    document.getElementById('dsDebug').checked = !!eff.debug;\r\n    refreshLockUI();\r\n    document.getElementById('setOverlay').style.display = 'flex';\r\n  }\r\n  function closePanel() { document.getElementById('setOverlay').style.display = 'none'; }\r\n  function closeIfOverlay(e) { if (e && e.target && e.target.id === 'setOverlay') closePanel(); }\r\n  function readPanel() {\r\n    return {\r\n      buildQty: parseFloat(document.getElementById('dsBuildQty').value) || 100,\r\n      perBlankCF: document.getElementById('dsPerBlankCF').value || 'No. Per Blank',\r\n      debug: document.getElementById('dsDebug').checked\r\n    };\r\n  }\r\n  function applyAndClose() {\r\n    closePanel();\r\n    state.perBlankCF = FBLib.Settings.resolve('perBlankCF') || 'No. Per Blank';\r\n    document.getElementById('buildQty').value = FBLib.Settings.resolve('buildQty') || 100;\r\n    document.getElementById('debugConsole').style.display = FBLib.Common.DEBUG_MODE ? 'block' : 'none';\r\n    updateCaption();\r\n  }\r\n  function saveUser() {\r\n    const p = readPanel();\r\n    Object.keys(p).forEach(function (k) { FBLib.Settings.setUserKey(k, p[k]); });\r\n    if (!FBLib.Settings.saveUser()) { alert('User editing is locked by admin.'); return; }\r\n    applyAndClose();\r\n  }\r\n  function resetToDefaults() { if (!confirm('Reset your personal settings to defaults?')) return; FBLib.Settings.clearUser(); applyAndClose(); }\r\n  function publishMaster() {\r\n    if (!FBLib.Settings.isAdmin()) return;\r\n    if (!confirm('Publish current panel values as the default for all users?')) return;\r\n    FBLib.Settings.publishMaster(readPanel()); alert('Published.'); applyAndClose();\r\n  }\r\n  function toggleLock() {\r\n    if (!FBLib.Settings.isAdmin()) return;\r\n    const nowLocked = FBLib.Settings.userEditingAllowed();\r\n    FBLib.Settings.setLock(nowLocked); refreshLockUI();\r\n    alert('User editing: ' + (nowLocked ? 'LOCKED' : 'UNLOCKED'));\r\n  }\r\n  return { init: init, openPanel: openPanel, closePanel: closePanel, closeIfOverlay: closeIfOverlay,\r\n    saveUser: saveUser, resetToDefaults: resetToDefaults, publishMaster: publishMaster, toggleLock: toggleLock };\r\n})();\r\n\r\n/* ── INIT ── */\r\nwindow.onload = async function () {\r\n  document.getElementById('buildQty').value = FBLib.Settings.resolve('buildQty') || 100;\r\n  if (FBLib.Common.DEBUG_MODE) document.getElementById('debugConsole').style.display = 'block';\r\n  PageSettings.init();\r\n  await loadCfFields();\r\n  setStatus('Ready — choose a filter and Generate Plan.');\r\n};\r\n</script>\r\n</body>\r\n</html>\r\n",
  "active" : true,
  "note" : "",
  "type" : "Page"
} ]