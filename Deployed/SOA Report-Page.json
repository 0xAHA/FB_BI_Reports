[ {
  "name" : "SOA Report",
  "description" : "SOA Report",
  "data" : "<!DOCTYPE html>\r\n<!--\r\n================================================================================\r\n  REPORT: SOA Report (Statement of Account)\r\n  PATH:   Custom/Malmet/SOA_Report.htm\r\n  --------------------------------------------------------------------------------\r\n  Invoiced (shipped) sales order lines for a customer group over a date range,\r\n  filterable by product-tree category and free text. Columns are drag-reorderable\r\n  and resizable, persisted per user via FBLib.Settings.\r\n\r\n  Re-platformed onto the shared fb-lib / fb-styles stack (2026-08): shared chrome\r\n  now comes from fb-styles (header/.hdr-btn, .split-btn, .rpt-table §29, .ms-* §32,\r\n  fb-drawer §11, spinner §19) instead of ~100 lines of duplicated local CSS; the\r\n  settings modal became a canonical fb-drawer; the hand-rolled product-tree\r\n  dropdown became FBLib.Common.MultiSelect; and export moved to FBLib.Export,\r\n  which adds a formatted .xlsx alongside the existing CSV.\r\n================================================================================\r\n-->\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <title>SOA Report - Fishbowl BI</title>\r\n\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\r\n\r\n  <!-- Shared Fishbowl BI lib (Settings layer + Common formatting/debug helpers,\r\n       MultiSelect, drawers, and FBLib.Export). Inlined by Fishbowl from the saved\r\n       script named \"fb-lib\". Source of truth: scripts/fb-lib.js. MUST come before\r\n       fb-styles so window.FBLib exists before any inline body code runs. -->\r\n  <script>\r\n    {% Script fb-lib %}\r\n  </script>\r\n\r\n  <!-- Shared chrome (source: scripts/fb-styles.css). Owns the design tokens,\r\n       header/.hdr-btn/.split-btn family, .rpt-table, .ms-*, .row-link, fb-drawer\r\n       and the spinner keyframes. Do NOT redeclare any of those locally. -->\r\n  <style>\r\n    {% Style fb-styles %}\r\n  </style>\r\n\r\n  <style>\r\n    /* REPORT-LOCAL CSS ONLY.\r\n       Tokens, header + .hdr-btn/.split-btn, .rpt-table (§29), .ms-* (§32),\r\n       .row-link (§31), fb-drawer (§11), .ds-* controls and the spinner\r\n       keyframes all come from fb-styles. Everything below is either layout\r\n       unique to this report or a deliberate override of a shared rule. */\r\n\r\n    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }\r\n\r\n    /* ── PAGE ── */\r\n    .wrap { max-width: 100%; margin: 0; padding: 16px 20px 60px; }\r\n    .card { background: #fff; border: 1px solid var(--border); border-radius: var(--r-card); box-shadow: var(--sh1); margin-bottom: 16px; }\r\n\r\n    /* ── CONTROLS ── */\r\n    .controls { display: flex; flex-wrap: wrap; gap: 14px 20px; padding: 14px 16px; align-items: flex-end; }\r\n    .field { display: flex; flex-direction: column; gap: 4px; }\r\n    .field label { font-size: 10px; font-weight: 600; color: #506872; text-transform: uppercase; letter-spacing: 0.04em; }\r\n    .field input[type=text] { min-width: 200px; }\r\n    .field select { min-width: 180px; }\r\n    /* The shared .ms-trigger is a fixed 30px pill sized for a filter strip;\r\n       widen it here so it lines up with the neighbouring 34px inputs. */\r\n    .field .ms-container { min-width: 220px; max-width: 340px; }\r\n    .field .ms-trigger { height: 34px; }\r\n\r\n    /* ── TABLE ──\r\n       .rpt-table supplies the navy header, zebra, hover and totals styling.\r\n       These overrides add what this report needs on top: a FIXED layout so\r\n       the <colgroup> widths the user drags are respected, the sticky offset\r\n       for the 56px page header (§29 assumes a scroll container at top: 0),\r\n       and the drag/resize affordances. */\r\n    .rpt-table { table-layout: fixed; font-size: 12.5px; }\r\n    .rpt-table th { position: sticky; top: 56px; z-index: 5; padding: 8px 10px;\r\n        font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; overflow: hidden; }\r\n    .rpt-table th.nr { text-align: right; }\r\n    .rpt-table th.dragging { opacity: 0.4; }\r\n    .rpt-table td { padding: 6px 10px; overflow: hidden; text-overflow: ellipsis; }\r\n    .col-resize { position: absolute; top: 0; right: 0; width: 7px; height: 100%; cursor: col-resize; }\r\n    .desc { max-width: 280px; overflow: hidden; text-overflow: ellipsis; }\r\n    .loc { max-width: 240px; overflow: hidden; text-overflow: ellipsis; }\r\n    .empty { padding: 36px; text-align: center; color: #8FA1A7; font-style: italic; }\r\n\r\n    /* ── SPINNER (keyframes + .spin come from fb-styles §19) ── */\r\n    #spinner { display: none; padding: 40px; text-align: center; color: #506872; }\r\n\r\n    /* ── SETTINGS DRAWER (chrome from fb-styles §11) ── */\r\n    #setOverlay .ds-section { margin-bottom: 18px; }\r\n    #setOverlay .ds-checks label { display: block; padding: 5px 0; font-size: 13px; cursor: pointer; }\r\n    #setOverlay .ds-checks input { margin-right: 7px; }\r\n\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n  <header>\r\n    <div>\r\n      <h1>SOA Report</h1>\r\n      <p id=\"statusLine\">Initialising…</p>\r\n    </div>\r\n    <div class=\"hdr-actions\">\r\n      <button class=\"hdr-btn\" onclick=\"loadData()\" title=\"Reload\"><svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>Refresh</button>\r\n      <div class=\"split-btn\">\r\n        <button id=\"xlsxBtn\" class=\"hdr-btn hdr-btn-primary\" onclick=\"exportExcel()\" title=\"Download a formatted Excel workbook (.xlsx)\"><svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18M3 15h18M9 3v18\"/></svg>Excel</button>\r\n        <button id=\"csvBtn\" class=\"hdr-btn\" onclick=\"exportCSV()\" title=\"Download the raw data as a CSV file\"><svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6\"/><path d=\"M8 13h8M8 17h5\"/></svg>CSV</button>\r\n      </div>\r\n      <button id=\"setBtn\" class=\"hdr-btn hdr-btn-icon\" onclick=\"FBLib.Common.toggleDrawer('setOverlay')\" title=\"Settings\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M19.14 12.94c.04-.31.06-.62.06-.94 0-.32-.02-.63-.06-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96a7.03 7.03 0 00-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94 0 .32.02.63.06.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 018.4 12 3.6 3.6 0 0112 8.4a3.6 3.6 0 013.6 3.6 3.6 3.6 0 01-3.6 3.6z\"/></svg></button>\r\n    </div>\r\n  </header>\r\n\r\n  <div class=\"wrap\">\r\n\r\n    <!-- CONTROLS -->\r\n    <div class=\"card\">\r\n      <div class=\"controls\">\r\n        <div class=\"field\">\r\n          <label>Customer Group</label>\r\n          <select id=\"groupSel\" onchange=\"loadData()\"></select>\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Product Tree</label>\r\n          <!-- Canonical FBLib.Common.MultiSelect markup (fb-lib MULTI-SELECT\r\n               doc block); the widget is created in init(). -->\r\n          <div class=\"ms-container\" id=\"treeMs\">\r\n            <div class=\"ms-trigger\" id=\"treeMs-trigger\">\r\n              <span class=\"ms-placeholder\" id=\"treeMs-placeholder\">All categories</span>\r\n            </div>\r\n            <div class=\"ms-dropdown hidden\" id=\"treeMs-dropdown\">\r\n              <div class=\"ms-search\"><input type=\"text\" id=\"treeMs-search\" placeholder=\"Filter categories…\" /></div>\r\n              <div class=\"ms-actions\">\r\n                <span id=\"treeMs-all\">Select All</span>\r\n                <span id=\"treeMs-clear\">Clear All</span>\r\n              </div>\r\n              <div class=\"ms-list\" id=\"treeMs-list\"></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Date Invoiced — From</label>\r\n          <input type=\"date\" id=\"dateFrom\" onchange=\"loadData()\" />\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Date Invoiced — To</label>\r\n          <input type=\"date\" id=\"dateTo\" onchange=\"loadData()\" />\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Search product / customer / invoice / PO</label>\r\n          <input type=\"text\" id=\"search\" placeholder=\"contains…\" oninput=\"applyFiltersDebounced()\" />\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- TABLE -->\r\n    <div class=\"card\">\r\n      <div id=\"spinner\"><svg class=\"spin\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"#E3E3E3\" stroke-width=\"3\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke=\"#2d9cdb\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg><div style=\"margin-top:8px;\">Loading invoiced sales…</div></div>\r\n      <table class=\"rpt-table\" id=\"soaTable\">\r\n        <colgroup id=\"soaColgroup\"></colgroup>\r\n        <thead id=\"soaHead\"></thead>\r\n        <tbody id=\"soaBody\">\r\n          <tr><td class=\"empty\" colspan=\"12\">Loading…</td></tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <!-- SETTINGS — canonical fb-drawer (fb-styles §11 + FBLib.Common.registerDrawer).\r\n       Must be a sibling of <header>; fb-lib positions it under the live header\r\n       height and supplies the shared scrim. Never override its z-index. -->\r\n  <div id=\"setOverlay\" class=\"fb-drawer\">\r\n    <div class=\"fb-drawer-head\">\r\n      <h2>Settings — SOA Report</h2>\r\n      <button type=\"button\" class=\"fb-drawer-close\" onclick=\"FBLib.Common.closeDrawer('setOverlay')\">&times;</button>\r\n    </div>\r\n    <div class=\"fb-drawer-body\">\r\n      <div id=\"dsLockBadge\" class=\"ds-lock-badge\" style=\"display:none;\">Locked by admin — your changes won't be saved.</div>\r\n      <div class=\"ds-section ds-checks\">\r\n        <label class=\"ds-label\">Options</label>\r\n        <label><input type=\"checkbox\" id=\"dsDebug\" /> Show debug console</label>\r\n      </div>\r\n      <div id=\"dsAdminSection\" class=\"ds-section ds-admin\" style=\"display:none;\">\r\n        <label class=\"ds-label\">Admin</label>\r\n        <button type=\"button\" class=\"ds-btn ds-btn-admin\" onclick=\"PageSettings.publishMaster()\">Publish as default for everyone</button>\r\n        <button type=\"button\" class=\"ds-btn ds-btn-admin\" id=\"dsLockBtn\" onclick=\"PageSettings.toggleLock()\">Lock user editing</button>\r\n      </div>\r\n    </div>\r\n    <div class=\"fb-drawer-foot\">\r\n      <button type=\"button\" class=\"ds-btn\" onclick=\"PageSettings.resetToDefaults()\">Reset to defaults</button>\r\n      <button type=\"button\" class=\"ds-btn ds-btn-primary\" onclick=\"PageSettings.saveUser()\">Save (just me)</button>\r\n    </div>\r\n  </div>\r\n\r\n<script>\r\n/* ── RUNTIME GUARD ── */\r\nif (typeof runQuery !== 'function' && typeof runQueryAsync !== 'function') {\r\n  document.body.innerHTML = '<div style=\"padding:40px;font-family:sans-serif;color:#475569;\"><h2>Not running inside Fishbowl</h2><p>This report requires the Fishbowl BI environment.</p></div>';\r\n  throw new Error('Fishbowl API not available');\r\n}\r\n\r\n/* ── FB-LIB SETTINGS ── */\r\nFBLib.Settings.init({\r\n  userKey:   'cdx.bi.soa.user.v1',\r\n  masterKey: 'cdx.bi.soa.master.v1',\r\n  defaults: { v: 1, group: 'NSW LHG', dateFrom: '', dateTo: '', cols: [], treeCats: [], debug: false },\r\n  propFallback: { debug: { name: 'BI_SHOW_DEBUG', dflt: 'false', parse: v => (v === 'true' || v === true) } }\r\n});\r\n\r\n/* ── THIN HELPERS ── */\r\nconst _C = (window.FBLib && FBLib.Common) ? FBLib.Common : null;\r\nfunction fmtMoney(v) {\r\n  if (_C && _C.formatMoney) return _C.formatMoney(v);\r\n  const n = parseFloat(v || 0); if (isNaN(n)) return '';\r\n  return (n < 0 ? '-$' : '$') + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\r\n}\r\nfunction fmtQty(v) {\r\n  if (_C && _C.formatQty) return _C.formatQty(v);\r\n  const n = parseFloat(v); if (isNaN(n)) return '';\r\n  return n % 1 === 0 ? String(Math.round(n)) : n.toFixed(4).replace(/\\.?0+$/, '');\r\n}\r\nfunction fmtDate(s) { try { return _C && _C.formatDate ? _C.formatDate(s) : String(s || '').split(' ')[0]; } catch (_) { return String(s || ''); } }\r\nfunction esc(s) { if (_C && _C.escSQL) return _C.escSQL(s); return String(s == null ? '' : s).replace(/'/g, \"''\"); }\r\nfunction escHtml(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }\r\nfunction setStatus(m) { document.getElementById('statusLine').textContent = m; }\r\nfunction safeDate(s) { return /^\\d{4}-\\d{2}-\\d{2}$/.test(s) ? s : ''; }\r\nfunction ymd(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }\r\n\r\n/* ── QUERY HELPERS ── */\r\nfunction norm(r) {\r\n  if (r == null) return [];\r\n  if (typeof r === 'string') { try { const p = JSON.parse(r); return Array.isArray(p) ? p : []; } catch (_) { return []; } }\r\n  return Array.isArray(r) ? r : [];\r\n}\r\nasync function qp(sql) {\r\n  try { return norm(await runQueryAsync(sql)); }\r\n  catch (e) { try { return norm(runQuery(sql)); } catch (e2) { throw e2; } }\r\n}\r\n\r\n/* ── COLUMNS (default order matches the requested spreadsheet; reorderable + resizable) ── */\r\nconst _DEFAULT_COLS = [\r\n  { key: 'productnum',   label: 'Product', w: 130 },\r\n  { key: 'proddesc',     label: 'Product Description', w: 240 },\r\n  { key: 'qty',          label: 'Quantity', w: 80, qty: true, nr: true },\r\n  { key: 'dateordered',  label: 'Date Ordered', w: 110, date: true },\r\n  { key: 'invoicenum',   label: 'Invoice Number', w: 120, link: 'Sales Order' },\r\n  { key: 'totalincl',    label: 'Value (inc GST)', w: 130, money: true, nr: true },\r\n  { key: 'totalexcl',    label: 'Value (ex GST)', w: 130, money: true, nr: true },\r\n  // noTotal: a unit price is a RATE — summing it down the column is\r\n  // meaningless, so the Excel totals row leaves it blank.\r\n  { key: 'unitprice',    label: 'Unit Price', w: 110, money: true, nr: true, noTotal: true },\r\n  { key: 'orderref',     label: 'Customer PO', w: 130 },\r\n  { key: 'dateinvoiced', label: 'Date Invoiced', w: 110, date: true },\r\n  { key: 'partnerloc',   label: 'Partner Location', w: 220 },\r\n  { key: 'customer',     label: 'Customer', w: 180 }\r\n];\r\nlet _cols = _DEFAULT_COLS.map(function (c) { return Object.assign({}, c); });\r\nlet _dragKey = null;\r\nlet _resizing = null;\r\n\r\n/* ── STATE ── */\r\nlet _all = [];\r\nlet _shown = [];\r\nlet _filterTimer = null;\r\nlet _treeCats = [];          // [{ name }] product-tree categories for the filter\r\nconst _selTree = new Set();  // selected category names (never reassign — use clear()/add())\r\nlet _treeMs = null;          // FBLib.Common.MultiSelect instance\r\n\r\n/* ── COLUMN PREFS (reorder + width, persisted via fb-lib) ── */\r\nfunction loadColPrefs() {\r\n  let saved = null;\r\n  try { saved = FBLib.Settings.resolve('cols'); } catch (_) {}\r\n  if (!Array.isArray(saved) || !saved.length) {\r\n    _cols = _DEFAULT_COLS.map(function (c) { return Object.assign({}, c); });\r\n    fitColsToScreen();   // first run: size columns to fill the screen\r\n    return;\r\n  }\r\n  const byKey = {}; _DEFAULT_COLS.forEach(function (c) { byKey[c.key] = c; });\r\n  const out = []; const seen = {};\r\n  saved.forEach(function (s) {\r\n    const d = byKey[s.key];\r\n    if (d && !seen[s.key]) { out.push(Object.assign({}, d, { w: (s.w > 40 ? s.w : d.w) })); seen[s.key] = 1; }\r\n  });\r\n  _DEFAULT_COLS.forEach(function (c) { if (!seen[c.key]) out.push(Object.assign({}, c)); });\r\n  _cols = out;\r\n}\r\nfunction saveColPrefs() {\r\n  try { FBLib.Settings.setUserKey('cols', _cols.map(function (c) { return { key: c.key, w: c.w }; })); FBLib.Settings.saveUser(); } catch (_) {}\r\n}\r\n// Scale the default widths so the columns fill the available width on first load.\r\nfunction fitColsToScreen() {\r\n  const host = document.getElementById('soaTable').parentElement;\r\n  const avail = (host && host.clientWidth) ? host.clientWidth : (window.innerWidth - 40);\r\n  const sum = _cols.reduce(function (s, c) { return s + c.w; }, 0);\r\n  if (avail < 200 || sum <= 0) return;\r\n  const factor = avail / sum;\r\n  _cols.forEach(function (c) { c.w = Math.max(60, Math.round(c.w * factor)); });\r\n}\r\n\r\nfunction renderHead() {\r\n  const cg = document.getElementById('soaColgroup');\r\n  const head = document.getElementById('soaHead');\r\n  let total = 0;\r\n  cg.innerHTML = _cols.map(function (c) { total += c.w; return '<col style=\"width:' + c.w + 'px\">'; }).join('');\r\n  document.getElementById('soaTable').style.width = total + 'px';\r\n\r\n  const tr = document.createElement('tr');\r\n  _cols.forEach(function (c) {\r\n    const th = document.createElement('th');\r\n    if (c.nr) th.className = 'nr';\r\n    th.dataset.key = c.key;\r\n    th.draggable = true;\r\n    th.appendChild(document.createTextNode(c.label));\r\n    const rz = document.createElement('div'); rz.className = 'col-resize';\r\n    rz.addEventListener('mousedown', function (e) { startResize(e, c, th); });\r\n    th.appendChild(rz);\r\n    th.addEventListener('dragstart', function (e) { if (_resizing) { e.preventDefault(); return; } _dragKey = c.key; e.dataTransfer.effectAllowed = 'move'; th.classList.add('dragging'); });\r\n    th.addEventListener('dragover', function (e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; if (_dragKey && _dragKey !== c.key) th.classList.add('drag-over'); });\r\n    th.addEventListener('dragleave', function () { th.classList.remove('drag-over'); });\r\n    th.addEventListener('drop', function (e) {\r\n      e.preventDefault(); th.classList.remove('drag-over');\r\n      if (!_dragKey || _dragKey === c.key) return;\r\n      const fi = _cols.findIndex(function (x) { return x.key === _dragKey; });\r\n      const ti = _cols.findIndex(function (x) { return x.key === c.key; });\r\n      if (fi < 0 || ti < 0) return;\r\n      const m = _cols.splice(fi, 1)[0]; _cols.splice(ti, 0, m);\r\n      saveColPrefs(); renderHead(); render();\r\n    });\r\n    th.addEventListener('dragend', function () { _dragKey = null; document.querySelectorAll('#soaHead th').forEach(function (t) { t.classList.remove('dragging', 'drag-over'); }); });\r\n    tr.appendChild(th);\r\n  });\r\n  head.innerHTML = ''; head.appendChild(tr);\r\n}\r\n\r\nfunction startResize(e, col, th) {\r\n  e.preventDefault(); e.stopPropagation();\r\n  _resizing = { col: col, startX: e.clientX, startW: col.w };\r\n  th.draggable = false;\r\n  document.addEventListener('mousemove', onResizeMove);\r\n  document.addEventListener('mouseup', onResizeUp);\r\n}\r\nfunction onResizeMove(e) {\r\n  if (!_resizing) return;\r\n  const w = Math.max(50, _resizing.startW + (e.clientX - _resizing.startX));\r\n  _resizing.col.w = w;\r\n  const idx = _cols.indexOf(_resizing.col);\r\n  const colEl = document.getElementById('soaColgroup').children[idx];\r\n  if (colEl) colEl.style.width = w + 'px';\r\n  let total = 0; _cols.forEach(function (c) { total += c.w; });\r\n  document.getElementById('soaTable').style.width = total + 'px';\r\n}\r\nfunction onResizeUp() {\r\n  document.removeEventListener('mousemove', onResizeMove);\r\n  document.removeEventListener('mouseup', onResizeUp);\r\n  if (_resizing) { _resizing = null; saveColPrefs(); renderHead(); }\r\n}\r\n\r\n/* ── DEBUG ── */\r\n/* The debug console is fb-lib's shared bottom drawer (mountDebugDrawer) —\r\n   the report no longer carries its own console card or CSS. */\r\nfunction dbg(msg, type) { try { if (FBLib.Common.DEBUG_MODE) FBLib.Common.debugLog(msg, type || 'info'); } catch (_) {} }\r\nfunction applyDebugVisibility() {\r\n  try {\r\n    const api = FBLib.Common.mountDebugDrawer();\r\n    if (!api) return;\r\n    // show() reveals the collapsed bar; collapse() only un-expands, so both\r\n    // are needed to land in the \"visible but not expanded\" state.\r\n    if (FBLib.Common.DEBUG_MODE) { api.show(); api.collapse(); } else { api.hide(); }\r\n  } catch (_) {}\r\n}\r\n\r\n/* ── CUSTOMER GROUP DROPDOWN ── */\r\nasync function loadGroups() {\r\n  const sel = document.getElementById('groupSel');\r\n  let groups = [];\r\n  try { groups = await qp(\"SELECT name FROM accountgroup WHERE name IS NOT NULL AND name <> '' ORDER BY name\"); }\r\n  catch (e) { dbg('accountgroup lookup failed: ' + e.message, 'warning'); }\r\n  const want = FBLib.Settings.resolve('group') || 'NSW LHG';\r\n  sel.innerHTML = '';\r\n  if (!groups.length) { const o = document.createElement('option'); o.value = ''; o.textContent = '(no customer groups found)'; sel.appendChild(o); return; }\r\n  groups.forEach(function (g) {\r\n    const o = document.createElement('option'); o.value = g.name; o.textContent = g.name;\r\n    if (g.name === want) o.selected = true;\r\n    sel.appendChild(o);\r\n  });\r\n}\r\n\r\n/* ── PRODUCT TREE MULTI-SELECT ──\r\n   Uses the shared FBLib.Common.MultiSelect widget (fb-lib) against the\r\n   canonical .ms-container markup, replacing ~60 lines of bespoke dropdown\r\n   code. Filtering is purely client-side, so re-filtering on every checkbox\r\n   (onChange) is cheap — there is no query to defer to onClose. */\r\nasync function loadTreeCats() {\r\n  let cats = [];\r\n  try {\r\n    cats = await qp(\"SELECT DISTINCT pt.name AS name FROM producttree pt \" +\r\n      \"JOIN producttotree ptt ON ptt.producttreeid = pt.id \" +\r\n      \"WHERE pt.name IS NOT NULL AND pt.name <> '' ORDER BY pt.name\");\r\n  } catch (e) { dbg('producttree lookup failed: ' + e.message, 'warning'); }\r\n  _treeCats = cats.map(function (c) { return { name: c.name }; });\r\n\r\n  const saved = FBLib.Settings.resolve('treeCats');\r\n  // Never reassign _selTree — buildMS-style closures hold the Set reference.\r\n  _selTree.clear();\r\n  if (Array.isArray(saved)) saved.forEach(function (v) { _selTree.add(v); });\r\n\r\n  _treeMs = FBLib.Common.MultiSelect.create({\r\n    containerId: 'treeMs',\r\n    items: treeOptions().map(function (c) { return { value: c.name, label: c.name }; }),\r\n    selected: [..._selTree],\r\n    placeholder: 'All categories',\r\n    maxTags: 3,\r\n    onChange: function (selected) {\r\n      _selTree.clear();\r\n      selected.forEach(function (v) { _selTree.add(v); });\r\n      persistTree();\r\n      applyFilters();\r\n    }\r\n  });\r\n}\r\n// \"(Uncategorised)\" pseudo-category catches products with no tree mapping.\r\nfunction treeOptions() { return [{ name: '(Uncategorised)' }].concat(_treeCats); }\r\nfunction persistTree() { try { FBLib.Settings.setUserKey('treeCats', [..._selTree]); FBLib.Settings.saveUser(); } catch (_) {} }\r\n\r\n/* ── LOAD DATA ── */\r\nasync function loadData() {\r\n  const group = document.getElementById('groupSel').value;\r\n  const from = safeDate(document.getElementById('dateFrom').value);\r\n  const to = safeDate(document.getElementById('dateTo').value);\r\n  persistControls();\r\n\r\n  if (!group) { setStatus('Select a customer group.'); return; }\r\n  if (!from || !to) { setStatus('Choose a Date Invoiced range.'); return; }\r\n\r\n  document.getElementById('spinner').style.display = 'block';\r\n  document.getElementById('soaTable').style.display = 'none';\r\n  setStatus('Loading…');\r\n\r\n  try {\r\n    // Invoiced = shipped SO lines (ship.statusId = 30 Shipped). Date Invoiced =\r\n    // ship.dateShipped; Invoice Number = so.num. Customer group via the account's\r\n    // accountgrouprelation → accountgroup. Product-tree category via producttotree.\r\n    //\r\n    // Two legs UNIONed so service / non-inventory items are captured too:\r\n    //   Leg 1 — physical lines that ship (one row per shipitem, qty = qtyShipped).\r\n    //   Leg 2 — lines fulfilled WITHOUT a physical shipment (service, labor, etc.):\r\n    //           one row per soitem on a shipped SO, qty = qtyFulfilled, dated to the\r\n    //           SO's earliest in-range shipment. The NOT EXISTS guard means this leg\r\n    //           adds only lines NOT already counted in leg 1 — so it's correct whether\r\n    //           or not service items happen to create shipitem rows (no double count).\r\n    const treeJoin =\r\n      \"LEFT JOIN (SELECT productid, MIN(producttreeid) AS treeid FROM producttotree GROUP BY productid) ptt ON ptt.productid = soitem.productid \" +\r\n      \"LEFT JOIN producttree ptree ON ptree.id = ptt.treeid \";\r\n    const rows = await qp(\r\n      \"SELECT * FROM ( \" +\r\n      // ── Leg 1: physical shipped lines ──\r\n      \"SELECT so.num AS invoicenum, so.customerpo AS orderref, \" +\r\n      \"so.dateissued AS dateordered, ship.dateshipped AS dateinvoiced, \" +\r\n      \"soitem.productnum AS productnum, COALESCE(prod.description, soitem.description) AS proddesc, \" +\r\n      \"soitem.unitprice AS unitprice, shipitem.qtyshipped AS qty, \" +\r\n      \"COALESCE(soitem.taxrate,0) AS taxrate, cust.name AS customer, \" +\r\n      \"COALESCE(NULLIF(ship.shiptoname,''), so.shiptoname) AS shiptoname, \" +\r\n      \"ship.shiptocity AS shiptocity, ship.shiptoaddress AS shiptoaddr, ptree.name AS treecat \" +\r\n      \"FROM shipitem \" +\r\n      \"JOIN ship ON ship.id = shipitem.shipid \" +\r\n      \"JOIN soitem ON soitem.id = shipitem.soitemid \" +\r\n      \"JOIN so ON so.id = soitem.soid \" +\r\n      \"JOIN customer cust ON cust.id = so.customerid \" +\r\n      \"JOIN accountgrouprelation agr ON agr.accountid = cust.accountid \" +\r\n      \"JOIN accountgroup ag ON ag.id = agr.groupid \" +\r\n      \"LEFT JOIN product prod ON prod.id = soitem.productid \" + treeJoin +\r\n      \"WHERE ship.statusid = 30 AND shipitem.soitemid IS NOT NULL \" +\r\n      \"AND COALESCE(shipitem.qtyshipped,0) > 0 \" +\r\n      \"AND ag.name = '\" + esc(group) + \"' \" +\r\n      \"AND DATE(ship.dateshipped) BETWEEN '\" + from + \"' AND '\" + to + \"' \" +\r\n      \"UNION ALL \" +\r\n      // ── Leg 2: fulfilled-but-not-shipped lines (service / non-inventory) ──\r\n      \"SELECT so.num AS invoicenum, so.customerpo AS orderref, \" +\r\n      \"so.dateissued AS dateordered, shx.dateinvoiced AS dateinvoiced, \" +\r\n      \"soitem.productnum AS productnum, COALESCE(prod.description, soitem.description) AS proddesc, \" +\r\n      \"soitem.unitprice AS unitprice, soitem.qtyfulfilled AS qty, \" +\r\n      \"COALESCE(soitem.taxrate,0) AS taxrate, cust.name AS customer, \" +\r\n      \"so.shiptoname AS shiptoname, so.shiptocity AS shiptocity, so.shiptoaddress AS shiptoaddr, ptree.name AS treecat \" +\r\n      \"FROM soitem \" +\r\n      \"JOIN so ON so.id = soitem.soid \" +\r\n      \"JOIN (SELECT soid, MIN(dateshipped) AS dateinvoiced FROM ship WHERE statusid = 30 \" +\r\n      \"AND DATE(dateshipped) BETWEEN '\" + from + \"' AND '\" + to + \"' GROUP BY soid) shx ON shx.soid = so.id \" +\r\n      \"JOIN customer cust ON cust.id = so.customerid \" +\r\n      \"JOIN accountgrouprelation agr ON agr.accountid = cust.accountid \" +\r\n      \"JOIN accountgroup ag ON ag.id = agr.groupid \" +\r\n      \"LEFT JOIN product prod ON prod.id = soitem.productid \" + treeJoin +\r\n      \"WHERE ag.name = '\" + esc(group) + \"' \" +\r\n      \"AND soitem.productid IS NOT NULL AND soitem.showitemflag = 1 \" +\r\n      \"AND COALESCE(soitem.qtyfulfilled,0) > 0 \" +\r\n      \"AND NOT EXISTS (SELECT 1 FROM shipitem si2 WHERE si2.soitemid = soitem.id AND COALESCE(si2.qtyshipped,0) > 0) \" +\r\n      \") u ORDER BY u.dateinvoiced ASC, u.invoicenum LIMIT 20000\");\r\n\r\n    _all = rows.map(function (r) {\r\n      const loc = (r.shiptoname || '') + (r.shiptocity ? ', ' + r.shiptocity : '');\r\n      // Per-line values: ex-GST = qtyShipped × unit price; inc-GST applies the line tax rate.\r\n      const qty = parseFloat(r.qty) || 0;\r\n      const unitprice = parseFloat(r.unitprice) || 0;\r\n      const taxrate = parseFloat(r.taxrate) || 0;\r\n      const totalexcl = qty * unitprice;\r\n      const totalincl = totalexcl * (1 + taxrate);\r\n      return {\r\n        productnum: r.productnum || '', proddesc: r.proddesc || '',\r\n        qty: qty, dateordered: r.dateordered, invoicenum: r.invoicenum || '',\r\n        totalincl: totalincl, totalexcl: totalexcl,\r\n        unitprice: unitprice, orderref: r.orderref || '',\r\n        dateinvoiced: r.dateinvoiced,\r\n        partnerloc: loc || '', partnerlocFull: [r.shiptoname, r.shiptoaddr, r.shiptocity].filter(Boolean).join(', '),\r\n        customer: r.customer || '', treecat: r.treecat || ''\r\n      };\r\n    });\r\n\r\n    applyFilters();\r\n    const inv = new Set(_all.map(function (r) { return r.invoicenum; }));\r\n    const lineVal = _all.reduce(function (s, r) { return s + r.qty * r.unitprice; }, 0);\r\n    setStatus(_all.length + ' invoiced line(s) · ' + inv.size + ' order(s) · ' + fmtMoney(lineVal) + ' line value · group \"' + group + '\"');\r\n  } catch (e) {\r\n    console.error(e);\r\n    setStatus('Error: ' + (e.message || e));\r\n    document.getElementById('soaBody').innerHTML = '<tr><td class=\"empty\" colspan=\"' + _cols.length + '\">Error: ' + escHtml(e.message || String(e)) + '</td></tr>';\r\n  } finally {\r\n    document.getElementById('spinner').style.display = 'none';\r\n    document.getElementById('soaTable').style.display = '';\r\n  }\r\n}\r\n\r\n/* ── FILTER + RENDER ── */\r\nfunction applyFiltersDebounced() { clearTimeout(_filterTimer); _filterTimer = setTimeout(applyFilters, 200); }\r\n\r\nfunction applyFilters() {\r\n  const q = (document.getElementById('search').value || '').trim().toLowerCase();\r\n  const useTree = _selTree.size > 0;\r\n  _shown = _all.filter(function (r) {\r\n    if (useTree && !_selTree.has(r.treecat || '(Uncategorised)')) return false;\r\n    if (q && (r.productnum + ' ' + r.proddesc + ' ' + r.customer + ' ' + r.invoicenum + ' ' + r.orderref).toLowerCase().indexOf(q) === -1) return false;\r\n    return true;\r\n  });\r\n  render();\r\n}\r\n\r\nfunction render() {\r\n  const tbody = document.getElementById('soaBody');\r\n  tbody.innerHTML = '';\r\n  if (!_shown.length) {\r\n    tbody.innerHTML = '<tr><td class=\"empty\" colspan=\"' + _cols.length + '\">No invoiced lines for this group / date range.</td></tr>';\r\n    return;\r\n  }\r\n  const frag = document.createDocumentFragment();\r\n  _shown.forEach(function (r) {\r\n    const tr = document.createElement('tr');\r\n    _cols.forEach(function (c) { tr.appendChild(buildCell(r, c)); });\r\n    frag.appendChild(tr);\r\n  });\r\n  tbody.appendChild(frag);\r\n}\r\n\r\nfunction buildCell(r, col) {\r\n  const v = r[col.key];\r\n  if (col.link === 'Sales Order' && v) {\r\n    const td = document.createElement('td');\r\n    const a = document.createElement('a'); a.className = 'row-link'; a.href = '#'; a.textContent = v;\r\n    a.addEventListener('click', function (e) { e.preventDefault(); openModule('Sales Order', v); });\r\n    td.appendChild(a); return td;\r\n  }\r\n  if (col.money) return numTd(fmtMoney(v));\r\n  if (col.qty)   return numTd(fmtQty(v));\r\n  if (col.date)  { const td = document.createElement('td'); td.textContent = fmtDate(v); return td; }\r\n  const td = document.createElement('td');\r\n  if (col.cls) td.className = col.cls;\r\n  td.textContent = v == null ? '' : v;\r\n  if (col.key === 'partnerloc' && r.partnerlocFull) td.title = r.partnerlocFull;\r\n  else if (v) td.title = v;\r\n  return td;\r\n}\r\nfunction numTd(text) { const el = document.createElement('td'); el.className = 'num-cell'; el.textContent = text == null ? '' : text; return el; }\r\n\r\n/* ── EXPORTS ──\r\n   Both formats stay available: .xlsx is the deliverable the customer works\r\n   in (formatting travels with the file, so no re-styling and Save-As on\r\n   every run), CSV is kept for feeding other systems.\r\n\r\n   Everything below delegates to FBLib.Export — including the blob download\r\n   itself, which is where the \"second export loses its file extension\" bug\r\n   came from. The old code revoked the object URL synchronously after\r\n   click(), so the download handler could find the URL already dead and\r\n   fall back to the blob's UUID (no extension). See fb-lib for the detail. */\r\n\r\nfunction _exportEnv() { return (window.FBLib && FBLib.Export) ? FBLib.Export : null; }\r\n\r\nfunction _exportBase() {\r\n  const grp = document.getElementById('groupSel').value || 'group';\r\n  const stamp = ymd(new Date());\r\n  return 'SOA_' + grp.replace(/[^A-Za-z0-9]+/g, '_').replace(/^_+|_+$/g, '') + '_' + stamp;\r\n}\r\n\r\n// The banner lines that record exactly which slice of data was exported —\r\n// the file gets emailed around, so it has to be self-describing.\r\nfunction _exportSubtitle() {\r\n  const lines = [];\r\n  const grp = document.getElementById('groupSel').value;\r\n  if (grp) lines.push('Customer group: ' + grp);\r\n  const from = document.getElementById('dateFrom').value;\r\n  const to = document.getElementById('dateTo').value;\r\n  if (from || to) lines.push('Invoiced ' + (from ? fmtDate(from) : '…') + ' – ' + (to ? fmtDate(to) : '…'));\r\n  lines.push('Product tree: ' + (_selTree.size ? Array.from(_selTree).join(', ') : 'All categories'));\r\n  const q = (document.getElementById('search').value || '').trim();\r\n  if (q) lines.push('Search: \"' + q + '\"');\r\n  let who = '';\r\n  try { who = (JSON.parse(getUser()) || {}).userName || ''; } catch (_) {}\r\n  lines.push(_shown.length + ' line' + (_shown.length === 1 ? '' : 's') +\r\n    ' · generated ' + fmtDate(ymd(new Date())) + (who ? ' by ' + who : ''));\r\n  return lines;\r\n}\r\n\r\n// Export the columns the user is actually looking at, in their order and at\r\n// their widths — _cols carries the persisted reorder/resize state.\r\nfunction _exportCols() { return _cols; }\r\n\r\nasync function exportExcel() {\r\n  if (!_shown.length) { alert('Nothing to export.'); return; }\r\n  const X = _exportEnv();\r\n  if (!X || !X.xlsx) {\r\n    alert('Excel export needs an updated \"fb-lib\" script on this server.\\n\\nAsk your administrator to re-save the fb-lib Script, or use the CSV button.');\r\n    return;\r\n  }\r\n  const btn = document.getElementById('xlsxBtn');\r\n  const prev = btn ? btn.innerHTML : '';\r\n  if (btn) { btn.disabled = true; btn.textContent = 'Building…'; }\r\n  setStatus('Building Excel workbook…');\r\n  try {\r\n    const name = await X.xlsx({\r\n      filename: _exportBase() + '.xlsx',\r\n      sheet: {\r\n        name: 'SOA Detail',\r\n        title: 'Statement of Account',\r\n        subtitle: _exportSubtitle(),\r\n        cols: _exportCols(),\r\n        rows: _shown,\r\n        totals: true\r\n      }\r\n    });\r\n    dbg('Exported ' + name + ' (' + _shown.length + ' rows)', 'success');\r\n    setStatus(_shown.length + ' line' + (_shown.length === 1 ? '' : 's') + ' — exported ' + name);\r\n  } catch (e) {\r\n    dbg('Excel export failed: ' + e.message, 'error');\r\n    alert('Could not build the Excel file: ' + e.message);\r\n    setStatus('Excel export failed.');\r\n  } finally {\r\n    if (btn) { btn.disabled = false; btn.innerHTML = prev; }\r\n  }\r\n}\r\n\r\nfunction exportCSV() {\r\n  if (!_shown.length) { alert('Nothing to export.'); return; }\r\n  const X = _exportEnv();\r\n  const name = _exportBase() + '.csv';\r\n  if (X && X.csv) {\r\n    X.csv({ filename: name, cols: _exportCols(), rows: _shown });\r\n  } else {\r\n    // Fallback for a server still running an older fb-lib. Same deferred\r\n    // cleanup as FBLib.Export.download — do NOT revoke synchronously.\r\n    const q = function (v) { return '\"' + String(v == null ? '' : v).replace(/\"/g, '\"\"') + '\"'; };\r\n    const lines = [_cols.map(function (c) { return q(c.label); }).join(',')];\r\n    _shown.forEach(function (r) {\r\n      lines.push(_cols.map(function (c) {\r\n        let v = r[c.key];\r\n        if (c.date) v = fmtDate(v);\r\n        else if (c.money) v = (parseFloat(v) || 0).toFixed(2);\r\n        return q(v);\r\n      }).join(','));\r\n    });\r\n    const blob = new Blob([String.fromCharCode(0xFEFF) + lines.join('\\r\\n')], { type: 'text/csv;charset=utf-8;' });\r\n    const url = URL.createObjectURL(blob);\r\n    const a = document.createElement('a');\r\n    a.href = url; a.download = name; a.rel = 'noopener'; a.style.display = 'none';\r\n    document.body.appendChild(a); a.click();\r\n    setTimeout(function () {\r\n      try { document.body.removeChild(a); } catch (_) {}\r\n      try { URL.revokeObjectURL(url); } catch (_) {}\r\n    }, 4000);\r\n  }\r\n  dbg('Exported ' + name + ' (' + _shown.length + ' rows)', 'success');\r\n  setStatus(_shown.length + ' line' + (_shown.length === 1 ? '' : 's') + ' — exported ' + name);\r\n}\r\n\r\n/* ── SETTINGS PERSISTENCE ── */\r\nfunction persistControls() {\r\n  try {\r\n    FBLib.Settings.setUserKey('group', document.getElementById('groupSel').value || '');\r\n    FBLib.Settings.setUserKey('dateFrom', document.getElementById('dateFrom').value || '');\r\n    FBLib.Settings.setUserKey('dateTo', document.getElementById('dateTo').value || '');\r\n    FBLib.Settings.saveUser();\r\n  } catch (_) {}\r\n}\r\n\r\n/* ── SETTINGS PANEL ──\r\n   Chrome is the shared fb-drawer; fb-lib owns open/close, the scrim, ESC\r\n   and the trigger's .active state. This module only hydrates and reads the\r\n   form (via the registerDrawer onBeforeOpen hook wired in init). */\r\nwindow.PageSettings = (function () {\r\n  'use strict';\r\n  function init() {\r\n    const admin = document.getElementById('dsAdminSection');\r\n    if (admin) admin.style.display = FBLib.Settings.isAdmin() ? 'block' : 'none';\r\n    FBLib.Common.registerDrawer({\r\n      id: 'setOverlay',\r\n      triggerId: 'setBtn',\r\n      onBeforeOpen: hydrate\r\n    });\r\n    refreshLockUI();\r\n  }\r\n  function refreshLockUI() {\r\n    const allowed = FBLib.Settings.userEditingAllowed();\r\n    const badge = document.getElementById('dsLockBadge');\r\n    if (badge) badge.style.display = (!allowed && !FBLib.Settings.isAdmin()) ? 'block' : 'none';\r\n    const lockBtn = document.getElementById('dsLockBtn');\r\n    if (lockBtn) lockBtn.textContent = allowed ? 'Lock user editing' : 'Unlock user editing';\r\n  }\r\n  function hydrate() {\r\n    const eff = FBLib.Settings.effective();\r\n    document.getElementById('dsDebug').checked = !!eff.debug;\r\n    refreshLockUI();\r\n  }\r\n  function openPanel() { FBLib.Common.openDrawer('setOverlay'); }\r\n  function closePanel() { FBLib.Common.closeDrawer('setOverlay'); }\r\n  function readPanel() {\r\n    return { debug: document.getElementById('dsDebug').checked };\r\n  }\r\n  function applyAndClose() {\r\n    closePanel();\r\n    applyDebugVisibility();\r\n  }\r\n  function saveUser() {\r\n    const p = readPanel();\r\n    Object.keys(p).forEach(function (k) { FBLib.Settings.setUserKey(k, p[k]); });\r\n    if (!FBLib.Settings.saveUser()) { alert('User editing is locked by admin.'); return; }\r\n    applyAndClose();\r\n  }\r\n  function resetToDefaults() { if (!confirm('Reset your personal settings to defaults?')) return; FBLib.Settings.clearUser(); location.reload(); }\r\n  function publishMaster() {\r\n    if (!FBLib.Settings.isAdmin()) return;\r\n    if (!confirm('Publish current panel values as the default for all users?')) return;\r\n    FBLib.Settings.publishMaster(readPanel()); alert('Published.'); applyAndClose();\r\n  }\r\n  function toggleLock() {\r\n    if (!FBLib.Settings.isAdmin()) return;\r\n    const nowLocked = FBLib.Settings.userEditingAllowed();\r\n    FBLib.Settings.setLock(nowLocked); refreshLockUI();\r\n    alert('User editing: ' + (nowLocked ? 'LOCKED' : 'UNLOCKED'));\r\n  }\r\n  return { init: init, openPanel: openPanel, closePanel: closePanel,\r\n    saveUser: saveUser, resetToDefaults: resetToDefaults, publishMaster: publishMaster, toggleLock: toggleLock };\r\n})();\r\n\r\n/* ── INIT ── */\r\nwindow.onload = async function () {\r\n  // Default date range: current month to today (persisted values win).\r\n  const today = new Date();\r\n  const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);\r\n  document.getElementById('dateFrom').value = FBLib.Settings.resolve('dateFrom') || ymd(monthStart);\r\n  document.getElementById('dateTo').value = FBLib.Settings.resolve('dateTo') || ymd(today);\r\n  applyDebugVisibility();\r\n  PageSettings.init();\r\n  loadColPrefs();\r\n  renderHead();\r\n  // Outside-click closing of the product-tree dropdown is handled by\r\n  // FBLib.Common.MultiSelect — no local listener needed.\r\n  await loadGroups();\r\n  await loadTreeCats();\r\n  loadData();\r\n};\r\n</script>\r\n</body>\r\n</html>\r\n",
