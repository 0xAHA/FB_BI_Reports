[ {
  "name" : "Open Sales Orders — Sample",
  "description" : "Open Sales Orders — Sample",
  "data" : "<!DOCTYPE html>\r\n<!--\r\n    report-sample.htm — a GENERIC Fishbowl BI report demonstrating the portal\r\n    data transport used by the Cloudflare architecture in this package.\r\n\r\n    It lists open sales orders (Order #, Customer, Status, Total, Date Issued)\r\n    in a sortable table. It runs unchanged in three contexts:\r\n\r\n      • fishbowl   — inside the Fishbowl desktop client (native runQuery bridges)\r\n      • portal     — served from a Cloudflare Pages site behind Access; talks to\r\n                     same-origin /api/data-query (the Pages Function → Worker →\r\n                     tunnel → Fishbowl chain). No token in JS; the Access cookie\r\n                     authenticates.\r\n      • standalone — anywhere else (opened as a file, LAN dev). No backend →\r\n                     it falls back to built-in SAMPLE DATA and shows a banner.\r\n\r\n    This file contains NO real hostnames, emails, or company data. To wire it to\r\n    a real portal, add your Pages hostname to PORTAL_HOSTS below.\r\n\r\n    See ARCHITECTURE.md for the full request chain.\r\n-->\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Open Sales Orders — Sample</title>\r\n    <style>\r\n        * { margin: 0; padding: 0; box-sizing: border-box; }\r\n        body {\r\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\r\n            font-size: 13px; color: #334155; background: #f5f5f5; padding: 16px;\r\n        }\r\n        h1 { font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 2px; }\r\n        .sub { font-size: 12px; color: #64748b; margin-bottom: 12px; }\r\n        .banner {\r\n            display: none; margin-bottom: 12px; padding: 8px 12px; border-radius: 6px;\r\n            font-size: 12px; background: #fff3cd; color: #856404; border: 1px solid #ffe69c;\r\n        }\r\n        .banner.show { display: block; }\r\n        .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; }\r\n        table { width: 100%; border-collapse: collapse; }\r\n        th {\r\n            background: #f8fafc; text-align: left; padding: 10px 12px; font-size: 11px;\r\n            font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: 0.04em;\r\n            border-bottom: 2px solid #e2e8f0; cursor: pointer; user-select: none; white-space: nowrap;\r\n        }\r\n        th:hover { background: #eef2f7; }\r\n        th .arrow { color: #94a3b8; font-size: 10px; margin-left: 4px; }\r\n        th.sorted .arrow { color: #2d9cdb; }\r\n        td { padding: 9px 12px; border-bottom: 1px solid #eef2f7; }\r\n        td.num { font-weight: 600; color: #1e293b; font-variant-numeric: tabular-nums; }\r\n        td.money { text-align: right; font-variant-numeric: tabular-nums; }\r\n        td.date { font-variant-numeric: tabular-nums; white-space: nowrap; }\r\n        tr:hover td { background: #f8fafc; }\r\n        .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }\r\n        .b10 { background: #e2e8f0; color: #475569; }   /* Estimate */\r\n        .b20 { background: #cce5ff; color: #004085; }   /* Issued */\r\n        .b25 { background: #fff3cd; color: #856404; }   /* In Progress */\r\n        .b60 { background: #d4edda; color: #155724; }   /* Fulfilled */\r\n        .empty { padding: 24px; text-align: center; color: #94a3b8; font-style: italic; }\r\n    </style>\r\n</head>\r\n<body>\r\n    <h1>Open Sales Orders</h1>\r\n    <div class=\"sub\" id=\"subtitle\">Loading…</div>\r\n    <div class=\"banner\" id=\"banner\"></div>\r\n    <div class=\"card\">\r\n        <table id=\"tbl\">\r\n            <thead>\r\n                <tr id=\"head\"></tr>\r\n            </thead>\r\n            <tbody id=\"body\">\r\n                <tr><td class=\"empty\" colspan=\"5\">Loading…</td></tr>\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n\r\n    <script>\r\n    // ── Mode detection ───────────────────────────────────────────────\r\n    // Add your Cloudflare Pages hostname(s) here so the page detects\r\n    // portal mode when served from behind Access.\r\n    const PORTAL_HOSTS = ['your-portal.pages.dev', 'portal.example.com'];\r\n    const MODE = (typeof runQuery === 'function'\r\n               || typeof runQueryAsync === 'function'\r\n               || typeof runRestApiAsync === 'function') ? 'fishbowl'\r\n           : PORTAL_HOSTS.includes(location.hostname) ? 'portal'\r\n           : 'standalone';\r\n\r\n    // Connection object. In portal mode baseUrl is empty (same-origin) and the\r\n    // Cloudflare Access cookie authenticates automatically — no token in JS.\r\n    // In standalone mode you'd log in via /api/login and hold a Bearer token;\r\n    // this sample doesn't, so standalone falls through to sample data.\r\n    const _conn = { baseUrl: '', token: null };\r\n    if (MODE === 'standalone') { _conn.baseUrl = 'http://localhost:2456'; }\r\n\r\n    // ── Data transport (trimmed from the production report) ───────────\r\n    function lowercaseKeys(rows) {\r\n        return (rows || []).map(r => {\r\n            if (!r || typeof r !== 'object') return r;\r\n            const out = {};\r\n            for (const k of Object.keys(r)) out[k.toLowerCase()] = r[k];\r\n            return out;\r\n        });\r\n    }\r\n\r\n    // qp() picks the best available transport, in priority order:\r\n    //   runQueryAsync / runQuery  → Fishbowl desktop bridges\r\n    //   runRestApiAsync           → Fishbowl mobile app bridge\r\n    //   httpQuery()               → portal (same-origin) / standalone (Bearer)\r\n    async function qp(sql) {\r\n        if (typeof runQueryAsync === 'function') {\r\n            const r = await runQueryAsync(sql);\r\n            return Array.isArray(r) ? r : (typeof r === 'string' ? JSON.parse(r) : []);\r\n        }\r\n        if (typeof runQuery === 'function') {\r\n            const r = runQuery(sql);\r\n            return typeof r === 'string' ? JSON.parse(r) : (Array.isArray(r) ? r : []);\r\n        }\r\n        if (typeof runRestApiAsync === 'function') {\r\n            const raw = await runRestApiAsync({\r\n                method: 'GET', path: '/api/data-query',\r\n                queryParameters: [['query', sql]],\r\n            });\r\n            const data = typeof raw === 'string' ? JSON.parse(raw) : raw;\r\n            const rows = Array.isArray(data) ? data : (data && (data.rows || data.data || data.results)) || [];\r\n            return lowercaseKeys(rows);\r\n        }\r\n        return await httpQuery(sql);\r\n    }\r\n\r\n    // HTTP transport for /api/data-query.\r\n    //   portal:     same-origin fetch; Access cookie rides along automatically.\r\n    //   standalone: cross-origin fetch with a Bearer token (not set in this sample).\r\n    async function httpQuery(sql) {\r\n        if (MODE === 'standalone' && !_conn.token) {\r\n            const err = new Error('Standalone mode with no token — connect a backend to load live data.');\r\n            err.code = 'NO_TOKEN';\r\n            throw err;\r\n        }\r\n        const url = _conn.baseUrl.replace(/\\/$/, '') + '/api/data-query?query=' + encodeURIComponent(sql);\r\n        const headers = {};\r\n        if (_conn.token) headers.Authorization = 'Bearer ' + _conn.token;\r\n        const res = await fetch(url, { headers });\r\n        if (!res.ok) throw new Error('HTTP ' + res.status + ' ' + res.statusText);\r\n        const data = await res.json();\r\n        const rows = Array.isArray(data) ? data : (data.rows || data.data || data.results || []);\r\n        return lowercaseKeys(rows);\r\n    }\r\n\r\n    // ── Query + rendering ─────────────────────────────────────────────\r\n    const SQL =\r\n        \"SELECT so.num AS num, c.name AS customer, sostatus.name AS status, \" +\r\n        \"       so.statusid AS statusid, so.dateissued AS dateissued, \" +\r\n        \"       so.totalprice AS totalprice \" +\r\n        \"FROM so \" +\r\n        \"JOIN customer c   ON c.id = so.customerid \" +\r\n        \"JOIN sostatus     ON sostatus.id = so.statusid \" +\r\n        \"WHERE so.statusid IN (20, 25) \" +\r\n        \"ORDER BY so.dateissued DESC \" +\r\n        \"LIMIT 200\";\r\n\r\n    // Trimmed status map (matches Fishbowl's sostatus ids).\r\n    const STATUS_MAP = { 10: 'Estimate', 20: 'Issued', 25: 'In Progress', 60: 'Fulfilled' };\r\n\r\n    // Built-in sample data — used when no Fishbowl backend is reachable so the\r\n    // page renders anywhere. NOT real data.\r\n    const MOCK = [\r\n        { num: 'SO-1042', customer: 'Acme Widgets',        statusid: 20, status: 'Issued',      dateissued: '2026-07-02', totalprice: 4820.00 },\r\n        { num: 'SO-1043', customer: 'Globex Supplies',     statusid: 25, status: 'In Progress', dateissued: '2026-07-03', totalprice: 15230.50 },\r\n        { num: 'SO-1044', customer: 'Initech Pty Ltd',     statusid: 20, status: 'Issued',      dateissued: '2026-07-05', totalprice: 990.00 },\r\n        { num: 'SO-1045', customer: 'Umbrella Trading',    statusid: 25, status: 'In Progress', dateissued: '2026-07-05', totalprice: 27640.75 },\r\n        { num: 'SO-1046', customer: 'Wayne Distribution',  statusid: 20, status: 'Issued',      dateissued: '2026-07-08', totalprice: 3125.00 },\r\n        { num: 'SO-1047', customer: 'Stark Wholesale',     statusid: 20, status: 'Issued',      dateissued: '2026-07-09', totalprice: 8410.20 },\r\n        { num: 'SO-1048', customer: 'Hooli Retail',        statusid: 25, status: 'In Progress', dateissued: '2026-07-10', totalprice: 560.00 },\r\n        { num: 'SO-1049', customer: 'Cyberdyne Systems',   statusid: 20, status: 'Issued',      dateissued: '2026-07-11', totalprice: 19875.00 }\r\n    ];\r\n\r\n    const COLS = [\r\n        { key: 'num',        label: 'Order #',     cls: 'num',   type: 'str' },\r\n        { key: 'customer',   label: 'Customer',    cls: '',      type: 'str' },\r\n        { key: 'statusid',   label: 'Status',      cls: '',      type: 'num', badge: true },\r\n        { key: 'totalprice', label: 'Total',       cls: 'money', type: 'num', money: true },\r\n        { key: 'dateissued', label: 'Date Issued', cls: 'date',  type: 'date' }\r\n    ];\r\n\r\n    let _rows = [];\r\n    let _sortKey = 'dateissued';\r\n    let _sortDir = 'desc';\r\n\r\n    function fmtMoney(n) {\r\n        const v = parseFloat(n);\r\n        if (isNaN(v)) return '';\r\n        return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\r\n    }\r\n    function fmtDate(s) {\r\n        if (!s) return '';\r\n        const d = new Date(String(s).split('T')[0] + 'T00:00:00');\r\n        if (isNaN(d.getTime())) return String(s);\r\n        const mm = String(d.getMonth() + 1).padStart(2, '0');\r\n        const dd = String(d.getDate()).padStart(2, '0');\r\n        return mm + '/' + dd + '/' + d.getFullYear();\r\n    }\r\n    function esc(s) {\r\n        return String(s == null ? '' : s).replace(/[&<>\"']/g, c =>\r\n            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\r\n    }\r\n\r\n    function renderHead() {\r\n        document.getElementById('head').innerHTML = COLS.map(c => {\r\n            const sorted = c.key === _sortKey;\r\n            const arrow = sorted ? (_sortDir === 'asc' ? '▲' : '▼') : '⇅';\r\n            const align = c.cls === 'money' ? ' style=\"text-align:right;\"' : '';\r\n            return '<th class=\"' + (sorted ? 'sorted' : '') + '\" data-key=\"' + c.key + '\"' + align + '>'\r\n                 + esc(c.label) + '<span class=\"arrow\">' + arrow + '</span></th>';\r\n        }).join('');\r\n        document.querySelectorAll('#head th').forEach(th =>\r\n            th.addEventListener('click', () => onSort(th.getAttribute('data-key'))));\r\n    }\r\n\r\n    function onSort(key) {\r\n        if (_sortKey === key) _sortDir = (_sortDir === 'asc') ? 'desc' : 'asc';\r\n        else { _sortKey = key; _sortDir = 'asc'; }\r\n        renderHead();\r\n        renderBody();\r\n    }\r\n\r\n    function sorted(rows) {\r\n        const col = COLS.find(c => c.key === _sortKey) || COLS[0];\r\n        const mult = _sortDir === 'asc' ? 1 : -1;\r\n        return rows.slice().sort((a, b) => {\r\n            let av = a[_sortKey], bv = b[_sortKey];\r\n            if (col.type === 'num')  { av = parseFloat(av) || 0; bv = parseFloat(bv) || 0; return (av - bv) * mult; }\r\n            if (col.type === 'date') { av = String(av || ''); bv = String(bv || ''); return av.localeCompare(bv) * mult; }\r\n            return String(av || '').toLowerCase().localeCompare(String(bv || '').toLowerCase()) * mult;\r\n        });\r\n    }\r\n\r\n    function renderBody() {\r\n        const body = document.getElementById('body');\r\n        if (!_rows.length) {\r\n            body.innerHTML = '<tr><td class=\"empty\" colspan=\"' + COLS.length + '\">No open sales orders.</td></tr>';\r\n            return;\r\n        }\r\n        body.innerHTML = sorted(_rows).map(r => '<tr>' + COLS.map(c => {\r\n            if (c.badge) {\r\n                const id = parseInt(r.statusid, 10);\r\n                const label = STATUS_MAP[id] || r.status || id;\r\n                return '<td><span class=\"badge b' + id + '\">' + esc(label) + '</span></td>';\r\n            }\r\n            if (c.money) return '<td class=\"money\">' + fmtMoney(r[c.key]) + '</td>';\r\n            if (c.type === 'date') return '<td class=\"date\">' + fmtDate(r[c.key]) + '</td>';\r\n            return '<td class=\"' + c.cls + '\">' + esc(r[c.key]) + '</td>';\r\n        }).join('') + '</tr>').join('');\r\n    }\r\n\r\n    function showBanner(msg) {\r\n        const b = document.getElementById('banner');\r\n        b.textContent = msg;\r\n        b.classList.add('show');\r\n    }\r\n\r\n    async function load() {\r\n        renderHead();\r\n        try {\r\n            const rows = await qp(SQL);\r\n            _rows = rows;\r\n            document.getElementById('subtitle').textContent =\r\n                rows.length + ' open order' + (rows.length === 1 ? '' : 's') + ' · mode: ' + MODE;\r\n            renderBody();\r\n        } catch (e) {\r\n            // No backend reachable → show sample data so the page still demos.\r\n            console.warn('Live load failed, using sample data:', e);\r\n            _rows = MOCK;\r\n            document.getElementById('subtitle').textContent = MOCK.length + ' sample orders · mode: ' + MODE;\r\n            showBanner('Sample data — not connected to Fishbowl. When deployed behind the Cloudflare portal '\r\n                + '(mode: portal), this table loads live open sales orders via /api/data-query.');\r\n            renderBody();\r\n        }\r\n    }\r\n\r\n    load();\r\n    </script>\r\n</body>\r\n</html>\r\n",
  "active" : true,
  "note" : "",
  "type" : "Page"
} ]