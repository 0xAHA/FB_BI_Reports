[ {
  "name" : "Product Category Assignment",
  "description" : "Product Category Assignment",
  "data" : "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <title>Product Category Assignment — Fishbowl BI</title>\r\n  <script src=\"https://cdn.tailwindcss.com\"></script>\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\r\n  <style>\r\n    html, body { height: 100%; margin: 0; padding: 0; overflow: hidden; font-family: 'Inter', sans-serif; }\r\n    body { display: flex; flex-direction: column; }\r\n\r\n    /* ── Filters panel (mirrors PartActivity.htm) ── */\r\n    #filtersPanel { background: white; border-bottom: 1px solid #e2e8f0; padding: 10px 20px; display: none; flex-shrink: 0; }\r\n    #filtersPanel.open { display: block; }\r\n    #filtersPanel input[type=text] {\r\n      padding: 4px 8px; border: 1px solid #e2e8f0; border-radius: 6px;\r\n      font-size: 12px; color: #374151; background: #f9fafb; font-family: 'Inter', sans-serif;\r\n    }\r\n\r\n    /* ── Multi-select (ported from PartActivity.htm) ── */\r\n    .ms-container { position: relative; }\r\n    .ms-trigger {\r\n      display: flex; align-items: center; flex-wrap: nowrap; gap: 3px;\r\n      border: 1px solid #e2e8f0; border-radius: 6px; padding: 3px 8px;\r\n      background: white; height: 30px; overflow: hidden; cursor: pointer; font-size: 12px;\r\n    }\r\n    .ms-trigger:hover { border-color: #9ca3af; }\r\n    .ms-tag { background: #dbeafe; color: #1d4ed8; padding: 1px 5px; border-radius: 3px; font-size: 11px; display: flex; align-items: center; gap: 2px; white-space: nowrap; }\r\n    .ms-tag-x { cursor: pointer; font-weight: bold; }\r\n    .ms-placeholder { color: #9ca3af; }\r\n    .ms-dropdown {\r\n      position: absolute; z-index: 500; top: calc(100% + 2px); left: 0; right: 0; min-width: 260px;\r\n      background: white; border: 1px solid #d1d5db; border-radius: 6px;\r\n      box-shadow: 0 6px 20px rgba(0,0,0,0.13); display: flex; flex-direction: column; max-height: 320px;\r\n    }\r\n    .ms-search { padding: 6px 8px; border-bottom: 1px solid #f3f4f6; }\r\n    .ms-search input { width: 100%; border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 8px; font-size: 12px; outline: none; font-family: 'Inter', sans-serif; }\r\n    .ms-actions { padding: 3px 10px; border-bottom: 1px solid #f3f4f6; display: flex; gap: 10px; font-size: 11px; }\r\n    .ms-actions span { color: #3b82f6; cursor: pointer; }\r\n    .ms-actions span:hover { text-decoration: underline; }\r\n    .ms-list { overflow-y: auto; flex: 1; }\r\n    .ms-item { display: flex; align-items: center; gap: 8px; padding: 5px 10px; cursor: pointer; font-size: 12px; }\r\n    .ms-item:hover { background: #eff6ff; }\r\n    .ms-item .tree-path { color: #94a3b8; font-size: 10px; margin-left: 4px; }\r\n    .ms-empty { padding: 12px; color: #9ca3af; font-size: 12px; text-align: center; }\r\n\r\n    /* ── Header buttons ── */\r\n    .hdr-btn {\r\n      display: flex; align-items: center; gap: 5px;\r\n      padding: 6px 10px; border-radius: 8px; font-size: 12px; font-weight: 500;\r\n      border: 1px solid #e2e8f0; background: white; color: #475569;\r\n      cursor: pointer; transition: all 0.15s; white-space: nowrap;\r\n    }\r\n    .hdr-btn:hover { background: #f8fafc; border-color: #cbd5e1; }\r\n    .hdr-btn.active { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; }\r\n    .hdr-btn svg { width: 14px; height: 14px; flex-shrink: 0; }\r\n\r\n    /* ── Data table ── */\r\n    #tableWrap { flex: 1; overflow: auto; }\r\n    #dataTable { border-collapse: collapse; width: 100%; font-size: 12px; }\r\n    #dataTable th {\r\n      background: #1e3a5f; color: white; font-weight: 500;\r\n      padding: 8px 10px; text-align: left; white-space: nowrap;\r\n      position: sticky; top: 0; z-index: 10;\r\n    }\r\n    #dataTable th.sortable { cursor: pointer; user-select: none; }\r\n    #dataTable th.sortable:hover { background: #264f80; }\r\n    #dataTable th.sort-asc::after  { content: ' \\2191'; opacity: 0.8; }\r\n    #dataTable th.sort-desc::after { content: ' \\2193'; opacity: 0.8; }\r\n    #dataTable td { padding: 5px 10px; border-bottom: 1px solid #e5e7eb; white-space: nowrap; vertical-align: middle; }\r\n    #dataTable tr:nth-child(even) td { background: #f9fafb; }\r\n    #dataTable tr:hover td { background: #eff6ff !important; }\r\n    #dataTable tr.row-selected td { background: #dbeafe !important; }\r\n    #dataTable td.desc-cell { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n    #dataTable td.trees-cell { white-space: normal; }\r\n\r\n    /* Tree chips inside the table.\r\n       Multi-tree products render one chip per row, stacked vertically via\r\n       a wrapper .tree-stack so each chip occupies its own line. */\r\n    .tree-stack { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; }\r\n    .tree-chip {\r\n      display: inline-flex; align-items: center; gap: 4px;\r\n      background: #ecfdf5; color: #065f46;\r\n      padding: 2px 8px; border-radius: 3px;\r\n      font-size: 11px; font-weight: 500;\r\n      max-width: 100%;\r\n      border: 1px solid #a7f3d0;\r\n      white-space: normal; word-break: break-word;\r\n    }\r\n    .tree-chip.unassigned {\r\n      background: #fff7ed; color: #9a3412;\r\n      border-color: #fdba74;\r\n    }\r\n    .tree-chip .tree-ico { flex-shrink: 0; opacity: 0.7; }\r\n\r\n    /* Folder-style filter dropdown — each row indents by depth */\r\n    .ms-item .folder-ico { width: 12px; height: 12px; color: #94a3b8; flex-shrink: 0; }\r\n    .ms-item.tree-row { gap: 6px; }\r\n\r\n    /* Row checkbox */\r\n    .row-check { width: 14px; height: 14px; accent-color: #2d9cdb; cursor: pointer; }\r\n\r\n    /* Clickable Product # — same look as PartActivity.htm */\r\n    .row-link { color: #2d9cdb; cursor: pointer; text-decoration: none; font-weight: 600; }\r\n    .row-link:hover { text-decoration: underline; color: #1e7bb4; }\r\n\r\n    /* Status indicators */\r\n    .active-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981; }\r\n    .active-dot.inactive { background: #cbd5e1; }\r\n\r\n    /* ── Sticky action bar at bottom ── */\r\n    #actionBar {\r\n      flex-shrink: 0; background: white; border-top: 1px solid #e2e8f0;\r\n      padding: 10px 20px;\r\n      display: flex; align-items: center; gap: 14px; flex-wrap: wrap;\r\n      box-shadow: 0 -2px 12px rgba(0,0,0,0.04);\r\n    }\r\n    #actionBar.disabled { opacity: 0.5; pointer-events: none; }\r\n    #actionBar .selCount { font-size: 13px; font-weight: 600; color: #1e293b; }\r\n    #actionBar select, #actionBar input[type=text] {\r\n      padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px;\r\n      font-size: 12px; background: white; min-width: 240px; font-family: 'Inter', sans-serif;\r\n    }\r\n    #applyBtn {\r\n      padding: 6px 16px; border-radius: 6px; font-size: 12px; font-weight: 600;\r\n      background: #2d9cdb; color: white; border: none; cursor: pointer;\r\n    }\r\n    #applyBtn:hover { background: #1e7bb4; }\r\n    #applyBtn:disabled { background: #cbd5e1; cursor: not-allowed; }\r\n    #clearSelBtn {\r\n      padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 500;\r\n      background: transparent; color: #64748b; border: 1px solid #e2e8f0; cursor: pointer;\r\n    }\r\n    #clearSelBtn:hover { background: #f8fafc; color: #334155; }\r\n\r\n    /* ── Toast ── */\r\n    .toast-container { position: fixed; bottom: 80px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 8px; }\r\n    .toast {\r\n      min-width: 260px; padding: 12px 16px; background: white;\r\n      border-radius: 8px; border-left: 4px solid;\r\n      box-shadow: 0 10px 25px -3px rgba(0,0,0,0.12);\r\n      font-size: 13px; color: #1e293b;\r\n      animation: slideIn .25s ease-out;\r\n    }\r\n    .toast.success { border-color: #10b981; }\r\n    .toast.error   { border-color: #ef4444; }\r\n    .toast.info    { border-color: #2d9cdb; }\r\n    @keyframes slideIn { from { transform: translateX(400px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }\r\n\r\n    /* Spinner */\r\n    @keyframes spin { to { transform: rotate(360deg); } }\r\n    .spinner { animation: spin 0.75s linear infinite; }\r\n\r\n    /* Skeleton overlay while data loads */\r\n    #loadingOverlay {\r\n      position: absolute; inset: 0;\r\n      background: rgba(255,255,255,0.85);\r\n      display: none; align-items: center; justify-content: center;\r\n      z-index: 100;\r\n    }\r\n    #loadingOverlay.show { display: flex; }\r\n  </style>\r\n</head>\r\n<body class=\"bg-slate-50\">\r\n\r\n  <!-- HEADER -->\r\n  <header class=\"bg-white border-b border-slate-200 px-5 flex items-center justify-between flex-shrink-0 shadow-sm\" style=\"height:56px;\">\r\n    <div>\r\n      <h1 class=\"text-base font-bold text-slate-900 leading-tight\">Product Category Assignment</h1>\r\n      <p id=\"statusLine\" class=\"text-xs text-slate-400 leading-tight\">Initialising…</p>\r\n    </div>\r\n    <div class=\"flex items-center gap-2\">\r\n      <button id=\"filtersBtn\" onclick=\"toggleFilters()\" class=\"hdr-btn\">\r\n        <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z\"/></svg>\r\n        Filters\r\n      </button>\r\n      <button onclick=\"loadAll()\" class=\"hdr-btn\">\r\n        <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>\r\n        Refresh\r\n      </button>\r\n      <button onclick=\"exportCSV()\" class=\"hdr-btn\">\r\n        <svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"/></svg>\r\n        CSV\r\n      </button>\r\n    </div>\r\n  </header>\r\n\r\n  <!-- FILTERS PANEL -->\r\n  <div id=\"filtersPanel\">\r\n    <div class=\"flex flex-wrap gap-x-5 gap-y-2 items-end\">\r\n\r\n      <!-- Tree multi-select -->\r\n      <div style=\"min-width:240px; max-width:320px;\">\r\n        <div class=\"text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1\">Filter by Tree</div>\r\n        <div class=\"ms-container\" id=\"tree-ms\">\r\n          <div class=\"ms-trigger\" id=\"treeTrigger\"><span class=\"ms-placeholder\">All trees</span></div>\r\n          <div class=\"ms-dropdown hidden\" id=\"treeDropdown\">\r\n            <div class=\"ms-search\"><input type=\"text\" placeholder=\"Search trees…\" id=\"treeSearch\" /></div>\r\n            <div class=\"ms-actions\"><span id=\"treeAll\">Select All</span><span id=\"treeClear\">Clear All</span></div>\r\n            <div class=\"ms-list\" id=\"treeList\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Active filter -->\r\n      <div style=\"min-width:140px;\">\r\n        <div class=\"text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1\">Active</div>\r\n        <div class=\"ms-container\" id=\"active-ms\">\r\n          <div class=\"ms-trigger\" id=\"activeTrigger\"><span class=\"ms-placeholder\">All</span></div>\r\n          <div class=\"ms-dropdown hidden\" id=\"activeDropdown\">\r\n            <div class=\"ms-list\" id=\"activeList\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Free-text search -->\r\n      <div style=\"min-width:240px; flex:1;\">\r\n        <div class=\"text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1\">Search</div>\r\n        <input type=\"text\" id=\"searchInput\" placeholder=\"Product # or description…\" style=\"width:100%;\" />\r\n      </div>\r\n\r\n      <!-- Untagged toggle -->\r\n      <label class=\"flex items-center gap-2 cursor-pointer pb-1\">\r\n        <input type=\"checkbox\" id=\"untaggedOnly\" class=\"w-4 h-4\" style=\"accent-color:#2d9cdb;\" />\r\n        <span class=\"text-xs font-medium text-slate-700\">Untagged only</span>\r\n      </label>\r\n\r\n    </div>\r\n  </div>\r\n\r\n  <!-- DATA TABLE -->\r\n  <div id=\"tableWrap\" class=\"relative\">\r\n    <table id=\"dataTable\">\r\n      <thead>\r\n        <tr>\r\n          <th style=\"width:34px;\">\r\n            <input type=\"checkbox\" id=\"selectAllBox\" class=\"row-check\" />\r\n          </th>\r\n          <th class=\"sortable\" data-sort=\"num\">Product #</th>\r\n          <th class=\"sortable\" data-sort=\"description\">Description</th>\r\n          <th class=\"sortable\" data-sort=\"active\" style=\"text-align:center;\">Active</th>\r\n          <th>Trees</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody id=\"tableBody\"></tbody>\r\n    </table>\r\n    <div id=\"loadingOverlay\">\r\n      <div class=\"flex flex-col items-center gap-2\">\r\n        <svg class=\"spinner\" width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\">\r\n          <circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"#cbd5e1\" stroke-width=\"3\" />\r\n          <path d=\"M22 12a10 10 0 0 1-10 10\" stroke=\"#2d9cdb\" stroke-width=\"3\" stroke-linecap=\"round\" />\r\n        </svg>\r\n        <span class=\"text-sm text-slate-500\">Loading…</span>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- ACTION BAR (sticky bottom) -->\r\n  <div id=\"actionBar\" class=\"disabled\">\r\n    <span class=\"selCount\" id=\"selCount\">0 selected</span>\r\n    <span class=\"text-xs text-slate-400\">·</span>\r\n    <span class=\"text-xs font-medium text-slate-600\">Assign to tree:</span>\r\n    <select id=\"targetTree\"><option value=\"\">— pick a tree —</option></select>\r\n    <button id=\"applyBtn\" onclick=\"applyAssignment()\" disabled>Apply</button>\r\n    <button id=\"clearSelBtn\" onclick=\"clearSelection()\">Clear selection</button>\r\n    <span class=\"text-xs text-slate-400 ml-auto\">Adds the selected products to the chosen tree. Removing memberships must be done in the Fishbowl client.</span>\r\n  </div>\r\n\r\n  <div class=\"toast-container\" id=\"toasts\"></div>\r\n\r\n  <!-- ═══ DEBUG CONSOLE (fixed bottom, shown when BI_SHOW_DEBUG=true) ════════ -->\r\n  <div id=\"debugConsoleContainer\" style=\"display:none;position:fixed;bottom:0;left:0;right:0;z-index:9000;font-family:'Inter',-apple-system,sans-serif;\">\r\n    <div id=\"debugResizeHandle\" style=\"height:5px;background:transparent;cursor:ns-resize;border-top:2px solid #e2e8f0;\" title=\"Drag to resize\"></div>\r\n    <div style=\"max-width:100%;background:white;box-shadow:0 -4px 24px rgba(0,0,0,.12);\">\r\n      <button onclick=\"toggleDebugConsole()\" style=\"width:100%;padding:8px 16px;display:flex;align-items:center;justify-content:space-between;background:none;border:none;cursor:pointer;text-align:left;\" onmouseover=\"this.style.background='#f8fafc'\" onmouseout=\"this.style.background='none'\">\r\n        <div style=\"display:flex;align-items:center;gap:8px;\">\r\n          <svg width=\"14\" height=\"14\" fill=\"none\" stroke=\"#64748b\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\"/></svg>\r\n          <span style=\"font-size:12px;font-weight:600;color:#475569;\">Debug Console</span>\r\n          <span style=\"font-size:11px;color:#94a3b8;font-weight:400;\">Auto-scrolls to latest entry</span>\r\n        </div>\r\n        <svg id=\"debugChevron\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"2\" viewBox=\"0 0 24 24\" style=\"transition:transform .2s;transform:rotate(180deg)\"><path d=\"M19 9l-7 7-7-7\"/></svg>\r\n      </button>\r\n      <div id=\"debugContent\" style=\"display:none;border-top:1px solid #e2e8f0;\">\r\n        <div style=\"background:#1e293b;padding:6px 14px;display:flex;align-items:center;justify-content:space-between;\">\r\n          <span style=\"font-size:11px;color:#64748b;font-family:monospace;\">Diagnostics</span>\r\n          <div style=\"display:flex;align-items:center;gap:10px;\">\r\n            <button id=\"debugCopyBtn\" onclick=\"copyDebugLog()\" style=\"font-size:11px;color:#64748b;background:none;border:none;cursor:pointer;padding:0;display:flex;align-items:center;gap:4px;\" onmouseover=\"this.style.color='white'\" onmouseout=\"this.style.color='#64748b'\">\r\n              <svg width=\"11\" height=\"11\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><rect x=\"9\" y=\"9\" width=\"13\" height=\"13\" rx=\"2\"/><path d=\"M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1\"/></svg>\r\n              Copy\r\n            </button>\r\n            <button onclick=\"clearDebugLog()\" style=\"font-size:11px;color:#64748b;background:none;border:none;cursor:pointer;padding:0;\" onmouseover=\"this.style.color='white'\" onmouseout=\"this.style.color='#64748b'\">Clear</button>\r\n          </div>\r\n        </div>\r\n        <div id=\"debugLog\" style=\"background:#0f172a;color:#e2e8f0;padding:10px 14px;font-family:monospace;font-size:11px;height:200px;overflow-y:auto;scrollbar-width:thin;\">\r\n          <span style=\"color:#475569;font-style:italic;\">Waiting for application to initialize…</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n<script>\r\n'use strict';\r\n\r\n// ============================================================\r\n// FEATURE DETECTION\r\n// ============================================================\r\nif (typeof runQuery !== 'function' && typeof runQueryAsync !== 'function') {\r\n  document.body.innerHTML = '<div style=\"padding:40px;font-family:sans-serif;color:#475569;\"><h2>Not running inside Fishbowl</h2><p>This report requires the Fishbowl embedded browser. Open it from the BI Script Editor / Report module.</p></div>';\r\n  throw new Error('Fishbowl API not available');\r\n}\r\n\r\n// ============================================================\r\n// STATE\r\n// ============================================================\r\nlet _products = [];          // [{ id, num, description, sku, active, treeIds: Set, treeNames: [] }]\r\nlet _treesById = new Map();  // id -> { id, name, parentId, path, depth }\r\nlet _treesSorted = [];       // flat list sorted by full path (alphabetical)\r\nlet _selectedRowIds = new Set();\r\nlet _sortCol = 'num';\r\nlet _sortDir = 'asc';\r\n\r\n// filter state\r\nconst _selTrees = new Set();\r\nconst _selActive = new Set(['1']);  // default: active only\r\n\r\nlet _activeMS = null;        // currently open multi-select dropdown type\r\n\r\n// ============================================================\r\n// DEBUG CONSOLE — same pattern as Sales_Dashboard_DragDrop.htm\r\n// Enable by setting Fishbowl property BI_SHOW_DEBUG=true.\r\n// ============================================================\r\nconst DEBUG_MODE = (function(){\r\n  try { const v = (typeof getProperty === 'function') ? getProperty('BI_SHOW_DEBUG','false') : 'false'; return v === 'true' || v === true; }\r\n  catch(e) { return false; }\r\n})();\r\n\r\nfunction debugLog(message, type = 'info') {\r\n  if (!DEBUG_MODE) return;\r\n  const ts = new Date().toLocaleTimeString();\r\n  const logDiv = document.getElementById('debugLog');\r\n  if (!logDiv) return;\r\n  if (logDiv.querySelector('span[style*=\"italic\"]')) logDiv.innerHTML = '';\r\n  const colors = { info:'#60a5fa', success:'#34d399', warning:'#fbbf24', error:'#f87171', click:'#c084fc' };\r\n  const entry = document.createElement('div');\r\n  entry.style.marginBottom = '3px';\r\n  entry.innerHTML = `<span style=\"color:#475569\">[${ts}]</span> <span style=\"color:${colors[type]||colors.info}\">${message}</span>`;\r\n  logDiv.appendChild(entry);\r\n  logDiv.scrollTop = logDiv.scrollHeight;\r\n}\r\n\r\nfunction toggleDebugConsole() {\r\n  const content = document.getElementById('debugContent');\r\n  const chevron = document.getElementById('debugChevron');\r\n  const open = content.style.display !== 'none';\r\n  content.style.display = open ? 'none' : 'block';\r\n  chevron.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';\r\n  updateMainContentPadding();\r\n}\r\n\r\n// Push the rest of the layout up by however tall the debug console currently\r\n// is, so the fixed-position console never overlaps the table or action bar.\r\n// Body is a flex column with height:100% — padding-bottom on body shrinks the\r\n// flex content area so children stay fully visible.\r\nfunction updateMainContentPadding() {\r\n  const dc = document.getElementById('debugConsoleContainer');\r\n  if (!dc) return;\r\n  if (dc.style.display !== 'none') {\r\n    document.body.style.paddingBottom = dc.offsetHeight + 'px';\r\n  } else {\r\n    document.body.style.paddingBottom = '';\r\n  }\r\n}\r\n\r\nfunction clearDebugLog() {\r\n  const logDiv = document.getElementById('debugLog');\r\n  if (logDiv) logDiv.innerHTML = '<span style=\"color:#475569;font-style:italic;\">Log cleared</span>';\r\n}\r\n\r\nfunction copyDebugLog() {\r\n  const logDiv = document.getElementById('debugLog');\r\n  if (!logDiv) return;\r\n  const text = Array.from(logDiv.querySelectorAll('div')).map(d => d.textContent).join('\\n');\r\n  navigator.clipboard.writeText(text).then(() => {\r\n    const btn = document.getElementById('debugCopyBtn');\r\n    if (btn) {\r\n      const orig = btn.innerHTML;\r\n      btn.innerHTML = '<svg width=\"11\" height=\"11\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg> Copied!';\r\n      btn.style.color = '#34d399';\r\n      setTimeout(() => { btn.innerHTML = orig; btn.style.color = '#64748b'; }, 1500);\r\n    }\r\n  }).catch(() => {});\r\n}\r\n\r\n// Vertical resize on the console\r\n(function() {\r\n  let _resizing = false, _startY = 0, _startH = 0;\r\n  document.addEventListener('DOMContentLoaded', () => {\r\n    const handle = document.getElementById('debugResizeHandle');\r\n    const log    = document.getElementById('debugLog');\r\n    if (!handle || !log) return;\r\n    handle.addEventListener('mousedown', e => {\r\n      _resizing = true; _startY = e.clientY; _startH = log.offsetHeight;\r\n      document.body.style.userSelect = 'none';\r\n      e.preventDefault();\r\n    });\r\n    document.addEventListener('mousemove', e => {\r\n      if (!_resizing) return;\r\n      const delta = _startY - e.clientY;\r\n      log.style.height = Math.max(80, Math.min(window.innerHeight * 0.7, _startH + delta)) + 'px';\r\n      updateMainContentPadding();\r\n    });\r\n    document.addEventListener('mouseup', () => {\r\n      if (_resizing) { _resizing = false; document.body.style.userSelect = ''; }\r\n    });\r\n  });\r\n})();\r\n\r\n// ============================================================\r\n// HELPERS\r\n// ============================================================\r\nasync function runQueryP(sql) {\r\n  if (typeof runQueryAsync === 'function') {\r\n    const r = await runQueryAsync(sql);\r\n    return Array.isArray(r) ? r : [];\r\n  }\r\n  try { const p = JSON.parse(runQuery(sql)); return Array.isArray(p) ? p : []; }\r\n  catch (e) { return []; }\r\n}\r\n\r\nfunction setStatus(msg) {\r\n  const el = document.getElementById('statusLine');\r\n  if (el) el.textContent = msg;\r\n}\r\n\r\nfunction showToast(message, type = 'info', duration = 3000) {\r\n  const wrap = document.getElementById('toasts');\r\n  const t = document.createElement('div');\r\n  t.className = `toast ${type}`;\r\n  t.textContent = message;\r\n  wrap.appendChild(t);\r\n  setTimeout(() => {\r\n    t.style.opacity = '0';\r\n    t.style.transition = 'opacity .2s';\r\n    setTimeout(() => t.remove(), 250);\r\n  }, duration);\r\n}\r\n\r\nfunction escapeHtml(s) {\r\n  if (s == null) return '';\r\n  return String(s).replace(/[&<>\"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;' })[c]);\r\n}\r\n\r\n// ============================================================\r\n// LOAD: products + tree memberships + tree hierarchy\r\n// ============================================================\r\nasync function loadAll() {\r\n  document.getElementById('loadingOverlay').classList.add('show');\r\n  setStatus('Loading…');\r\n\r\n  try {\r\n    // Tree hierarchy first so we can build paths for products\r\n    const treeRows = await runQueryP(`\r\n      SELECT id, name, parentId\r\n      FROM producttree\r\n      ORDER BY name\r\n    `);\r\n    _buildTreeMap(treeRows);\r\n\r\n    // Products + their tree memberships, flattened with GROUP_CONCAT\r\n    const prodRows = await runQueryP(`\r\n      SELECT\r\n        p.id              AS product_id,\r\n        p.num             AS product_num,\r\n        p.description     AS description,\r\n        p.sku             AS sku,\r\n        p.activeFlag      AS active,\r\n        GROUP_CONCAT(DISTINCT ptt.productTreeId SEPARATOR ',') AS tree_ids\r\n      FROM product p\r\n      LEFT JOIN producttotree ptt ON ptt.productId = p.id\r\n      GROUP BY p.id, p.num, p.description, p.sku, p.activeFlag\r\n      ORDER BY p.num\r\n    `);\r\n\r\n    _products = prodRows.map(r => {\r\n      const treeIds = new Set();\r\n      if (r.tree_ids) {\r\n        String(r.tree_ids).split(',').forEach(s => {\r\n          const n = parseInt(s, 10);\r\n          if (!isNaN(n)) treeIds.add(n);\r\n        });\r\n      }\r\n      return {\r\n        id: r.product_id,\r\n        num: r.product_num || '',\r\n        description: r.description || '',\r\n        sku: r.sku || '',\r\n        active: r.active == 1 || r.active === '1' || r.active === true,\r\n        treeIds\r\n      };\r\n    });\r\n\r\n    _renderFilters();\r\n    _renderTargetTreeDropdown();\r\n    _renderTable();\r\n    setStatus(`${_products.length} products · ${_treesSorted.length} trees`);\r\n  } catch (e) {\r\n    console.error(e);\r\n    showToast('Load failed: ' + e.message, 'error', 6000);\r\n    setStatus('Load failed');\r\n  } finally {\r\n    document.getElementById('loadingOverlay').classList.remove('show');\r\n  }\r\n}\r\n\r\n// Build _treesById + _treesSorted with full hierarchical path for each tree.\r\n// producttree.parentId is self-referential; we walk parents to build \"Root:Branch:Leaf\".\r\nfunction _buildTreeMap(rows) {\r\n  _treesById = new Map();\r\n  rows.forEach(r => {\r\n    _treesById.set(r.id, { id: r.id, name: r.name || '', parentId: r.parentid, path: null, depth: 0 });\r\n  });\r\n\r\n  function pathFor(id, guard = 0) {\r\n    if (guard > 64) return ''; // cycle protection\r\n    const node = _treesById.get(id);\r\n    if (!node) return '';\r\n    if (node.path !== null) return node.path;\r\n    const parent = (node.parentId && node.parentId !== node.id) ? _treesById.get(node.parentId) : null;\r\n    if (parent) {\r\n      node.depth = (parent.depth === undefined ? 0 : parent.depth) + 1;\r\n      node.path = pathFor(parent.id, guard + 1) + ':' + node.name;\r\n    } else {\r\n      node.depth = 0;\r\n      node.path = node.name;\r\n    }\r\n    return node.path;\r\n  }\r\n\r\n  for (const id of _treesById.keys()) pathFor(id);\r\n\r\n  _treesSorted = Array.from(_treesById.values()).sort((a, b) => a.path.localeCompare(b.path));\r\n}\r\n\r\n// ============================================================\r\n// FILTER UI (multi-select pattern from PartActivity.htm)\r\n// ============================================================\r\nfunction toggleFilters() {\r\n  const p = document.getElementById('filtersPanel');\r\n  if (!p) return;\r\n  p.classList.toggle('open');\r\n  closeMS();\r\n}\r\n\r\nfunction _msData(type) {\r\n  switch (type) {\r\n    case 'tree':   return { trigger: 'treeTrigger',   dropdown: 'treeDropdown',   list: 'treeList',   search: 'treeSearch',   placeholder: 'All trees',  items: _treesSorted.map(t => ({ val: String(t.id), lbl: t.name, sub: t.path, depth: t.depth || 0 })), sel: _selTrees };\r\n    case 'active': return { trigger: 'activeTrigger', dropdown: 'activeDropdown', list: 'activeList', search: null,             placeholder: 'All',        items: [{ val: '1', lbl: 'Active' }, { val: '0', lbl: 'Inactive' }], sel: _selActive };\r\n  }\r\n}\r\n\r\nfunction _renderFilters() {\r\n  ['tree', 'active'].forEach(_buildMS);\r\n}\r\n\r\nfunction _buildMS(type) {\r\n  const d = _msData(type);\r\n  if (!d) return;\r\n\r\n  _updateMSTrigger(type);\r\n  const trig = document.getElementById(d.trigger);\r\n  trig.onclick = (e) => { e.stopPropagation(); _toggleMSDropdown(type); };\r\n  const dd = document.getElementById(d.dropdown);\r\n  dd.onclick = (e) => e.stopPropagation();\r\n\r\n  if (d.search) {\r\n    const s = document.getElementById(d.search);\r\n    if (s) s.oninput = e => _renderMSList(type, e.target.value);\r\n  }\r\n  if (type === 'tree') {\r\n    document.getElementById('treeAll').onclick   = (e) => { e.stopPropagation(); _treesSorted.forEach(t => _selTrees.add(String(t.id))); _updateMSTrigger('tree'); _renderMSList('tree', document.getElementById('treeSearch').value); _renderTable(); };\r\n    document.getElementById('treeClear').onclick = (e) => { e.stopPropagation(); _selTrees.clear(); _updateMSTrigger('tree'); _renderMSList('tree', document.getElementById('treeSearch').value); _renderTable(); };\r\n  }\r\n}\r\n\r\nfunction _updateMSTrigger(type) {\r\n  const d = _msData(type);\r\n  if (!d) return;\r\n  const trig = document.getElementById(d.trigger);\r\n  if (!trig) return;\r\n  if (d.sel.size === 0) {\r\n    trig.innerHTML = `<span class=\"ms-placeholder\">${d.placeholder}</span><span style=\"color:#9ca3af;font-size:10px;margin-left:auto;\">▾</span>`;\r\n    return;\r\n  }\r\n  const tags = [];\r\n  let shown = 0;\r\n  for (const it of d.items) {\r\n    if (!d.sel.has(it.val)) continue;\r\n    if (shown < 3) {\r\n      tags.push(`<span class=\"ms-tag\">${escapeHtml(it.lbl)}<span class=\"ms-tag-x\" data-type=\"${type}\" data-val=\"${escapeHtml(it.val)}\">×</span></span>`);\r\n    }\r\n    shown++;\r\n  }\r\n  if (shown > 3) tags.push(`<span class=\"ms-tag\">+${shown - 3}</span>`);\r\n  trig.innerHTML = tags.join('') + '<span style=\"color:#9ca3af;font-size:10px;margin-left:auto;\">▾</span>';\r\n  trig.querySelectorAll('.ms-tag-x').forEach(x => {\r\n    x.onclick = (e) => {\r\n      e.stopPropagation();\r\n      const t = x.dataset.type, v = x.dataset.val;\r\n      _msData(t).sel.delete(v);\r\n      _updateMSTrigger(t);\r\n      _renderTable();\r\n    };\r\n  });\r\n}\r\n\r\nfunction _renderMSList(type, term) {\r\n  const d = _msData(type);\r\n  if (!d) return;\r\n  const list = document.getElementById(d.list);\r\n  if (!list) return;\r\n  const q = (term || '').toLowerCase();\r\n  const items = d.items.filter(it =>\r\n    !q || it.lbl.toLowerCase().includes(q) || (it.sub || '').toLowerCase().includes(q)\r\n  );\r\n  if (!items.length) { list.innerHTML = '<div class=\"ms-empty\">No matches</div>'; return; }\r\n  if (type === 'tree') {\r\n    list.innerHTML = items.map(it => {\r\n      const checked = d.sel.has(it.val) ? 'checked' : '';\r\n      const indent = (it.depth || 0) * 16;\r\n      return `<label class=\"ms-item tree-row\" style=\"padding-left:${10 + indent}px;\" title=\"${escapeHtml(it.sub || it.lbl)}\">`\r\n        + `<input type=\"checkbox\" data-type=\"${type}\" data-val=\"${escapeHtml(it.val)}\" ${checked}>`\r\n        + `<svg class=\"folder-ico\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M2 4a1 1 0 011-1h3.5l1.5 1.5H13a1 1 0 011 1V12a1 1 0 01-1 1H3a1 1 0 01-1-1V4z\"/></svg>`\r\n        + `<span>${escapeHtml(it.lbl)}</span>`\r\n        + `</label>`;\r\n    }).join('');\r\n  } else {\r\n    list.innerHTML = items.map(it => {\r\n      const checked = d.sel.has(it.val) ? 'checked' : '';\r\n      const sub = it.sub && it.sub !== it.lbl ? `<span class=\"tree-path\">${escapeHtml(it.sub)}</span>` : '';\r\n      return `<label class=\"ms-item\"><input type=\"checkbox\" data-type=\"${type}\" data-val=\"${escapeHtml(it.val)}\" ${checked}><span>${escapeHtml(it.lbl)}</span>${sub}</label>`;\r\n    }).join('');\r\n  }\r\n  list.querySelectorAll('input[type=checkbox]').forEach(cb => {\r\n    cb.onchange = () => {\r\n      const t = cb.dataset.type, v = cb.dataset.val, s = _msData(t).sel;\r\n      if (cb.checked) s.add(v); else s.delete(v);\r\n      _updateMSTrigger(t);\r\n      _renderTable();\r\n    };\r\n  });\r\n}\r\n\r\nfunction _toggleMSDropdown(type) {\r\n  const d = _msData(type);\r\n  if (!d) return;\r\n  const dd = document.getElementById(d.dropdown);\r\n  if (_activeMS === type) { closeMS(); return; }\r\n  closeMS();\r\n  _activeMS = type;\r\n  dd.classList.remove('hidden');\r\n  _renderMSList(type, '');\r\n  if (d.search) {\r\n    const s = document.getElementById(d.search);\r\n    s.value = '';\r\n    setTimeout(() => s.focus(), 10);\r\n  }\r\n}\r\n\r\nfunction closeMS() {\r\n  if (!_activeMS) return;\r\n  const d = _msData(_activeMS);\r\n  if (d) document.getElementById(d.dropdown).classList.add('hidden');\r\n  _activeMS = null;\r\n}\r\n\r\ndocument.addEventListener('click', e => { if (!e.target.closest('.ms-container')) closeMS(); });\r\n\r\n// ============================================================\r\n// TABLE\r\n// ============================================================\r\nfunction _filteredProducts() {\r\n  const search = (document.getElementById('searchInput').value || '').trim().toLowerCase();\r\n  const untaggedOnly = document.getElementById('untaggedOnly').checked;\r\n\r\n  return _products.filter(p => {\r\n    if (_selActive.size > 0) {\r\n      const k = p.active ? '1' : '0';\r\n      if (!_selActive.has(k)) return false;\r\n    }\r\n    if (untaggedOnly && p.treeIds.size > 0) return false;\r\n    if (_selTrees.size > 0) {\r\n      let ok = false;\r\n      for (const tid of p.treeIds) {\r\n        if (_selTrees.has(String(tid))) { ok = true; break; }\r\n      }\r\n      if (!ok) return false;\r\n    }\r\n    if (search) {\r\n      const hay = (p.num + ' ' + p.description).toLowerCase();\r\n      if (!hay.includes(search)) return false;\r\n    }\r\n    return true;\r\n  });\r\n}\r\n\r\nfunction _sortProducts(rows) {\r\n  const col = _sortCol, dir = _sortDir === 'asc' ? 1 : -1;\r\n  return rows.slice().sort((a, b) => {\r\n    let av, bv;\r\n    if (col === 'active') { av = a.active ? 1 : 0; bv = b.active ? 1 : 0; }\r\n    else { av = (a[col] || '').toString().toLowerCase(); bv = (b[col] || '').toString().toLowerCase(); }\r\n    if (av < bv) return -1 * dir;\r\n    if (av > bv) return  1 * dir;\r\n    return 0;\r\n  });\r\n}\r\n\r\nfunction _renderTable() {\r\n  const rows = _sortProducts(_filteredProducts());\r\n  const tbody = document.getElementById('tableBody');\r\n  if (!rows.length) {\r\n    tbody.innerHTML = `<tr><td colspan=\"5\" class=\"text-center py-6 text-slate-400\">No products match the current filters.</td></tr>`;\r\n    _updateSelectionUI();\r\n    return;\r\n  }\r\n  const out = rows.map(p => {\r\n    const checked = _selectedRowIds.has(p.id) ? 'checked' : '';\r\n    const rowCls  = _selectedRowIds.has(p.id) ? 'row-selected' : '';\r\n    const trees = p.treeIds.size === 0\r\n      ? '<div class=\"tree-stack\"><span class=\"tree-chip unassigned\">No tree</span></div>'\r\n      : '<div class=\"tree-stack\">' + Array.from(p.treeIds).map(tid => {\r\n          const t = _treesById.get(tid);\r\n          if (!t) return '';\r\n          return `<span class=\"tree-chip\" title=\"${escapeHtml(t.path)}\">${escapeHtml(t.path)}</span>`;\r\n        }).join('') + '</div>';\r\n    const dot = p.active ? '<span class=\"active-dot\" title=\"Active\"></span>' : '<span class=\"active-dot inactive\" title=\"Inactive\"></span>';\r\n    return `<tr class=\"${rowCls}\" data-id=\"${p.id}\">\r\n      <td><input type=\"checkbox\" class=\"row-check\" data-id=\"${p.id}\" ${checked}></td>\r\n      <td><a href=\"#\" class=\"row-link product-link\" data-num=\"${escapeHtml(p.num)}\">${escapeHtml(p.num)}</a></td>\r\n      <td class=\"desc-cell\" title=\"${escapeHtml(p.description)}\">${escapeHtml(p.description)}</td>\r\n      <td style=\"text-align:center;\">${dot}</td>\r\n      <td class=\"trees-cell\">${trees}</td>\r\n    </tr>`;\r\n  }).join('');\r\n  tbody.innerHTML = out;\r\n\r\n  tbody.querySelectorAll('.row-check').forEach(cb => {\r\n    cb.onchange = () => {\r\n      const id = parseInt(cb.dataset.id, 10);\r\n      if (cb.checked) _selectedRowIds.add(id); else _selectedRowIds.delete(id);\r\n      const tr = cb.closest('tr');\r\n      tr.classList.toggle('row-selected', cb.checked);\r\n      _updateSelectionUI();\r\n    };\r\n  });\r\n\r\n  tbody.querySelectorAll('a.product-link').forEach(a => {\r\n    a.addEventListener('click', e => {\r\n      e.preventDefault();\r\n      const num = a.dataset.num;\r\n      if (!num || typeof openModule !== 'function') return;\r\n      try { openModule('Product', num); }\r\n      catch (err) { debugLog('openModule failed: ' + (err.message || err), 'error'); }\r\n    });\r\n  });\r\n\r\n  _updateSelectAllBox(rows);\r\n  _updateSelectionUI();\r\n}\r\n\r\nfunction _updateSelectAllBox(visibleRows) {\r\n  const box = document.getElementById('selectAllBox');\r\n  if (!box) return;\r\n  if (!visibleRows.length) { box.checked = false; box.indeterminate = false; return; }\r\n  const sel = visibleRows.filter(r => _selectedRowIds.has(r.id)).length;\r\n  box.indeterminate = sel > 0 && sel < visibleRows.length;\r\n  box.checked = sel === visibleRows.length;\r\n}\r\n\r\ndocument.getElementById('selectAllBox').addEventListener('change', e => {\r\n  const visible = _sortProducts(_filteredProducts());\r\n  if (e.target.checked) visible.forEach(p => _selectedRowIds.add(p.id));\r\n  else visible.forEach(p => _selectedRowIds.delete(p.id));\r\n  _renderTable();\r\n});\r\n\r\n// Column header sort\r\ndocument.querySelectorAll('#dataTable th.sortable').forEach(th => {\r\n  th.addEventListener('click', () => {\r\n    const col = th.dataset.sort;\r\n    if (_sortCol === col) _sortDir = _sortDir === 'asc' ? 'desc' : 'asc';\r\n    else { _sortCol = col; _sortDir = 'asc'; }\r\n    document.querySelectorAll('#dataTable th.sortable').forEach(h => {\r\n      h.classList.remove('sort-asc', 'sort-desc');\r\n      if (h.dataset.sort === _sortCol) h.classList.add(_sortDir === 'asc' ? 'sort-asc' : 'sort-desc');\r\n    });\r\n    _renderTable();\r\n  });\r\n});\r\n\r\ndocument.getElementById('searchInput').addEventListener('input', _renderTable);\r\ndocument.getElementById('untaggedOnly').addEventListener('change', _renderTable);\r\n\r\n// ============================================================\r\n// ACTION BAR — selection + assignment\r\n// ============================================================\r\nfunction _renderTargetTreeDropdown() {\r\n  const sel = document.getElementById('targetTree');\r\n  sel.innerHTML = '<option value=\"\">— pick a tree —</option>' +\r\n    _treesSorted.map(t => `<option value=\"${t.id}\">${escapeHtml(t.path)}</option>`).join('');\r\n  sel.onchange = _updateSelectionUI;\r\n}\r\n\r\nfunction _updateSelectionUI() {\r\n  const n = _selectedRowIds.size;\r\n  document.getElementById('selCount').textContent = `${n} selected`;\r\n  const bar = document.getElementById('actionBar');\r\n  bar.classList.toggle('disabled', n === 0);\r\n  const applyBtn = document.getElementById('applyBtn');\r\n  const hasTarget = !!document.getElementById('targetTree').value;\r\n  applyBtn.disabled = n === 0 || !hasTarget;\r\n}\r\n\r\nfunction clearSelection() {\r\n  _selectedRowIds.clear();\r\n  _renderTable();\r\n}\r\n\r\n// ============================================================\r\n// APPLY — write via Fishbowl ImportRq Type=ProductTree\r\n// Columns: ProductNumber, Path (colon-separated, e.g. \"Product:Branch1:Leaf\")\r\n// Note: ImportRq Type=ProductTree only ADDS memberships. To remove a product\r\n// from a tree the user must use the Fishbowl client.\r\n// ============================================================\r\nasync function applyAssignment() {\r\n  const treeId = document.getElementById('targetTree').value;\r\n  if (!treeId || _selectedRowIds.size === 0) return;\r\n  const tree = _treesById.get(parseInt(treeId, 10));\r\n  if (!tree) { showToast('Target tree not found', 'error'); return; }\r\n\r\n  const ids = Array.from(_selectedRowIds);\r\n  const selectedProducts = ids.map(id => _products.find(p => p.id === id)).filter(Boolean);\r\n  if (!selectedProducts.length) return;\r\n\r\n  const path = tree.path; // e.g. \"Product:Branch1:Leaf\"\r\n\r\n  debugLog(`Assigning ${selectedProducts.length} product(s) to tree \"${path}\"`, 'info');\r\n\r\n  const btn = document.getElementById('applyBtn');\r\n  const origLabel = btn.textContent;\r\n  btn.disabled = true;\r\n  btn.textContent = 'Saving…';\r\n\r\n  let okCount = 0, failCount = 0;\r\n  const errors = [];\r\n\r\n  for (const p of selectedProducts) {\r\n    try {\r\n      const result = await _importProductTreeRow(p.num, path);\r\n      if (result.ok) {\r\n        okCount++;\r\n        debugLog(`✓ ${p.num} → ${path}`, 'success');\r\n        // Optimistically update local state so the UI reflects the new\r\n        // membership without waiting for the full reload.\r\n        p.treeIds.add(tree.id);\r\n      } else {\r\n        failCount++;\r\n        errors.push(`${p.num}: ${result.error}`);\r\n        debugLog(`✗ ${p.num}: ${result.error}`, 'error');\r\n      }\r\n    } catch (e) {\r\n      failCount++;\r\n      errors.push(`${p.num}: ${e.message || e}`);\r\n      debugLog(`✗ ${p.num}: ${e.message || e}`, 'error');\r\n    }\r\n  }\r\n\r\n  btn.textContent = origLabel;\r\n  _renderTable();\r\n  _updateSelectionUI();\r\n\r\n  if (failCount === 0) {\r\n    showToast(`✓ Assigned ${okCount} product(s) to ${tree.name}`, 'success', 4000);\r\n  } else if (okCount === 0) {\r\n    showToast(`Assignment failed for all ${failCount} product(s) — see console`, 'error', 6000);\r\n    console.error('ProductTree import errors:\\n' + errors.join('\\n'));\r\n  } else {\r\n    showToast(`Partial: ${okCount} succeeded, ${failCount} failed — see console`, 'error', 6000);\r\n    console.error('ProductTree import errors:\\n' + errors.join('\\n'));\r\n  }\r\n\r\n  // Re-sync from the database so the UI matches reality.\r\n  await loadAll();\r\n}\r\n\r\n// Submit a single ProductTree import row.\r\n// Build a 2-row CSV body (header + data) and post via ImportRq.\r\nasync function _importProductTreeRow(productNumber, path) {\r\n  if (typeof runApiRequest !== 'function') {\r\n    return { ok: false, error: 'runApiRequest not available' };\r\n  }\r\n  const csvEsc = (s) => {\r\n    const v = String(s == null ? '' : s);\r\n    return (v.includes(',') || v.includes('\"') || v.includes('\\n'))\r\n      ? `\"${v.replace(/\"/g, '\"\"')}\"`\r\n      : v;\r\n  };\r\n  // Fishbowl ImportRq convention: Type is \"Import<Name>\", first row is the\r\n  // column-name header, subsequent rows are data. Other reports in this repo\r\n  // (e.g. ImportDefaultLocations) follow the same shape.\r\n  const headerRow = '\"ProductNumber\",\"Path\"';\r\n  const dataRow = `${csvEsc(productNumber)},${csvEsc(path)}`;\r\n\r\n  const payload = {\r\n    ImportRq: {\r\n      Type: 'ImportProductTree',\r\n      Rows: { Row: [headerRow, dataRow] }\r\n    }\r\n  };\r\n  const payloadStr = JSON.stringify(payload);\r\n  debugLog(`ImportRq CSV ↓`, 'info');\r\n  debugLog(`  ${headerRow}`, 'info');\r\n  debugLog(`  ${dataRow}`, 'info');\r\n\r\n  let raw;\r\n  try {\r\n    raw = runApiRequest('ImportRq', payloadStr);\r\n  } catch (e) {\r\n    debugLog(`runApiRequest threw: ${e.message || e}`, 'error');\r\n    return { ok: false, error: e.message || String(e) };\r\n  }\r\n  if (!raw) {\r\n    debugLog('runApiRequest returned empty response', 'error');\r\n    return { ok: false, error: 'no response' };\r\n  }\r\n\r\n  // Surface the raw response so we can see exactly what came back.\r\n  const preview = typeof raw === 'string' ? raw : JSON.stringify(raw);\r\n  debugLog(`ImportRq ← ${preview.length > 400 ? preview.slice(0, 400) + '…' : preview}`, 'info');\r\n\r\n  let resp;\r\n  try { resp = typeof raw === 'string' ? JSON.parse(raw) : raw; }\r\n  catch (e) {\r\n    debugLog(`Unparseable response: ${preview.slice(0, 200)}`, 'error');\r\n    return { ok: false, error: 'unparseable response' };\r\n  }\r\n\r\n  const rs = resp && resp.ImportRs;\r\n  if (rs && rs.statusCode === 1000) return { ok: true };\r\n  const msg = rs ? `${rs.statusCode || ''} ${rs.statusMessage || ''}`.trim() : 'unknown';\r\n  return { ok: false, error: msg };\r\n}\r\n\r\n// ============================================================\r\n// CSV export (visible rows)\r\n// ============================================================\r\nfunction exportCSV() {\r\n  const rows = _sortProducts(_filteredProducts());\r\n  if (!rows.length) { showToast('Nothing to export', 'info'); return; }\r\n  const headers = ['product_num', 'description', 'active', 'tree_paths'];\r\n  const esc = v => {\r\n    const s = v == null ? '' : String(v);\r\n    return (s.includes(',') || s.includes('\"') || s.includes('\\n'))\r\n      ? `\"${s.replace(/\"/g, '\"\"')}\"` : s;\r\n  };\r\n  let csv = headers.join(',') + '\\n';\r\n  rows.forEach(p => {\r\n    const paths = Array.from(p.treeIds).map(tid => _treesById.get(tid)?.path).filter(Boolean).join(' | ');\r\n    csv += [p.num, p.description, p.active ? 'Y' : 'N', paths].map(esc).join(',') + '\\n';\r\n  });\r\n  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });\r\n  const a = document.createElement('a');\r\n  a.href = URL.createObjectURL(blob);\r\n  const ts = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);\r\n  a.download = `ProductCategoryAssignment_${ts}.csv`;\r\n  document.body.appendChild(a); a.click(); document.body.removeChild(a);\r\n}\r\n\r\n// ============================================================\r\n// INIT\r\n// ============================================================\r\ndocument.addEventListener('DOMContentLoaded', () => {\r\n  if (DEBUG_MODE) {\r\n    const dc = document.getElementById('debugConsoleContainer');\r\n    if (dc) dc.style.display = 'block';\r\n    // Open the panel by default so the user sees output without an extra click.\r\n    const content = document.getElementById('debugContent');\r\n    const chevron = document.getElementById('debugChevron');\r\n    if (content) content.style.display = 'block';\r\n    if (chevron) chevron.style.transform = 'rotate(0deg)';\r\n    updateMainContentPadding();\r\n    debugLog('Debug mode enabled (BI_SHOW_DEBUG=true)', 'info');\r\n    debugLog('runApiRequest available: ' + (typeof runApiRequest === 'function'), typeof runApiRequest === 'function' ? 'success' : 'warning');\r\n  }\r\n  document.getElementById('targetTree').addEventListener('change', _updateSelectionUI);\r\n  loadAll();\r\n});\r\n\r\n// Keep padding in sync if the window itself is resized while the console is open.\r\nwindow.addEventListener('resize', updateMainContentPadding);\r\n</script>\r\n</body>\r\n</html>\r\n",
