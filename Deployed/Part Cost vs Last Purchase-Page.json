[ {
  "name" : "Part Cost vs Last Purchase",
  "description" : "Part Cost vs Last Purchase",
  "data" : "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <title>Part Cost vs Last Purchase - Fishbowl BI</title>\r\n\r\n  <!-- Google Fonts - Inter -->\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\r\n\r\n  <!-- Shared Fishbowl BI lib (Settings layer + Common formatting/debug helpers).\r\n       Inlined by Fishbowl from the saved script named \"fb-lib\". Source of truth\r\n       lives at scripts/fb-lib.js. Uses FBLib.Common + FBLib.Settings only. -->\r\n  <script>\r\n    {% Script fb-lib %}\r\n  </script>\r\n\r\n  <style>\r\n    * { box-sizing: border-box; }\r\n    html, body { margin: 0; padding: 0; }\r\n    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 13px; color: #1e293b; background: #f8fafc; }\r\n\r\n    /* ── HEADER BAR ── */\r\n    header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; height: 56px; }\r\n    header h1 { font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.15; }\r\n    #statusLine { font-size: 12px; color: #94a3b8; line-height: 1.15; margin: 0; }\r\n    .hdr-actions { display: flex; align-items: center; gap: 8px; }\r\n    .hdr-btn { display: flex; align-items: center; gap: 5px; padding: 6px 10px; border-radius: 8px; font-size: 12px; font-weight: 500; border: 1px solid #e2e8f0; background: #fff; color: #475569; cursor: pointer; transition: all 0.15s; white-space: nowrap; font-family: inherit; }\r\n    .hdr-btn:hover { background: #f8fafc; border-color: #cbd5e1; }\r\n    .hdr-btn:disabled { opacity: 0.5; cursor: not-allowed; }\r\n    .hdr-btn svg { width: 14px; height: 14px; flex-shrink: 0; }\r\n    .hdr-btn-icon { padding: 7px; border-radius: 8px; }\r\n    .hdr-sep { width: 1px; height: 24px; background: #e2e8f0; margin: 0 2px; }\r\n\r\n    /* ── PAGE ── */\r\n    .wrap { max-width: 1400px; margin: 0 auto; padding: 16px 20px 60px; }\r\n    .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); margin-bottom: 16px; }\r\n\r\n    /* ── CONTROLS STRIP ── */\r\n    .controls { display: flex; flex-wrap: wrap; gap: 14px 20px; padding: 14px 16px; align-items: flex-end; }\r\n    .field { display: flex; flex-direction: column; gap: 4px; }\r\n    .field label { font-size: 10px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; }\r\n    .field select, .field input { padding: 7px 9px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; color: #1e293b; background: #fff; font-family: inherit; }\r\n    .field input[type=number] { width: 110px; text-align: right; }\r\n    .field input[type=text] { min-width: 240px; }\r\n    .field select:focus, .field input:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }\r\n    .field .chk { display: flex; align-items: center; gap: 7px; text-transform: none; font-size: 12px; font-weight: 500; color: #475569; cursor: pointer; padding-bottom: 7px; }\r\n    .field .chk input { width: auto; padding: 0; margin: 0; border: 0; box-shadow: none; }\r\n\r\n    /* ── BULK ACTIONS (inline with filters) ── */\r\n    .bulk-actions { display: flex; align-items: center; gap: 10px; padding-bottom: 1px; }\r\n    .sel-count { font-size: 12px; color: #475569; font-weight: 600; white-space: nowrap; }\r\n    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 7px; font-size: 12px; font-weight: 600; border: 1px solid #cbd5e1; background: #fff; color: #334155; cursor: pointer; font-family: inherit; }\r\n    .btn:hover { background: #f1f5f9; }\r\n    .btn:disabled { opacity: 0.5; cursor: not-allowed; }\r\n    .btn-primary { background: #2563eb; border-color: #2563eb; color: #fff; }\r\n    .btn-primary:hover { background: #1d4ed8; }\r\n    .spacer { flex: 1; }\r\n\r\n    /* ── TABLE ── */\r\n    .data-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }\r\n    .data-table th { background: #1e3a5f; color: #fff; font-weight: 500; font-size: 11px; text-align: left; padding: 8px 10px; white-space: nowrap; position: sticky; top: 56px; z-index: 5; text-transform: uppercase; letter-spacing: 0.03em; }\r\n    .data-table th.nr { text-align: right; }\r\n    .data-table th.ctr, .data-table td.ctr { text-align: center; }\r\n    .data-table td { padding: 6px 10px; border-bottom: 1px solid #eef2f7; white-space: nowrap; vertical-align: middle; }\r\n    .data-table tbody tr:nth-child(even) td { background: #f9fafb; }\r\n    .data-table tbody tr:hover td { background: #eff6ff; }\r\n    .data-table tbody tr.sel td { background: #eef6ff; }\r\n    .num-cell { text-align: right; font-variant-numeric: tabular-nums; }\r\n    .muted { color: #94a3b8; }\r\n    .desc { max-width: 260px; overflow: hidden; text-overflow: ellipsis; }\r\n    .row-link { color: #2563eb; cursor: pointer; text-decoration: none; font-weight: 600; }\r\n    .row-link:hover { text-decoration: underline; }\r\n    .chip { display: inline-block; font-size: 10px; font-weight: 600; color: #475569; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 999px; padding: 2px 8px; }\r\n    .up { color: #b45309; font-weight: 600; }      /* last > current (cost should rise) */\r\n    .down { color: #047857; font-weight: 600; }     /* last < current (cost should drop) */\r\n    .flat { color: #94a3b8; }\r\n    .new { color: #7c3aed; font-weight: 600; }       /* current cost is 0 */\r\n    .upd-btn { padding: 4px 9px; font-size: 11px; border-radius: 6px; border: 1px solid #bfdbfe; background: #eff6ff; color: #1d4ed8; cursor: pointer; font-weight: 600; font-family: inherit; }\r\n    .upd-btn:hover { background: #dbeafe; }\r\n    .upd-btn:disabled { opacity: 0.4; cursor: not-allowed; background: #f8fafc; color: #94a3b8; border-color: #e2e8f0; }\r\n    .empty { padding: 36px; text-align: center; color: #94a3b8; font-style: italic; }\r\n\r\n    /* ── SPINNER ── */\r\n    #spinner { display: none; padding: 40px; text-align: center; color: #64748b; }\r\n    @keyframes spin { to { transform: rotate(360deg); } }\r\n    .spin { animation: spin 0.8s linear infinite; }\r\n\r\n    /* ── DEBUG ── */\r\n    #debugConsole { display: none; }\r\n    #debugConsole .dc-head { display: flex; justify-content: space-between; align-items: center; background: #0f172a; padding: 10px 14px; border-radius: 10px 10px 0 0; }\r\n    #debugConsole .dc-head h3 { margin: 0; font-size: 12px; color: #e2e8f0; }\r\n    #debugLog { background: #0f172a; border-radius: 0 0 10px 10px; padding: 12px; max-height: 260px; overflow-y: auto; font-family: ui-monospace, monospace; font-size: 11px; color: #e2e8f0; white-space: pre-wrap; }\r\n    .mini-btn { padding: 4px 9px; font-size: 11px; border-radius: 6px; border: 1px solid #334155; background: #1e293b; color: #cbd5e1; cursor: pointer; font-family: inherit; }\r\n\r\n    /* ── IMPORT/RESULT STATUS ── */\r\n    #statusBanner { display: none; margin-bottom: 16px; }\r\n    #statusBanner .msg { padding: 12px 16px; border-radius: 8px; font-weight: 600; font-size: 13px; }\r\n    .msg-ok { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }\r\n    .msg-err { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }\r\n    .msg-info { background: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; }\r\n\r\n    /* ── SETTINGS PANEL ── */\r\n    #setOverlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1001; display: none; justify-content: flex-end; }\r\n    #setPanel { background: #f8fafc; width: 400px; max-width: 95vw; height: 100%; overflow-y: auto; box-shadow: -2px 0 12px rgba(0,0,0,0.25); display: flex; flex-direction: column; }\r\n    #setPanel .ds-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-bottom: 1px solid #e2e8f0; background: #fff; }\r\n    #setPanel .ds-header h2 { margin: 0; font-size: 15px; }\r\n    #setPanel .ds-close { background: transparent; border: none; font-size: 24px; cursor: pointer; color: #64748b; line-height: 1; }\r\n    #setPanel .ds-body { padding: 16px 18px; flex: 1; }\r\n    #setPanel .ds-section { margin-bottom: 20px; }\r\n    #setPanel .ds-label { display: block; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: #475569; margin-bottom: 8px; }\r\n    #setPanel .ds-sub { font-size: 11px; color: #94a3b8; margin: -4px 0 8px; }\r\n    #setPanel input, #setPanel select { width: 100%; padding: 7px 9px; font-size: 13px; border: 1px solid #cbd5e1; border-radius: 6px; background: #fff; font-family: inherit; margin-bottom: 8px; }\r\n    #setPanel .ds-checks label { display: block; padding: 5px 0; font-size: 13px; cursor: pointer; }\r\n    #setPanel .ds-checks input { width: auto; margin-right: 7px; }\r\n    #setPanel .ds-footer { padding: 12px 18px; border-top: 1px solid #e2e8f0; background: #fff; display: flex; gap: 8px; justify-content: flex-end; }\r\n    #setPanel .ds-btn { padding: 7px 14px; font-size: 13px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; cursor: pointer; font-family: inherit; }\r\n    #setPanel .ds-btn-primary { background: #2563eb; color: #fff; border-color: #2563eb; }\r\n    #setPanel .ds-admin { border-top: 1px dashed #cbd5e1; padding-top: 16px; }\r\n    #setPanel .ds-btn-admin { display: block; width: 100%; margin-bottom: 6px; background: #fef3c7; border-color: #f59e0b; color: #7c2d12; }\r\n    #setPanel .ds-lock-badge { background: #fef3c7; color: #92400e; border: 1px solid #f59e0b; padding: 6px 10px; border-radius: 6px; font-size: 12px; margin-bottom: 14px; }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n  <header>\r\n    <div>\r\n      <h1>Part Cost vs Last Purchase</h1>\r\n      <p id=\"statusLine\">Initialising…</p>\r\n    </div>\r\n    <div class=\"hdr-actions\">\r\n      <button class=\"hdr-btn\" onclick=\"loadData()\" title=\"Reload\"><svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>Refresh</button>\r\n      <button class=\"hdr-btn\" onclick=\"exportCSV()\" title=\"Export CSV\"><svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"/></svg>CSV</button>\r\n      <button class=\"hdr-btn hdr-btn-icon\" onclick=\"PageSettings.openPanel()\" title=\"Settings\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M19.14 12.94c.04-.31.06-.62.06-.94 0-.32-.02-.63-.06-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96a7.03 7.03 0 00-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94 0 .32.02.63.06.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 018.4 12 3.6 3.6 0 0112 8.4a3.6 3.6 0 013.6 3.6 3.6 3.6 0 01-3.6 3.6z\"/></svg></button>\r\n    </div>\r\n  </header>\r\n\r\n  <div class=\"wrap\">\r\n\r\n    <div id=\"statusBanner\"><div class=\"msg\" id=\"statusBannerMsg\"></div></div>\r\n\r\n    <!-- CONTROLS + BULK BAR -->\r\n    <div class=\"card\">\r\n      <div class=\"controls\">\r\n        <div class=\"field\">\r\n          <label>Search part # / description</label>\r\n          <input type=\"text\" id=\"search\" placeholder=\"contains…\" oninput=\"applyFiltersDebounced()\" />\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Lookback (days)</label>\r\n          <input type=\"number\" id=\"lookbackDays\" min=\"1\" step=\"1\" value=\"365\" onchange=\"loadData()\" />\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Min |Δ%|</label>\r\n          <input type=\"number\" id=\"minDelta\" min=\"0\" step=\"1\" value=\"0\" oninput=\"applyFiltersDebounced()\" />\r\n        </div>\r\n        <div class=\"field\" style=\"justify-content:flex-end;\">\r\n          <label class=\"chk\"><input type=\"checkbox\" id=\"hideNoPrice\" checked onchange=\"applyFilters()\" /> Hide parts with no recent purchase</label>\r\n        </div>\r\n        <div class=\"spacer\"></div>\r\n        <div class=\"bulk-actions\">\r\n          <span class=\"sel-count\" id=\"selCount\">0 selected</span>\r\n          <button class=\"btn btn-primary\" id=\"updateSelectedBtn\" onclick=\"updateSelected()\" disabled>\r\n            <svg width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg>\r\n            Update Selected\r\n          </button>\r\n          <button class=\"btn\" id=\"updateAllBtn\" onclick=\"updateAllShown()\" title=\"\">Update All Shown</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- TABLE -->\r\n    <div class=\"card\">\r\n      <div id=\"spinner\"><svg class=\"spin\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"#e2e8f0\" stroke-width=\"3\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke=\"#2563eb\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg><div style=\"margin-top:8px;\">Loading parts &amp; purchase history…</div></div>\r\n      <table class=\"data-table\" id=\"costTable\">\r\n        <thead>\r\n          <tr>\r\n            <th class=\"ctr\"><input type=\"checkbox\" id=\"selAll\" onchange=\"toggleSelectAll(this)\" /></th>\r\n            <th>Part #</th>\r\n            <th>Description</th>\r\n            <th>Type</th>\r\n            <th class=\"nr\">Current Cost</th>\r\n            <th class=\"nr\">Last Purchase</th>\r\n            <th class=\"nr\">Δ %</th>\r\n            <th class=\"nr\">Recent POs</th>\r\n            <th class=\"nr\">Qty Purch.</th>\r\n            <th class=\"nr\">Price Range</th>\r\n            <th class=\"ctr\">Update</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody id=\"costBody\">\r\n          <tr><td class=\"empty\" colspan=\"11\">Loading…</td></tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <!-- DEBUG -->\r\n    <div class=\"card\" id=\"debugConsole\">\r\n      <div class=\"dc-head\"><h3>Debug Console (raw import responses appear here)</h3><button class=\"mini-btn\" onclick=\"clearDebug()\">Clear</button></div>\r\n      <div id=\"debugLog\"></div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <!-- SETTINGS PANEL -->\r\n  <div id=\"setOverlay\" onclick=\"PageSettings.closeIfOverlay(event)\">\r\n    <div id=\"setPanel\" onclick=\"event.stopPropagation()\">\r\n      <div class=\"ds-header\">\r\n        <h2>Settings — Part Cost</h2>\r\n        <button type=\"button\" class=\"ds-close\" onclick=\"PageSettings.closePanel()\">&times;</button>\r\n      </div>\r\n      <div class=\"ds-body\">\r\n        <div id=\"dsLockBadge\" class=\"ds-lock-badge\" style=\"display:none;\">Locked by admin — your changes won't be saved.</div>\r\n\r\n        <div class=\"ds-section\">\r\n          <label class=\"ds-label\">Defaults</label>\r\n          <div class=\"ds-sub\">Lookback window (days) for \"last purchase\" &amp; the recent stats.</div>\r\n          <input type=\"number\" id=\"dsLookback\" min=\"1\" step=\"1\" />\r\n          <div class=\"ds-sub\">Minimum |Δ%| to show (0 = all).</div>\r\n          <input type=\"number\" id=\"dsMinDelta\" min=\"0\" step=\"1\" />\r\n        </div>\r\n\r\n        <div class=\"ds-section ds-checks\">\r\n          <label class=\"ds-label\">Options</label>\r\n          <label><input type=\"checkbox\" id=\"dsDebug\" /> Show debug console</label>\r\n        </div>\r\n\r\n        <div id=\"dsAdminSection\" class=\"ds-section ds-admin\" style=\"display:none;\">\r\n          <label class=\"ds-label\">Admin</label>\r\n          <button type=\"button\" class=\"ds-btn ds-btn-admin\" onclick=\"PageSettings.publishMaster()\">Publish as default for everyone</button>\r\n          <button type=\"button\" class=\"ds-btn ds-btn-admin\" id=\"dsLockBtn\" onclick=\"PageSettings.toggleLock()\">Lock user editing</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"ds-footer\">\r\n        <button type=\"button\" class=\"ds-btn\" onclick=\"PageSettings.resetToDefaults()\">Reset to defaults</button>\r\n        <button type=\"button\" class=\"ds-btn ds-btn-primary\" onclick=\"PageSettings.saveUser()\">Save (just me)</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n<script>\r\n/* ── RUNTIME GUARD ── */\r\nif (typeof runQuery !== 'function' && typeof runQueryAsync !== 'function') {\r\n  document.body.innerHTML = '<div style=\"padding:40px;font-family:sans-serif;color:#475569;\"><h2>Not running inside Fishbowl</h2><p>This report requires the Fishbowl BI environment (it reads parts via runQuery and writes cost via the Import API).</p></div>';\r\n  throw new Error('Fishbowl API not available');\r\n}\r\n\r\n/* ── FB-LIB SETTINGS ── */\r\nFBLib.Settings.init({\r\n  masterStorage: 'userProperties',   // shared admin defaults via userproperties, not report data (which needs a SAVED report — see FBLib.SharedData)\r\n  userKey:   'cdx.bi.partCost.user.v1',\r\n  masterKey: 'cdx.bi.partCost.master.v1',\r\n  defaults: {\r\n    v: 1,\r\n    lookbackDays: 365,\r\n    minDeltaPct: 0,\r\n    hideNoPrice: true,\r\n    importType: 'ImportPartProductAndVendorPricing',\r\n    costColumn: '',      // blank = auto-detect the Standard Cost column\r\n    partNumColumn: '',   // blank = auto-detect the Part Number column\r\n    debug: false\r\n  },\r\n  propFallback: { debug: { name: 'BI_SHOW_DEBUG', dflt: 'false', parse: v => (v === 'true' || v === true) } }\r\n});\r\n\r\n/* ── THIN HELPERS (prefer FBLib.Common; local fallback if saved fb-lib is behind) ── */\r\nconst _C = (window.FBLib && FBLib.Common) ? FBLib.Common : null;\r\nfunction fmtMoney(v) {\r\n  if (_C && _C.formatMoney) return _C.formatMoney(v);\r\n  const n = parseFloat(v || 0); if (isNaN(n)) return '';\r\n  return (n < 0 ? '-$' : '$') + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\r\n}\r\nfunction fmtQty(v) {\r\n  if (_C && _C.formatQty) return _C.formatQty(v);\r\n  const n = parseFloat(v); if (isNaN(n)) return '';\r\n  return n % 1 === 0 ? String(Math.round(n)) : n.toFixed(4).replace(/\\.?0+$/, '');\r\n}\r\nfunction esc(s) {\r\n  if (_C && _C.escSQL) return _C.escSQL(s);\r\n  return String(s == null ? '' : s).replace(/'/g, \"''\");\r\n}\r\nfunction escHtml(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }\r\nfunction setStatus(m) { document.getElementById('statusLine').textContent = m; }\r\n\r\n/* ── QUERY HELPERS ── */\r\nfunction norm(r) {\r\n  if (r == null) return [];\r\n  if (typeof r === 'string') { try { const p = JSON.parse(r); return Array.isArray(p) ? p : []; } catch (_) { return []; } }\r\n  return Array.isArray(r) ? r : [];\r\n}\r\nasync function qp(sql) {\r\n  try { return norm(await runQueryAsync(sql)); }\r\n  catch (e) { try { return norm(runQuery(sql)); } catch (e2) { throw e2; } }\r\n}\r\nfunction fmtDate(s) { try { return _C && _C.formatDate ? _C.formatDate(s) : String(s || '').split(' ')[0]; } catch (_) { return String(s || ''); } }\r\n\r\n/* ── STATE ── */\r\nlet _all = [];          // all rows (parts + purchase stats)\r\nlet _shown = [];        // filtered rows currently rendered\r\nconst _selected = new Set();   // selected partids\r\nlet _inventoryTypeId = 10;     // resolved at load (Inventory part type)\r\nlet _filterTimer = null;\r\n\r\n// Part cost is written via the Fishbowl Import API. The REST /api/parts/{id}\r\n// endpoint is read-only (POST returns HTTP 405 — no update verb exists), so we\r\n// use the same ImportRq path the other tools use. The canonical CSV header for\r\n// the import type is fetched once via ImportHeaderRq and cached here.\r\nlet _imp = null;   // { type, header:[], partIdx, costIdx, idx:{uom,type,desc} }\r\n\r\n/* ── DEBUG ── */\r\nfunction dbg(msg, type) { try { if (FBLib.Common.DEBUG_MODE) FBLib.Common.debugLog(msg, type || 'info'); } catch (_) {} }\r\nfunction dbgForce(msg, type) {\r\n  document.getElementById('debugConsole').style.display = 'block';\r\n  try { FBLib.Common.debugLog(msg, type || 'info'); } catch (_) {\r\n    const box = document.getElementById('debugLog');\r\n    const d = document.createElement('div'); d.textContent = msg; box.appendChild(d); box.scrollTop = box.scrollHeight;\r\n  }\r\n}\r\nfunction clearDebug() { try { FBLib.Common.clearDebugLog(); } catch (_) {} if (!FBLib.Common.DEBUG_MODE) document.getElementById('debugConsole').style.display = 'none'; }\r\n\r\n/* ── BANNER ── */\r\nfunction banner(msg, kind) {\r\n  const wrap = document.getElementById('statusBanner');\r\n  const el = document.getElementById('statusBannerMsg');\r\n  el.innerHTML = msg; el.className = 'msg ' + (kind === 'ok' ? 'msg-ok' : kind === 'err' ? 'msg-err' : 'msg-info');\r\n  wrap.style.display = 'block';\r\n  if (kind === 'ok') setTimeout(function () { wrap.style.display = 'none'; }, 9000);\r\n}\r\n\r\n/* ── LOAD DATA ── */\r\nasync function loadData() {\r\n  const lookbackDays = parseInt(document.getElementById('lookbackDays').value, 10) || 365;\r\n  persistControls();\r\n  document.getElementById('spinner').style.display = 'block';\r\n  document.getElementById('costTable').style.display = 'none';\r\n  setStatus('Loading…');\r\n  _selected.clear();\r\n\r\n  try {\r\n    // Resolve the Inventory part type id (everything else counts as non-stock-tracked).\r\n    const types = await qp(\"SELECT id, name FROM parttype\");\r\n    const typeName = {};\r\n    types.forEach(function (t) { typeName[t.id] = t.name; });\r\n    const inv = types.find(function (t) { return String(t.name || '').toLowerCase() === 'inventory'; });\r\n    _inventoryTypeId = inv ? inv.id : 10;\r\n\r\n    // Non-stock-tracked parts.\r\n    const parts = await qp(\r\n      \"SELECT p.id AS id, p.num AS num, p.description AS description, p.typeid AS typeid, \" +\r\n      \"p.stdcost AS stdcost, COALESCE(pc.avgcost,0) AS avgcost, u.code AS uom \" +\r\n      \"FROM part p JOIN uom u ON u.id = p.uomid \" +\r\n      \"LEFT JOIN partcost pc ON pc.partid = p.id \" +\r\n      \"WHERE p.activeflag = 1 AND p.typeid <> \" + _inventoryTypeId + \" \" +\r\n      \"ORDER BY p.num LIMIT 5000\");\r\n\r\n    // Purchase history within the lookback window, chunked by part id.\r\n    const windowStart = new Date(Date.now() - lookbackDays * 86400000).toISOString().split('T')[0];\r\n    const ids = parts.map(function (p) { return p.id; });\r\n    const hist = {};   // partid -> {last, lastDate, count, qty, min, max}\r\n    for (let i = 0; i < ids.length; i += 1000) {\r\n      const chunk = ids.slice(i, i + 1000);\r\n      if (!chunk.length) continue;\r\n      const rows = await qp(\r\n        \"SELECT poitem.partid AS partid, poitem.unitcost AS unitcost, \" +\r\n        \"COALESCE(poitem.datelastfulfillment, po.dateissued, po.datecreated) AS pdate, \" +\r\n        \"COALESCE(poitem.qtyfulfilled, poitem.qtytofulfill, 0) AS qty \" +\r\n        \"FROM poitem JOIN po ON po.id = poitem.poid \" +\r\n        \"WHERE poitem.partid IN (\" + chunk.join(',') + \") AND poitem.unitcost IS NOT NULL \" +\r\n        \"AND po.statusid NOT IN (10, 80) \" +\r\n        \"AND COALESCE(poitem.datelastfulfillment, po.dateissued, po.datecreated) >= '\" + windowStart + \"' \" +\r\n        \"ORDER BY poitem.partid, pdate DESC\");\r\n      rows.forEach(function (r) {\r\n        const pid = r.partid;\r\n        const cost = parseFloat(r.unitcost);\r\n        if (isNaN(cost)) return;\r\n        let h = hist[pid];\r\n        if (!h) { h = hist[pid] = { last: cost, lastDate: r.pdate, count: 0, qty: 0, min: cost, max: cost }; }\r\n        // rows are DESC by date, so the first seen per part is the most recent\r\n        h.count += 1;\r\n        h.qty += parseFloat(r.qty) || 0;\r\n        if (cost < h.min) h.min = cost;\r\n        if (cost > h.max) h.max = cost;\r\n      });\r\n    }\r\n\r\n    _all = parts.map(function (p) {\r\n      const h = hist[p.id];\r\n      const cur = parseFloat(p.stdcost) || 0;\r\n      const last = h ? h.last : null;\r\n      let delta = null;\r\n      if (last != null) { delta = cur > 0 ? ((last - cur) / cur) * 100 : (last > 0 ? Infinity : 0); }\r\n      return {\r\n        id: p.id, num: p.num, description: p.description || '',\r\n        typeid: p.typeid, typename: typeName[p.typeid] || ('Type ' + p.typeid), uom: p.uom || '',\r\n        current: cur, last: last, lastDate: h ? h.lastDate : null, delta: delta,\r\n        count: h ? h.count : 0, qty: h ? h.qty : 0,\r\n        min: h ? h.min : null, max: h ? h.max : null\r\n      };\r\n    });\r\n\r\n    applyFilters();\r\n    const withPx = _all.filter(function (r) { return r.last != null; }).length;\r\n    setStatus(_all.length + ' non-stock parts · ' + withPx + ' with a purchase in the last ' + lookbackDays + ' days');\r\n  } catch (e) {\r\n    console.error(e);\r\n    setStatus('Error: ' + (e.message || e));\r\n    document.getElementById('costBody').innerHTML = '<tr><td class=\"empty\" colspan=\"11\">Error: ' + escHtml(e.message || String(e)) + '</td></tr>';\r\n  } finally {\r\n    document.getElementById('spinner').style.display = 'none';\r\n    document.getElementById('costTable').style.display = '';\r\n  }\r\n}\r\n\r\n/* ── FILTER + RENDER ── */\r\nfunction applyFiltersDebounced() { clearTimeout(_filterTimer); _filterTimer = setTimeout(applyFilters, 200); }\r\n\r\nfunction applyFilters() {\r\n  const q = (document.getElementById('search').value || '').trim().toLowerCase();\r\n  const minDelta = Math.abs(parseFloat(document.getElementById('minDelta').value) || 0);\r\n  const hideNoPrice = document.getElementById('hideNoPrice').checked;\r\n  persistControls();\r\n  _shown = _all.filter(function (r) {\r\n    if (hideNoPrice && r.last == null) return false;\r\n    if (q && (r.num + ' ' + r.description).toLowerCase().indexOf(q) === -1) return false;\r\n    if (minDelta > 0) {\r\n      if (r.delta == null) return false;\r\n      if (r.delta !== Infinity && Math.abs(r.delta) < minDelta) return false;\r\n    }\r\n    return true;\r\n  });\r\n  render();\r\n}\r\n\r\nfunction deltaCell(r) {\r\n  if (r.delta == null) return '<span class=\"muted\">—</span>';\r\n  if (r.current === 0) return '<span class=\"new\">new</span>';\r\n  if (r.delta === Infinity) return '<span class=\"new\">∞</span>';\r\n  const cls = r.delta > 0.05 ? 'up' : (r.delta < -0.05 ? 'down' : 'flat');\r\n  const sign = r.delta > 0 ? '+' : '';\r\n  return '<span class=\"' + cls + '\">' + sign + r.delta.toFixed(1) + '%</span>';\r\n}\r\n\r\nfunction render() {\r\n  const tbody = document.getElementById('costBody');\r\n  tbody.innerHTML = '';\r\n  if (!_shown.length) {\r\n    tbody.innerHTML = '<tr><td class=\"empty\" colspan=\"11\">No parts match the current filters.</td></tr>';\r\n    updateSelCount();\r\n    return;\r\n  }\r\n  const frag = document.createDocumentFragment();\r\n  _shown.forEach(function (r) {\r\n    const tr = document.createElement('tr');\r\n    if (_selected.has(r.id)) tr.className = 'sel';\r\n    const canUpdate = r.last != null;\r\n\r\n    // checkbox\r\n    const cbTd = document.createElement('td'); cbTd.className = 'ctr';\r\n    const cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = _selected.has(r.id);\r\n    cb.disabled = !canUpdate;\r\n    cb.addEventListener('change', function () { toggleRow(r.id, cb.checked); });\r\n    cbTd.appendChild(cb); tr.appendChild(cbTd);\r\n\r\n    // part # link\r\n    const pTd = document.createElement('td');\r\n    const a = document.createElement('a'); a.className = 'row-link'; a.href = '#'; a.textContent = r.num;\r\n    a.addEventListener('click', function (e) { e.preventDefault(); openModule('Part', r.num); });\r\n    pTd.appendChild(a); tr.appendChild(pTd);\r\n\r\n    tr.appendChild(td(r.description, 'desc muted', r.description));\r\n    const tTd = document.createElement('td'); tTd.innerHTML = '<span class=\"chip\">' + escHtml(r.typename) + '</span>'; tr.appendChild(tTd);\r\n    tr.appendChild(numTd(fmtMoney(r.current)));\r\n    tr.appendChild(numTd(r.last != null ? fmtMoney(r.last) : '—', r.last == null ? 'muted' : '', r.lastDate ? 'Last purchased ' + fmtDate(r.lastDate) : ''));\r\n\r\n    const dTd = document.createElement('td'); dTd.className = 'num-cell'; dTd.innerHTML = deltaCell(r); tr.appendChild(dTd);\r\n\r\n    tr.appendChild(numTd(r.count ? String(r.count) : '—', r.count ? '' : 'muted'));\r\n    tr.appendChild(numTd(r.qty ? fmtQty(r.qty) : '—', r.qty ? '' : 'muted'));\r\n    tr.appendChild(numTd(r.min != null ? (fmtMoney(r.min) + ' – ' + fmtMoney(r.max)) : '—', r.min == null ? 'muted' : ''));\r\n\r\n    // update button\r\n    const uTd = document.createElement('td'); uTd.className = 'ctr';\r\n    const btn = document.createElement('button'); btn.className = 'upd-btn'; btn.textContent = 'Update';\r\n    btn.disabled = !canUpdate;\r\n    btn.title = canUpdate ? ('Set Standard Cost to ' + fmtMoney(r.last)) : 'No purchase in window';\r\n    btn.addEventListener('click', function () { updateOne(r, btn); });\r\n    uTd.appendChild(btn); tr.appendChild(uTd);\r\n\r\n    frag.appendChild(tr);\r\n  });\r\n  tbody.appendChild(frag);\r\n  syncSelAll();\r\n  updateSelCount();\r\n}\r\nfunction td(text, cls, title) { const el = document.createElement('td'); el.textContent = text == null ? '' : text; if (cls) el.className = cls; if (title) el.title = title; return el; }\r\nfunction numTd(text, cls, title) { const el = document.createElement('td'); el.className = 'num-cell' + (cls ? ' ' + cls : ''); el.textContent = text == null ? '' : text; if (title) el.title = title; return el; }\r\n\r\n/* ── SELECTION ── */\r\nfunction toggleRow(id, on) {\r\n  if (on) _selected.add(id); else _selected.delete(id);\r\n  // Re-sync the highlight class on each rendered row to its selection state.\r\n  document.querySelectorAll('#costBody tr').forEach(function (row, i) {\r\n    const r = _shown[i]; if (!r) return; row.classList.toggle('sel', _selected.has(r.id));\r\n  });\r\n  syncSelAll(); updateSelCount();\r\n}\r\nfunction toggleSelectAll(master) {\r\n  _shown.forEach(function (r) { if (r.last != null) { if (master.checked) _selected.add(r.id); else _selected.delete(r.id); } });\r\n  render();\r\n}\r\nfunction syncSelAll() {\r\n  const master = document.getElementById('selAll');\r\n  const eligible = _shown.filter(function (r) { return r.last != null; });\r\n  const selCount = eligible.filter(function (r) { return _selected.has(r.id); }).length;\r\n  master.checked = eligible.length > 0 && selCount === eligible.length;\r\n  master.indeterminate = selCount > 0 && selCount < eligible.length;\r\n}\r\nfunction updateSelCount() {\r\n  const n = _selected.size;\r\n  document.getElementById('selCount').textContent = n + ' selected';\r\n  document.getElementById('updateSelectedBtn').disabled = n === 0;\r\n  const shownUpd = _shown.filter(function (r) { return r.last != null; }).length;\r\n  const allBtn = document.getElementById('updateAllBtn');\r\n  allBtn.disabled = shownUpd === 0;\r\n  allBtn.title = shownUpd + ' shown row(s) have a last purchase price';\r\n}\r\n\r\n/* ── COST UPDATE via Import API (ImportPartProductAndVendorPricing) ── */\r\nfunction _normHdr(s) { return String(s == null ? '' : s).toLowerCase().replace(/[^a-z0-9]/g, ''); }\r\n\r\n// Split one quoted CSV line into field names (handles \"\" escapes).\r\nfunction _parseCsvLine(line) {\r\n  const out = []; let cur = '', inq = false;\r\n  for (let i = 0; i < line.length; i++) {\r\n    const ch = line[i];\r\n    if (inq) { if (ch === '\"') { if (line[i + 1] === '\"') { cur += '\"'; i++; } else inq = false; } else cur += ch; }\r\n    else { if (ch === '\"') inq = true; else if (ch === ',') { out.push(cur); cur = ''; } else cur += ch; }\r\n  }\r\n  out.push(cur);\r\n  return out.map(function (s) { return s.trim(); });\r\n}\r\n\r\n// ImportHeaderRs.Header arrives as {Row: \"<quoted csv line>\"} (sometimes an array\r\n// or bare string). Normalise all shapes to an array of column names.\r\nfunction _extractHeader(r) {\r\n  let h = r && r.ImportHeaderRs && r.ImportHeaderRs.Header;\r\n  if (h == null) return null;\r\n  if (h && typeof h === 'object' && !Array.isArray(h)) h = h.Row;\r\n  if (typeof h === 'string') return _parseCsvLine(h);\r\n  if (Array.isArray(h)) {\r\n    if (h.length === 1 && typeof h[0] === 'string' && h[0].indexOf(',') >= 0) return _parseCsvLine(h[0]);\r\n    return h.map(function (x) { return String(x).replace(/^\"|\"$/g, '').trim(); });\r\n  }\r\n  return null;\r\n}\r\n\r\n// Fetch + cache the canonical import header, and locate the columns we need.\r\nfunction ensureImportHeader() {\r\n  if (_imp) return _imp;\r\n  if (typeof runApiRequest !== 'function') throw new Error('Import API (runApiRequest) is not available in this environment.');\r\n  const type = FBLib.Settings.resolve('importType') || 'ImportPartProductAndVendorPricing';\r\n  const resp = runApiRequest('ImportHeaderRq', JSON.stringify({ ImportHeaderRq: { Type: type } }));\r\n  const r = typeof resp === 'string' ? JSON.parse(resp) : resp;\r\n  const header = _extractHeader(r);\r\n  if (!Array.isArray(header) || !header.length) throw new Error('Could not parse import header for ' + type + ' — ' + JSON.stringify(r));\r\n  dbg('ImportHeader ' + type + ' (' + header.length + ' cols): ' + header.join(', '), 'query');\r\n\r\n  function find(reArr, override) {\r\n    if (override) { const oi = header.findIndex(function (h) { return _normHdr(h) === _normHdr(override); }); if (oi >= 0) return oi; }\r\n    for (let k = 0; k < reArr.length; k++) {\r\n      const i = header.findIndex(function (h) { return reArr[k].test(_normHdr(h)); });\r\n      if (i >= 0) return i;\r\n    }\r\n    return -1;\r\n  }\r\n  const partIdx = find([/^partnumber$/, /^partnum$/, /partnumber/], FBLib.Settings.resolve('partNumColumn'));\r\n  const costIdx = find([/^standardcost$/, /^stdcost$/, /standardcost/, /^cost$/], FBLib.Settings.resolve('costColumn'));\r\n  if (partIdx < 0) throw new Error('No Part Number column found in import header: ' + header.join(', '));\r\n  if (costIdx < 0) throw new Error('No Standard Cost column found in import header: ' + header.join(', ') + ' (set it in Settings)');\r\n  const idx = {\r\n    uom:  find([/^uom$/, /^partuom$/, /unitofmeasure/]),\r\n    type: find([/^parttypeid$/, /^parttype$/, /^type$/]),\r\n    desc: find([/^partdescription$/, /^description$/])\r\n  };\r\n  _imp = { type: type, header: header, partIdx: partIdx, costIdx: costIdx, idx: idx };\r\n  return _imp;\r\n}\r\n\r\n// One CSV data row: Part # + Standard Cost, plus matching UOM/Type/Description as\r\n// safe identity fields (no-ops for the existing part) to dodge required-column errors.\r\nfunction buildImportRow(imp, part) {\r\n  const vals = imp.header.map(function () { return ''; });\r\n  vals[imp.partIdx] = part.num;\r\n  vals[imp.costIdx] = Math.round(part.last * 100000) / 100000;\r\n  // Re-send the part's existing UOM / PartTypeID / Description (exact current\r\n  // values → no-ops) so the import has the columns it may require. Everything\r\n  // else — including custom-field (CF-*) columns — stays blank = no change.\r\n  if (imp.idx.uom  >= 0 && part.uom)            vals[imp.idx.uom]  = part.uom;\r\n  if (imp.idx.type >= 0 && part.typeid != null) vals[imp.idx.type] = part.typeid;\r\n  if (imp.idx.desc >= 0 && part.description)    vals[imp.idx.desc] = part.description;\r\n  return vals.map(function (v) { return '\"' + String(v).replace(/\"/g, '\"\"') + '\"'; }).join(',');\r\n}\r\n\r\n// Send one ImportRq batch (header row + N data rows). Returns {ok} or {ok:false, message}.\r\nfunction importBatch(imp, parts) {\r\n  const rows = [imp.header.map(function (h) { return '\"' + String(h).replace(/\"/g, '\"\"') + '\"'; }).join(',')];\r\n  parts.forEach(function (p) { rows.push(buildImportRow(imp, p)); });\r\n  const payload = { ImportRq: { Type: imp.type, Rows: { Row: rows } } };\r\n  const resp = runApiRequest('ImportRq', JSON.stringify(payload));\r\n  dbg('ImportRq ' + imp.type + ' (' + parts.length + ' row(s)) → ' + (typeof resp === 'string' ? resp : JSON.stringify(resp)), 'success');\r\n  const r = !resp ? null : (typeof resp === 'string' ? JSON.parse(resp) : resp);\r\n  const code = r && r.ImportRs ? r.ImportRs.statusCode : null;\r\n  if (code === 1000 || code === '1000') return { ok: true };\r\n  const msg = (r && r.ImportRs && r.ImportRs.statusMessage) || (r && r.ErrorRs && r.ErrorRs.statusMessage) || ('No/!1000 response: ' + JSON.stringify(r));\r\n  return { ok: false, message: msg };\r\n}\r\n\r\n// Apply cost updates to a set of rows, batched. Sync runApiRequest, yielding to\r\n// the UI between batches. Mutates row.current/delta on success.\r\nasync function applyCostUpdates(rows) {\r\n  let imp;\r\n  try { imp = ensureImportHeader(); }\r\n  catch (e) { dbgForce('Import header error: ' + (e && e.message ? e.message : e), 'error'); banner('Cannot update: ' + escHtml(e && e.message ? e.message : String(e)) + '. See debug console.', 'err'); return { ok: 0, failed: rows.length, msgs: [String(e && e.message ? e.message : e)] }; }\r\n  const BATCH = 200;\r\n  let ok = 0, failed = 0; const msgs = [];\r\n  for (let i = 0; i < rows.length; i += BATCH) {\r\n    const batch = rows.slice(i, i + BATCH);\r\n    setStatus('Updating ' + Math.min(i + batch.length, rows.length) + ' / ' + rows.length + '…');\r\n    await new Promise(function (res) { setTimeout(res, 0); });\r\n    let result;\r\n    try { result = importBatch(imp, batch); }\r\n    catch (e) { result = { ok: false, message: (e && e.message ? e.message : String(e)) }; }\r\n    if (result.ok) {\r\n      batch.forEach(function (p) { p.current = p.last; p.delta = 0; _selected.delete(p.id); });\r\n      ok += batch.length;\r\n    } else {\r\n      failed += batch.length;\r\n      msgs.push(result.message);\r\n      dbgForce('Batch failed (' + batch.length + ' row(s)): ' + result.message, 'error');\r\n    }\r\n  }\r\n  return { ok: ok, failed: failed, msgs: msgs };\r\n}\r\n\r\nasync function updateOne(row, btn) {\r\n  if (row.last == null) return;\r\n  if (!confirm('Set Standard Cost for ' + row.num + ' to ' + fmtMoney(row.last) + ' (current ' + fmtMoney(row.current) + ')?')) return;\r\n  if (btn) { btn.disabled = true; btn.textContent = '…'; }\r\n  const res = await applyCostUpdates([row]);\r\n  if (res.ok === 1) banner('Updated ' + escHtml(row.num) + ' → ' + fmtMoney(row.last) + '.', 'ok');\r\n  else { banner('Update failed for ' + escHtml(row.num) + (res.msgs[0] ? ': ' + escHtml(String(res.msgs[0])) : '') + '. See debug console.', 'err'); if (btn) { btn.disabled = false; btn.textContent = 'Update'; } }\r\n  applyFilters();\r\n  setStatus(_all.length + ' non-stock parts');\r\n}\r\n\r\nasync function runBulk(rows) {\r\n  if (!rows.length) return;\r\n  if (!confirm('Update Standard Cost to the last purchase price for ' + rows.length + ' part(s)?')) return;\r\n  document.getElementById('updateSelectedBtn').disabled = true;\r\n  document.getElementById('updateAllBtn').disabled = true;\r\n  const res = await applyCostUpdates(rows);\r\n  applyFilters();\r\n  if (res.failed) banner('Updated ' + res.ok + ' part(s); ' + res.failed + ' failed. See debug console.', res.ok ? 'info' : 'err');\r\n  else banner('Updated ' + res.ok + ' part(s) successfully.', 'ok');\r\n  setStatus(_all.length + ' non-stock parts');\r\n}\r\nfunction updateSelected() {\r\n  const rows = _shown.filter(function (r) { return _selected.has(r.id) && r.last != null; });\r\n  if (!rows.length) { banner('No selected rows have a last purchase price.', 'info'); return; }\r\n  runBulk(rows);\r\n}\r\nfunction updateAllShown() {\r\n  const rows = _shown.filter(function (r) { return r.last != null; });\r\n  if (!rows.length) { banner('No shown rows have a last purchase price.', 'info'); return; }\r\n  runBulk(rows);\r\n}\r\n\r\n/* ── CSV ── */\r\nfunction exportCSV() {\r\n  if (!_shown.length) { alert('Nothing to export.'); return; }\r\n  const q = function (v) { return '\"' + String(v == null ? '' : v).replace(/\"/g, '\"\"') + '\"'; };\r\n  const lines = ['Part #,Description,Type,Current Cost,Last Purchase,Last Date,Delta %,Recent POs,Qty Purchased,Min Price,Max Price'];\r\n  _shown.forEach(function (r) {\r\n    lines.push([r.num, r.description, r.typename, r.current, r.last == null ? '' : r.last,\r\n      r.lastDate ? fmtDate(r.lastDate) : '', r.delta == null ? '' : (r.delta === Infinity ? 'new' : r.delta.toFixed(2)),\r\n      r.count, r.qty, r.min == null ? '' : r.min, r.max == null ? '' : r.max].map(q).join(','));\r\n  });\r\n  const blob = new Blob(['﻿' + lines.join('\\r\\n')], { type: 'text/csv;charset=utf-8;' });\r\n  const url = URL.createObjectURL(blob);\r\n  const a = document.createElement('a');\r\n  a.href = url; a.download = 'PartCostVsPurchase_' + new Date().toISOString().split('T')[0] + '.csv';\r\n  a.click(); URL.revokeObjectURL(url);\r\n}\r\n\r\n/* ── SETTINGS PERSISTENCE ── */\r\nfunction persistControls() {\r\n  try {\r\n    FBLib.Settings.setUserKey('lookbackDays', parseInt(document.getElementById('lookbackDays').value, 10) || 365);\r\n    FBLib.Settings.setUserKey('minDeltaPct', parseFloat(document.getElementById('minDelta').value) || 0);\r\n    FBLib.Settings.setUserKey('hideNoPrice', document.getElementById('hideNoPrice').checked);\r\n    FBLib.Settings.saveUser();\r\n  } catch (_) {}\r\n}\r\n\r\n/* ── SETTINGS PANEL CONTROLLER ── */\r\nwindow.PageSettings = (function () {\r\n  'use strict';\r\n  function init() {\r\n    const admin = document.getElementById('dsAdminSection');\r\n    if (admin) admin.style.display = FBLib.Settings.isAdmin() ? 'block' : 'none';\r\n    refreshLockUI();\r\n  }\r\n  function refreshLockUI() {\r\n    const allowed = FBLib.Settings.userEditingAllowed();\r\n    const badge = document.getElementById('dsLockBadge');\r\n    if (badge) badge.style.display = (!allowed && !FBLib.Settings.isAdmin()) ? 'block' : 'none';\r\n    const lockBtn = document.getElementById('dsLockBtn');\r\n    if (lockBtn) lockBtn.textContent = allowed ? 'Lock user editing' : 'Unlock user editing';\r\n  }\r\n  function openPanel() {\r\n    const eff = FBLib.Settings.effective();\r\n    document.getElementById('dsLookback').value = eff.lookbackDays || 365;\r\n    document.getElementById('dsMinDelta').value = eff.minDeltaPct || 0;\r\n    document.getElementById('dsDebug').checked = !!eff.debug;\r\n    refreshLockUI();\r\n    document.getElementById('setOverlay').style.display = 'flex';\r\n  }\r\n  function closePanel() { document.getElementById('setOverlay').style.display = 'none'; }\r\n  function closeIfOverlay(e) { if (e && e.target && e.target.id === 'setOverlay') closePanel(); }\r\n  function readPanel() {\r\n    return {\r\n      lookbackDays: parseInt(document.getElementById('dsLookback').value, 10) || 365,\r\n      minDeltaPct: parseFloat(document.getElementById('dsMinDelta').value) || 0,\r\n      debug: document.getElementById('dsDebug').checked\r\n    };\r\n  }\r\n  function applyAndClose() {\r\n    closePanel();\r\n    _imp = null;   // re-fetch the import header next write (import type / columns may have changed)\r\n    document.getElementById('lookbackDays').value = FBLib.Settings.resolve('lookbackDays') || 365;\r\n    document.getElementById('minDelta').value = FBLib.Settings.resolve('minDeltaPct') || 0;\r\n    document.getElementById('debugConsole').style.display = FBLib.Common.DEBUG_MODE ? 'block' : 'none';\r\n    loadData();\r\n  }\r\n  function saveUser() {\r\n    const p = readPanel();\r\n    Object.keys(p).forEach(function (k) { FBLib.Settings.setUserKey(k, p[k]); });\r\n    if (!FBLib.Settings.saveUser()) { alert('User editing is locked by admin.'); return; }\r\n    applyAndClose();\r\n  }\r\n  function resetToDefaults() { if (!confirm('Reset your personal settings to defaults?')) return; FBLib.Settings.clearUser(); applyAndClose(); }\r\n  function publishMaster() {\r\n    if (!FBLib.Settings.isAdmin()) return;\r\n    if (!confirm('Publish current panel values as the default for all users?')) return;\r\n    FBLib.Settings.publishMaster(readPanel()); alert('Published.'); applyAndClose();\r\n  }\r\n  function toggleLock() {\r\n    if (!FBLib.Settings.isAdmin()) return;\r\n    const nowLocked = FBLib.Settings.userEditingAllowed();\r\n    FBLib.Settings.setLock(nowLocked); refreshLockUI();\r\n    alert('User editing: ' + (nowLocked ? 'LOCKED' : 'UNLOCKED'));\r\n  }\r\n  return { init: init, openPanel: openPanel, closePanel: closePanel, closeIfOverlay: closeIfOverlay,\r\n    saveUser: saveUser, resetToDefaults: resetToDefaults, publishMaster: publishMaster, toggleLock: toggleLock };\r\n})();\r\n\r\n/* ── INIT ── */\r\nwindow.onload = function () {\r\n  document.getElementById('lookbackDays').value = FBLib.Settings.resolve('lookbackDays') || 365;\r\n  document.getElementById('minDelta').value = FBLib.Settings.resolve('minDeltaPct') || 0;\r\n  document.getElementById('hideNoPrice').checked = FBLib.Settings.resolve('hideNoPrice') !== false;\r\n  if (FBLib.Common.DEBUG_MODE) document.getElementById('debugConsole').style.display = 'block';\r\n  PageSettings.init();\r\n  loadData();\r\n};\r\n</script>\r\n</body>\r\n</html>\r\n",
