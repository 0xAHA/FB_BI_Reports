[ {
  "name" : "Bulk Scrap — Non-Available Inventory",
  "description" : "Bulk Scrap — Non-Available Inventory",
  "data" : "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n  <title>Bulk Scrap — Non-Available Inventory - Fishbowl BI</title>\r\n\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\" />\r\n\r\n  <!-- Shared Fishbowl BI lib (Settings layer + Common formatting/debug helpers).\r\n       Inlined by Fishbowl from the saved script named \"fb-lib\". Source of truth\r\n       lives at scripts/fb-lib.js. Uses FBLib.Common + FBLib.Settings only. -->\r\n  <script>\r\n    {% Script fb-lib %}\r\n  </script>\r\n\r\n  <style>\r\n    * { box-sizing: border-box; }\r\n    html, body { margin: 0; padding: 0; }\r\n    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 13px; color: #1e293b; background: #f8fafc; }\r\n\r\n    /* ── HEADER BAR ── */\r\n    header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04); display: flex; align-items: center; justify-content: space-between; padding: 0 20px; height: 56px; }\r\n    header h1 { font-size: 16px; font-weight: 700; color: #0f172a; margin: 0; line-height: 1.15; }\r\n    #statusLine { font-size: 12px; color: #94a3b8; line-height: 1.15; margin: 0; }\r\n    .hdr-actions { display: flex; align-items: center; gap: 8px; }\r\n    .hdr-btn { display: flex; align-items: center; gap: 5px; padding: 6px 10px; border-radius: 8px; font-size: 12px; font-weight: 500; border: 1px solid #e2e8f0; background: #fff; color: #475569; cursor: pointer; transition: all 0.15s; white-space: nowrap; font-family: inherit; }\r\n    .hdr-btn:hover { background: #f8fafc; border-color: #cbd5e1; }\r\n    .hdr-btn:disabled { opacity: 0.5; cursor: not-allowed; }\r\n    .hdr-btn svg { width: 14px; height: 14px; flex-shrink: 0; }\r\n    .hdr-btn-icon { padding: 7px; border-radius: 8px; }\r\n    .hdr-sep { width: 1px; height: 24px; background: #e2e8f0; margin: 0 2px; }\r\n\r\n    /* ── PAGE ── */\r\n    .wrap { max-width: 100%; margin: 0; padding: 16px 20px 60px; }\r\n    .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); margin-bottom: 16px; }\r\n\r\n    /* ── CONTROLS STRIP ── */\r\n    .controls { display: flex; flex-wrap: wrap; gap: 14px 20px; padding: 14px 16px; align-items: flex-end; }\r\n    .field { display: flex; flex-direction: column; gap: 4px; }\r\n    .field label { font-size: 10px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; }\r\n    .field select, .field input { padding: 7px 9px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; color: #1e293b; background: #fff; font-family: inherit; }\r\n    .field input[type=text] { min-width: 200px; }\r\n    .field input[type=date] { min-width: 150px; }\r\n    .field.note input { min-width: 280px; }\r\n    .field select:focus, .field input:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }\r\n    .field .chk { display: flex; align-items: center; gap: 7px; text-transform: none; font-size: 12px; font-weight: 500; color: #475569; cursor: pointer; padding-bottom: 7px; }\r\n    .field .chk input { width: auto; padding: 0; margin: 0; border: 0; box-shadow: none; }\r\n    .spacer { flex: 1; }\r\n\r\n    /* ── BULK ACTIONS ── */\r\n    .bulk-actions { display: flex; align-items: center; gap: 10px; padding-bottom: 1px; }\r\n    .sel-count { font-size: 12px; color: #475569; font-weight: 600; white-space: nowrap; }\r\n    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 7px; font-size: 12px; font-weight: 600; border: 1px solid #cbd5e1; background: #fff; color: #334155; cursor: pointer; font-family: inherit; }\r\n    .btn:hover { background: #f1f5f9; }\r\n    .btn:disabled { opacity: 0.5; cursor: not-allowed; }\r\n    .btn-danger { background: #dc2626; border-color: #dc2626; color: #fff; }\r\n    .btn-danger:hover { background: #b91c1c; border-color: #b91c1c; }\r\n\r\n    /* ── TABLE ── */\r\n    .data-table { width: 100%; border-collapse: collapse; font-size: 12.5px; }\r\n    .data-table th { background: #1e3a5f; color: #fff; font-weight: 500; font-size: 11px; text-align: left; padding: 8px 10px; white-space: nowrap; position: sticky; top: 56px; z-index: 5; text-transform: uppercase; letter-spacing: 0.03em; }\r\n    .data-table th.nr { text-align: right; }\r\n    .data-table th.ctr, .data-table td.ctr { text-align: center; }\r\n    .data-table td { padding: 6px 10px; border-bottom: 1px solid #eef2f7; white-space: nowrap; vertical-align: middle; }\r\n    .data-table tbody tr.item:hover td { background: #fff7f5; }\r\n    .data-table tbody tr.sel td { background: #fef2f2; }\r\n    .group-row td { background: #eef2f7; font-weight: 600; color: #0f172a; padding: 7px 10px; border-bottom: 1px solid #e2e8f0; position: sticky; top: 88px; z-index: 4; }\r\n    .group-row .loc-name { color: #1e3a5f; }\r\n    .group-row .group-sub { color: #64748b; font-weight: 500; font-size: 11px; margin-left: 8px; }\r\n    .num-cell { text-align: right; font-variant-numeric: tabular-nums; }\r\n    .muted { color: #94a3b8; }\r\n    .desc { max-width: 280px; overflow: hidden; text-overflow: ellipsis; }\r\n    .row-link { color: #2563eb; cursor: pointer; text-decoration: none; font-weight: 600; }\r\n    .row-link:hover { text-decoration: underline; }\r\n    .scrap-qty { width: 90px; padding: 5px 7px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12.5px; text-align: right; font-family: inherit; }\r\n    .scrap-qty:focus { outline: none; border-color: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,0.12); }\r\n    .scrap-qty.over { border-color: #dc2626; background: #fef2f2; }\r\n    .row-note { width: 170px; padding: 5px 7px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12.5px; font-family: inherit; }\r\n    .row-note:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }\r\n    .scrap-btn { padding: 4px 10px; font-size: 11px; border-radius: 6px; border: 1px solid #fecaca; background: #fef2f2; color: #b91c1c; cursor: pointer; font-weight: 600; font-family: inherit; }\r\n    .scrap-btn:hover { background: #fee2e2; }\r\n    .scrap-btn:disabled { opacity: 0.4; cursor: not-allowed; }\r\n    .empty { padding: 36px; text-align: center; color: #94a3b8; font-style: italic; }\r\n\r\n    /* ── SPINNER ── */\r\n    #spinner { display: none; padding: 40px; text-align: center; color: #64748b; }\r\n    @keyframes spin { to { transform: rotate(360deg); } }\r\n    .spin { animation: spin 0.8s linear infinite; }\r\n\r\n    /* ── DEBUG ── */\r\n    #debugConsole { display: none; }\r\n    #debugConsole .dc-head { display: flex; justify-content: space-between; align-items: center; background: #0f172a; padding: 10px 14px; border-radius: 10px 10px 0 0; }\r\n    #debugConsole .dc-head h3 { margin: 0; font-size: 12px; color: #e2e8f0; }\r\n    #debugLog { background: #0f172a; border-radius: 0 0 10px 10px; padding: 12px; max-height: 260px; overflow-y: auto; font-family: ui-monospace, monospace; font-size: 11px; color: #e2e8f0; white-space: pre-wrap; }\r\n    .mini-btn { padding: 4px 9px; font-size: 11px; border-radius: 6px; border: 1px solid #334155; background: #1e293b; color: #cbd5e1; cursor: pointer; font-family: inherit; }\r\n\r\n    /* ── BANNER ── */\r\n    #statusBanner { display: none; margin-bottom: 16px; }\r\n    #statusBanner .msg { padding: 12px 16px; border-radius: 8px; font-weight: 600; font-size: 13px; }\r\n    .msg-ok { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }\r\n    .msg-err { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }\r\n    .msg-info { background: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; }\r\n\r\n    /* ── SETTINGS PANEL ── */\r\n    #setOverlay { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1001; display: none; justify-content: flex-end; }\r\n    #setPanel { background: #f8fafc; width: 380px; max-width: 95vw; height: 100%; overflow-y: auto; box-shadow: -2px 0 12px rgba(0,0,0,0.25); display: flex; flex-direction: column; }\r\n    #setPanel .ds-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; border-bottom: 1px solid #e2e8f0; background: #fff; }\r\n    #setPanel .ds-header h2 { margin: 0; font-size: 15px; }\r\n    #setPanel .ds-close { background: transparent; border: none; font-size: 24px; cursor: pointer; color: #64748b; line-height: 1; }\r\n    #setPanel .ds-body { padding: 16px 18px; flex: 1; }\r\n    #setPanel .ds-section { margin-bottom: 20px; }\r\n    #setPanel .ds-label { display: block; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: #475569; margin-bottom: 8px; }\r\n    #setPanel .ds-checks label { display: block; padding: 5px 0; font-size: 13px; cursor: pointer; }\r\n    #setPanel .ds-checks input { margin-right: 7px; }\r\n    #setPanel .ds-footer { padding: 12px 18px; border-top: 1px solid #e2e8f0; background: #fff; display: flex; gap: 8px; justify-content: flex-end; }\r\n    #setPanel .ds-btn { padding: 7px 14px; font-size: 13px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; cursor: pointer; font-family: inherit; }\r\n    #setPanel .ds-btn-primary { background: #2563eb; color: #fff; border-color: #2563eb; }\r\n    #setPanel .ds-admin { border-top: 1px dashed #cbd5e1; padding-top: 16px; }\r\n    #setPanel .ds-btn-admin { display: block; width: 100%; margin-bottom: 6px; background: #fef3c7; border-color: #f59e0b; color: #7c2d12; }\r\n    #setPanel .ds-lock-badge { background: #fef3c7; color: #92400e; border: 1px solid #f59e0b; padding: 6px 10px; border-radius: 6px; font-size: 12px; margin-bottom: 14px; }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n  <header>\r\n    <div>\r\n      <h1>Bulk Scrap — Non-Available Inventory</h1>\r\n      <p id=\"statusLine\">Initialising…</p>\r\n    </div>\r\n    <div class=\"hdr-actions\">\r\n      <button class=\"hdr-btn\" onclick=\"loadData()\" title=\"Reload\"><svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"/></svg>Refresh</button>\r\n      <button class=\"hdr-btn\" onclick=\"exportCSV()\" title=\"Export CSV\"><svg fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"/></svg>CSV</button>\r\n      <button class=\"hdr-btn hdr-btn-icon\" onclick=\"PageSettings.openPanel()\" title=\"Settings\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M19.14 12.94c.04-.31.06-.62.06-.94 0-.32-.02-.63-.06-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96a7.03 7.03 0 00-1.62-.94l-.36-2.54a.484.484 0 00-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94 0 .32.02.63.06.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 018.4 12 3.6 3.6 0 0112 8.4a3.6 3.6 0 013.6 3.6 3.6 3.6 0 01-3.6 3.6z\"/></svg></button>\r\n    </div>\r\n  </header>\r\n\r\n  <div class=\"wrap\">\r\n\r\n    <div id=\"statusBanner\"><div class=\"msg\" id=\"statusBannerMsg\"></div></div>\r\n\r\n    <!-- CONTROLS -->\r\n    <div class=\"card\">\r\n      <div class=\"controls\">\r\n        <div class=\"field\">\r\n          <label>Search part / description</label>\r\n          <input type=\"text\" id=\"search\" placeholder=\"contains…\" oninput=\"applyFiltersDebounced()\" />\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Location Group</label>\r\n          <select id=\"lgFilter\" onchange=\"applyFilters()\"><option value=\"\">All location groups</option></select>\r\n        </div>\r\n        <div class=\"field note\">\r\n          <label>Shared note (used if a row's note is blank)</label>\r\n          <input type=\"text\" id=\"note\" placeholder=\"reason for scrap…\" />\r\n        </div>\r\n        <div class=\"field\">\r\n          <label>Date</label>\r\n          <input type=\"date\" id=\"scrapDate\" />\r\n        </div>\r\n        <div class=\"spacer\"></div>\r\n        <div class=\"bulk-actions\">\r\n          <span class=\"sel-count\" id=\"selCount\">0 selected</span>\r\n          <button class=\"btn btn-danger\" id=\"scrapSelectedBtn\" onclick=\"scrapSelected()\" disabled>\r\n            <svg width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path d=\"M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6\"/></svg>\r\n            Scrap Selected\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- TABLE -->\r\n    <div class=\"card\">\r\n      <div id=\"spinner\"><svg class=\"spin\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"#e2e8f0\" stroke-width=\"3\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke=\"#2563eb\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg><div style=\"margin-top:8px;\">Loading non-available inventory…</div></div>\r\n      <table class=\"data-table\" id=\"scrapTable\">\r\n        <thead>\r\n          <tr>\r\n            <th class=\"ctr\"><input type=\"checkbox\" id=\"selAll\" onchange=\"toggleSelectAll(this)\" /></th>\r\n            <th>Part #</th>\r\n            <th>Description</th>\r\n            <th>UOM</th>\r\n            <th class=\"nr\">On Hand</th>\r\n            <th class=\"nr\">Avg Cost</th>\r\n            <th class=\"nr\">Ext Value</th>\r\n            <th class=\"nr\">Qty to Scrap</th>\r\n            <th>Note</th>\r\n            <th class=\"ctr\">Scrap</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody id=\"scrapBody\">\r\n          <tr><td class=\"empty\" colspan=\"10\">Loading…</td></tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <!-- DEBUG -->\r\n    <div class=\"card\" id=\"debugConsole\">\r\n      <div class=\"dc-head\"><h3>Debug Console (raw import responses appear here)</h3><button class=\"mini-btn\" onclick=\"clearDebug()\">Clear</button></div>\r\n      <div id=\"debugLog\"></div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <!-- SETTINGS PANEL -->\r\n  <div id=\"setOverlay\" onclick=\"PageSettings.closeIfOverlay(event)\">\r\n    <div id=\"setPanel\" onclick=\"event.stopPropagation()\">\r\n      <div class=\"ds-header\">\r\n        <h2>Settings — Bulk Scrap</h2>\r\n        <button type=\"button\" class=\"ds-close\" onclick=\"PageSettings.closePanel()\">&times;</button>\r\n      </div>\r\n      <div class=\"ds-body\">\r\n        <div id=\"dsLockBadge\" class=\"ds-lock-badge\" style=\"display:none;\">Locked by admin — your changes won't be saved.</div>\r\n        <div class=\"ds-section ds-checks\">\r\n          <label class=\"ds-label\">Options</label>\r\n          <label><input type=\"checkbox\" id=\"dsDebug\" /> Show debug console</label>\r\n        </div>\r\n        <div id=\"dsAdminSection\" class=\"ds-section ds-admin\" style=\"display:none;\">\r\n          <label class=\"ds-label\">Admin</label>\r\n          <button type=\"button\" class=\"ds-btn ds-btn-admin\" onclick=\"PageSettings.publishMaster()\">Publish as default for everyone</button>\r\n          <button type=\"button\" class=\"ds-btn ds-btn-admin\" id=\"dsLockBtn\" onclick=\"PageSettings.toggleLock()\">Lock user editing</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"ds-footer\">\r\n        <button type=\"button\" class=\"ds-btn\" onclick=\"PageSettings.resetToDefaults()\">Reset to defaults</button>\r\n        <button type=\"button\" class=\"ds-btn ds-btn-primary\" onclick=\"PageSettings.saveUser()\">Save (just me)</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n<script>\r\n/* ── RUNTIME GUARD ── */\r\nif (typeof runQuery !== 'function' && typeof runQueryAsync !== 'function') {\r\n  document.body.innerHTML = '<div style=\"padding:40px;font-family:sans-serif;color:#475569;\"><h2>Not running inside Fishbowl</h2><p>This report requires the Fishbowl BI environment (reads inventory via runQuery, scraps via the Import API).</p></div>';\r\n  throw new Error('Fishbowl API not available');\r\n}\r\n\r\n/* ── FB-LIB SETTINGS ── */\r\nFBLib.Settings.init({\r\n  userKey:   'cdx.bi.bulkScrap.user.v1',\r\n  masterKey: 'cdx.bi.bulkScrap.master.v1',\r\n  defaults: {\r\n    v: 1,\r\n    importType: 'ImportScrapData',\r\n    debug: false\r\n  },\r\n  propFallback: { debug: { name: 'BI_SHOW_DEBUG', dflt: 'false', parse: v => (v === 'true' || v === true) } }\r\n});\r\n\r\n/* ── THIN HELPERS (prefer FBLib.Common; local fallback if saved fb-lib is behind) ── */\r\nconst _C = (window.FBLib && FBLib.Common) ? FBLib.Common : null;\r\nfunction fmtMoney(v) {\r\n  if (_C && _C.formatMoney) return _C.formatMoney(v);\r\n  const n = parseFloat(v || 0); if (isNaN(n)) return '';\r\n  return (n < 0 ? '-$' : '$') + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\r\n}\r\nfunction fmtQty(v) {\r\n  if (_C && _C.formatQty) return _C.formatQty(v);\r\n  const n = parseFloat(v); if (isNaN(n)) return '';\r\n  return n % 1 === 0 ? String(Math.round(n)) : n.toFixed(4).replace(/\\.?0+$/, '');\r\n}\r\nfunction esc(s) {\r\n  if (_C && _C.escSQL) return _C.escSQL(s);\r\n  return String(s == null ? '' : s).replace(/'/g, \"''\");\r\n}\r\nfunction escHtml(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }\r\nfunction setStatus(m) { document.getElementById('statusLine').textContent = m; }\r\n\r\n/* ── QUERY HELPERS ── */\r\nfunction norm(r) {\r\n  if (r == null) return [];\r\n  if (typeof r === 'string') { try { const p = JSON.parse(r); return Array.isArray(p) ? p : []; } catch (_) { return []; } }\r\n  return Array.isArray(r) ? r : [];\r\n}\r\nasync function qp(sql) {\r\n  try { return norm(await runQueryAsync(sql)); }\r\n  catch (e) { try { return norm(runQuery(sql)); } catch (e2) { throw e2; } }\r\n}\r\n\r\n/* ── STATE ── */\r\nlet _all = [];        // all rows {key, partid, partnum, partdesc, uom, locid, locname, lgid, lgname, avgcost, qty, value, scrapQty}\r\nlet _shown = [];      // filtered rows\r\nconst _selected = new Set();   // selected row keys\r\nlet _filterTimer = null;\r\n\r\n// Scrap is written via the Import API (ImportScrapData). The canonical CSV header\r\n// is fetched once via ImportHeaderRq and cached here.\r\nlet _imp = null;   // { type, header:[], partIdx, locIdx, qtyIdx, idx:{date,note,class,customer} }\r\n\r\n/* ── DEBUG / BANNER ── */\r\nfunction dbg(msg, type) { try { if (FBLib.Common.DEBUG_MODE) FBLib.Common.debugLog(msg, type || 'info'); } catch (_) {} }\r\nfunction dbgForce(msg, type) {\r\n  document.getElementById('debugConsole').style.display = 'block';\r\n  try { FBLib.Common.debugLog(msg, type || 'info'); } catch (_) {\r\n    const box = document.getElementById('debugLog');\r\n    const d = document.createElement('div'); d.textContent = msg; box.appendChild(d); box.scrollTop = box.scrollHeight;\r\n  }\r\n}\r\nfunction clearDebug() { try { FBLib.Common.clearDebugLog(); } catch (_) {} if (!FBLib.Common.DEBUG_MODE) document.getElementById('debugConsole').style.display = 'none'; }\r\nfunction banner(msg, kind) {\r\n  const wrap = document.getElementById('statusBanner');\r\n  const el = document.getElementById('statusBannerMsg');\r\n  el.innerHTML = msg; el.className = 'msg ' + (kind === 'ok' ? 'msg-ok' : kind === 'err' ? 'msg-err' : 'msg-info');\r\n  wrap.style.display = 'block';\r\n  if (kind === 'ok') setTimeout(function () { wrap.style.display = 'none'; }, 9000);\r\n}\r\n\r\n/* ── LOAD DATA ── */\r\nasync function loadData() {\r\n  document.getElementById('spinner').style.display = 'block';\r\n  document.getElementById('scrapTable').style.display = 'none';\r\n  setStatus('Loading…');\r\n  _selected.clear();\r\n\r\n  try {\r\n    // On-hand inventory (tag types 30/40) physically sitting in locations that\r\n    // are NOT counted as available (location.countedAsAvailable = 0), summed per\r\n    // part + location. Restricted to the user's accessible location groups.\r\n    let allowed = null;\r\n    try { if (typeof getLocationGroupList === 'function') allowed = getLocationGroupList(); } catch (_) {}\r\n    const lgFilter = (Array.isArray(allowed) && allowed.length) ? (' AND lg.id IN (' + allowed.join(',') + ') ') : ' ';\r\n\r\n    const rows = await qp(\r\n      \"SELECT p.id AS partid, p.num AS partnum, p.description AS partdesc, u.code AS uom, \" +\r\n      \"l.id AS locid, l.name AS locname, lg.id AS lgid, lg.name AS lgname, \" +\r\n      \"COALESCE(pc.avgcost,0) AS avgcost, SUM(t.qty) AS qty \" +\r\n      \"FROM tag t \" +\r\n      \"JOIN location l ON l.id = t.locationid \" +\r\n      \"JOIN locationgroup lg ON lg.id = l.locationgroupid \" +\r\n      \"JOIN part p ON p.id = t.partid \" +\r\n      \"JOIN uom u ON u.id = p.uomid \" +\r\n      \"LEFT JOIN partcost pc ON pc.partid = p.id \" +\r\n      \"WHERE l.countedasavailable = 0 AND l.activeflag = 1 AND t.typeid IN (30,40) AND t.qty > 0\" + lgFilter +\r\n      \"GROUP BY p.id, p.num, p.description, u.code, l.id, l.name, lg.id, lg.name, pc.avgcost \" +\r\n      \"HAVING SUM(t.qty) > 0 \" +\r\n      \"ORDER BY lg.name, l.name, p.num\");\r\n\r\n    _all = rows.map(function (r) {\r\n      const qty = parseFloat(r.qty) || 0;\r\n      const avg = parseFloat(r.avgcost) || 0;\r\n      return {\r\n        key: r.partid + '_' + r.locid,\r\n        partid: r.partid, partnum: r.partnum, partdesc: r.partdesc || '', uom: r.uom || '',\r\n        locid: r.locid, locname: r.locname || '', lgid: r.lgid, lgname: r.lgname || '',\r\n        avgcost: avg, qty: qty, value: qty * avg, scrapQty: qty, note: ''\r\n      };\r\n    });\r\n\r\n    buildLgFilter();\r\n    applyFilters();\r\n    const locs = new Set(_all.map(function (r) { return r.locid; }));\r\n    const totalVal = _all.reduce(function (s, r) { return s + r.value; }, 0);\r\n    setStatus(_all.length + ' part/location line(s) across ' + locs.size + ' non-available location(s) · ' + fmtMoney(totalVal) + ' at risk');\r\n  } catch (e) {\r\n    console.error(e);\r\n    setStatus('Error: ' + (e.message || e));\r\n    document.getElementById('scrapBody').innerHTML = '<tr><td class=\"empty\" colspan=\"10\">Error: ' + escHtml(e.message || String(e)) + '</td></tr>';\r\n  } finally {\r\n    document.getElementById('spinner').style.display = 'none';\r\n    document.getElementById('scrapTable').style.display = '';\r\n  }\r\n}\r\n\r\nfunction buildLgFilter() {\r\n  const sel = document.getElementById('lgFilter');\r\n  const cur = sel.value;\r\n  const seen = {};\r\n  _all.forEach(function (r) { if (!seen[r.lgid]) seen[r.lgid] = r.lgname; });\r\n  sel.innerHTML = '<option value=\"\">All location groups</option>';\r\n  Object.keys(seen).sort(function (a, b) { return String(seen[a]).localeCompare(String(seen[b])); })\r\n    .forEach(function (id) {\r\n      const o = document.createElement('option');\r\n      o.value = id; o.textContent = seen[id];\r\n      if (id === cur) o.selected = true;\r\n      sel.appendChild(o);\r\n    });\r\n}\r\n\r\n/* ── FILTER + RENDER ── */\r\nfunction applyFiltersDebounced() { clearTimeout(_filterTimer); _filterTimer = setTimeout(applyFilters, 200); }\r\n\r\nfunction applyFilters() {\r\n  const q = (document.getElementById('search').value || '').trim().toLowerCase();\r\n  const lg = document.getElementById('lgFilter').value;\r\n  _shown = _all.filter(function (r) {\r\n    if (lg && String(r.lgid) !== String(lg)) return false;\r\n    if (q && (r.partnum + ' ' + r.partdesc).toLowerCase().indexOf(q) === -1) return false;\r\n    return true;\r\n  });\r\n  render();\r\n}\r\n\r\nfunction render() {\r\n  const tbody = document.getElementById('scrapBody');\r\n  tbody.innerHTML = '';\r\n  if (!_shown.length) {\r\n    tbody.innerHTML = '<tr><td class=\"empty\" colspan=\"10\">No non-available inventory matches the current filters.</td></tr>';\r\n    updateSelCount();\r\n    return;\r\n  }\r\n  const frag = document.createDocumentFragment();\r\n  let curLoc = null;\r\n  _shown.forEach(function (r) {\r\n    if (r.locid !== curLoc) {\r\n      curLoc = r.locid;\r\n      frag.appendChild(buildGroupHeader(r.locid));\r\n    }\r\n    frag.appendChild(buildItemRow(r));\r\n  });\r\n  tbody.appendChild(frag);\r\n  syncSelAll();\r\n  updateSelCount();\r\n}\r\n\r\nfunction buildGroupHeader(locid) {\r\n  const inGroup = _shown.filter(function (r) { return r.locid === locid; });\r\n  const first = inGroup[0];\r\n  const qty = inGroup.reduce(function (s, r) { return s + r.qty; }, 0);\r\n  const val = inGroup.reduce(function (s, r) { return s + r.value; }, 0);\r\n  const allSel = inGroup.every(function (r) { return _selected.has(r.key); });\r\n\r\n  const tr = document.createElement('tr'); tr.className = 'group-row';\r\n  const cbTd = document.createElement('td'); cbTd.className = 'ctr';\r\n  const cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = allSel;\r\n  cb.title = 'Select all in this location';\r\n  cb.addEventListener('change', function () { toggleGroup(locid, cb.checked); });\r\n  cbTd.appendChild(cb); tr.appendChild(cbTd);\r\n\r\n  const td = document.createElement('td'); td.colSpan = 9;\r\n  td.innerHTML = '<span class=\"loc-name\">\uD83D\uDCCD ' + escHtml(first.lgname + ' - ' + first.locname) + '</span>' +\r\n    '<span class=\"group-sub\">' + inGroup.length + ' part(s) · ' + fmtQty(qty) + ' on hand · ' + fmtMoney(val) + '</span>';\r\n  tr.appendChild(td);\r\n  return tr;\r\n}\r\n\r\nfunction buildItemRow(r) {\r\n  const tr = document.createElement('tr'); tr.className = 'item'; tr.dataset.key = r.key;\r\n  if (_selected.has(r.key)) tr.classList.add('sel');\r\n\r\n  const cbTd = document.createElement('td'); cbTd.className = 'ctr';\r\n  const cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = _selected.has(r.key);\r\n  cb.addEventListener('change', function () { toggleRow(r.key, cb.checked); });\r\n  cbTd.appendChild(cb); tr.appendChild(cbTd);\r\n\r\n  const pTd = document.createElement('td');\r\n  const a = document.createElement('a'); a.className = 'row-link'; a.href = '#'; a.textContent = r.partnum;\r\n  a.addEventListener('click', function (e) { e.preventDefault(); openModule('Part', r.partnum); });\r\n  pTd.appendChild(a); tr.appendChild(pTd);\r\n\r\n  tr.appendChild(cell(r.partdesc, 'desc muted', r.partdesc));\r\n  tr.appendChild(cell(r.uom, 'muted'));\r\n  tr.appendChild(numTd(fmtQty(r.qty)));\r\n  tr.appendChild(numTd(fmtMoney(r.avgcost), 'muted'));\r\n  tr.appendChild(numTd(fmtMoney(r.value)));\r\n\r\n  // Qty to scrap (editable, defaults to full on-hand)\r\n  const qTd = document.createElement('td'); qTd.className = 'nr';\r\n  const inp = document.createElement('input'); inp.type = 'number'; inp.className = 'scrap-qty';\r\n  inp.min = '0'; inp.step = 'any'; inp.value = fmtQty(r.scrapQty);\r\n  inp.addEventListener('input', function () {\r\n    r.scrapQty = parseFloat(inp.value) || 0;\r\n    inp.classList.toggle('over', r.scrapQty > r.qty + 1e-9);\r\n  });\r\n  qTd.appendChild(inp); tr.appendChild(qTd);\r\n\r\n  // Per-row note — falls back to the shared note above when left blank.\r\n  const nTd = document.createElement('td');\r\n  const nInp = document.createElement('input'); nInp.type = 'text'; nInp.className = 'row-note';\r\n  nInp.placeholder = 'uses shared note'; nInp.value = r.note || '';\r\n  nInp.addEventListener('input', function () { r.note = nInp.value; });\r\n  nTd.appendChild(nInp); tr.appendChild(nTd);\r\n\r\n  const sTd = document.createElement('td'); sTd.className = 'ctr';\r\n  const btn = document.createElement('button'); btn.className = 'scrap-btn'; btn.textContent = 'Scrap';\r\n  btn.title = 'Scrap this line';\r\n  btn.addEventListener('click', function () { scrapOne(r, btn); });\r\n  sTd.appendChild(btn); tr.appendChild(sTd);\r\n\r\n  return tr;\r\n}\r\nfunction cell(text, cls, title) { const el = document.createElement('td'); el.textContent = text == null ? '' : text; if (cls) el.className = cls; if (title) el.title = title; return el; }\r\nfunction numTd(text, cls) { const el = document.createElement('td'); el.className = 'num-cell' + (cls ? ' ' + cls : ''); el.textContent = text == null ? '' : text; return el; }\r\n\r\n/* ── SELECTION ── */\r\nfunction toggleRow(key, on) {\r\n  if (on) _selected.add(key); else _selected.delete(key);\r\n  const tr = document.querySelector('#scrapBody tr.item[data-key=\"' + cssEsc(key) + '\"]');\r\n  if (tr) tr.classList.toggle('sel', on);\r\n  syncSelAll(); updateSelCount();\r\n}\r\nfunction toggleGroup(locid, on) {\r\n  _shown.filter(function (r) { return r.locid === locid; })\r\n    .forEach(function (r) { if (on) _selected.add(r.key); else _selected.delete(r.key); });\r\n  render();\r\n}\r\nfunction toggleSelectAll(master) {\r\n  _shown.forEach(function (r) { if (master.checked) _selected.add(r.key); else _selected.delete(r.key); });\r\n  render();\r\n}\r\nfunction syncSelAll() {\r\n  const master = document.getElementById('selAll');\r\n  const n = _shown.filter(function (r) { return _selected.has(r.key); }).length;\r\n  master.checked = _shown.length > 0 && n === _shown.length;\r\n  master.indeterminate = n > 0 && n < _shown.length;\r\n}\r\nfunction updateSelCount() {\r\n  const sel = _shown.filter(function (r) { return _selected.has(r.key); });\r\n  const qty = sel.reduce(function (s, r) { return s + (r.scrapQty || 0); }, 0);\r\n  document.getElementById('selCount').textContent = sel.length + ' selected' + (sel.length ? ' · ' + fmtQty(qty) + ' qty' : '');\r\n  document.getElementById('scrapSelectedBtn').disabled = sel.length === 0;\r\n}\r\nfunction cssEsc(s) { return String(s).replace(/\"/g, '\\\\\"'); }\r\n\r\n/* ── SCRAP via Import API (ImportScrapData) ── */\r\nfunction _normHdr(s) { return String(s == null ? '' : s).toLowerCase().replace(/[^a-z0-9]/g, ''); }\r\nfunction _parseCsvLine(line) {\r\n  const out = []; let cur = '', inq = false;\r\n  for (let i = 0; i < line.length; i++) {\r\n    const ch = line[i];\r\n    if (inq) { if (ch === '\"') { if (line[i + 1] === '\"') { cur += '\"'; i++; } else inq = false; } else cur += ch; }\r\n    else { if (ch === '\"') inq = true; else if (ch === ',') { out.push(cur); cur = ''; } else cur += ch; }\r\n  }\r\n  out.push(cur);\r\n  return out.map(function (s) { return s.trim(); });\r\n}\r\nfunction _extractHeader(r) {\r\n  let h = r && r.ImportHeaderRs && r.ImportHeaderRs.Header;\r\n  if (h == null) return null;\r\n  if (h && typeof h === 'object' && !Array.isArray(h)) h = h.Row;\r\n  if (typeof h === 'string') return _parseCsvLine(h);\r\n  if (Array.isArray(h)) {\r\n    if (h.length === 1 && typeof h[0] === 'string' && h[0].indexOf(',') >= 0) return _parseCsvLine(h[0]);\r\n    return h.map(function (x) { return String(x).replace(/^\"|\"$/g, '').trim(); });\r\n  }\r\n  return null;\r\n}\r\n\r\n// Fetch + cache the canonical scrap-import header and locate the columns we need.\r\nfunction ensureImportHeader() {\r\n  if (_imp) return _imp;\r\n  if (typeof runApiRequest !== 'function') throw new Error('Import API (runApiRequest) is not available in this environment.');\r\n  const type = FBLib.Settings.resolve('importType') || 'ImportScrapData';\r\n  const resp = runApiRequest('ImportHeaderRq', JSON.stringify({ ImportHeaderRq: { Type: type } }));\r\n  const r = typeof resp === 'string' ? JSON.parse(resp) : resp;\r\n  const header = _extractHeader(r);\r\n  if (!Array.isArray(header) || !header.length) throw new Error('Could not parse scrap import header for ' + type + ' — ' + JSON.stringify(r));\r\n  dbg('ImportHeader ' + type + ' (' + header.length + ' cols): ' + header.join(', '), 'query');\r\n\r\n  function find(reArr) {\r\n    for (let k = 0; k < reArr.length; k++) {\r\n      const i = header.findIndex(function (h) { return reArr[k].test(_normHdr(h)); });\r\n      if (i >= 0) return i;\r\n    }\r\n    return -1;\r\n  }\r\n  const partIdx = find([/^partnumber$/, /^partnum$/, /partnumber/]);\r\n  const locIdx  = find([/^location$/, /^locationname$/, /^location$/]);\r\n  const qtyIdx  = find([/^qty$/, /^quantity$/]);\r\n  if (partIdx < 0) throw new Error('No PartNumber column in scrap header: ' + header.join(', '));\r\n  if (locIdx  < 0) throw new Error('No Location column in scrap header: ' + header.join(', '));\r\n  if (qtyIdx  < 0) throw new Error('No Qty column in scrap header: ' + header.join(', '));\r\n  const idx = {\r\n    date:     find([/^date$/]),\r\n    note:     find([/^note$/]),\r\n    cls:      find([/^class$/, /^qbclass$/]),\r\n    customer: find([/^customer$/])\r\n  };\r\n  _imp = { type: type, header: header, partIdx: partIdx, locIdx: locIdx, qtyIdx: qtyIdx, idx: idx };\r\n  return _imp;\r\n}\r\n\r\nfunction buildScrapRow(imp, row, fallbackNote, date) {\r\n  const vals = imp.header.map(function () { return ''; });\r\n  vals[imp.partIdx] = row.partnum;\r\n  vals[imp.locIdx]  = row.lgname + '-' + row.locname;   // \"Main-Stock 100\"\r\n  vals[imp.qtyIdx]  = row.scrapQty;\r\n  const note = (row.note && row.note.trim()) || fallbackNote;   // per-row note, else shared note\r\n  if (imp.idx.date >= 0 && date) vals[imp.idx.date] = date;\r\n  if (imp.idx.note >= 0 && note) vals[imp.idx.note] = note;\r\n  // Class / Customer / Tracking-* columns intentionally left blank.\r\n  return vals.map(function (v) { return '\"' + String(v).replace(/\"/g, '\"\"') + '\"'; }).join(',');\r\n}\r\n\r\nfunction importBatch(imp, rows, note, date) {\r\n  const csv = [imp.header.map(function (h) { return '\"' + String(h).replace(/\"/g, '\"\"') + '\"'; }).join(',')];\r\n  rows.forEach(function (r) { csv.push(buildScrapRow(imp, r, note, date)); });\r\n  const payload = { ImportRq: { Type: imp.type, Rows: { Row: csv } } };\r\n  const resp = runApiRequest('ImportRq', JSON.stringify(payload));\r\n  dbg('ImportRq ' + imp.type + ' (' + rows.length + ' row(s)) → ' + (typeof resp === 'string' ? resp : JSON.stringify(resp)), 'success');\r\n  const r = !resp ? null : (typeof resp === 'string' ? JSON.parse(resp) : resp);\r\n  const code = r && r.ImportRs ? r.ImportRs.statusCode : null;\r\n  if (code === 1000 || code === '1000') return { ok: true };\r\n  const msg = (r && r.ImportRs && r.ImportRs.statusMessage) || (r && r.ErrorRs && r.ErrorRs.statusMessage) || ('No/!1000 response: ' + JSON.stringify(r));\r\n  return { ok: false, message: msg };\r\n}\r\n\r\n// Apply scraps for a set of rows, batched. Reduces on-hand qty on success.\r\nasync function applyScraps(rows, note, date) {\r\n  let imp;\r\n  try { imp = ensureImportHeader(); }\r\n  catch (e) { dbgForce('Scrap header error: ' + (e && e.message ? e.message : e), 'error'); banner('Cannot scrap: ' + escHtml(e && e.message ? e.message : String(e)) + '. See debug console.', 'err'); return { ok: 0, failed: rows.length }; }\r\n  const BATCH = 200;\r\n  let ok = 0, failed = 0;\r\n  for (let i = 0; i < rows.length; i += BATCH) {\r\n    const batch = rows.slice(i, i + BATCH);\r\n    setStatus('Scrapping ' + Math.min(i + batch.length, rows.length) + ' / ' + rows.length + '…');\r\n    await new Promise(function (res) { setTimeout(res, 0); });\r\n    let result;\r\n    try { result = importBatch(imp, batch, note, date); }\r\n    catch (e) { result = { ok: false, message: (e && e.message ? e.message : String(e)) }; }\r\n    if (result.ok) {\r\n      batch.forEach(function (r) {\r\n        r.qty = Math.max(0, r.qty - (r.scrapQty || 0));\r\n        r.value = r.qty * r.avgcost;\r\n        r.scrapQty = r.qty;\r\n        _selected.delete(r.key);\r\n      });\r\n      ok += batch.length;\r\n    } else {\r\n      failed += batch.length;\r\n      dbgForce('Scrap batch failed (' + batch.length + ' row(s)): ' + result.message, 'error');\r\n      banner('Scrap failed: ' + escHtml(result.message) + '. See debug console.', 'err');\r\n    }\r\n  }\r\n  // Drop fully-scrapped lines.\r\n  _all = _all.filter(function (r) { return r.qty > 1e-9; });\r\n  applyFilters();\r\n  return { ok: ok, failed: failed };\r\n}\r\n\r\n// Effective note for a row = its own note, else the shared top-field note.\r\nfunction _effNote(row, topNote) { return (row.note && row.note.trim()) || topNote; }\r\n\r\nasync function scrapOne(row, btn) {\r\n  if (!(row.scrapQty > 0)) { banner('Enter a quantity to scrap for ' + escHtml(row.partnum) + '.', 'info'); return; }\r\n  const topNote = (document.getElementById('note').value || '').trim();\r\n  const note = _effNote(row, topNote);\r\n  if (!note) { banner('A note is required — enter one on this line, or fill the shared note above.', 'err'); return; }\r\n  const date = document.getElementById('scrapDate').value || '';\r\n  if (!confirm('Scrap ' + fmtQty(row.scrapQty) + ' ' + row.uom + ' of ' + row.partnum + ' from ' + row.lgname + '-' + row.locname + '?\\n\\nNote: ' + note)) return;\r\n  if (btn) { btn.disabled = true; btn.textContent = '…'; }\r\n  const res = await applyScraps([row], topNote, date);\r\n  if (res.ok === 1 && !res.failed) banner('Scrapped ' + escHtml(row.partnum) + '.', 'ok');\r\n  setStatus(_all.length + ' line(s) remaining');\r\n}\r\n\r\nasync function scrapSelected() {\r\n  const rows = _shown.filter(function (r) { return _selected.has(r.key) && r.scrapQty > 0; });\r\n  if (!rows.length) { banner('No selected rows have a quantity to scrap.', 'info'); return; }\r\n  const topNote = (document.getElementById('note').value || '').trim();\r\n  const missing = rows.filter(function (r) { return !_effNote(r, topNote); });\r\n  if (missing.length) { banner('A note is required — ' + missing.length + ' selected line(s) have none. Enter a per-row note or fill the shared note above.', 'err'); return; }\r\n  const date = document.getElementById('scrapDate').value || '';\r\n  const totQty = rows.reduce(function (s, r) { return s + r.scrapQty; }, 0);\r\n  const totVal = rows.reduce(function (s, r) { return s + r.scrapQty * r.avgcost; }, 0);\r\n  if (!confirm('Scrap ' + rows.length + ' line(s) — ' + fmtQty(totQty) + ' units, ' + fmtMoney(totVal) + ' value?')) return;\r\n  document.getElementById('scrapSelectedBtn').disabled = true;\r\n  const res = await applyScraps(rows, topNote, date);\r\n  if (res.failed) banner('Scrapped ' + res.ok + ' line(s); ' + res.failed + ' failed. See debug console.', res.ok ? 'info' : 'err');\r\n  else banner('Scrapped ' + res.ok + ' line(s) successfully.', 'ok');\r\n  setStatus(_all.length + ' line(s) remaining');\r\n}\r\n\r\n/* ── CSV ── */\r\nfunction exportCSV() {\r\n  if (!_shown.length) { alert('Nothing to export.'); return; }\r\n  const q = function (v) { return '\"' + String(v == null ? '' : v).replace(/\"/g, '\"\"') + '\"'; };\r\n  const lines = ['Location Group,Location,Part #,Description,UOM,On Hand,Avg Cost,Ext Value,Qty to Scrap'];\r\n  _shown.forEach(function (r) {\r\n    lines.push([r.lgname, r.locname, r.partnum, r.partdesc, r.uom, r.qty, r.avgcost, r.value, r.scrapQty].map(q).join(','));\r\n  });\r\n  const blob = new Blob(['﻿' + lines.join('\\r\\n')], { type: 'text/csv;charset=utf-8;' });\r\n  const url = URL.createObjectURL(blob);\r\n  const a = document.createElement('a');\r\n  a.href = url; a.download = 'NonAvailableInventory_' + new Date().toISOString().split('T')[0] + '.csv';\r\n  a.click(); URL.revokeObjectURL(url);\r\n}\r\n\r\n/* ── SETTINGS PANEL ── */\r\nwindow.PageSettings = (function () {\r\n  'use strict';\r\n  function init() {\r\n    const admin = document.getElementById('dsAdminSection');\r\n    if (admin) admin.style.display = FBLib.Settings.isAdmin() ? 'block' : 'none';\r\n    refreshLockUI();\r\n  }\r\n  function refreshLockUI() {\r\n    const allowed = FBLib.Settings.userEditingAllowed();\r\n    const badge = document.getElementById('dsLockBadge');\r\n    if (badge) badge.style.display = (!allowed && !FBLib.Settings.isAdmin()) ? 'block' : 'none';\r\n    const lockBtn = document.getElementById('dsLockBtn');\r\n    if (lockBtn) lockBtn.textContent = allowed ? 'Lock user editing' : 'Unlock user editing';\r\n  }\r\n  function openPanel() {\r\n    const eff = FBLib.Settings.effective();\r\n    document.getElementById('dsDebug').checked = !!eff.debug;\r\n    refreshLockUI();\r\n    document.getElementById('setOverlay').style.display = 'flex';\r\n  }\r\n  function closePanel() { document.getElementById('setOverlay').style.display = 'none'; }\r\n  function closeIfOverlay(e) { if (e && e.target && e.target.id === 'setOverlay') closePanel(); }\r\n  function readPanel() {\r\n    return { debug: document.getElementById('dsDebug').checked };\r\n  }\r\n  function applyAndClose() {\r\n    closePanel();\r\n    document.getElementById('debugConsole').style.display = FBLib.Common.DEBUG_MODE ? 'block' : 'none';\r\n  }\r\n  function saveUser() {\r\n    const p = readPanel();\r\n    Object.keys(p).forEach(function (k) { FBLib.Settings.setUserKey(k, p[k]); });\r\n    if (!FBLib.Settings.saveUser()) { alert('User editing is locked by admin.'); return; }\r\n    applyAndClose();\r\n  }\r\n  function resetToDefaults() { if (!confirm('Reset your personal settings to defaults?')) return; FBLib.Settings.clearUser(); applyAndClose(); }\r\n  function publishMaster() {\r\n    if (!FBLib.Settings.isAdmin()) return;\r\n    if (!confirm('Publish current panel values as the default for all users?')) return;\r\n    FBLib.Settings.publishMaster(readPanel()); alert('Published.'); applyAndClose();\r\n  }\r\n  function toggleLock() {\r\n    if (!FBLib.Settings.isAdmin()) return;\r\n    const nowLocked = FBLib.Settings.userEditingAllowed();\r\n    FBLib.Settings.setLock(nowLocked); refreshLockUI();\r\n    alert('User editing: ' + (nowLocked ? 'LOCKED' : 'UNLOCKED'));\r\n  }\r\n  return { init: init, openPanel: openPanel, closePanel: closePanel, closeIfOverlay: closeIfOverlay,\r\n    saveUser: saveUser, resetToDefaults: resetToDefaults, publishMaster: publishMaster, toggleLock: toggleLock };\r\n})();\r\n\r\n/* ── INIT ── */\r\nwindow.onload = function () {\r\n  document.getElementById('scrapDate').valueAsDate = new Date();\r\n  if (FBLib.Common.DEBUG_MODE) document.getElementById('debugConsole').style.display = 'block';\r\n  PageSettings.init();\r\n  loadData();\r\n};\r\n</script>\r\n</body>\r\n</html>\r\n",
