[ {
  "name" : "WO_Labour_Used_Save_Probe",
  "description" : "WO_Labour_Used_Save_Probe",
  "data" : "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<style>\r\n  body { font-family: sans-serif; padding: 14px; color:#0f172a; }\r\n  h2 { margin:0 0 4px; font-size:16px; }\r\n  .sub { color:#64748b; font-size:12px; margin-bottom:12px; }\r\n  input { font-family: monospace; padding:4px 8px; font-size:13px; }\r\n  button { font-family: inherit; padding:6px 12px; font-size:13px; cursor:pointer;\r\n           background:#2d9cdb; color:#fff; border:none; border-radius:6px; }\r\n  button.warn { background:#b45309; }\r\n  table { border-collapse:collapse; margin-top:10px; font-size:12px; width:100%; }\r\n  th,td { border:1px solid #e2e8f0; padding:5px 8px; text-align:left; }\r\n  th { background:#1e3a5f; color:#fff; }\r\n  td.num { font-variant-numeric:tabular-nums; text-align:right; }\r\n  .lab { background:#fffbeb; }\r\n  pre { background:#0f172a; color:#e2e8f0; padding:10px; border-radius:8px;\r\n        font-size:11px; white-space:pre-wrap; word-break:break-word; margin-top:10px; }\r\n  .msg { margin-left:8px; font-size:12px; }\r\n</style>\r\n</head>\r\n<body>\r\n  <h2>WO Labour Used + Scrap — SaveWorkOrderRq probe</h2>\r\n  <div class=\"sub\">\r\n    Tests whether a labour line's <b>QtyUsed</b> can be adjusted via a standalone\r\n    <b>SaveWorkOrderRq</b> (target left untouched), then reads the DB row back to\r\n    confirm what actually persisted. Also tests the <b>QtyScrapped</b> field on the WO\r\n    save (bottom section) as a possible replacement for the separate ImportScrapData\r\n    CSV scrap flow — checking whether it actually moves on-hand stock or is cosmetic.\r\n    Read-only until you click a Save/Fulfil button, which writes to the WO — demo DB only.\r\n  </div>\r\n\r\n  <div>\r\n    WO #: <input id=\"wo\" value=\"219:001\" />\r\n    <button onclick=\"loadWo()\">Load</button>\r\n    <span class=\"msg\" id=\"msg\"></span>\r\n  </div>\r\n\r\n  <div id=\"grid\"></div>\r\n\r\n  <div id=\"saveWrap\" style=\"display:none; margin-top:12px;\">\r\n    <button class=\"warn\" onclick=\"saveWo()\">Save labour QtyUsed &rarr; then re-read DB</button>\r\n    <button onclick=\"startWo()\" style=\"background:#0f766e; margin-left:8px;\">Start WO (StatusID&rarr;30)</button>\r\n    <span class=\"msg\" id=\"saveMsg\"></span>\r\n    <div class=\"sub\" style=\"margin-top:6px;\">\r\n      To isolate the mechanism: on a fresh <b>Entered</b> WO, click <b>Save labour QtyUsed</b> and note\r\n      whether the DB read-back persists (0&rarr;N or 0&rarr;0). Then click <b>Start WO</b> and Save again —\r\n      if it only persists once Started, the report must pre-store labour AFTER the WO is started.\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"fulfilWrap\" style=\"display:none; margin-top:10px; padding-top:10px; border-top:1px dashed #cbd5e1;\">\r\n    <button class=\"warn\" onclick=\"fulfilWo()\" style=\"background:#b91c1c;\">Fulfil WO (status&rarr;40), labour UNTOUCHED &rarr; re-read DB</button>\r\n    <span class=\"msg\" id=\"fulfilMsg\"></span>\r\n    <div class=\"sub\" style=\"margin-top:6px;\">\r\n      Decisive test: sets StatusID=40 and FG QtyUsed=target (a finish), but leaves the labour\r\n      lines' QtyUsed exactly as already stored. If the stored values survive, the fix is\r\n      \"set labour while open, then fulfil\". Only run on a disposable OPEN test WO (e.g. 220:001).\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"scrapWrap\" style=\"display:none; margin-top:10px; padding-top:10px; border-top:1px dashed #cbd5e1;\">\r\n    <button class=\"warn\" onclick=\"runScrapTest(false)\" style=\"background:#7c2d12;\">Save QtyScrapped (current status) &rarr; re-read DB + on-hand</button>\r\n    <button class=\"warn\" onclick=\"runScrapTest(true)\" style=\"background:#b91c1c; margin-left:8px;\">Fulfil WO (status&rarr;40) + apply QtyScrapped &rarr; re-read DB + on-hand</button>\r\n    <span class=\"msg\" id=\"scrapMsg\"></span>\r\n    <div class=\"sub\" style=\"margin-top:6px;\">\r\n      Tests whether setting a component line's <b>QtyScrapped</b> in the SaveWorkOrderRq\r\n      actually scraps stock — the alternative to the separate <code>ImportScrapData</code> CSV\r\n      flow used in Production_Scheduling. The <b>on-hand delta</b> (tag qty, typeid 30/40) is the\r\n      decisive check: <b>[STOCK MOVED]</b> means a plain WO save can replace the CSV path;\r\n      <b>[no change]</b> means QtyScrapped is cosmetic and the ImportScrapData flow is still\r\n      required. Enter a New QtyScrapped on an <i>inventory raw-material</i> line (scrapping\r\n      labour/non-inventory has no stock to move). Run the finish variant on a disposable OPEN WO.\r\n    </div>\r\n    <div class=\"sub\" style=\"margin-top:6px; color:#8A1E30;\">\r\n      <b>RESULT (2026-07-25, DB-verified):</b> COSMETIC. Setting <code>woitem.QtyScrapped</code>\r\n      via SaveWorkOrderRq (at Entered <i>and</i> at status&rarr;40) wrote the DB field but created\r\n      <b>zero</b> inventorylog transactions and moved <b>no</b> on-hand stock (LID-501 stayed 92,\r\n      committed 0). It does NOT replace the ImportScrapData flow — actual scrap needs a real\r\n      inventory transaction. Caveat: the finish variant went status&rarr;40 without committing a\r\n      pick, so it didn't test scrap during a real finish; but the field fired nothing either way,\r\n      and ImportScrapData scraps from general stock (no pick needed) so it's strictly more capable.\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"moWrap\" style=\"display:none; margin-top:10px; padding-top:10px; border-top:1px dashed #cbd5e1;\">\r\n    <div>\r\n      MO #: <input id=\"moNum\" value=\"\" style=\"width:90px\" />\r\n      <button onclick=\"loadMo()\" style=\"background:#7c3aed;\">Load MO (REST)</button>\r\n      <span class=\"msg\" id=\"moMsg\"></span>\r\n    </div>\r\n    <div id=\"moGrid\"></div>\r\n    <div id=\"moSaveWrap\" style=\"display:none; margin-top:8px;\">\r\n      <button class=\"warn\" onclick=\"saveMoItems()\" style=\"background:#7c3aed;\">Save MO item quantityFulfilled (REST POST) &rarr; re-read DB</button>\r\n      <span class=\"msg\" id=\"moSaveMsg\"></span>\r\n    </div>\r\n    <div class=\"sub\" style=\"margin-top:6px;\">\r\n      Tests the REST <b>Update a manufacture order</b> endpoint (each config item has\r\n      <code>quantity</code> + <code>quantityFulfilled</code>). Per the docs, <b>configurations only\r\n      update when the MO status is \"Entered\"</b>, and SO-linked MOs are skipped — so this can't set a\r\n      <i>finished</i> WO's labour. After POST it re-GETs the MO and re-reads the WO's labour\r\n      <code>woitem.qtyUsed</code> to show whether an MO-item change flows to the WO. Demo DB only.\r\n    </div>\r\n  </div>\r\n\r\n  <div id=\"subWrap\" style=\"margin-top:14px; padding-top:12px; border-top:2px solid #0f172a;\">\r\n    <h2 style=\"font-size:15px;\">Item substitution probe — remove one WOItem + add another (open WO)</h2>\r\n    <div class=\"sub\">\r\n      Tests whether a component part can be <b>substituted</b> on an OPEN work order via the\r\n      legacy API. <b>Add</b> uses the documented <code>AddWorkOrderItemRq</code> (\"add an item to\r\n      an open WO\"); <b>Remove</b> uses <code>SaveWorkOrderRq</code> with the chosen line dropped\r\n      from the <code>WOItems</code> array — that removal is <i>undocumented</i> and is the real\r\n      unknown we're probing. Each button writes to the WO, then re-reads the DB\r\n      <code>woitem</code> rows to show what actually persisted (<b>[NEW]</b> / <b>[REMOVED]</b>).\r\n      Demo DB / disposable open WO only.\r\n    </div>\r\n    <div style=\"margin-top:10px; display:flex; gap:16px; flex-wrap:wrap; align-items:flex-end;\">\r\n      <label>Work order (open) — the BOM to edit<br>\r\n        <select id=\"subWo\" onchange=\"subLoadItems()\" style=\"min-width:170px; padding:4px; font-size:13px;\"></select>\r\n      </label>\r\n      <label>Remove WOItem<br>\r\n        <select id=\"subRemove\" style=\"min-width:300px; padding:4px; font-size:13px;\"></select>\r\n      </label>\r\n      <label>Add part<br>\r\n        <select id=\"subAddPart\" style=\"min-width:230px; padding:4px; font-size:13px;\"></select>\r\n      </label>\r\n      <label>Add as type<br>\r\n        <select id=\"subAddType\" style=\"min-width:150px; padding:4px; font-size:13px;\">\r\n          <option value=\"20\">Raw Good (20)</option>\r\n          <option value=\"10\">Finished Good (10)</option>\r\n        </select>\r\n      </label>\r\n      <label>Qty<br>\r\n        <input id=\"subAddQty\" value=\"1\" style=\"width:70px\" />\r\n      </label>\r\n    </div>\r\n    <div style=\"margin-top:10px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;\">\r\n      <button onclick=\"subAddItem()\">Add item (AddWorkOrderItemRq)</button>\r\n      <button class=\"warn\" onclick=\"subRemoveItem()\">Remove item (SaveWorkOrderRq)</button>\r\n      <button class=\"warn\" style=\"background:#b91c1c;\" onclick=\"subSubstitute()\">Substitute (add + remove)</button>\r\n      <button onclick=\"subLoadItems()\" style=\"background:#0f766e;\">Reload items</button>\r\n      <span class=\"msg\" id=\"subMsg\"></span>\r\n    </div>\r\n    <div id=\"subGrid\"></div>\r\n  </div>\r\n\r\n  <pre id=\"out\" style=\"display:none;\"></pre>\r\n\r\n  <script>\r\n    var _items = [];   // labour line descriptors { woitemId, part, target, apiUsed }\r\n    var _scrap = [];   // component line descriptors { apiIndex, woitemId, part, partId } — for the QtyScrapped test\r\n\r\n    function q(sql) { return JSON.parse(runQuery(sql)); }\r\n\r\n    function dbRows(woNum) {\r\n      // qtyTarget / qtyUsed / qtyScrapped straight from the DB for every line, plus\r\n      // the part id (for the on-hand stock check) and the woitem type (10 = finished-\r\n      // good output, 20 = component — raw material or labour/service).\r\n      return q(\r\n        \"SELECT wi.id AS woitem_id, wi.partid AS part_id, wi.typeid AS wo_item_type, \" +\r\n        \"       p.num AS part_num, p.typeid AS part_typeid, \" +\r\n        \"       wi.qtytarget, wi.qtyused, wi.qtyscrapped \" +\r\n        \"FROM wo JOIN woitem wi ON wi.woid=wo.id \" +\r\n        \"LEFT JOIN part p ON p.id=wi.partid \" +\r\n        \"WHERE wo.num='\" + woNum.replace(/'/g, \"''\") + \"' ORDER BY wi.sortid\"\r\n      );\r\n    }\r\n\r\n    // Total on-hand (tag qty, typeid 30/40) per part — the decisive stock-movement\r\n    // check for the scrap test. Parts with no tags (labour/service) just don't appear.\r\n    function onHandByPart(partIds) {\r\n      var ids = (partIds || []).filter(function (v) { return v != null && v !== ''; });\r\n      if (!ids.length) return {};\r\n      var m = {};\r\n      try {\r\n        q(\"SELECT partid, COALESCE(SUM(qty),0) AS oh FROM tag WHERE typeid IN (30,40) AND partid IN (\" +\r\n          ids.join(',') + \") GROUP BY partid\").forEach(function (r) { m[String(r.partid)] = r.oh; });\r\n      } catch (e) { /* best-effort */ }\r\n      return m;\r\n    }\r\n\r\n    function loadWo() {\r\n      var woNum = document.getElementById('wo').value.trim();\r\n      var msg = document.getElementById('msg');\r\n      var grid = document.getElementById('grid');\r\n      msg.textContent = ''; grid.innerHTML = '';\r\n      document.getElementById('saveWrap').style.display = 'none';\r\n      document.getElementById('fulfilWrap').style.display = 'none';\r\n      document.getElementById('scrapWrap').style.display = 'none';\r\n      document.getElementById('out').style.display = 'none';\r\n      if (typeof runApiRequest !== 'function') { msg.textContent = 'Run inside Fishbowl.'; return; }\r\n      try {\r\n        var rs = JSON.parse(runApiRequest('GetWorkOrderRq',\r\n          JSON.stringify({ GetWorkOrderRq: { WorkOrderNumber: woNum } })));\r\n        var g = rs.GetWorkOrderRs || {};\r\n        if (g.statusCode !== 1000 || !g.WO) { msg.textContent = 'Get failed: ' + g.statusCode + ' ' + (g.statusMessage||''); return; }\r\n        var raw = g.WO.WOItems && g.WO.WOItems.WOItem;\r\n        var apiItems = Array.isArray(raw) ? raw : (raw ? [raw] : []);\r\n        var db = dbRows(woNum);\r\n        var dbByPartAndTarget = {};   // fallback index\r\n        var dbById = {};\r\n        db.forEach(function(r){ dbById[String(r.woitem_id)] = r; });\r\n\r\n        // On-hand (total tag qty, typeid 30/40) per part — shown per line + used by the scrap test.\r\n        var ohNow = onHandByPart(db.map(function (r) { return r.part_id; }));\r\n\r\n        var rows = '<table><tr><th>API WOItem.ID</th><th>Part</th><th>partType</th>' +\r\n                   '<th>Target</th><th>Used (API)</th><th>Scrap (API)</th>' +\r\n                   '<th>DB used</th><th>DB scrap</th><th>On hand</th>' +\r\n                   '<th>Labour?</th><th>New QtyUsed</th><th>New QtyScrapped</th></tr>';\r\n        _items = []; _scrap = [];\r\n        apiItems.forEach(function(wi, i){\r\n          var idA = wi.ID != null ? wi.ID : (wi.WOItemID != null ? wi.WOItemID : '');\r\n          var pnum = wi.PartNum || (wi.Part && wi.Part.Num) || '?';\r\n          var ptype = wi.Part && wi.Part.TypeID != null ? wi.Part.TypeID : '?';\r\n          var isFg = wi.TypeID === 10;                                     // finished-good output line\r\n          var isComponent = !isFg;                                        // raw material OR labour/service\r\n          var isLabour = isComponent && ptype !== 10 && ptype !== '?';    // non-inventory component\r\n          var dbr = dbById[String(idA)] || {};\r\n          var oh = (dbr.part_id != null && ohNow[String(dbr.part_id)] != null) ? ohNow[String(dbr.part_id)] : '—';\r\n          var usedInput  = isLabour    ? '<input id=\"nu_' + i + '\" style=\"width:80px\" placeholder=\"used\" />'  : '';\r\n          var scrapInput = isComponent ? '<input id=\"sc_' + i + '\" style=\"width:80px\" placeholder=\"scrap\" />' : '';\r\n          rows += '<tr class=\"' + (isLabour ? 'lab' : '') + '\">' +\r\n                  '<td>' + idA + '</td><td>' + pnum + '</td><td class=\"num\">' + ptype + '</td>' +\r\n                  '<td class=\"num\">' + wi.QtyToFulfill + '</td>' +\r\n                  '<td class=\"num\">' + wi.QtyUsed + '</td>' +\r\n                  '<td class=\"num\">' + (wi.QtyScrapped != null ? wi.QtyScrapped : '—') + '</td>' +\r\n                  '<td class=\"num\">' + (dbr.qtyused != null ? dbr.qtyused : '—') + '</td>' +\r\n                  '<td class=\"num\">' + (dbr.qtyscrapped != null ? dbr.qtyscrapped : '—') + '</td>' +\r\n                  '<td class=\"num\">' + oh + '</td>' +\r\n                  '<td>' + (isLabour ? 'YES' : '') + '</td>' +\r\n                  '<td>' + usedInput + '</td>' +\r\n                  '<td>' + scrapInput + '</td></tr>';\r\n          if (isLabour)    _items.push({ apiIndex: i, woitemId: idA, part: pnum });\r\n          if (isComponent) _scrap.push({ apiIndex: i, woitemId: idA, part: pnum, partId: dbr.part_id });\r\n        });\r\n        rows += '</table>';\r\n        grid.innerHTML = rows;\r\n        // Stash the fresh API WO so Save reuses the exact object shape.\r\n        window._apiWo = g.WO;\r\n        window._apiItems = apiItems;\r\n        if (_items.length) {\r\n          document.getElementById('saveWrap').style.display = '';\r\n          document.getElementById('fulfilWrap').style.display = '';\r\n        }\r\n        if (_scrap.length) document.getElementById('scrapWrap').style.display = '';\r\n        msg.textContent = 'Loaded. ' + _items.length + ' labour line(s), ' + _scrap.length + ' component line(s). WO status=' + g.WO.StatusID + '.';\r\n\r\n        // Resolve the WO's MO so the REST MO-endpoint test can target it.\r\n        try {\r\n          var moInfo = q(\"SELECT mo.num AS mo_num, mo.statusid AS mo_status \" +\r\n            \"FROM wo JOIN moitem ON wo.moitemid=moitem.id JOIN mo ON moitem.moid=mo.id \" +\r\n            \"WHERE wo.num='\" + woNum.replace(/'/g, \"''\") + \"' LIMIT 1\")[0];\r\n          if (moInfo) {\r\n            document.getElementById('moNum').value = moInfo.mo_num;\r\n            document.getElementById('moWrap').style.display = '';\r\n            document.getElementById('moGrid').innerHTML = '';\r\n            document.getElementById('moSaveWrap').style.display = 'none';\r\n            document.getElementById('moMsg').textContent = 'MO ' + moInfo.mo_num + ' (status ' + moInfo.mo_status + ') — click Load MO.';\r\n          }\r\n        } catch (e) { /* MO resolve is best-effort */ }\r\n      } catch (e) { msg.textContent = 'ERR: ' + (e && e.message || e); }\r\n    }\r\n\r\n    function saveWo() {\r\n      var woNum = document.getElementById('wo').value.trim();\r\n      var saveMsg = document.getElementById('saveMsg');\r\n      var out = document.getElementById('out');\r\n      saveMsg.textContent = '';\r\n      try {\r\n        // Re-GET fresh so we hold the current version/shape.\r\n        var rs = JSON.parse(runApiRequest('GetWorkOrderRq',\r\n          JSON.stringify({ GetWorkOrderRq: { WorkOrderNumber: woNum } })));\r\n        var wo = rs.GetWorkOrderRs && rs.GetWorkOrderRs.WO;\r\n        if (!wo) { saveMsg.textContent = 'Re-Get failed.'; return; }\r\n        var raw = wo.WOItems && wo.WOItems.WOItem;\r\n        var items = Array.isArray(raw) ? raw : (raw ? [raw] : []);\r\n\r\n        var dbBefore = dbRows(woNum);\r\n\r\n        var applied = [];\r\n        _items.forEach(function(it){\r\n          var inp = document.getElementById('nu_' + it.apiIndex);\r\n          if (!inp || inp.value.trim() === '') return;\r\n          var v = parseFloat(inp.value.trim());\r\n          if (!isFinite(v)) return;\r\n          var wi = items[it.apiIndex];\r\n          if (!wi) return;\r\n          // ONLY set QtyUsed. Leave QtyToFulfill / OriginalQtyToFulfill untouched.\r\n          wi.QtyUsed = String(v);\r\n          applied.push(it.part + ' (WOItem ' + it.woitemId + ') QtyUsed=' + v);\r\n        });\r\n        if (!applied.length) { saveMsg.textContent = 'Enter at least one New QtyUsed.'; return; }\r\n\r\n        var saveRs = JSON.parse(runApiRequest('SaveWorkOrderRq',\r\n          JSON.stringify({ SaveWorkOrderRq: { WO: wo } })));\r\n        var s = saveRs.SaveWorkOrderRs || {};\r\n\r\n        var dbAfter = dbRows(woNum);\r\n\r\n        var report = 'Sent: ' + applied.join('  |  ') + '\\n' +\r\n                     'SaveWorkOrderRs statusCode=' + s.statusCode + '  ' + (s.statusMessage || '') + '\\n\\n' +\r\n                     'DB qtyUsed BEFORE -> AFTER (labour lines):\\n';\r\n        var beforeById = {}; dbBefore.forEach(function(r){ beforeById[String(r.woitem_id)] = r; });\r\n        dbAfter.forEach(function(r){\r\n          if (String(r.part_typeid) === '10') return;\r\n          var b = beforeById[String(r.woitem_id)] || {};\r\n          report += '  ' + r.part_num + ' (id ' + r.woitem_id + '): target=' + r.qtytarget +\r\n                    '  used ' + (b.qtyused != null ? b.qtyused : '?') + ' -> ' + r.qtyused + '\\n';\r\n        });\r\n        out.style.display = 'block';\r\n        out.textContent = report;\r\n        saveMsg.textContent = s.statusCode === 1000 ? 'Save returned 1000. Check the DB read-back below.' : 'Save returned ' + s.statusCode;\r\n      } catch (e) { saveMsg.textContent = 'ERR: ' + (e && e.message || e); }\r\n    }\r\n\r\n    // Transition an OPEN WO to Started (StatusID 30) via SaveWorkOrderRq, then\r\n    // reload — so the standalone labour-save test can be run at Entered vs Started\r\n    // without touching the report's pick machinery.\r\n    function startWo() {\r\n      var woNum = document.getElementById('wo').value.trim();\r\n      var saveMsg = document.getElementById('saveMsg');\r\n      saveMsg.textContent = '';\r\n      try {\r\n        var rs = JSON.parse(runApiRequest('GetWorkOrderRq',\r\n          JSON.stringify({ GetWorkOrderRq: { WorkOrderNumber: woNum } })));\r\n        var wo = rs.GetWorkOrderRs && rs.GetWorkOrderRs.WO;\r\n        if (!wo) { saveMsg.textContent = 'Re-Get failed.'; return; }\r\n        if (wo.StatusID === 40) { saveMsg.textContent = 'Already fulfilled — cannot start.'; return; }\r\n        var before = wo.StatusID;\r\n        wo.StatusID = 30;\r\n        var sr = JSON.parse(runApiRequest('SaveWorkOrderRq',\r\n          JSON.stringify({ SaveWorkOrderRq: { WO: wo } })));\r\n        var s = sr.SaveWorkOrderRs || {};\r\n        saveMsg.textContent = 'Start save (StatusID ' + before + '->30) returned ' + s.statusCode + '  ' + (s.statusMessage || '') + '. Reloading…';\r\n        loadWo();\r\n      } catch (e) { saveMsg.textContent = 'ERR: ' + (e && e.message || e); }\r\n    }\r\n\r\n    function fulfilWo() {\r\n      var woNum = document.getElementById('wo').value.trim();\r\n      var fulfilMsg = document.getElementById('fulfilMsg');\r\n      var out = document.getElementById('out');\r\n      fulfilMsg.textContent = '';\r\n      try {\r\n        var rs = JSON.parse(runApiRequest('GetWorkOrderRq',\r\n          JSON.stringify({ GetWorkOrderRq: { WorkOrderNumber: woNum } })));\r\n        var wo = rs.GetWorkOrderRs && rs.GetWorkOrderRs.WO;\r\n        if (!wo) { fulfilMsg.textContent = 'Re-Get failed.'; return; }\r\n        if (wo.StatusID === 40) { fulfilMsg.textContent = 'Already fulfilled (status 40) — run this on an OPEN test WO.'; return; }\r\n        var raw = wo.WOItems && wo.WOItems.WOItem;\r\n        var items = Array.isArray(raw) ? raw : (raw ? [raw] : []);\r\n\r\n        var dbBefore = dbRows(woNum);\r\n\r\n        // Mimic a finish: fulfil the WO + receive the finished good(s), but\r\n        // do NOT touch any non-FG line — the labour lines keep whatever\r\n        // qtyUsed is already stored. This isolates whether the status->40\r\n        // transition preserves or recomputes pre-stored labour consumption.\r\n        wo.StatusID = 40;\r\n        items.forEach(function (wi) {\r\n          if (wi.TypeID === 10) {\r\n            var tgt = wi.QtyToFulfill != null ? wi.QtyToFulfill : wi.QtyUsed;\r\n            wi.QtyUsed = String(tgt);\r\n          }\r\n          // non-FG (raw + labour): left exactly as returned by Get.\r\n        });\r\n\r\n        var saveRs = JSON.parse(runApiRequest('SaveWorkOrderRq',\r\n          JSON.stringify({ SaveWorkOrderRq: { WO: wo } })));\r\n        var s = saveRs.SaveWorkOrderRs || {};\r\n\r\n        var dbAfter = dbRows(woNum);\r\n        var beforeById = {}; dbBefore.forEach(function(r){ beforeById[String(r.woitem_id)] = r; });\r\n        var report = 'FULFIL test (status->40, labour untouched)\\n' +\r\n                     'SaveWorkOrderRs statusCode=' + s.statusCode + '  ' + (s.statusMessage || '') + '\\n\\n' +\r\n                     'DB qtyUsed BEFORE -> AFTER (labour lines):\\n';\r\n        dbAfter.forEach(function(r){\r\n          if (String(r.part_typeid) === '10') return;\r\n          var b = beforeById[String(r.woitem_id)] || {};\r\n          var kept = (b.qtyused != null && String(b.qtyused) === String(r.qtyused));\r\n          report += '  ' + r.part_num + ' (id ' + r.woitem_id + '): target=' + r.qtytarget +\r\n                    '  used ' + (b.qtyused != null ? b.qtyused : '?') + ' -> ' + r.qtyused +\r\n                    '   ' + (kept ? '[PRESERVED]' : '[CHANGED]') + '\\n';\r\n        });\r\n        out.style.display = 'block';\r\n        out.textContent = report;\r\n        fulfilMsg.textContent = 'Done — see PRESERVED/CHANGED below.';\r\n      } catch (e) { fulfilMsg.textContent = 'ERR: ' + (e && e.message || e); }\r\n    }\r\n\r\n    // ── QtyScrapped test — scrap via SaveWorkOrderRq (vs the ImportScrapData CSV flow) ──\r\n    // Sets wi.QtyScrapped on component lines that carry a New QtyScrapped value, leaving\r\n    // QtyToFulfill / QtyUsed untouched so we can see whether Fishbowl adjusts Used or moves\r\n    // stock on its own. Returns { applied[], partIds[] } for the report + on-hand check.\r\n    function applyScrap(items) {\r\n      var applied = [], partIds = [];\r\n      _scrap.forEach(function (it) {\r\n        var inp = document.getElementById('sc_' + it.apiIndex);\r\n        if (!inp || inp.value.trim() === '') return;\r\n        var v = parseFloat(inp.value.trim());\r\n        if (!isFinite(v)) return;\r\n        var wi = items[it.apiIndex];\r\n        if (!wi) return;\r\n        wi.QtyScrapped = String(v);\r\n        applied.push(it.part + ' (WOItem ' + it.woitemId + ') QtyScrapped=' + v);\r\n        if (it.partId != null) partIds.push(it.partId);\r\n      });\r\n      return { applied: applied, partIds: partIds };\r\n    }\r\n\r\n    // Core scrap test. finish=false → save at the current status; finish=true → also set\r\n    // StatusID=40 + FG QtyUsed=target (scrap AT finish, the production flow's moment). It\r\n    // snapshots DB woitem (target/used/scrap) AND part on-hand before/after, so the report\r\n    // shows both what the woitem recorded AND — the decisive bit — whether stock actually\r\n    // moved. [STOCK MOVED] → QtyScrapped can replace the ImportScrapData CSV path;\r\n    // [no change] → the field is cosmetic and the CSV flow is still required.\r\n    function runScrapTest(finish) {\r\n      var woNum = document.getElementById('wo').value.trim();\r\n      var scrapMsg = document.getElementById('scrapMsg');\r\n      var out = document.getElementById('out');\r\n      scrapMsg.textContent = '';\r\n      try {\r\n        var rs = JSON.parse(runApiRequest('GetWorkOrderRq',\r\n          JSON.stringify({ GetWorkOrderRq: { WorkOrderNumber: woNum } })));\r\n        var wo = rs.GetWorkOrderRs && rs.GetWorkOrderRs.WO;\r\n        if (!wo) { scrapMsg.textContent = 'Re-Get failed.'; return; }\r\n        if (finish && wo.StatusID === 40) { scrapMsg.textContent = 'Already fulfilled — run the finish-scrap test on an OPEN WO.'; return; }\r\n        var raw = wo.WOItems && wo.WOItems.WOItem;\r\n        var items = Array.isArray(raw) ? raw : (raw ? [raw] : []);\r\n\r\n        var dbBefore = dbRows(woNum);\r\n        var partIds = dbBefore.map(function (r) { return r.part_id; }).filter(function (v) { return v != null; });\r\n        var ohBefore = onHandByPart(partIds);\r\n\r\n        if (finish) {\r\n          wo.StatusID = 40;\r\n          items.forEach(function (wi) {\r\n            if (wi.TypeID === 10) { var tgt = wi.QtyToFulfill != null ? wi.QtyToFulfill : wi.QtyUsed; wi.QtyUsed = String(tgt); }\r\n          });\r\n        }\r\n\r\n        var ap = applyScrap(items);\r\n        if (!ap.applied.length) { scrapMsg.textContent = 'Enter at least one New QtyScrapped (on an inventory raw-material line).'; return; }\r\n\r\n        var saveRs = JSON.parse(runApiRequest('SaveWorkOrderRq',\r\n          JSON.stringify({ SaveWorkOrderRq: { WO: wo } })));\r\n        var s = saveRs.SaveWorkOrderRs || {};\r\n\r\n        var dbAfter = dbRows(woNum);\r\n        var ohAfter = onHandByPart(partIds);\r\n        var beforeById = {}; dbBefore.forEach(function (r) { beforeById[String(r.woitem_id)] = r; });\r\n        var numById = {}; dbAfter.forEach(function (r) { numById[String(r.part_id)] = r.part_num; });\r\n\r\n        var report = 'SCRAP test' + (finish ? ' (status->40 + FG used=target)' : ' (current status, no finish)') + '\\n' +\r\n                     'Sent: ' + ap.applied.join('  |  ') + '\\n' +\r\n                     'SaveWorkOrderRs statusCode=' + s.statusCode + '  ' + (s.statusMessage || '') + '\\n\\n' +\r\n                     'DB woitem BEFORE -> AFTER (component lines):\\n';\r\n        dbAfter.forEach(function (r) {\r\n          if (String(r.wo_item_type) === '10') return;   // skip the FG output line\r\n          var b = beforeById[String(r.woitem_id)] || {};\r\n          report += '  ' + r.part_num + ' (id ' + r.woitem_id + '): target=' + r.qtytarget +\r\n                    '  used ' + (b.qtyused != null ? b.qtyused : '?') + '->' + r.qtyused +\r\n                    '  scrap ' + (b.qtyscrapped != null ? b.qtyscrapped : '?') + '->' + r.qtyscrapped + '\\n';\r\n        });\r\n        report += '\\nOn-hand (tag qty, typeid 30/40) BEFORE -> AFTER for scrapped parts (decisive):\\n';\r\n        var seen = {};\r\n        ap.partIds.forEach(function (pid) {\r\n          if (seen[String(pid)]) return; seen[String(pid)] = 1;\r\n          var b = ohBefore[String(pid)], a = ohAfter[String(pid)];\r\n          var moved = String(b == null ? 0 : b) !== String(a == null ? 0 : a);\r\n          report += '  part ' + (numById[String(pid)] || ('#' + pid)) + ': ' +\r\n                    (b != null ? b : 0) + ' -> ' + (a != null ? a : 0) +\r\n                    '   ' + (moved ? '[STOCK MOVED]' : '[no change — cosmetic]') + '\\n';\r\n        });\r\n        out.style.display = 'block';\r\n        out.textContent = report;\r\n        scrapMsg.textContent = s.statusCode === 1000 ? 'Save returned 1000. Check the on-hand delta below.' : 'Save returned ' + s.statusCode;\r\n      } catch (e) { scrapMsg.textContent = 'ERR: ' + (e && e.message || e); }\r\n    }\r\n\r\n    // ── REST \"Update a manufacture order\" endpoint test ──────────────────────\r\n    // GET /api/manufacture-orders/:id → show each configuration item's quantity +\r\n    // quantityFulfilled → let the user edit quantityFulfilled on a non-FG (labour/\r\n    // overhead/raw) item → POST the whole MO back → re-GET the MO + re-read the WO's\r\n    // labour woitem.qtyUsed, to see whether an MO-item change flows through to the WO.\r\n    async function loadMo() {\r\n      var moNum = document.getElementById('moNum').value.trim();\r\n      var moMsg = document.getElementById('moMsg');\r\n      var moGrid = document.getElementById('moGrid');\r\n      moMsg.textContent = ''; moGrid.innerHTML = '';\r\n      document.getElementById('moSaveWrap').style.display = 'none';\r\n      if (typeof runRestApiAsync !== 'function') { moMsg.textContent = 'runRestApiAsync unavailable (REST not enabled).'; return; }\r\n      if (!moNum) { moMsg.textContent = 'Enter an MO #.'; return; }\r\n      var info;\r\n      try { info = q(\"SELECT id, statusid FROM mo WHERE num='\" + moNum.replace(/'/g, \"''\") + \"' LIMIT 1\")[0]; }\r\n      catch (e) { moMsg.textContent = 'DB lookup failed: ' + (e && e.message || e); return; }\r\n      if (!info) { moMsg.textContent = 'MO ' + moNum + ' not found.'; return; }\r\n      var moId = parseInt(info.id, 10);\r\n      try {\r\n        var full = await runRestApiAsync({ method: 'GET', path: '/api/manufacture-orders/' + moId });\r\n        window._moId = moId; window._moNum = moNum; window._moItemMap = {};\r\n        var st = (full && full.status) || ('status ' + info.statusid);\r\n        var rows = '<table><tr><th>Item ID</th><th>Config</th><th>Part</th><th>Type</th>' +\r\n                   '<th>quantity</th><th>quantityFulfilled</th><th>New qtyFulfilled</th></tr>';\r\n        (full.configurations || []).forEach(function (cfg, ci) {\r\n          (cfg.items || []).forEach(function (it, ii) {\r\n            var pid = it.id;\r\n            window._moItemMap[String(pid)] = { ci: ci, ii: ii, part: (it.part && it.part.name) || '?' };\r\n            var isFg = (it.type === 'Finished Good');\r\n            rows += '<tr class=\"' + (isFg ? '' : 'lab') + '\">' +\r\n              '<td>' + pid + '</td><td class=\"num\">' + (cfg.id != null ? cfg.id : ci) + '</td>' +\r\n              '<td>' + ((it.part && it.part.name) || '?') + '</td><td>' + (it.type || '?') + '</td>' +\r\n              '<td class=\"num\">' + it.quantity + '</td><td class=\"num\">' + it.quantityFulfilled + '</td>' +\r\n              '<td>' + (isFg ? '' : '<input id=\"mf_' + pid + '\" style=\"width:90px\" placeholder=\"e.g. 2\" />') + '</td></tr>';\r\n          });\r\n        });\r\n        rows += '</table>';\r\n        moGrid.innerHTML = rows;\r\n        document.getElementById('moSaveWrap').style.display = '';\r\n        var warn = String(st).toLowerCase() !== 'entered'\r\n          ? ' — NOTE: status is not \"Entered\", so configurations will NOT update (docs).' : '';\r\n        moMsg.textContent = 'MO ' + moNum + ' loaded. status=' + st + warn;\r\n      } catch (e) { moMsg.textContent = 'REST GET failed: ' + ((e && (e.message || e.status)) || e); }\r\n    }\r\n\r\n    async function saveMoItems() {\r\n      var woNum = document.getElementById('wo').value.trim();\r\n      var moSaveMsg = document.getElementById('moSaveMsg');\r\n      var out = document.getElementById('out');\r\n      moSaveMsg.textContent = '';\r\n      var moId = window._moId;\r\n      if (moId == null) { moSaveMsg.textContent = 'Load the MO first.'; return; }\r\n      try {\r\n        // Fresh GET so we hold the current shape/version, then apply edits.\r\n        var full = await runRestApiAsync({ method: 'GET', path: '/api/manufacture-orders/' + moId });\r\n        var applied = [];\r\n        Object.keys(window._moItemMap || {}).forEach(function (pid) {\r\n          var inp = document.getElementById('mf_' + pid);\r\n          if (!inp || inp.value.trim() === '') return;\r\n          var v = parseFloat(inp.value.trim());\r\n          if (!isFinite(v)) return;\r\n          var m = window._moItemMap[pid];\r\n          var it = full.configurations[m.ci] && full.configurations[m.ci].items[m.ii];\r\n          if (!it) return;\r\n          it.quantityFulfilled = String(v);\r\n          applied.push(m.part + ' (item ' + pid + ') quantityFulfilled=' + v);\r\n        });\r\n        if (!applied.length) { moSaveMsg.textContent = 'Enter at least one New qtyFulfilled.'; return; }\r\n\r\n        var dbBefore = dbRows(woNum);\r\n\r\n        var res = await runRestApiAsync({ method: 'POST', path: '/api/manufacture-orders/' + moId, body: JSON.stringify(full) });\r\n\r\n        // Re-GET the MO to see the persisted item quantityFulfilled.\r\n        var after = await runRestApiAsync({ method: 'GET', path: '/api/manufacture-orders/' + moId });\r\n        var afterById = {};\r\n        (after.configurations || []).forEach(function (cfg) { (cfg.items || []).forEach(function (it) { afterById[String(it.id)] = it; }); });\r\n\r\n        var dbAfter = dbRows(woNum);\r\n        var beforeById = {}; dbBefore.forEach(function (r) { beforeById[String(r.woitem_id)] = r; });\r\n\r\n        var report = 'MO REST POST — set item quantityFulfilled\\n' +\r\n                     'Sent: ' + applied.join('  |  ') + '\\n' +\r\n                     'POST result: ' + (typeof res === 'string' ? res.slice(0, 160) : JSON.stringify({ id: res && res.id, status: res && res.status })) + '\\n\\n' +\r\n                     'MO item quantityFulfilled AFTER (re-GET):\\n';\r\n        Object.keys(window._moItemMap).forEach(function (pid) {\r\n          var inp = document.getElementById('mf_' + pid);\r\n          if (!inp || inp.value.trim() === '') return;\r\n          var it = afterById[String(pid)] || {};\r\n          report += '  ' + window._moItemMap[pid].part + ' (item ' + pid + '): quantityFulfilled -> ' + (it.quantityFulfilled != null ? it.quantityFulfilled : '?') + '\\n';\r\n        });\r\n        report += '\\nWO ' + woNum + ' non-FG woitem.qtyUsed BEFORE -> AFTER:\\n';\r\n        dbAfter.forEach(function (r) {\r\n          if (String(r.part_typeid) === '10') return;\r\n          var b = beforeById[String(r.woitem_id)] || {};\r\n          report += '  ' + r.part_num + ' (id ' + r.woitem_id + '): target=' + r.qtytarget +\r\n                    '  used ' + (b.qtyused != null ? b.qtyused : '?') + ' -> ' + r.qtyused + '\\n';\r\n        });\r\n        out.style.display = 'block';\r\n        out.textContent = report;\r\n        moSaveMsg.textContent = 'Done — see the read-back below.';\r\n      } catch (e) { moSaveMsg.textContent = 'REST error: ' + ((e && (e.message || e.status)) || e); }\r\n    }\r\n\r\n    // ══════════════════════════════════════════════════════════════════\r\n    // ITEM SUBSTITUTION PROBE — remove one WOItem + add another (open WO)\r\n    // ------------------------------------------------------------------\r\n    // Add  = AddWorkOrderItemRq (documented: adds a line to an open WO).\r\n    // Remove = SaveWorkOrderRq with the chosen WOItem dropped from the\r\n    //          WOItems array (UNDOCUMENTED — the real unknown).\r\n    // Substitute = Add then Remove, one report.\r\n    // Every action re-reads the DB woitem rows so the [NEW]/[REMOVED]\r\n    // outcome is what actually persisted, not what the API claimed.\r\n    // ══════════════════════════════════════════════════════════════════\r\n    var _subItems = [];   // the picked WO's API WOItem[] (for the remove dropdown)\r\n\r\n    function subInit() {\r\n      if (typeof runQuery !== 'function') { document.getElementById('subMsg').textContent = 'Run inside Fishbowl.'; return; }\r\n      // Open WOs (Entered=10 / Started=30) — the only states AddWorkOrderItemRq accepts.\r\n      try {\r\n        var wos = q(\"SELECT wo.num AS num, wo.statusid AS st FROM wo WHERE wo.statusid IN (10,30) ORDER BY wo.num LIMIT 500\");\r\n        document.getElementById('subWo').innerHTML = '<option value=\"\">— pick a WO —</option>' +\r\n          wos.map(function (r) { var n = String(r.num).replace(/\"/g, '&quot;'); return '<option value=\"' + n + '\">' + r.num + ' (status ' + r.st + ')</option>'; }).join('');\r\n      } catch (e) { document.getElementById('subMsg').textContent = 'WO list failed: ' + (e && e.message || e); }\r\n      // Inventory parts to add (num + default UOM code + avg cost for the Add request).\r\n      try {\r\n        var parts = q(\"SELECT p.num AS num, COALESCE(p.description,'') AS descr, COALESCE(u.code,'ea') AS uomcode, COALESCE(pc.avgcost,0) AS cost \" +\r\n          \"FROM part p LEFT JOIN uom u ON u.id=p.uomid LEFT JOIN partcost pc ON pc.partid=p.id \" +\r\n          \"WHERE p.activeflag=1 AND p.typeid=10 ORDER BY p.num LIMIT 1000\");\r\n        document.getElementById('subAddPart').innerHTML = parts.map(function (r) {\r\n          var esc = function (v) { return String(v == null ? '' : v).replace(/\"/g, '&quot;'); };\r\n          return '<option value=\"' + esc(r.num) + '\" data-uom=\"' + esc(r.uomcode) + '\" data-cost=\"' + (r.cost || 0) + '\" data-desc=\"' + esc(r.descr) + '\">' + r.num + ' (' + r.uomcode + ')</option>';\r\n        }).join('');\r\n      } catch (e) { /* best-effort */ }\r\n    }\r\n\r\n    // GET the picked WO → fill the remove dropdown + show its current DB rows.\r\n    function subLoadItems() {\r\n      var woNum = document.getElementById('subWo').value.trim();\r\n      var rsel = document.getElementById('subRemove');\r\n      var grid = document.getElementById('subGrid');\r\n      var msg  = document.getElementById('subMsg');\r\n      rsel.innerHTML = ''; grid.innerHTML = ''; msg.textContent = ''; _subItems = [];\r\n      if (!woNum) return;\r\n      if (typeof runApiRequest !== 'function') { msg.textContent = 'Run inside Fishbowl.'; return; }\r\n      try {\r\n        var rs = JSON.parse(runApiRequest('GetWorkOrderRq', JSON.stringify({ GetWorkOrderRq: { WorkOrderNumber: woNum } })));\r\n        var g = rs.GetWorkOrderRs || {};\r\n        if (g.statusCode !== 1000 || !g.WO) { msg.textContent = 'Get failed: ' + g.statusCode + ' ' + (g.statusMessage || ''); return; }\r\n        var raw = g.WO.WOItems && g.WO.WOItems.WOItem;\r\n        _subItems = Array.isArray(raw) ? raw : (raw ? [raw] : []);\r\n        rsel.innerHTML = _subItems.map(function (wi) {\r\n          var id = wi.ID != null ? wi.ID : (wi.WOItemID != null ? wi.WOItemID : '');\r\n          var pnum = wi.PartNum || (wi.Part && wi.Part.Num) || '?';\r\n          return '<option value=\"' + id + '\">#' + id + ' — ' + pnum + ' (type ' + wi.TypeID + ', target ' + wi.QtyToFulfill + ')</option>';\r\n        }).join('');\r\n        subRenderDb(woNum);\r\n        msg.textContent = 'WO ' + woNum + ' status=' + g.WO.StatusID + ' — ' + _subItems.length + ' item(s).';\r\n      } catch (e) { msg.textContent = 'ERR: ' + (e && e.message || e); }\r\n    }\r\n\r\n    function subRenderDb(woNum) {\r\n      try {\r\n        var db = dbRows(woNum);\r\n        var rows = '<table><tr><th>woitem id</th><th>Part</th><th>type</th><th>target</th><th>used</th><th>scrap</th></tr>';\r\n        db.forEach(function (r) {\r\n          rows += '<tr><td>' + r.woitem_id + '</td><td>' + (r.part_num || '?') + '</td>' +\r\n                  '<td class=\"num\">' + r.wo_item_type + '</td><td class=\"num\">' + r.qtytarget + '</td>' +\r\n                  '<td class=\"num\">' + r.qtyused + '</td><td class=\"num\">' + (r.qtyscrapped != null ? r.qtyscrapped : '—') + '</td></tr>';\r\n        });\r\n        document.getElementById('subGrid').innerHTML = rows + '</table>';\r\n      } catch (e) { document.getElementById('subGrid').innerHTML = ''; }\r\n    }\r\n\r\n    // Text diff of the WO's DB woitem rows before vs after an action.\r\n    function subDiff(before, after) {\r\n      var beforeIds = {}, afterIds = {};\r\n      before.forEach(function (r) { beforeIds[String(r.woitem_id)] = r; });\r\n      after.forEach(function (r) { afterIds[String(r.woitem_id)] = r; });\r\n      var lines = 'WOItem rows AFTER (vs before):\\n';\r\n      after.forEach(function (r) {\r\n        var tag = beforeIds[String(r.woitem_id)] ? '' : '   [NEW]';\r\n        lines += '  #' + r.woitem_id + '  ' + (r.part_num || '?') + '  type ' + r.wo_item_type +\r\n                 '  target=' + r.qtytarget + '  used=' + r.qtyused + tag + '\\n';\r\n      });\r\n      before.forEach(function (r) {\r\n        if (!afterIds[String(r.woitem_id)]) lines += '  #' + r.woitem_id + '  ' + (r.part_num || '?') + '   [REMOVED]\\n';\r\n      });\r\n      return lines;\r\n    }\r\n\r\n    // Read the Add-part selector → { partNum, uom, cost, typeId, qty } or null.\r\n    function subAddSpec(msg) {\r\n      var psel = document.getElementById('subAddPart');\r\n      var opt = psel.options[psel.selectedIndex];\r\n      if (!opt || !opt.value) { msg.textContent = 'Pick a part to add.'; return null; }\r\n      var qty = parseFloat(document.getElementById('subAddQty').value.trim());\r\n      if (!isFinite(qty)) { msg.textContent = 'Enter a qty to add.'; return null; }\r\n      return {\r\n        partNum: opt.value,\r\n        // AddWorkOrderItemRq REQUIRES a non-empty Description (else status 1012\r\n        // \"You must have a description for the Work Order item.\"). Default to the\r\n        // part's own description, falling back to the part number.\r\n        desc: opt.getAttribute('data-desc') || opt.value,\r\n        uom: opt.getAttribute('data-uom') || 'ea',\r\n        cost: parseFloat(opt.getAttribute('data-cost') || '0') || 0,\r\n        typeId: parseInt(document.getElementById('subAddType').value, 10) || 20,\r\n        qty: qty\r\n      };\r\n    }\r\n\r\n    // AddWorkOrderItemRq (documented add).\r\n    function subAdd(woNum, spec) {\r\n      var rs = JSON.parse(runApiRequest('AddWorkOrderItemRq', JSON.stringify({ AddWorkOrderItemRq: {\r\n        OrderNum: woNum, TypeId: spec.typeId, Description: spec.desc, PartNum: spec.partNum,\r\n        Quantity: spec.qty, UOMCode: spec.uom, Cost: spec.cost\r\n      } })));\r\n      return rs.AddWorkOrderItemRs || {};\r\n    }\r\n\r\n    // Remove a WOItem by dropping it from the array in a SaveWorkOrderRq (undocumented).\r\n    // Returns { statusCode, statusMessage, found }.\r\n    function subRemoveById(woNum, removeId) {\r\n      var rs = JSON.parse(runApiRequest('GetWorkOrderRq', JSON.stringify({ GetWorkOrderRq: { WorkOrderNumber: woNum } })));\r\n      var wo = rs.GetWorkOrderRs && rs.GetWorkOrderRs.WO;\r\n      if (!wo) return { statusCode: 'no-get', found: false };\r\n      var raw = wo.WOItems && wo.WOItems.WOItem;\r\n      var items = Array.isArray(raw) ? raw : (raw ? [raw] : []);\r\n      var kept = items.filter(function (wi) { var id = (wi.ID != null ? wi.ID : wi.WOItemID); return String(id) !== String(removeId); });\r\n      var found = kept.length !== items.length;\r\n      wo.WOItems = { WOItem: kept };\r\n      var sr = JSON.parse(runApiRequest('SaveWorkOrderRq', JSON.stringify({ SaveWorkOrderRq: { WO: wo } })));\r\n      var s = sr.SaveWorkOrderRs || {};\r\n      return { statusCode: s.statusCode, statusMessage: s.statusMessage, found: found };\r\n    }\r\n\r\n    function subAddItem() {\r\n      var woNum = document.getElementById('subWo').value.trim();\r\n      var msg = document.getElementById('subMsg'), out = document.getElementById('out');\r\n      msg.textContent = '';\r\n      if (!woNum) { msg.textContent = 'Pick a WO.'; return; }\r\n      var spec = subAddSpec(msg); if (!spec) return;\r\n      try {\r\n        var dbBefore = dbRows(woNum);\r\n        var s = subAdd(woNum, spec);\r\n        var dbAfter = dbRows(woNum);\r\n        var addedOk = dbAfter.some(function (r) { return String(r.part_num) === String(spec.partNum); }) &&\r\n                      dbAfter.length > dbBefore.length;\r\n        out.style.display = 'block';\r\n        out.textContent = 'ADD via AddWorkOrderItemRq\\n' +\r\n          'Sent: OrderNum=' + woNum + '  PartNum=' + spec.partNum + '  TypeId=' + spec.typeId +\r\n          '  Qty=' + spec.qty + '  UOM=' + spec.uom + '  Cost=' + spec.cost + '\\n' +\r\n          'AddWorkOrderItemRs statusCode=' + s.statusCode + '  ' + (s.statusMessage || '') + '\\n' +\r\n          'Row count ' + dbBefore.length + ' -> ' + dbAfter.length + '   ' + (addedOk ? '[ADDED]' : '[no new line]') + '\\n\\n' +\r\n          subDiff(dbBefore, dbAfter);\r\n        msg.textContent = s.statusCode === 1000 ? 'Add returned 1000 — check the diff.' : 'Add returned ' + s.statusCode;\r\n        subLoadItems();\r\n      } catch (e) { msg.textContent = 'ERR: ' + (e && e.message || e); }\r\n    }\r\n\r\n    function subRemoveItem() {\r\n      var woNum = document.getElementById('subWo').value.trim();\r\n      var msg = document.getElementById('subMsg'), out = document.getElementById('out');\r\n      msg.textContent = '';\r\n      if (!woNum) { msg.textContent = 'Pick a WO.'; return; }\r\n      var removeId = document.getElementById('subRemove').value;\r\n      if (!removeId) { msg.textContent = 'Pick a WOItem to remove.'; return; }\r\n      try {\r\n        var dbBefore = dbRows(woNum);\r\n        var r = subRemoveById(woNum, removeId);\r\n        var dbAfter = dbRows(woNum);\r\n        var gone = !dbAfter.some(function (x) { return String(x.woitem_id) === String(removeId); });\r\n        out.style.display = 'block';\r\n        out.textContent = 'REMOVE via SaveWorkOrderRq (dropped WOItem ' + removeId + ' from the array)\\n' +\r\n          (r.found ? '' : 'NOTE: WOItem ' + removeId + ' was not in the fresh GET.\\n') +\r\n          'SaveWorkOrderRs statusCode=' + r.statusCode + '  ' + (r.statusMessage || '') + '\\n' +\r\n          'WOItem ' + removeId + ' after save: ' + (gone ? '[REMOVED]' : '[STILL PRESENT — save ignored the drop]') + '\\n\\n' +\r\n          subDiff(dbBefore, dbAfter);\r\n        msg.textContent = (r.statusCode === 1000) ? (gone ? 'Removed (1000).' : 'Save 1000 but the line persisted.') : 'Save returned ' + r.statusCode;\r\n        subLoadItems();\r\n      } catch (e) { msg.textContent = 'ERR: ' + (e && e.message || e); }\r\n    }\r\n\r\n    function subSubstitute() {\r\n      var woNum = document.getElementById('subWo').value.trim();\r\n      var msg = document.getElementById('subMsg'), out = document.getElementById('out');\r\n      msg.textContent = '';\r\n      if (!woNum) { msg.textContent = 'Pick a WO.'; return; }\r\n      var removeId = document.getElementById('subRemove').value;\r\n      if (!removeId) { msg.textContent = 'Pick a WOItem to remove.'; return; }\r\n      var spec = subAddSpec(msg); if (!spec) return;\r\n      try {\r\n        var dbBefore = dbRows(woNum);\r\n        var aS = subAdd(woNum, spec);                 // 1) add the replacement\r\n        var r  = subRemoveById(woNum, removeId);      // 2) fresh GET (now includes the new line) then drop the old\r\n        var dbAfter = dbRows(woNum);\r\n        var addedOk   = dbAfter.some(function (x) { return String(x.part_num) === String(spec.partNum); });\r\n        var removedOk = !dbAfter.some(function (x) { return String(x.woitem_id) === String(removeId); });\r\n        out.style.display = 'block';\r\n        out.textContent = 'SUBSTITUTE — add ' + spec.partNum + ' (x' + spec.qty + ', type ' + spec.typeId + ')  +  remove WOItem ' + removeId + '\\n' +\r\n          'AddWorkOrderItemRs=' + aS.statusCode + '  ' + (aS.statusMessage || '') + '\\n' +\r\n          'SaveWorkOrderRs(remove)=' + r.statusCode + '  ' + (r.statusMessage || '') + '\\n' +\r\n          'Result: add ' + (addedOk ? '[ADDED]' : '[not added]') + ' · remove ' + (removedOk ? '[REMOVED]' : '[still present]') + '\\n\\n' +\r\n          subDiff(dbBefore, dbAfter);\r\n        msg.textContent = 'Substitute done — see the report.';\r\n        subLoadItems();\r\n      } catch (e) { msg.textContent = 'ERR: ' + (e && e.message || e); }\r\n    }\r\n\r\n    loadWo();\r\n    subInit();\r\n  </script>\r\n</body>\r\n</html>\r\n",
  "active" : true,
  "note" : "",
  "type" : "Page"
} ]