[ {
  "name" : "Production Scheduler",
  "description" : "Production Scheduler",
  "data" : "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n  <meta charset=\"UTF-8\" />\r\n  <title>Production Scheduler</title>\r\n  <style>\r\n    *{box-sizing:border-box;margin:0;padding:0}\r\n    body{font-family:sans-serif;background:#f1f5f9;color:#1e293b;font-size:13px;display:flex;flex-direction:column;min-height:100vh}\r\n\r\n    /* Header */\r\n    .hdr{background:#1e293b;color:#fff;padding:10px 18px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}\r\n    .hdr-title{font-size:15px;font-weight:700}\r\n    .hdr-sub{font-size:11px;color:#94a3b8;margin-top:1px}\r\n    .hdr-right{display:flex;gap:8px;align-items:center}\r\n    .btn{padding:6px 13px;border-radius:6px;border:none;cursor:pointer;font-size:12px;font-weight:600}\r\n    .btn-ghost{background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.2)}\r\n    .btn-primary{background:#3b82f6;color:#fff}\r\n    .btn-success{background:#22c55e;color:#fff}\r\n    .btn-warn{background:#f59e0b;color:#fff}\r\n    .btn:hover{opacity:.85}\r\n\r\n    /* Metrics */\r\n    .metrics{display:flex;gap:8px;padding:10px 18px;flex-shrink:0;flex-wrap:wrap}\r\n    .metric{background:#fff;border-radius:8px;padding:8px 14px;flex:1;min-width:110px;border-left:3px solid #e2e8f0}\r\n    .metric.red{border-left-color:#ef4444}.metric.amber{border-left-color:#f59e0b}\r\n    .metric.blue{border-left-color:#3b82f6}.metric.green{border-left-color:#22c55e}\r\n    .metric-val{font-size:22px;font-weight:700;color:#1e293b}\r\n    .metric.red .metric-val{color:#dc2626}.metric.amber .metric-val{color:#d97706}.metric.green .metric-val{color:#16a34a}\r\n    .metric-lbl{font-size:10px;color:#64748b;margin-top:1px}\r\n\r\n    /* Toolbar */\r\n    .toolbar{display:flex;gap:8px;padding:6px 18px;align-items:center;flex-wrap:wrap;background:#fff;border-bottom:1px solid #e2e8f0;flex-shrink:0}\r\n    .pill{padding:3px 11px;border-radius:99px;border:1px solid #e2e8f0;background:#fff;color:#475569;cursor:pointer;font-size:11px;font-weight:600}\r\n    .pill.active{background:#eff6ff;color:#1d4ed8;border-color:#93c5fd}\r\n    .search-box{padding:4px 10px;border-radius:6px;border:1px solid #e2e8f0;font-size:12px;width:170px}\r\n    .auto-btn{background:#7c3aed;color:#fff;border:none;padding:5px 14px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:700}\r\n    .auto-btn:hover{background:#6d28d9}\r\n    .days-input{width:50px;padding:4px 6px;border-radius:6px;border:1px solid #e2e8f0;font-size:12px;text-align:center}\r\n\r\n    /* Layout */\r\n    .layout{display:flex;flex:1;overflow:hidden}\r\n\r\n    /* Sidebar */\r\n    .sidebar{width:220px;min-width:220px;background:#fff;border-right:1px solid #e2e8f0;display:flex;flex-direction:column;overflow:hidden}\r\n    .sb-hdr{padding:8px 12px;font-size:11px;font-weight:700;color:#475569;border-bottom:1px solid #e2e8f0;background:#f8fafc;display:flex;align-items:center;justify-content:space-between}\r\n    .sb-count{background:#fee2e2;color:#b91c1c;border-radius:99px;padding:1px 6px;font-size:10px;font-weight:700}\r\n    .sb-list{flex:1;overflow-y:auto;padding:6px}\r\n    .uc{background:#fafafa;border:1px solid #e2e8f0;border-radius:6px;padding:7px 9px;margin-bottom:5px;cursor:grab}\r\n    .uc:hover{border-color:#93c5fd;background:#eff6ff}\r\n    .uc.dragging{opacity:.35}\r\n    .uc-num{font-weight:700;font-size:12px;color:#1e293b}\r\n    .uc-desc{color:#64748b;font-size:10px;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\r\n    .uc-meta{display:flex;gap:5px;margin-top:4px;align-items:center;flex-wrap:wrap}\r\n    .dur-badge{background:#e0f2fe;color:#0369a1;font-size:9px;font-weight:700;padding:1px 5px;border-radius:4px}\r\n    .pri-badge{font-size:9px;font-weight:700;padding:1px 5px;border-radius:99px}\r\n    .ph{background:#fee2e2;color:#991b1b}.pn{background:#f1f5f9;color:#475569}.pl{background:#f0fdf4;color:#166534}\r\n\r\n    /* Scheduler */\r\n    .scheduler{flex:1;overflow:auto}\r\n    .sched-inner{min-width:700px}\r\n\r\n    /* Day header */\r\n    .day-hdr{display:flex;position:sticky;top:0;z-index:10;background:#1e293b}\r\n    .line-col-hdr{width:150px;min-width:150px;padding:8px 10px;font-size:10px;font-weight:600;color:#94a3b8;border-right:1px solid #334155}\r\n    .day-hdr-cell{flex:1;min-width:100px;text-align:center;padding:5px 4px;border-right:1px solid #334155;font-size:10px}\r\n    .day-hdr-cell.today-hdr{background:#1d4ed8}\r\n    .dname{font-weight:700;color:#fff}\r\n    .ddate{color:#94a3b8;margin-top:1px}\r\n    .day-hdr-cell.today-hdr .ddate{color:#bfdbfe}\r\n\r\n    /* Grid */\r\n    .grid-row{display:flex;border-bottom:1px solid #e2e8f0;min-height:90px}\r\n    .line-lbl{width:150px;min-width:150px;padding:8px 10px;border-right:1px solid #e2e8f0;background:#f8fafc;display:flex;flex-direction:column;justify-content:center}\r\n    .ln{font-weight:700;font-size:11px;color:#1e293b}\r\n    .lcap{font-size:10px;color:#94a3b8;margin-top:2px}\r\n    .lutil{font-size:10px;margin-top:3px;font-weight:600}\r\n    .day-slot{flex:1;min-width:100px;padding:3px;border-right:1px solid #e2e8f0;position:relative;vertical-align:top}\r\n    .day-slot.today-col{background:#eff6ff}\r\n    .day-slot.drop-target{background:#dbeafe;border:2px dashed #3b82f6}\r\n    .slot-bar{height:4px;border-radius:2px;margin-bottom:3px;background:#e2e8f0}\r\n    .slot-fill{height:100%;border-radius:2px;transition:width .3s}\r\n    .cap-ok{background:#22c55e}.cap-warn{background:#f59e0b}.cap-over{background:#ef4444}\r\n\r\n    /* MO Cards in grid - resizable */\r\n    .mo-card{border-radius:5px;padding:4px 6px;margin-bottom:3px;cursor:grab;border:1px solid transparent;position:relative;user-select:none}\r\n    .mo-card:hover{filter:brightness(.95)}\r\n    .mo-card.dragging{opacity:.3}\r\n    .mo-card.s-entered{background:#dbeafe;border-color:#93c5fd;color:#1e40af}\r\n    .mo-card.s-issued{background:#dcfce7;border-color:#86efac;color:#166534}\r\n    .mo-card.s-overdue{background:#fee2e2;border-color:#fca5a5;color:#991b1b}\r\n    .mc-num{font-weight:700;font-size:11px}\r\n    .mc-desc{font-size:10px;opacity:.8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\r\n    .mc-dur{font-size:9px;opacity:.7}\r\n    .mc-remove{position:absolute;top:2px;right:3px;background:none;border:none;cursor:pointer;font-size:11px;opacity:0;color:inherit}\r\n    .mo-card:hover .mc-remove{opacity:.7}\r\n    .resize-handle{position:absolute;bottom:0;right:0;width:10px;height:10px;cursor:se-resize;opacity:.4}\r\n    .resize-handle:hover{opacity:1}\r\n    .resize-handle::after{content:'◢';font-size:9px;position:absolute;bottom:-1px;right:0px}\r\n    .empty-slot{color:#cbd5e1;font-size:10px;text-align:center;padding:6px 2px;pointer-events:none}\r\n\r\n    /* Save panel */\r\n    .save-panel{display:flex;position:fixed;bottom:0;left:0;right:0;background:#1e293b;color:#fff;padding:10px 20px;align-items:center;justify-content:space-between;border-top:2px solid #3b82f6;z-index:50}\r\n    .save-panel-hidden{opacity:0;pointer-events:none}\r\n    .pending-info{font-size:12px}\r\n    .pending-info strong{color:#60a5fa}\r\n    .save-actions{display:flex;gap:8px;align-items:center}\r\n\r\n    /* Issue dialog */\r\n    .overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:500;align-items:center;justify-content:center}\r\n    .overlay.show{display:flex}\r\n    .dialog{background:#fff;border-radius:12px;padding:24px;width:420px;max-width:90vw}\r\n    .dlg-title{font-size:16px;font-weight:700;margin-bottom:8px}\r\n    .dlg-sub{font-size:13px;color:#475569;margin-bottom:20px;line-height:1.5}\r\n    .dlg-actions{display:flex;gap:10px;justify-content:flex-end}\r\n    .dlg-btn{padding:8px 18px;border-radius:7px;border:none;cursor:pointer;font-size:13px;font-weight:600}\r\n    .dlg-cancel{background:#f1f5f9;color:#475569}\r\n    .dlg-save-only{background:#3b82f6;color:#fff}\r\n    .dlg-save-issue{background:#22c55e;color:#fff}\r\n\r\n    /* Toast */\r\n    #toast{position:fixed;top:16px;right:16px;z-index:999;padding:9px 16px;border-radius:8px;font-size:13px;font-weight:600;display:none;box-shadow:0 4px 14px rgba(0,0,0,.15)}\r\n    #toast.s{background:#22c55e;color:#fff}#toast.e{background:#ef4444;color:#fff}#toast.i{background:#3b82f6;color:#fff}\r\n\r\n    /* Loading */\r\n    #loading{position:fixed;inset:0;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;font-size:14px;color:#3b82f6;font-weight:600;z-index:300;flex-direction:column;gap:10px}\r\n    .spinner{width:24px;height:24px;border:2px solid #bfdbfe;border-top-color:#3b82f6;border-radius:50%;animation:spin .7s linear infinite}\r\n    @keyframes spin{to{transform:rotate(360deg)}}\r\n    #load-msg{color:#64748b;font-size:12px}\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n<div id=\"loading\">\r\n  <div class=\"spinner\"></div>\r\n  <div>Loading production data…</div>\r\n  <div id=\"load-msg\"></div>\r\n</div>\r\n<div id=\"toast\"></div>\r\n\r\n<!-- Issue Dialog -->\r\n<div class=\"overlay\" id=\"issue-overlay\">\r\n  <div class=\"dialog\">\r\n    <div class=\"dlg-title\">Save schedule to Fishbowl</div>\r\n    <div class=\"dlg-sub\" id=\"dlg-body\">You have pending schedule changes. Would you like to also issue all newly scheduled orders to lock them into production?</div>\r\n    <div class=\"dlg-actions\">\r\n      <button class=\"dlg-btn dlg-cancel\" onclick=\"closeDialog()\">Cancel</button>\r\n      <button class=\"dlg-btn dlg-save-only\" onclick=\"executeSave(false)\">Save dates only</button>\r\n      <button class=\"dlg-btn dlg-save-issue\" onclick=\"executeSave(true)\">Save &amp; Issue all</button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"hdr\">\r\n  <div>\r\n    <div class=\"hdr-title\">⚙ Production Scheduler</div>\r\n    <div class=\"hdr-sub\" id=\"hdr-sub\">Intelligent auto-scheduling · drag to adjust · save writes back to Fishbowl</div>\r\n  </div>\r\n  <div class=\"hdr-right\">\r\n    <button class=\"btn btn-ghost\" onclick=\"reload()\">↺ Refresh</button>\r\n    <button class=\"btn btn-primary\" onclick=\"openModule('Manufacture Order','')\">MO Module</button>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"metrics\" id=\"metrics\"></div>\r\n\r\n<div class=\"toolbar\">\r\n  <button class=\"pill active\" onclick=\"setFilter('all',this)\">All open</button>\r\n  <button class=\"pill\" onclick=\"setFilter('entered',this)\">Entered</button>\r\n  <button class=\"pill\" onclick=\"setFilter('issued',this)\">Issued</button>\r\n  <button class=\"pill\" onclick=\"setFilter('overdue',this)\">Overdue</button>\r\n  <input class=\"search-box\" id=\"search\" placeholder=\"Search MO # or part…\" oninput=\"renderAll()\"/>\r\n  <span style=\"margin-left:8px;font-size:11px;color:#64748b;\">Days:</span>\r\n  <input class=\"days-input\" id=\"days-ahead\" type=\"number\" value=\"7\" min=\"3\" max=\"30\" onchange=\"renderAll()\"/>\r\n  <button class=\"auto-btn\" onclick=\"autoSchedule()\">✦ Auto-Schedule</button>\r\n</div>\r\n\r\n<div class=\"layout\">\r\n  <div class=\"sidebar\">\r\n    <div class=\"sb-hdr\">\r\n      Unscheduled\r\n      <span class=\"sb-count\" id=\"sb-count\">0</span>\r\n    </div>\r\n    <div class=\"sb-list\" id=\"sb-list\"\r\n      ondragover=\"event.preventDefault()\"\r\n      ondrop=\"dropToSidebar(event)\">\r\n    </div>\r\n  </div>\r\n  <div class=\"scheduler\" id=\"scheduler\"></div>\r\n</div>\r\n\r\n<div class=\"save-panel\" id=\"save-panel\" style=\"opacity:0;pointer-events:none;\">\r\n  <div class=\"pending-info\"><strong id=\"pending-num\">0</strong> unsaved changes</div>\r\n  <div class=\"save-actions\">\r\n    <button class=\"btn btn-ghost\" onclick=\"discardChanges()\">Discard</button>\r\n    <button class=\"btn btn-success\" onclick=\"openSaveDialog()\">\uD83D\uDCBE Save to Fishbowl</button>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\n// ═══════════════════════════════════════════\r\n// CONFIG — update with AdaptiveAir's real lines\r\n// ═══════════════════════════════════════════\r\n// categoryId maps to calcategory.id in Fishbowl — check your Setup > Calendar Categories\r\n// for the real IDs. The demo database has \"Work Station 1\" = 100.\r\n// Add categoryId to each line so assignments write back to the MO's category field.\r\nconst LINES = [\r\n  { id: 1, name: \"Line A — HVAC Assembly\",     hoursPerDay: 8, categoryId: 100 },\r\n  { id: 2, name: \"Line B — Compressor\",         hoursPerDay: 8, categoryId: null },\r\n  { id: 3, name: \"Line C — Coil Fabrication\",   hoursPerDay: 8, categoryId: null },\r\n  { id: 4, name: \"Line D — Final Test\",         hoursPerDay: 4, categoryId: null },\r\n];\r\n\r\nconst WORK_START_HOUR = 7; // 7am\r\nconst DEFAULT_DURATION_HOURS = 4; // fallback if BOM has no estimatedDuration\r\n\r\n// ═══════════════════════════════════════════\r\n// STATE\r\n// ═══════════════════════════════════════════\r\nlet allMOs   = [];\r\nlet assignments = {}; // moId → { lineId, dayKey, durationHours }\r\nlet pendingChanges = {}; // moId → REST payload\r\nlet activeFilter = 'all';\r\nlet dragMoId = null;\r\nlet resizeMoId = null;\r\nlet resizeStartX = 0;\r\nlet resizeStartDur = 0;\r\n\r\n// ═══════════════════════════════════════════\r\n// HELPERS\r\n// ═══════════════════════════════════════════\r\nfunction getDays() {\r\n  const n = parseInt(document.getElementById('days-ahead')?.value || 7);\r\n  const days = [];\r\n  const t = new Date(); t.setHours(0,0,0,0);\r\n  for (let i = 0; i < n; i++) {\r\n    const d = new Date(t); d.setDate(t.getDate() + i);\r\n    days.push(d);\r\n  }\r\n  return days;\r\n}\r\nfunction dayKey(d){ return d.toISOString().split('T')[0]; }\r\nfunction isToday(d){ return dayKey(d) === dayKey(new Date()); }\r\nfunction isWeekend(d){ return d.getDay()===0||d.getDay()===6; }\r\nfunction isOverdue(mo){ return mo.datescheduled && new Date(mo.datescheduled)<new Date() && mo.statusid!==60; }\r\n\r\nfunction priorityScore(mo) {\r\n  // Lower = more urgent\r\n  // 1) explicit priority (1=High, 3=Normal, 5=Low)\r\n  const pri = mo.priorityid || 3;\r\n  // 2) SO due date pressure (days until due — negative = overdue)\r\n  const soUrgency = mo.soduedate\r\n    ? Math.max(-30, Math.min(30, Math.round((new Date(mo.soduedate)-new Date())/(1000*60*60*24))))\r\n    : 15;\r\n  // 3) date created (older = more urgent)\r\n  const ageDays = mo.datecreated\r\n    ? Math.round((new Date()-new Date(mo.datecreated))/(1000*60*60*24))\r\n    : 0;\r\n  return (pri * 10) + soUrgency - (ageDays * 0.1);\r\n}\r\n\r\nfunction durationHours(mo) {\r\n  if (assignments[mo.id]?.durationHours) return assignments[mo.id].durationHours;\r\n  if (mo.estimatedduration) return Math.max(0.5, mo.estimatedduration / 60);\r\n  return DEFAULT_DURATION_HOURS;\r\n}\r\n\r\nfunction toISO(date) {\r\n  const p = n => String(n).padStart(2,'0');\r\n  const off = -date.getTimezoneOffset();\r\n  const sign = off>=0?'+':'-';\r\n  const h = Math.floor(Math.abs(off)/60), m = Math.abs(off)%60;\r\n  return `${date.getFullYear()}-${p(date.getMonth()+1)}-${p(date.getDate())}T${p(WORK_START_HOUR)}:00:00.000${sign}${p(h)}${p(m)}`;\r\n}\r\n\r\n// Hours already booked on a line for a given day\r\nfunction hoursBooked(lineId, dk, excludeMoId=null) {\r\n  return Object.entries(assignments)\r\n    .filter(([moId, a]) => a.lineId===lineId && a.dayKey===dk && parseInt(moId)!==excludeMoId)\r\n    .reduce((sum,[moId]) => {\r\n      const mo = allMOs.find(m=>m.id===parseInt(moId));\r\n      return sum + (mo ? durationHours(mo) : 0);\r\n    }, 0);\r\n}\r\n\r\nfunction lineCapacity(line) { return line.hoursPerDay; }\r\n\r\n// ═══════════════════════════════════════════\r\n// LOAD\r\n// ═══════════════════════════════════════════\r\nasync function reload() {\r\n  setLoadMsg('Querying manufacture orders…');\r\n  document.getElementById('loading').style.display='flex';\r\n  try {\r\n    const rows = await runQueryAsync(`\r\n      SELECT\r\n        mo.id                     AS moid,\r\n        mo.num                    AS monum,\r\n        mo.statusId               AS statusid,\r\n        mo.dateScheduled          AS datescheduled,\r\n        mo.dateCreated            AS datecreated,\r\n        mo.locationGroupId        AS locationgroupid,\r\n        lg.name                   AS lgname,\r\n        moi.id                    AS moitemid,\r\n        moi.description           AS description,\r\n        moi.qtyToFulfill          AS qtytofulfill,\r\n        moi.priorityId            AS priorityid,\r\n        moi.dateScheduled         AS itemdate,\r\n        moi.dateScheduledToStart  AS itemstart,\r\n        moi.bomId                 AS bomid,\r\n        b.estimatedDuration       AS estimatedduration,\r\n        s.dateFirstShip              AS soduedate\r\n      FROM mo\r\n      JOIN moitem moi ON moi.moId = mo.id AND moi.typeId = 50\r\n      JOIN locationgroup lg ON lg.id = mo.locationGroupId\r\n      LEFT JOIN bom b ON b.id = moi.bomId\r\n      LEFT JOIN \\`so\\` s ON s.id = mo.soId\r\n      WHERE mo.statusId IN (10, 20, 50)\r\n      ORDER BY mo.dateScheduled ASC, mo.num ASC\r\n      LIMIT 300\r\n    `);\r\n\r\n    allMOs = rows.map(r => ({\r\n      id:                 r.moid,\r\n      num:                r.monum,\r\n      statusid:           r.statusid,\r\n      datescheduled:      r.datescheduled,\r\n      datecreated:        r.datecreated,\r\n      locationgroupid:    r.locationgroupid,\r\n      lgname:             r.lgname,\r\n      moitemid:           r.moitemid,\r\n      description:        r.description,\r\n      qtytofulfill:       r.qtytofulfill,\r\n      priorityid:         r.priorityid,\r\n      itemdate:           r.itemdate,\r\n      itemstart:          r.itemstart,\r\n      bomid:              r.bomid,\r\n      estimatedduration:  r.estimatedduration,\r\n      soduedate:          r.soduedate,\r\n    }));\r\n\r\n    // Restore saved assignments\r\n    const saved = loadSettings('adaptiveair_sched_v2');\r\n    assignments = saved ? JSON.parse(saved) : {};\r\n\r\n    renderAll();\r\n    showToast(`Loaded ${allMOs.length} open MOs`, 'i');\r\n  } catch(e) {\r\n    showToast('Load error: ' + e.message, 'e');\r\n  }\r\n  document.getElementById('loading').style.display='none';\r\n}\r\n\r\nfunction setLoadMsg(msg){ document.getElementById('load-msg').textContent=msg; }\r\n\r\n// ═══════════════════════════════════════════\r\n// AUTO-SCHEDULE\r\n// ═══════════════════════════════════════════\r\nfunction autoSchedule() {\r\n  const unscheduled = allMOs\r\n    .filter(mo => !assignments[mo.id] && mo.statusid !== 60)\r\n    .sort((a,b) => priorityScore(a) - priorityScore(b)); // lowest score = most urgent first\r\n\r\n  if (unscheduled.length === 0) {\r\n    showToast('All orders are already scheduled', 'i');\r\n    return;\r\n  }\r\n\r\n  const days = getDays().filter(d => !isWeekend(d));\r\n  let scheduled = 0;\r\n\r\n  for (const mo of unscheduled) {\r\n    const dur = durationHours(mo);\r\n    let placed = false;\r\n\r\n    // Try each day, each line — find first slot with capacity\r\n    for (const day of days) {\r\n      if (placed) break;\r\n      const dk = dayKey(day);\r\n      for (const line of LINES) {\r\n        const booked = hoursBooked(line.id, dk);\r\n        const cap = lineCapacity(line);\r\n        if (booked + dur <= cap) {\r\n          const sDate = new Date(day); sDate.setHours(WORK_START_HOUR,0,0,0);\r\n          assignments[mo.id] = { lineId: line.id, dayKey: dk, durationHours: dur };\r\n          pendingChanges[mo.id] = {\r\n            moId:                 mo.id,\r\n            moNum:                mo.num,\r\n            moItemId:             mo.moitemid,\r\n            dateScheduled:        toISO(sDate),\r\n            dateScheduledToStart: toISO(sDate),\r\n          };\r\n          placed = true;\r\n          scheduled++;\r\n          break;\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  saveSettings('adaptiveair_sched_v2', JSON.stringify(assignments));\r\n  updateSavePanel();\r\n  renderAll();\r\n  showToast(`Auto-scheduled ${scheduled} of ${unscheduled.length} orders`, 's');\r\n  if (scheduled < unscheduled.length) {\r\n    showToast(`${unscheduled.length - scheduled} orders couldn't fit — extend days range`, 'e');\r\n  }\r\n}\r\n\r\n// ═══════════════════════════════════════════\r\n// RENDER\r\n// ═══════════════════════════════════════════\r\nfunction renderAll() { renderMetrics(); renderGrid(); }\r\n\r\nfunction renderMetrics() {\r\n  const overdue    = allMOs.filter(isOverdue).length;\r\n  const unsched    = allMOs.filter(mo=>!assignments[mo.id]).length;\r\n  const sched      = allMOs.filter(mo=>assignments[mo.id]).length;\r\n  const issued     = allMOs.filter(mo=>mo.statusid===20).length;\r\n  document.getElementById('metrics').innerHTML = `\r\n    <div class=\"metric red\"><div class=\"metric-val\">${overdue}</div><div class=\"metric-lbl\">Overdue</div></div>\r\n    <div class=\"metric amber\"><div class=\"metric-val\">${unsched}</div><div class=\"metric-lbl\">Unscheduled</div></div>\r\n    <div class=\"metric blue\"><div class=\"metric-val\">${sched}</div><div class=\"metric-lbl\">Scheduled</div></div>\r\n    <div class=\"metric green\"><div class=\"metric-val\">${issued}</div><div class=\"metric-lbl\">Issued</div></div>\r\n  `;\r\n}\r\n\r\nfunction filteredMOs() {\r\n  const q = (document.getElementById('search')?.value||'').toLowerCase();\r\n  return allMOs.filter(mo=>{\r\n    if (activeFilter==='entered' && mo.statusid!==10) return false;\r\n    if (activeFilter==='issued'  && mo.statusid!==20) return false;\r\n    if (activeFilter==='overdue' && !isOverdue(mo))   return false;\r\n    if (q && !mo.num.toLowerCase().includes(q) && !(mo.description||'').toLowerCase().includes(q)) return false;\r\n    return true;\r\n  });\r\n}\r\n\r\nfunction renderGrid() {\r\n  const days = getDays();\r\n  const mos  = filteredMOs();\r\n\r\n  // Sidebar\r\n  const unsched = mos.filter(mo=>!assignments[mo.id]);\r\n  document.getElementById('sb-count').textContent = unsched.length;\r\n  document.getElementById('sb-list').innerHTML = unsched.length===0\r\n    ? '<div style=\"text-align:center;color:#94a3b8;padding:14px;font-size:11px;\">All orders scheduled ✓</div>'\r\n    : unsched.map(sbCard).join('');\r\n\r\n  // Grid\r\n  const hdrCells = days.map(d=>`\r\n    <div class=\"day-hdr-cell ${isToday(d)?'today-hdr':''} ${isWeekend(d)?'style=\"opacity:.5\"':''}\">\r\n      <div class=\"dname\">${d.toLocaleDateString('en-US',{weekday:'short'})}</div>\r\n      <div class=\"ddate\">${d.toLocaleDateString('en-US',{month:'short',day:'numeric'})}</div>\r\n    </div>`).join('');\r\n\r\n  let html=`<div class=\"sched-inner\"><div class=\"day-hdr\"><div class=\"line-col-hdr\">Line</div>${hdrCells}</div>`;\r\n\r\n  LINES.forEach(line=>{\r\n    const slots = days.map(d=>{\r\n      const dk = dayKey(d);\r\n      const booked = hoursBooked(line.id, dk);\r\n      const cap = lineCapacity(line);\r\n      const pct = Math.min(100, Math.round((booked/cap)*100));\r\n      const fillClass = pct>=100?'cap-over':pct>=75?'cap-warn':'cap-ok';\r\n      const mosHere = mos.filter(mo=>assignments[mo.id]?.lineId===line.id && assignments[mo.id]?.dayKey===dk);\r\n      const cards = mosHere.map(mo=>gridCard(mo)).join('');\r\n      const empty = mosHere.length===0 ? `<div class=\"empty-slot\">Drop here</div>` : '';\r\n      return `\r\n        <div class=\"day-slot ${isToday(d)?'today-col':''}\"\r\n          ondragover=\"dragOver(event)\"\r\n          ondragleave=\"dragLeave(event)\"\r\n          ondrop=\"dropOnSlot(event,${line.id},'${dk}')\">\r\n          <div class=\"slot-bar\"><div class=\"slot-fill ${fillClass}\" style=\"width:${pct}%\"></div></div>\r\n          ${cards}${empty}\r\n        </div>`;\r\n    }).join('');\r\n\r\n    const totalBooked = days.reduce((s,d)=>s+hoursBooked(line.id,dayKey(d)),0);\r\n    const utilPct = days.length>0 ? Math.round(totalBooked/(days.length*line.hoursPerDay)*100) : 0;\r\n    const utilColor = utilPct>=90?'#dc2626':utilPct>=60?'#d97706':'#16a34a';\r\n\r\n    html+=`\r\n      <div class=\"grid-row\">\r\n        <div class=\"line-lbl\">\r\n          <div class=\"ln\">${line.name}</div>\r\n          <div class=\"lcap\">${line.hoursPerDay}h/day</div>\r\n          <div class=\"lutil\" style=\"color:${utilColor}\">${utilPct}% utilised</div>\r\n        </div>\r\n        ${slots}\r\n      </div>`;\r\n  });\r\n\r\n  html+='</div>';\r\n  document.getElementById('scheduler').innerHTML = html;\r\n\r\n  // Attach drag listeners to sidebar cards\r\n  document.querySelectorAll('.uc').forEach(el=>{\r\n    el.addEventListener('dragstart',e=>{\r\n      dragMoId=parseInt(el.dataset.moid);\r\n      el.classList.add('dragging');\r\n      e.dataTransfer.effectAllowed='move';\r\n    });\r\n    el.addEventListener('dragend',()=>el.classList.remove('dragging'));\r\n  });\r\n\r\n  // Attach drag + resize to grid cards\r\n  document.querySelectorAll('.mo-card').forEach(el=>{\r\n    el.setAttribute('draggable','true');\r\n    el.addEventListener('dragstart',e=>{\r\n      if (e.target.classList.contains('resize-handle')) { e.preventDefault(); return; }\r\n      dragMoId=parseInt(el.dataset.moid);\r\n      el.classList.add('dragging');\r\n      e.dataTransfer.effectAllowed='move';\r\n    });\r\n    el.addEventListener('dragend',()=>el.classList.remove('dragging'));\r\n  });\r\n\r\n  // Resize handles\r\n  document.querySelectorAll('.resize-handle').forEach(handle=>{\r\n    handle.addEventListener('mousedown',e=>{\r\n      e.preventDefault();\r\n      e.stopPropagation();\r\n      resizeMoId = parseInt(handle.dataset.moid);\r\n      resizeStartX = e.clientX;\r\n      const mo = allMOs.find(m=>m.id===resizeMoId);\r\n      resizeStartDur = durationHours(mo);\r\n    });\r\n  });\r\n}\r\n\r\nfunction sbCard(mo) {\r\n  const dur = durationHours(mo);\r\n  const pri = mo.priorityid<=1?'ph':mo.priorityid>=5?'pl':'pn';\r\n  const priLbl = mo.priorityid<=1?'High':mo.priorityid>=5?'Low':'Normal';\r\n  const od = isOverdue(mo)?'style=\"border-color:#fca5a5;background:#fff5f5;\"':'';\r\n  return `\r\n    <div class=\"uc\" draggable=\"true\" data-moid=\"${mo.id}\" ${od}>\r\n      <div class=\"uc-num\">${mo.num}${isOverdue(mo)?' ⚠':''}</div>\r\n      <div class=\"uc-desc\">${mo.description||'—'}</div>\r\n      <div class=\"uc-meta\">\r\n        <span class=\"dur-badge\">${dur}h</span>\r\n        <span class=\"pri-badge ${pri}\">${priLbl}</span>\r\n        ${mo.soduedate?`<span style=\"font-size:9px;color:#64748b;\">SO due ${new Date(mo.soduedate).toLocaleDateString('en-US',{month:'short',day:'numeric'})}</span>`:''}\r\n      </div>\r\n    </div>`;\r\n}\r\n\r\nfunction gridCard(mo) {\r\n  const dur = durationHours(mo);\r\n  const cls = isOverdue(mo)?'s-overdue':mo.statusid===20?'s-issued':'s-entered';\r\n  return `\r\n    <div class=\"mo-card ${cls}\" data-moid=\"${mo.id}\"\r\n      title=\"${mo.num} — ${mo.description||''}\\n${dur}h · Qty: ${Math.round(mo.qtytofulfill||0)}${mo.soduedate?'\\nSO due: '+new Date(mo.soduedate).toLocaleDateString():''}\">\r\n      <button class=\"mc-remove\" onclick=\"event.stopPropagation();removeAssign(${mo.id})\" title=\"Unschedule\">✕</button>\r\n      <div class=\"mc-num\" onclick=\"openModule('Manufacture Order','${mo.num}')\">${mo.num}</div>\r\n      <div class=\"mc-desc\">${mo.description||'—'}</div>\r\n      <div class=\"mc-dur\">⏱ ${dur}h · Qty ${Math.round(mo.qtytofulfill||0)}</div>\r\n      <div class=\"resize-handle\" data-moid=\"${mo.id}\"></div>\r\n    </div>`;\r\n}\r\n\r\n// ═══════════════════════════════════════════\r\n// RESIZE (mouse drag to adjust duration)\r\n// ═══════════════════════════════════════════\r\ndocument.addEventListener('mousemove', e=>{\r\n  if (!resizeMoId) return;\r\n  const dx = e.clientX - resizeStartX;\r\n  // Each ~30px = 0.5h increment\r\n  const delta = Math.round(dx / 30) * 0.5;\r\n  const newDur = Math.max(0.5, Math.min(24, resizeStartDur + delta));\r\n  if (!assignments[resizeMoId]) return;\r\n  assignments[resizeMoId].durationHours = newDur;\r\n  // Update pending change duration note\r\n  if (pendingChanges[resizeMoId]) pendingChanges[resizeMoId].durationHours = newDur;\r\n  renderGrid();\r\n});\r\ndocument.addEventListener('mouseup', ()=>{\r\n  if (resizeMoId) {\r\n    saveSettings('adaptiveair_sched_v2', JSON.stringify(assignments));\r\n    resizeMoId=null;\r\n  }\r\n});\r\n\r\n// ═══════════════════════════════════════════\r\n// DRAG & DROP\r\n// ═══════════════════════════════════════════\r\nfunction dragOver(e) { e.preventDefault(); e.currentTarget.classList.add('drop-target'); }\r\nfunction dragLeave(e) { e.currentTarget.classList.remove('drop-target'); }\r\n\r\nfunction dropOnSlot(e, lineId, dk) {\r\n  e.preventDefault();\r\n  e.currentTarget.classList.remove('drop-target');\r\n  if (!dragMoId) return;\r\n  const mo = allMOs.find(m=>m.id===dragMoId);\r\n  if (!mo) return;\r\n\r\n  const dur = assignments[dragMoId]?.durationHours || durationHours(mo);\r\n  assignments[dragMoId] = { lineId, dayKey: dk, durationHours: dur };\r\n\r\n  const [y,mo2,d] = dk.split('-').map(Number);\r\n  const sDate = new Date(y,mo2-1,d,WORK_START_HOUR,0,0);\r\n  pendingChanges[dragMoId] = {\r\n    moId:     dragMoId,\r\n    moNum:    mo.num,\r\n    moItemId: mo.moitemid,\r\n    dateScheduled:        toISO(sDate),\r\n    dateScheduledToStart: toISO(sDate),\r\n  };\r\n\r\n  dragMoId=null;\r\n  saveSettings('adaptiveair_sched_v2', JSON.stringify(assignments));\r\n  updateSavePanel();\r\n  renderAll();\r\n}\r\n\r\nfunction dropToSidebar(e) {\r\n  e.preventDefault();\r\n  if (dragMoId) { removeAssign(dragMoId); dragMoId=null; }\r\n}\r\n\r\nfunction removeAssign(moId) {\r\n  delete assignments[moId];\r\n  delete pendingChanges[moId];\r\n  saveSettings('adaptiveair_sched_v2', JSON.stringify(assignments));\r\n  updateSavePanel();\r\n  renderAll();\r\n}\r\n\r\n// ═══════════════════════════════════════════\r\n// SAVE\r\n// ═══════════════════════════════════════════\r\nfunction updateSavePanel() {\r\n  const n = Object.keys(pendingChanges).length;\r\n  document.getElementById('pending-num').textContent = n;\r\n  const panel = document.getElementById('save-panel');\r\n  if (n > 0) {\r\n    panel.style.opacity = '1';\r\n    panel.style.pointerEvents = 'auto';\r\n  } else {\r\n    panel.style.opacity = '0';\r\n    panel.style.pointerEvents = 'none';\r\n  }\r\n}\r\n\r\nfunction openSaveDialog() {\r\n  const n = Object.keys(pendingChanges).length;\r\n  const entered = Object.values(pendingChanges).filter(c=>{\r\n    const mo = allMOs.find(m=>m.id===c.moId);\r\n    return mo && mo.statusid===10;\r\n  }).length;\r\n  document.getElementById('dlg-body').innerHTML =\r\n    `You have <strong>${n}</strong> order(s) with schedule changes.<br><br>` +\r\n    `<strong>${entered}</strong> are in <em>Entered</em> status and can be issued to lock them into production.<br><br>` +\r\n    `Would you like to save dates only, or save and issue all entered orders?`;\r\n  document.getElementById('issue-overlay').classList.add('show');\r\n}\r\n\r\nfunction closeDialog() {\r\n  document.getElementById('issue-overlay').classList.remove('show');\r\n}\r\n\r\nasync function executeSave(issueAfter) {\r\n  closeDialog();\r\n  const changes = Object.values(pendingChanges);\r\n  showToast(`Saving ${changes.length} change(s)…`, 'i');\r\n\r\n  let saved=0, issued=0, failed=0;\r\n\r\n  for (const change of changes) {\r\n    try {\r\n      // GET current MO\r\n      const current = await runRestApiAsync({ path:`/api/manufacture-orders/${change.moId}`, method:'GET' });\r\n      if (!current?.configurations) throw new Error('No config data returned');\r\n\r\n      // Build category from assigned line if it has a categoryId defined\r\n      const assignment = assignments[change.moId];\r\n      const line = assignment ? LINES.find(l=>l.id===assignment.lineId) : null;\r\n\r\n      // Update dateScheduled and optionally category on all configurations\r\n      const updatedConfigs = current.configurations.map(cfg=>({\r\n        ...cfg,\r\n        dateScheduled:        change.dateScheduled,\r\n        dateScheduledToStart: change.dateScheduledToStart,\r\n        ...(line?.categoryId ? { category: { id: line.categoryId } } : {}),\r\n      }));\r\n\r\n      // POST update — id required in body to match URL\r\n      await runRestApiAsync({\r\n        path:   `/api/manufacture-orders/${change.moId}`,\r\n        method: 'POST',\r\n        body:   JSON.stringify({\r\n          id:             current.id,\r\n          number:         current.number,\r\n          note:           current.note||'',\r\n          dateScheduled:  change.dateScheduled,\r\n          configurations: updatedConfigs,\r\n        }),\r\n      });\r\n      saved++;\r\n\r\n      // Issue if requested and status is Entered\r\n      if (issueAfter) {\r\n        const mo = allMOs.find(m=>m.id===change.moId);\r\n        if (mo && mo.statusid===10) {\r\n          await runRestApiAsync({\r\n            path:   `/api/manufacture-orders/${change.moId}/issue`,\r\n            method: 'POST',\r\n          });\r\n          mo.statusid = 20; // update local state\r\n          issued++;\r\n        }\r\n      }\r\n\r\n      delete pendingChanges[change.moId];\r\n      const mo = allMOs.find(m=>m.id===change.moId);\r\n      if (mo) mo.datescheduled = change.dateScheduled;\r\n\r\n    } catch(err) {\r\n      failed++;\r\n      console.error(`Failed MO ${change.moNum}:`, err);\r\n    }\r\n  }\r\n\r\n  updateSavePanel();\r\n  renderAll();\r\n\r\n  if (failed===0) {\r\n    showToast(`✓ ${saved} saved${issued>0?` · ${issued} issued`:''}`, 's');\r\n  } else {\r\n    showToast(`${saved} saved, ${issued} issued, ${failed} failed`, 'e');\r\n  }\r\n}\r\n\r\nfunction discardChanges() {\r\n  pendingChanges={};\r\n  updateSavePanel();\r\n  showToast('Changes discarded','i');\r\n}\r\n\r\n// ═══════════════════════════════════════════\r\n// FILTER / UTILS\r\n// ═══════════════════════════════════════════\r\nfunction setFilter(f,btn) {\r\n  activeFilter=f;\r\n  document.querySelectorAll('.pill').forEach(b=>b.classList.remove('active'));\r\n  btn.classList.add('active');\r\n  renderAll();\r\n}\r\n\r\nfunction showToast(msg,type='i') {\r\n  const t=document.getElementById('toast');\r\n  t.textContent=msg; t.className=type; t.style.display='block';\r\n  setTimeout(()=>t.style.display='none',3500);\r\n}\r\n\r\n// ═══════════════════════════════════════════\r\n// DEBUG\r\n// ═══════════════════════════════════════════\r\nfunction debugState() {\r\n  const panel = document.getElementById('save-panel');\r\n  const msg = [\r\n    'save-panel classes: ' + panel.className,\r\n    'save-panel display: ' + getComputedStyle(panel).display,\r\n    'pendingChanges count: ' + Object.keys(pendingChanges).length,\r\n    'assignments count: ' + Object.keys(assignments).length,\r\n    'allMOs count: ' + allMOs.length,\r\n    'pending keys: ' + Object.keys(pendingChanges).join(', '),\r\n  ].join('\\n');\r\n  alert(msg);\r\n}\r\n\r\n// ═══════════════════════════════════════════\r\n// INIT\r\n// ═══════════════════════════════════════════\r\n// Poll until Fishbowl's built-in functions are injected into the page,\r\n// then start the report. Avoids \"runQueryAsync is not defined\" on load.\r\nfunction waitForFishbowl() {\r\n  if (typeof runQueryAsync === 'function' && typeof runRestApiAsync === 'function') {\r\n    reload();\r\n  } else {\r\n    setTimeout(waitForFishbowl, 100);\r\n  }\r\n}\r\nwaitForFishbowl();\r\n</script>\r\n</body>\r\n</html>\r\n",
  "active" : true,
  "note" : "",
  "type" : "Page"
} ]