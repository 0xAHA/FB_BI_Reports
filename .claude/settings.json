{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/after-edit.js\"",
            "timeout": 60,
            "statusMessage": "Stamping, publishing and deploying"
          }
        ]
      }
    ]
  }
}
