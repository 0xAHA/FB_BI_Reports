<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Avalonia front end. Everything it knows about Fishbowl comes from
    FbApiTool.Core; this project draws and nothing else, which is the same
    arrangement the WPF app now has. The two are expected to coexist until
    this one reaches parity.

    net9.0, not net9.0-windows: that is the whole point.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FbApiTool</AssemblyName>
    <RootNamespace>FbApiTool.Ui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\fishbowl.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>Fishbowl API Tool</Product>
    <Company>Fishbowl</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\FbApiTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <!-- Inter is the face fb-styles names, and Avalonia ships it as a package,
         so the tool looks the same on a machine that has never seen it. -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />

    <!-- The results grid. A separate package in Avalonia, unlike WPF. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />

    <!-- The SQL editor. A port of AvalonEdit, and a real code editor: it
         brings the caret arithmetic, the completion window and the
         highlighting that SqlEditor.xaml.cs had to do by hand against a
         RichTextBox. This replacement should be smaller than what it
         replaces. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />

    <!-- The documentation tab. Wraps the platform's own browser — WebView2 on
         Windows, WebKitGTK on Linux — rather than bundling Chromium, which
         the CEF-based alternatives do at a cost of well over 100 MB for one
         tab that shows a local HTML file. Where neither is present the help
         opens in the system browser instead. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />

    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon is compiled in, not copied beside: Avalonia loads it
         through avares://, which works the same on every platform. -->
    <AvaloniaResource Include="..\assets\fishbowl.ico" Link="assets/fishbowl.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog and the API guide sit beside the executable, readable and
         replaceable by hand. Both are also embedded in the core library, so a
         copy of the executable on its own still works. -->
    <Content Include="..\assets\catalog.json" Link="assets\catalog.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\guide.html" Link="assets\guide.html"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
