<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FbApiTool.Ui"
             xmlns:core="clr-namespace:FbApiTool;assembly=FbApiTool.Core"
             x:Class="FbApiTool.Ui.RequestView">

    <Grid RowDefinitions="Auto,3*,4,2*" Background="{DynamicResource FbBg1}">

        <!-- ══ ENDPOINT BAR ═════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource FbBgPrimary}" CornerRadius="8" Margin="10,10,10,0"
                BorderBrush="{DynamicResource FbBorder}" BorderThickness="1" Padding="12,10">
            <StackPanel Spacing="8">
                <DockPanel>
                    <Border DockPanel.Dock="Left" x:Name="BadgeMethod" Classes="verb"
                            MinWidth="66" Padding="11,4" CornerRadius="3">
                        <TextBlock x:Name="TxtMethod" FontSize="12.5"/>
                    </Border>

                    <Button DockPanel.Dock="Right" x:Name="BtnSend" Classes="primary"
                            Content="Send" MinWidth="100" Margin="8,0,0,0"
                            ToolTip.Tip="Enter sends from any field. Inside the editors, Ctrl+Enter."/>
                    <Button DockPanel.Dock="Right" x:Name="BtnCopyAs" Classes="tool"
                            Content="Copy / paste ▾" Margin="8,0,0,0"
                            ToolTip.Tip="Copy this request out as a URL, a cURL command or a BI call — or fill the form in from a cURL command on the clipboard">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem x:Name="MnuCopyUrl" Header="URL"/>
                                <MenuItem x:Name="MnuCopyCurl" Header="cURL"
                                          ToolTip.Tip="The token is always replaced with &lt;TOKEN&gt;"/>
                                <MenuItem x:Name="MnuCopyBi" Header="runRestApiAsync (BI report)"/>
                                <Separator/>
                                <MenuItem x:Name="MnuPasteCurl" Header="Paste a cURL command"
                                          ToolTip.Tip="Read a cURL command off the clipboard and fill this form in from it"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button DockPanel.Dock="Right" x:Name="BtnSaveRequest" Classes="tool"
                            Content="Save" Margin="8,0,0,0"
                            ToolTip.Tip="Keep this request by name, with its {{variables}} intact"/>

                    <Button DockPanel.Dock="Right" x:Name="BtnRevertUrl" Classes="tool"
                            Content="Revert URL" Margin="8,0,0,0" IsVisible="False"
                            ToolTip.Tip="Go back to the URL built from the fields below"/>
                    <TextBox x:Name="TxtUrl" Margin="10,0,0,0"
                             FontFamily="{DynamicResource FbMono}" FontSize="12.5"
                             VerticalContentAlignment="Center"
                             ToolTip.Tip="Editable. Type over it to send something the form cannot express; Revert URL puts the fields back in charge."/>
                </DockPanel>

                <TextBlock x:Name="TxtEpDesc" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource FbTextSub}"/>

                <Border x:Name="ChipRight" CornerRadius="3" Padding="7,2" IsVisible="False"
                        HorizontalAlignment="Left" Background="{DynamicResource FbBg2}">
                    <TextBlock x:Name="TxtRight" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══ THE FORM ═════════════════════════════════════════════════
             Two columns, both visible at once. The web tool this replaces
             hid the body behind a tab, which meant checking a field name
             against the payload was a click each way. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,6,*" Margin="10,10,10,0">

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">

                    <Border x:Name="SecPath" Classes="card" IsVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="PATH PARAMETERS"/>
                            <StackPanel x:Name="PanelPath" Spacing="5"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="BtnAddQuery" Classes="tool"
                                        Content="+ Add" Margin="0" Padding="8,2"/>
                                <TextBlock Classes="label" Text="QUERY PARAMETERS"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <StackPanel x:Name="PanelQuery" Spacing="5"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="BtnAddHeader" Classes="tool"
                                        Content="+ Add" Margin="0" Padding="8,2"/>
                                <TextBlock Classes="label" Text="CUSTOM HEADERS"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="TxtAutoHeaders" FontSize="11.5"
                                       Foreground="{DynamicResource FbTextMuted}"/>
                            <StackPanel x:Name="PanelHeaders" Spacing="5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Background="Transparent"/>

            <!-- ── BODY + FIELD REFERENCE ───────────────────────────── -->
            <Border Grid.Column="2" x:Name="SecBody" Classes="card">
                <Grid RowDefinitions="Auto,2*,Auto,3*">
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="TxtContentType" FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource FbTextMuted}"/>
                            <Button x:Name="BtnFormatBody" Classes="tool" Content="Format" Padding="8,2"/>
                            <Button x:Name="BtnResetBody" Classes="tool" Content="Reset" Padding="8,2"
                                    ToolTip.Tip="Back to the template built from the documented fields"/>
                            <Button x:Name="BtnCopyBody" Classes="tool" Content="Copy" Padding="8,2" Margin="0"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtBodyLabel" Classes="label" Text="REQUEST BODY"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBox Grid.Row="1" x:Name="TxtBody" AcceptsReturn="True"
                             FontFamily="{DynamicResource FbMono}" FontSize="12.5"
                             VerticalAlignment="Stretch"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <DockPanel Grid.Row="2" Margin="0,10,0,4">
                        <ToggleButton DockPanel.Dock="Right" x:Name="TogFields"
                                      Classes="fold" IsChecked="True"
                                      ToolTip.Tip="Show or hide the documented fields"/>
                        <TextBlock/>
                        <TextBlock x:Name="TxtFieldCount" Classes="label"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Nothing documented. A blank panel reads as a control
                         that failed to load, so it says which of the two
                         reasons applies instead. -->
                    <TextBlock Grid.Row="3" x:Name="TxtNoFields" IsVisible="False"
                               FontSize="12.5" TextWrapping="Wrap" Margin="2,4,0,0"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource FbTextMuted}"/>

                    <!-- Every documented field, beside the body rather than
                         behind a tab: the whole point is to read one while
                         typing the other. -->
                    <DataGrid Grid.Row="3" x:Name="GridFields" IsReadOnly="True"
                              x:DataType="ui:FieldRow"
                              GridLinesVisibility="Horizontal" FontSize="12"
                              HeadersVisibility="Column"
                              CanUserResizeColumns="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="200"
                                                FontFamily="{DynamicResource FbMono}"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                            <DataGridTextColumn Header="Req" Binding="{Binding RequiredLabel}" Width="70"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ── SQL ───────────────────────────────────
                 /api/data-query carries its whole statement in a query
                 parameter. Left as an ordinary parameter row that is a
                 one-line box you cannot read a join in, so it takes the right
                 column and a real editor instead. -->
            <Border Grid.Column="2" x:Name="SecSql" Classes="card" IsVisible="False">
                <Grid RowDefinitions="Auto,*,Auto">
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <!-- The row limit lives here rather than in settings
                                 because it changes what comes back, and a
                                 setting that silently truncates a result is one
                                 nobody remembers turning on. -->
                            <CheckBox x:Name="ChkLimit" Content="Limit" MinWidth="0"
                                      VerticalAlignment="Center" FontSize="12"
                                      ToolTip.Tip="Append LIMIT to a plain SELECT, so a wide query cannot return the whole table"/>
                            <TextBox x:Name="TxtLimit" Width="66" FontSize="12" Padding="6,2"
                                     VerticalContentAlignment="Center"
                                     ToolTip.Tip="How many rows"/>
                            <CheckBox x:Name="ChkKeep" Content="Keep" MinWidth="0"
                                      VerticalAlignment="Center" FontSize="12"
                                      ToolTip.Tip="Store each result on this machine so it can be reviewed and compared later"/>
                            <Button x:Name="BtnSaved" Classes="tool" Content="Saved" Padding="8,2"
                                    ToolTip.Tip="Show the results kept so far"/>
                            <Button x:Name="BtnFormatSql" Classes="tool" Content="Format SQL" Padding="8,2"
                                    ToolTip.Tip="Break the statement onto clause lines"/>
                            <Button x:Name="BtnCopySql" Classes="tool" Content="Copy" Padding="8,2"/>
                            <Button x:Name="BtnClearSql" Classes="tool" Content="Clear" Padding="8,2" Margin="0"/>
                        </StackPanel>
                        <TextBlock Classes="label" Text="SQL QUERY" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{DynamicResource FbBgPrimary}" CornerRadius="4"
                            BorderBrush="{DynamicResource FbBorder}" BorderThickness="1">
                        <ui:SqlEditor x:Name="TxtSql"
                                      ToolTip.Tip="Ctrl+Enter sends. Enter makes a new line."/>
                    </Border>

                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock Margin="2,7,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FbTextMuted}"
                                   Text="Sent as ?query= · SELECT only · use Fishbowl table and column names · variables are expanded"/>

                        <!-- ── KEPT RESULTS ──────────────────────────────
                             A query run against a live database cannot be
                             re-run to get the same answer, which is the whole
                             reason for writing one down. -->
                        <Border x:Name="SavedPane" IsVisible="False" MaxHeight="200"
                                BorderBrush="{DynamicResource FbBorder}" BorderThickness="0,1,0,0"
                                Padding="0,8,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="BtnRestoreRun" Classes="tool" Content="Restore query"
                                                Padding="8,2"
                                                ToolTip.Tip="Put the selected run's SQL back in the editor"/>
                                        <Button x:Name="BtnCompareRun" Classes="tool" Content="Compare"
                                                Padding="8,2"
                                                ToolTip.Tip="Compare the selected run with what is in the response pane now"/>
                                        <Button x:Name="BtnRenameRun" Classes="tool" Content="Rename" Padding="8,2"/>
                                        <Button x:Name="BtnDeleteRun" Classes="tool" Content="Delete" Padding="8,2"/>
                                        <Button x:Name="BtnClearRuns" Classes="tool" Content="Clear all"
                                                Padding="8,2" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtSavedCount" Classes="label"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <ListBox x:Name="LstRuns" FontSize="12" x:DataType="core:QueryRun"
                                         Background="{DynamicResource FbBgSubtle}"
                                         BorderBrush="{DynamicResource FbBorder}" BorderThickness="1"
                                         ToolTip.Tip="Double-click to load a kept result back into the response pane">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:QueryRun">
                                            <DockPanel Margin="0,1">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}"
                                                           FontSize="11" Margin="0,0,9,0"
                                                           FontFamily="{DynamicResource FbMono}"
                                                           Foreground="{DynamicResource FbTextMuted}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}"
                                                           FontSize="11" Margin="9,0,0,0"
                                                           Foreground="{DynamicResource FbTextMuted}"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── IMPORT ───────────────────────────────────────────────
                 /api/import/{name} takes a spreadsheet, not a JSON object, and
                 the columns it wants come from the matching export endpoint
                 rather than from the documentation — so this pane can ask the
                 server what THIS database's columns are, custom fields and
                 all. -->
            <Border Grid.Column="2" x:Name="SecImport" Classes="card" IsVisible="False">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Classes="label" Text="IMPORT TYPE"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="0"
                                    Margin="8,0,0,0">
                            <RadioButton x:Name="FmtCsv" Classes="seg first" GroupName="ImportFmt"
                                         Content="CSV / Text" IsChecked="True"/>
                            <RadioButton x:Name="FmtJson" Classes="seg last" GroupName="ImportFmt"
                                         Content="JSON"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbImportName" FontSize="13"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="The server accepts only these names, exactly as spelled."/>
                    </DockPanel>

                    <Border Grid.Row="1" x:Name="DropZone" CornerRadius="8" Padding="14,11"
                            Margin="0,0,0,8" Cursor="Hand"
                            Background="{DynamicResource FbBg1}"
                            BorderBrush="{DynamicResource FbBlue}" BorderThickness="1.4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#128228;" FontSize="16"
                                       Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" x:Name="BtnClearFile" Classes="tool"
                                    Content="Clear" Padding="8,2" Margin="0" IsVisible="False"/>
                            <TextBlock x:Name="TxtDrop" VerticalAlignment="Center" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource FbTextSub}"
                                       Text="Drop a .csv, .txt or .json file here, or click to browse"/>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="BtnFetchHeaders" Classes="tool" Content="Fetch headers"
                                    Padding="8,2"
                                    ToolTip.Tip="Ask the server for this type's column headers and lay out a template row"/>
                            <Button x:Name="BtnClearImport" Classes="tool" Content="Clear"
                                    Padding="8,2" Margin="0"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtImportHint" Classes="label" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </DockPanel>

                    <TextBox Grid.Row="3" x:Name="TxtImport" AcceptsReturn="True"
                             FontFamily="{DynamicResource FbMono}" FontSize="12.5"
                             TextWrapping="NoWrap"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"/>

        <!-- ══ RESPONSE ═════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Classes="card" Margin="10,0,10,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="9">
                        <Border x:Name="ChipStatus" CornerRadius="3" Padding="8,2" IsVisible="False">
                            <TextBlock x:Name="TxtStatusCode" FontSize="11.5" FontWeight="Bold"
                                       FontFamily="{DynamicResource FbMono}"/>
                        </Border>
                        <TextBlock x:Name="TxtTiming" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource FbTextMuted}"/>

                        <!-- Shown only when the limit was actually appended, and
                             it says whether the result reached it: a short
                             result set that is quietly incomplete is worse than
                             a slow one. -->
                        <Border x:Name="ChipLimit" CornerRadius="3" Padding="8,2" IsVisible="False"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLimitNote" FontSize="11.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="OPENS ON" FontSize="10.5" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource FbTextMuted}"/>
                        <ComboBox x:Name="CmbView" Width="96" FontSize="12"/>
                        <Button x:Name="BtnCapture" Classes="tool" Content="Capture…" Padding="8,2"
                                ToolTip.Tip="Put a value from this response into a variable"/>
                        <Button x:Name="BtnCopyResp" Classes="tool" Content="Copy" Padding="8,2"/>
                        <Button x:Name="BtnSaveResp" Classes="tool" Content="Save…" Padding="8,2" Margin="0"/>
                    </StackPanel>
                    <TextBlock/>
                </DockPanel>

                <TabControl x:Name="Views" Padding="0">
                    <TabItem Header="Pretty" Classes="shell">
                        <ui:JsonView x:Name="TxtPretty"/>
                    </TabItem>
                    <TabItem Header="Raw" Classes="shell">
                        <TextBox x:Name="TxtRaw" IsReadOnly="True" AcceptsReturn="True"
                                 FontFamily="{DynamicResource FbMono}" FontSize="12.5"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </TabItem>
                    <TabItem Header="Table" Classes="shell">
                        <DataGrid x:Name="GridRows" IsReadOnly="True" FontSize="12.5"
                                  FontFamily="{DynamicResource FbMono}"
                                  x:CompileBindings="False"
                                  GridLinesVisibility="All" HeadersVisibility="Column"
                                  CanUserResizeColumns="True" CanUserSortColumns="True"/>
                    </TabItem>
                    <TabItem Header="Headers" Classes="shell">
                        <DataGrid x:Name="GridHeaders" IsReadOnly="True" FontSize="12"
                                  x:DataType="ui:HeaderRow"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Header" Binding="{Binding Key}" Width="290"
                                                    FontFamily="{DynamicResource FbMono}"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
