<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The palette comes in HERE rather than through Application.Resources:
         Avalonia builds Styles before Resources, so a style that reached for
         a token declared there would not find it. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FbApiTool/Brand.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!--
      The window's own chrome: the shell tabs, the sidebar, the buttons and the
      pills. The Fluent theme underneath renders selected and unselected in
      near-identical greys, which is the same problem the WPF build had, so the
      active thing is brought forward deliberately here rather than left to the
      theme.
    -->

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{StaticResource FbFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource FbBg1}" />
    </Style>

    <!-- A panel of the form: white, bordered, rounded. The window is a lot of
         small groups and they need to read as separate things. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource FbBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ══ SHELL TABS ═══════════════════════════════════════════════════ -->

    <!--
      Templated rather than restyled. The stock indicator is a rounded pip
      floating inside the tab's padding, which reads as underlining the word
      rather than marking the tab; where it lands depends on metrics this sheet
      has already changed. Owning the template puts the line flush against the
      bottom edge, which is the one place it means "this tab".
    -->
    <Style Selector="TabItem.shell">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource FbTextSub}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="*,2">
                    <ContentPresenter Grid.Row="0"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                    <Border Grid.Row="1" x:Name="Underline" Background="Transparent"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem.shell:selected">
        <Setter Property="Foreground" Value="{StaticResource FbBlueAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem.shell:selected /template/ Border#Underline">
        <Setter Property="Background" Value="{StaticResource FbBlue}" />
    </Style>
    <Style Selector="TabItem.shell:pointerover:not(:selected) /template/ Border#Underline">
        <Setter Property="Background" Value="{StaticResource FbBorderStrong}" />
    </Style>

    <!-- ══ BUTTONS ══════════════════════════════════════════════════════ -->

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource FbBlue}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource FbBlueHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="Button.tool">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource FbText}" />
        <Setter Property="BorderBrush" Value="{StaticResource FbBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource FbTint}" />
    </Style>

    <!-- On the brand bar, where the background is already blue. -->
    <Style Selector="Button.onbrand">
        <Setter Property="Background" Value="#1E7BB4" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.onbrand:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#176C9E" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ══ THE VERB PILL ════════════════════════════════════════════════
         Same treatment as a value chip in the response table, so the window
         has one chip style rather than two that happen to share a palette. -->

    <Style Selector="Border.verb">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.verb > TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FbMono}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Removing a row. Muted until pointed at, then the negative colour on
         its own tint — the same treatment a DELETE pill gets, so the thing
         that removes something always looks the same. -->
    <Style Selector="Button.rowkill">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource FbTextMuted}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rowkill /template/ ContentPresenter">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rowkill:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource MethodDeleteBg}" />
        <Setter Property="Foreground" Value="{StaticResource FbNegative}" />
    </Style>

    <!-- ══ THE METHOD FILTERS ═══════════════════════════════════════
         The same tinted-chip treatment as a verb pill and a value chip, so
         the window has one chip language rather than three. Stock toggle
         buttons render as solid blue, which says "primary action" about a
         filter that is on by default. -->

    <Style Selector="ToggleButton.pill">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{StaticResource FbMono}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource FbBorder}" />
        <Setter Property="Foreground" Value="{StaticResource FbTextMuted}" />
    </Style>
    <Style Selector="ToggleButton.pill /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Off is muted and outlined; on is the verb's own colour on its tint. -->
    <Style Selector="ToggleButton.pill.get:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource MethodGetBg}" />
        <Setter Property="Foreground" Value="{StaticResource MethodGet}" />
    </Style>
    <Style Selector="ToggleButton.pill.post:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource MethodPostBg}" />
        <Setter Property="Foreground" Value="{StaticResource MethodPost}" />
    </Style>
    <Style Selector="ToggleButton.pill.delete:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource MethodDeleteBg}" />
        <Setter Property="Foreground" Value="{StaticResource MethodDelete}" />
    </Style>
    <Style Selector="ToggleButton.pill:checked">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- A chevron that folds a section away. No border, no fill: it is a
         disclosure, not a command. -->
    <Style Selector="ToggleButton.fold">
        <Setter Property="Content" Value="&#x25BE;" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource FbTextMuted}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.fold:unchecked">
        <Setter Property="Content" Value="&#x25B8;" />
    </Style>
    <Style Selector="ToggleButton.fold:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource FbTint}" />
        <Setter Property="Foreground" Value="{StaticResource FbBlueAccent}" />
    </Style>

    <!-- ══ SIDEBAR ══════════════════════════════════════════════════════ -->

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource FbTextMuted}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource FbTextSub}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.build">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{StaticResource FbMono}" />
        <Setter Property="Foreground" Value="{StaticResource FbTextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
