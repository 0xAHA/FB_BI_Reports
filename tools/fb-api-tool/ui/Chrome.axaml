<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The palette comes in HERE rather than through Application.Resources:
         Avalonia builds Styles before Resources, so a style that reached for
         a token declared there would not find it. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FbApiTool/Brand.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!--
      The window's own chrome: the shell tabs, the sidebar, the buttons and the
      pills. The Fluent theme underneath renders selected and unselected in
      near-identical greys, which is the same problem the WPF build had, so the
      active thing is brought forward deliberately here rather than left to the
      theme.
    -->

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource FbFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource FbBg1}" />
    </Style>

    <!-- A panel of the form: white, bordered, rounded. The window is a lot of
         small groups and they need to read as separate things. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource FbBgPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FbBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- ══ SHELL TABS ═══════════════════════════════════════════════════ -->

    <!--
      Templated rather than restyled. The stock indicator is a rounded pip
      floating inside the tab's padding, which reads as underlining the word
      rather than marking the tab; where it lands depends on metrics this sheet
      has already changed. Owning the template puts the line flush against the
      bottom edge, which is the one place it means "this tab".
    -->
    <Style Selector="TabItem.shell">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextSub}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="*,2">
                    <ContentPresenter Grid.Row="0"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"/>
                    <Border Grid.Row="1" x:Name="Underline" Background="Transparent"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem.shell:selected">
        <Setter Property="Foreground" Value="{DynamicResource FbBlueAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem.shell:selected /template/ Border#Underline">
        <Setter Property="Background" Value="{DynamicResource FbBlue}" />
    </Style>
    <Style Selector="TabItem.shell:pointerover:not(:selected) /template/ Border#Underline">
        <Setter Property="Background" Value="{DynamicResource FbBorderStrong}" />
    </Style>

    <!-- ══ REQUEST TABS ══════════════════════════════════════════════
         Templated for the same reason the shell tabs are: the stock indicator
         floats inside the padding, and these tabs carry a verb pill and a
         close cross rather than a word, so it floats further still. -->

    <Style Selector="TabItem.req">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextSub}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Back" Background="{DynamicResource FbTabRest}"
                        CornerRadius="5,5,0,0">
                    <Grid RowDefinitions="*,2">
                        <ContentPresenter Grid.Row="0"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        <Border Grid.Row="1" x:Name="Underline" Background="Transparent"/>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem.req:selected">
        <Setter Property="Foreground" Value="{DynamicResource FbText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem.req:selected /template/ Border#Back">
        <Setter Property="Background" Value="{DynamicResource FbBgPrimary}" />
    </Style>
    <Style Selector="TabItem.req:selected /template/ Border#Underline">
        <Setter Property="Background" Value="{DynamicResource FbBlue}" />
    </Style>
    <Style Selector="TabItem.req:pointerover:not(:selected) /template/ Border#Back">
        <Setter Property="Background" Value="{DynamicResource FbTint}" />
    </Style>

    <!-- ══ BUTTONS ══════════════════════════════════════════════════════ -->

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource FbBlue}" />
        <Setter Property="Foreground" Value="{DynamicResource FbOnBrand}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FbBlueHover}" />
        <Setter Property="Foreground" Value="{DynamicResource FbOnBrand}" />
    </Style>

    <Style Selector="Button.tool">
        <Setter Property="Background" Value="{DynamicResource FbBgPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource FbText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FbBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FbTint}" />
    </Style>

    <!-- On the brand bar, where the background is already blue. -->
    <!-- On the brand bar, so its ground is the bar's own darker shade rather
         than the page accent: FbBlueAccent lightens in the dark theme, which
         put a pale blue button with white text on a deep blue bar. -->
    <Style Selector="Button.onbrand">
        <Setter Property="Background" Value="{DynamicResource FbBrandChip}" />
        <Setter Property="Foreground" Value="{DynamicResource FbOnBrand}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.onbrand:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FbBlueAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource FbOnBrand}" />
    </Style>

    <!-- ══ THE VERB PILL ════════════════════════════════════════════════
         Same treatment as a value chip in the response table, so the window
         has one chip style rather than two that happen to share a palette. -->

    <Style Selector="Border.verb">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.verb > TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FbMono}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Removing a row. Muted until pointed at, then the negative colour on
         its own tint — the same treatment a DELETE pill gets, so the thing
         that removes something always looks the same. -->
    <Style Selector="Button.rowkill">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FbNegative}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rowkill /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource FbNegative}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rowkill:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MethodDeleteBg}" />
        <Setter Property="Foreground" Value="{DynamicResource FbNegative}" />
    </Style>

    <!-- ══ THE METHOD FILTERS ═══════════════════════════════════════
         The same tinted-chip treatment as a verb pill and a value chip, so
         the window has one chip language rather than three. Stock toggle
         buttons render as solid blue, which says "primary action" about a
         filter that is on by default. -->

    <Style Selector="ToggleButton.pill">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{DynamicResource FbMono}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource FbBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextMuted}" />
    </Style>
    <Style Selector="ToggleButton.pill /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Off is muted and outlined; on is the verb's own colour on its tint. -->
    <Style Selector="ToggleButton.pill.get:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MethodGetBg}" />
        <Setter Property="Foreground" Value="{DynamicResource MethodGet}" />
    </Style>
    <Style Selector="ToggleButton.pill.post:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MethodPostBg}" />
        <Setter Property="Foreground" Value="{DynamicResource MethodPost}" />
    </Style>
    <Style Selector="ToggleButton.pill.delete:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MethodDeleteBg}" />
        <Setter Property="Foreground" Value="{DynamicResource MethodDelete}" />
    </Style>
    <Style Selector="ToggleButton.pill:checked">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- A chevron that folds a section away. No border, no fill: it is a
         disclosure, not a command. -->
    <Style Selector="ToggleButton.fold">
        <Setter Property="Content" Value="Hide &#x25BE;" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource FbBorderStrong}" />
        <Setter Property="Background" Value="{DynamicResource FbBgPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextSub}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.fold:unchecked">
        <Setter Property="Content" Value="Show &#x25B8;" />
    </Style>
    <Style Selector="ToggleButton.fold:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FbTint}" />
        <Setter Property="Foreground" Value="{DynamicResource FbBlueAccent}" />
    </Style>

    <!-- ══ SIDEBAR ══════════════════════════════════════════════════════ -->

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextMuted}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextSub}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.build">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{DynamicResource FbMono}" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <!-- ══ SEGMENTED PICKER ═════════════════════════════════════════════
         Two RadioButtons drawn as one joined control, for a choice between two
         views of the same thing. Templated from scratch because the Fluent
         RadioButton is a dot beside a label, which reads as a setting rather
         than as a switch between two panes. -->
    <Style Selector="RadioButton.seg">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextSub}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Seg"
                        Background="{DynamicResource FbBgPrimary}"
                        BorderBrush="{DynamicResource FbBorderStrong}"
                        BorderThickness="1,1,0,1"
                        Padding="13,5">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The pair is joined, so only the outer corners round and only the last
         one draws its right-hand border. -->
    <Style Selector="RadioButton.seg.first /template/ Border#Seg">
        <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="RadioButton.seg.last /template/ Border#Seg">
        <Setter Property="CornerRadius" Value="0,6,6,0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="RadioButton.seg:pointerover /template/ Border#Seg">
        <Setter Property="Background" Value="{DynamicResource FbBg2}" />
    </Style>
    <Style Selector="RadioButton.seg:checked /template/ Border#Seg">
        <Setter Property="Background" Value="{DynamicResource FbBlue}" />
    </Style>
    <Style Selector="RadioButton.seg:checked">
        <Setter Property="Foreground" Value="{DynamicResource FbOnBrand}" />
    </Style>


    <!-- ══ GUTTER BUTTON ═══════════════════════════════════════════════
         What is left behind when a panel is folded away: a full-height strip
         where the panel was. A small button floating in the corner reads as
         decoration and gets lost against the content beside it, whereas a
         strip the height of the pane is unmistakably the pane, closed. -->
    <Style Selector="Button.gutter">
        <Setter Property="Background" Value="{DynamicResource FbBgSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FbBorder}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.gutter /template/ ContentPresenter">
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style Selector="Button.gutter:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FbTint}" />
        <Setter Property="Foreground" Value="{DynamicResource FbBlueAccent}" />
    </Style>

</Styles>
