<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FbApiTool.Ui.ConnectWindow"
        Title="Connect to Fishbowl"
        Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="avares://FbApiTool/assets/fishbowl.ico">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{DynamicResource FbBlue}" Padding="20,14">
            <StackPanel Spacing="3">
                <TextBlock Text="Fishbowl API Tool" Foreground="{DynamicResource FbOnBrand}"
                           FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="Sign in to get a token, or paste one you already have."
                           Foreground="{DynamicResource FbTint}" FontSize="13"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource FbBg1}" Padding="20,12"
                BorderBrush="{DynamicResource FbBorder}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" x:Name="BtnOffline" Classes="tool"
                        Content="Work offline"
                        ToolTip.Tip="The endpoint list and both guides work with no connection."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="BtnConnect" Classes="primary" Content="Connect" MinWidth="110"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="20,16" Spacing="4">

            <TextBlock Classes="label" Text="SERVER"/>
            <TextBox x:Name="TxtServer" FontFamily="{DynamicResource FbMono}"/>

            <TabControl x:Name="Modes" Margin="0,10,0,0" Padding="0">
                <TabItem Header="Sign in" Classes="shell">
                    <StackPanel Margin="0,12,0,0" Spacing="4">
                        <TextBlock Classes="label" Text="USERNAME"/>
                        <TextBox x:Name="TxtUser"/>

                        <TextBlock Classes="label" Text="PASSWORD" Margin="0,8,0,3"/>
                        <TextBox x:Name="TxtPass" PasswordChar="&#x25cf;"/>

                        <TextBlock Classes="label" Margin="0,8,0,3"
                                   Text="MFA CODE (only if the account has MFA enabled)"/>
                        <TextBox x:Name="TxtMfa"/>

                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" x:Name="BtnForget" Classes="tool"
                                    Content="Forget" Margin="0"
                                    ToolTip.Tip="Remove this password from the Windows Credential Manager"/>
                            <CheckBox x:Name="ChkRemember" Content="Remember this password"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtVault" FontSize="11.5"
                                   Foreground="{DynamicResource FbTextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Paste a token" Classes="shell">
                    <StackPanel Margin="0,12,0,0" Spacing="4">
                        <TextBlock Classes="label" Text="BEARER TOKEN"/>
                        <TextBox x:Name="TxtToken" AcceptsReturn="True" Height="86"
                                 TextWrapping="Wrap" FontFamily="{DynamicResource FbMono}"
                                 FontSize="12"/>
                        <!-- A pasted token belongs to whoever issued it, so this
                             tool will not end its session on disconnect. -->
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource FbTextMuted}"
                                   Text="Checked before it is accepted. A pasted token is never logged out on disconnect — it belongs to whoever issued it and may still be in use elsewhere."/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Expander Header="Integrated app identity" Margin="0,12,0,0" FontSize="12.5">
                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <TextBlock FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="The first sign-in with a new name and id registers the app, and an administrator has to approve it in Settings ▸ Integrated Apps before it will work. Change these only to reuse an approval that already exists."/>
                    <Grid ColumnDefinitions="*,12,110" Margin="0,6,0,0">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Classes="label" Text="APP NAME"/>
                            <TextBox x:Name="TxtAppName"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Classes="label" Text="APP ID"/>
                            <TextBox x:Name="TxtAppId"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <Border x:Name="ErrBox" IsVisible="False" Margin="0,12,0,0"
                    Background="{DynamicResource FbErrorBg}" BorderBrush="{DynamicResource FbErrorBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="11,9">
                <TextBlock x:Name="TxtErr" Foreground="{DynamicResource FbErrorInk}" FontSize="12.5"
                           TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="TxtBusy" IsVisible="False" Margin="0,10,0,0"
                       FontSize="12.5" Foreground="{DynamicResource FbTextSub}"/>
        </StackPanel>
    </DockPanel>
</Window>
