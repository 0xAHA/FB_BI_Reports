<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      BRAND TOKENS — the same names in both themes, so nothing downstream has
      to know which one is on. Light is scripts/fb-styles.css exactly, keyed by
      the same names, so this tool, the WPF build, the report host and the
      reports themselves cannot drift apart.

      DARK IS NOT LIGHT INVERTED. Two things go wrong when it is, and the WPF
      attempt hit both:

        * The brand bar vanishes. Its background was a background token, so a
          dark theme turned it the same colour as the window and the white text
          on it became white text on nothing. Here the bar is FbBrandBar, which
          stays blue in both themes — a deeper blue in the dark one, so the
          white still reads against it.

        * The tints stop being backgrounds. #DEEAF4 behind #1e7bb4 is a pale
          blue behind a strong one; on a dark page the same pair is a pale
          blue behind a strong one, i.e. two light colours with no contrast
          between them. The dark tints are dim and the inks on them are
          lightened, which is the same relationship the other way up.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ══ LIGHT ═══════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FbBlue"            Color="#2d9cdb"/>
            <SolidColorBrush x:Key="FbBlueAccent"      Color="#1e7bb4"/>
            <SolidColorBrush x:Key="FbBlueHover"       Color="#4FB0E4"/>
            <SolidColorBrush x:Key="FbBluePressed"     Color="#176C9E"/>
            <SolidColorBrush x:Key="FbBrandBar"        Color="#2d9cdb"/>
            <SolidColorBrush x:Key="FbOnBrand"         Color="#FFFFFF"/>
            <SolidColorBrush x:Key="FbOnBrandSub"      Color="#DEEAF4"/>
            <SolidColorBrush x:Key="FbBrandChip"       Color="#1E7BB4"/>
            <SolidColorBrush x:Key="FbErrorBg"         Color="#FBE9EC"/>
            <SolidColorBrush x:Key="FbErrorBorder"     Color="#E7B3BC"/>
            <SolidColorBrush x:Key="FbErrorInk"        Color="#8A1E30"/>
            <SolidColorBrush x:Key="FbTabRest"         Color="#E8EEF2"/>

            <SolidColorBrush x:Key="FbSuccess"         Color="#1B7A46"/>
            <SolidColorBrush x:Key="FbWarning"         Color="#B26A14"/>
            <SolidColorBrush x:Key="FbNegative"        Color="#C43046"/>
            <SolidColorBrush x:Key="FbNeutral"         Color="#506872"/>
            <SolidColorBrush x:Key="FbGreen"           Color="#1B7A46"/>
            <SolidColorBrush x:Key="FbAmber"           Color="#B26A14"/>
            <SolidColorBrush x:Key="FbRed"             Color="#C43046"/>

            <SolidColorBrush x:Key="FbBgPrimary"       Color="#FFFFFF"/>
            <SolidColorBrush x:Key="FbBgSubtle"        Color="#FBFCFD"/>
            <SolidColorBrush x:Key="FbBgPanel"         Color="#F7FAFC"/>
            <SolidColorBrush x:Key="FbBg1"             Color="#F7F7F7"/>
            <SolidColorBrush x:Key="FbBg2"             Color="#EBEEED"/>
            <SolidColorBrush x:Key="FbBg3"             Color="#E3E3E3"/>
            <SolidColorBrush x:Key="FbBg4"             Color="#C6D0D4"/>
            <SolidColorBrush x:Key="FbBorder"          Color="#E3E3E3"/>
            <SolidColorBrush x:Key="FbBorderStrong"    Color="#C6D0D4"/>
            <SolidColorBrush x:Key="FbMenuBg"          Color="#0B3140"/>
            <SolidColorBrush x:Key="FbMenuBg2"         Color="#0E3646"/>

            <SolidColorBrush x:Key="FbText"            Color="#101010"/>
            <SolidColorBrush x:Key="FbTextSub"         Color="#506872"/>
            <SolidColorBrush x:Key="FbTextMuted"       Color="#8FA1A7"/>

            <SolidColorBrush x:Key="FbTint"            Color="#DEEAF4"/>
            <SolidColorBrush x:Key="FbTint2"           Color="#CBE5FB"/>
            <SolidColorBrush x:Key="AccPurple"         Color="#845EEB"/>
            <SolidColorBrush x:Key="AccPurpleBg"       Color="#D9CEF7"/>
            <SolidColorBrush x:Key="AccSage"           Color="#DBE8E1"/>
            <SolidColorBrush x:Key="AccYellowBg"       Color="#FBEDC4"/>
            <SolidColorBrush x:Key="AccMaroonBg"       Color="#F0D7DD"/>

            <SolidColorBrush x:Key="MethodGet"         Color="#1e7bb4"/>
            <SolidColorBrush x:Key="MethodPost"        Color="#1B7A46"/>
            <SolidColorBrush x:Key="MethodDelete"      Color="#C43046"/>
            <SolidColorBrush x:Key="MethodOther"       Color="#845EEB"/>
            <SolidColorBrush x:Key="MethodGetBg"       Color="#DEEAF4"/>
            <SolidColorBrush x:Key="MethodPostBg"      Color="#DBE8E1"/>
            <SolidColorBrush x:Key="MethodDeleteBg"    Color="#F0D7DD"/>
            <SolidColorBrush x:Key="MethodOtherBg"     Color="#D9CEF7"/>
        </ResourceDictionary>

        <!-- ══ DARK ════════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Dark">
            <!-- The brand blue itself does not change: it is the brand. What
                 changes is which of its shades is legible on what. -->
            <SolidColorBrush x:Key="FbBlue"            Color="#2d9cdb"/>
            <SolidColorBrush x:Key="FbBlueAccent"      Color="#5BB7E8"/>
            <SolidColorBrush x:Key="FbBlueHover"       Color="#7ACBF0"/>
            <SolidColorBrush x:Key="FbBluePressed"     Color="#2d9cdb"/>
            <!-- Deeper than FbBlue so white text keeps its contrast, and still
                 unmistakably the blue bar rather than another dark surface. -->
            <SolidColorBrush x:Key="FbBrandBar"        Color="#12557B"/>
            <SolidColorBrush x:Key="FbOnBrand"         Color="#FFFFFF"/>
            <SolidColorBrush x:Key="FbOnBrandSub"      Color="#BBD9EC"/>
            <SolidColorBrush x:Key="FbBrandChip"       Color="#0C3E5B"/>
            <SolidColorBrush x:Key="FbErrorBg"         Color="#3B1A21"/>
            <SolidColorBrush x:Key="FbErrorBorder"     Color="#6B3038"/>
            <SolidColorBrush x:Key="FbErrorInk"        Color="#F2A4B0"/>
            <SolidColorBrush x:Key="FbTabRest"         Color="#1B2428"/>

            <!-- Lightened inks. The light-theme values are chosen to read on
                 white and are far too dark to read on #14191C. -->
            <SolidColorBrush x:Key="FbSuccess"         Color="#57C48B"/>
            <SolidColorBrush x:Key="FbWarning"         Color="#E3A64F"/>
            <SolidColorBrush x:Key="FbNegative"        Color="#F2748A"/>
            <SolidColorBrush x:Key="FbNeutral"         Color="#A9BAC1"/>
            <SolidColorBrush x:Key="FbGreen"           Color="#57C48B"/>
            <SolidColorBrush x:Key="FbAmber"           Color="#E3A64F"/>
            <SolidColorBrush x:Key="FbRed"             Color="#F2748A"/>

            <!-- Surfaces, lightest to darkest in the same ORDER as the light
                 theme, so a control that sat one step above its neighbour
                 still does. -->
            <SolidColorBrush x:Key="FbBgPrimary"       Color="#161B1E"/>
            <SolidColorBrush x:Key="FbBgSubtle"        Color="#12171A"/>
            <SolidColorBrush x:Key="FbBgPanel"         Color="#1A2226"/>
            <SolidColorBrush x:Key="FbBg1"             Color="#0F1315"/>
            <SolidColorBrush x:Key="FbBg2"             Color="#212A2E"/>
            <SolidColorBrush x:Key="FbBg3"             Color="#2B3539"/>
            <SolidColorBrush x:Key="FbBg4"             Color="#3C484E"/>
            <SolidColorBrush x:Key="FbBorder"          Color="#2B3539"/>
            <SolidColorBrush x:Key="FbBorderStrong"    Color="#414F55"/>
            <SolidColorBrush x:Key="FbMenuBg"          Color="#0B3140"/>
            <SolidColorBrush x:Key="FbMenuBg2"         Color="#0E3646"/>

            <SolidColorBrush x:Key="FbText"            Color="#E9EEF0"/>
            <SolidColorBrush x:Key="FbTextSub"         Color="#A9BAC1"/>
            <SolidColorBrush x:Key="FbTextMuted"       Color="#7E8F96"/>

            <!-- Tints are now DIM, not pale. A pale tint behind a strong ink
                 is a light-on-light pair when the page is dark. -->
            <SolidColorBrush x:Key="FbTint"            Color="#14344A"/>
            <SolidColorBrush x:Key="FbTint2"           Color="#1A4463"/>
            <SolidColorBrush x:Key="AccPurple"         Color="#A88CF2"/>
            <SolidColorBrush x:Key="AccPurpleBg"       Color="#2E2450"/>
            <SolidColorBrush x:Key="AccSage"           Color="#17372A"/>
            <SolidColorBrush x:Key="AccYellowBg"       Color="#40320F"/>
            <SolidColorBrush x:Key="AccMaroonBg"       Color="#45202A"/>

            <SolidColorBrush x:Key="MethodGet"         Color="#5BB7E8"/>
            <SolidColorBrush x:Key="MethodPost"        Color="#57C48B"/>
            <SolidColorBrush x:Key="MethodDelete"      Color="#F2748A"/>
            <SolidColorBrush x:Key="MethodOther"       Color="#A88CF2"/>
            <SolidColorBrush x:Key="MethodGetBg"       Color="#14344A"/>
            <SolidColorBrush x:Key="MethodPostBg"      Color="#17372A"/>
            <SolidColorBrush x:Key="MethodDeleteBg"    Color="#45202A"/>
            <SolidColorBrush x:Key="MethodOtherBg"     Color="#2E2450"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Inter ships with the app as a package, so a machine that has never
         seen it still renders the way the design says. Type has no theme. -->
    <FontFamily x:Key="FbFont">Inter, Segoe UI Variable Text, Segoe UI, Roboto</FontFamily>
    <FontFamily x:Key="FbMono">Space Mono, Cascadia Mono, Consolas</FontFamily>

</ResourceDictionary>
