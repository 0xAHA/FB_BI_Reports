<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FbApiTool.Ui"
             x:Class="FbApiTool.Ui.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- Density before Chrome: the chrome overrides what it needs to. -->
        <StyleInclude Source="avares://FbApiTool/Density.axaml" />
        <StyleInclude Source="avares://FbApiTool/Chrome.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Kind-to-colour, the same mapping the WPF build uses. The model
                 lives in FbApiTool.Core and cannot name a brush itself. -->
            <ui:ChangeKindBrush x:Key="ChangeKindBrush" />
            <ui:SqlKindInk x:Key="SqlKindInk" />
            <ui:SqlKindFill x:Key="SqlKindFill" />
            <ui:ViewInk x:Key="ViewInk" />
            <ui:ViewFill x:Key="ViewFill" />
            <ui:MethodInk x:Key="MethodInk" />
            <ui:MethodFill x:Key="MethodFill" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
