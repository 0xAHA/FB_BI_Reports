<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FbApiTool.Ui"
        xmlns:core="clr-namespace:FbApiTool;assembly=FbApiTool.Core"
        x:Class="FbApiTool.Ui.MainWindow"
        Title="Fishbowl API Tool"
        Width="1640" Height="980"
        WindowStartupLocation="CenterScreen"
        Icon="avares://FbApiTool/assets/fishbowl.ico">

    <!-- The tour draws over everything, so the whole window is one cell of a
         Grid and the tour layer is the cell above it. Not hit-testable until
         the tour starts, or it would swallow every click. -->
    <Grid>
    <DockPanel>

        <!-- ══ IDLE WARNING ═════════════════════════════════════════════
             Shown only while the countdown is running. Any key or click
             cancels it, so this is a reminder rather than a prompt that has
             to be answered. -->
        <Border DockPanel.Dock="Top" x:Name="IdleBanner" IsVisible="False"
                Background="{DynamicResource MethodDeleteBg}" Padding="14,7"
                BorderBrush="{DynamicResource FbBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BtnStaySignedIn" Classes="tool"
                        Content="Stay signed in" Margin="10,0,0,0"/>
                <TextBlock x:Name="TxtIdleMessage" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource FbWarning}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- ══ BRAND / CONNECTION ═══════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" x:Name="BrandBar"
                Background="{DynamicResource FbBrandBar}" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Fishbowl API Tool" Foreground="{DynamicResource FbOnBrand}"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" x:Name="TxtBuiltFor" Foreground="{DynamicResource FbOnBrandSub}"
                           FontSize="12.5" VerticalAlignment="Center" Margin="9,2,0,0"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Border x:Name="ChipDocs" Background="{DynamicResource FbBrandChip}" CornerRadius="10"
                            Padding="9,2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDocsChip" Foreground="{DynamicResource FbOnBrand}" FontSize="11.5"/>
                    </Border>
                    <ComboBox x:Name="CmbProfile" Width="168" VerticalAlignment="Center" FontSize="12.5"/>
                    <Button x:Name="BtnSettings" Classes="onbrand" Content="&#x2699;" Padding="9,4"/>
                    <TextBlock x:Name="TxtAuth" Foreground="{DynamicResource FbOnBrand}" FontSize="12.5"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnAuth" Classes="onbrand" Content="Connect"/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- Loud on purpose: a write here changes real data. -->
        <Border DockPanel.Dock="Top" x:Name="ProdBanner" IsVisible="False"
                Background="{DynamicResource FbNegative}" Padding="14,5">
            <TextBlock x:Name="TxtProdBanner" Foreground="{DynamicResource FbOnBrand}" FontSize="12.5"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- ══ STATUS ═══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource FbBg1}" Padding="12,5"
                BorderBrush="{DynamicResource FbBorder}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <!-- Always on screen, so "which build is that?" never depends
                     on opening a dialog first. -->
                <TextBlock DockPanel.Dock="Right" x:Name="TxtVersion" Classes="build"
                           Margin="14,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" x:Name="TxtServerChip" Classes="status"
                           Foreground="{DynamicResource FbTextMuted}"/>
                <TextBlock x:Name="TxtStatus" Classes="status" Text="Loading…"
                           TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
            </DockPanel>
        </Border>

        <!-- ══ SHELL ════════════════════════════════════════════════════
             Documentation docks right, away from the two tabs you work in. -->
        <TabControl x:Name="Shell" Padding="0">
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabItem Header="Requests" Classes="shell">
                <Grid x:Name="ReqGridCols" ColumnDefinitions="330,5,*">

                    <!-- ── SIDEBAR ──────────────────────────────────── -->
                    <Border Grid.Column="0" x:Name="SidebarPane" Background="{DynamicResource FbBgSubtle}"
                            BorderBrush="{DynamicResource FbBorder}" BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="Auto,*,5,Auto">
                            <StackPanel Grid.Row="0" Margin="10,9,10,6" Spacing="6">
                                <TextBox x:Name="TxtSearch" Watermark="Filter by name, path or description"
                                         FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleButton x:Name="TogGet" Classes="pill get"
                                                  Content="GET" IsChecked="True"/>
                                    <ToggleButton x:Name="TogPost" Classes="pill post"
                                                  Content="POST" IsChecked="True"/>
                                    <ToggleButton x:Name="TogDelete" Classes="pill delete"
                                                  Content="DELETE" IsChecked="True"/>
                                    <Button x:Name="BtnExpandAll" Classes="tool" Content="&#8862;"
                                            Padding="7,2" ToolTip.Tip="Expand all"/>
                                    <Button x:Name="BtnCollapseAll" Classes="tool" Content="&#8863;"
                                            Padding="7,2" ToolTip.Tip="Collapse all"/>
                                    <Button x:Name="BtnSidebarHide" Classes="tool" Content="◂"
                                            Padding="7,2" Margin="0"
                                            ToolTip.Tip="Fold the endpoint list away and give the request the width"/>
                                </StackPanel>
                            </StackPanel>

                            <TreeView Grid.Row="1" x:Name="TreeEndpoints" Background="Transparent"
                                      BorderThickness="0">
                                <TreeView.Styles>
                                    <!-- Only a category has an expanded state;
                                         binding it on every node would reach for
                                         a property an endpoint does not have. -->
                                    <Style Selector="TreeViewItem" x:DataType="ui:CategoryNode">
                                        <Setter Property="IsExpanded"
                                                Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>
                                    </Style>
                                </TreeView.Styles>

                                <!-- Both levels are listed here rather than
                                     nested: Avalonia matches a template to a
                                     node by its DataType, so a tree of two
                                     different shapes is two templates, not one
                                     inside the other. -->
                                <TreeView.DataTemplates>
                                    <TreeDataTemplate DataType="ui:CategoryNode"
                                                      ItemsSource="{Binding Endpoints}">
                                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,1">
                                            <TextBlock Text="{Binding Glyph}" FontSize="13"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CountLabel}" FontSize="10.5"
                                                       Foreground="{DynamicResource FbTextMuted}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </TreeDataTemplate>

                                    <DataTemplate DataType="ui:EndpointNode">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                            <Border Classes="verb"
                                                    Background="{Binding Method, Converter={StaticResource MethodFill}}">
                                                <TextBlock Text="{Binding Method}"
                                                           Foreground="{Binding Method, Converter={StaticResource MethodInk}}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.DataTemplates>
                            </TreeView>

                            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"/>

                            <!-- ── WORKSPACE ─────────────────────────────
                                 Saved requests, variables and history. Kept
                                 with the endpoint list rather than beside the
                                 response: all three are things you reach for
                                 while composing, not while reading. -->
                            <Border Grid.Row="3" x:Name="WorkspaceBand" Height="240"
                                    Background="{DynamicResource FbBgPanel}"
                                    BorderBrush="{DynamicResource FbBorder}"
                                    BorderThickness="0,1,0,0">
                                <TabControl x:Name="Workspace" Padding="8,4,8,8">

                                    <TabItem Header="Saved" Classes="shell">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                        Spacing="6" Margin="0,5,0,0">
                                                <Button x:Name="BtnOpenSaved" Classes="tool" Content="Open"
                                                        Margin="0"/>
                                                <Button x:Name="BtnRenameSaved" Classes="tool" Content="Rename"
                                                        Margin="0"/>
                                            </StackPanel>
                                            <ListBox x:Name="LstSaved" Background="Transparent"
                                                     BorderThickness="0" FontSize="12">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="ui:SavedRow">
                                                        <DockPanel Margin="0,1">
                                                            <Button DockPanel.Dock="Right" Classes="rowkill"
                                                                    Content="×" Tag="{Binding Request}"
                                                                    Click="KillSaved"
                                                                    ToolTip.Tip="Delete this saved request"/>
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding Summary}" FontSize="10.5"
                                                                       Margin="9,0,0,0" VerticalAlignment="Center"
                                                                       FontFamily="{DynamicResource FbMono}"
                                                                       Foreground="{DynamicResource FbTextMuted}"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </TabItem>

                                    <TabItem Header="Variables" Classes="shell">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                        Spacing="6" Margin="0,5,0,0">
                                                <Button x:Name="BtnAddVar" Classes="tool" Content="+ Add" Margin="0"/>
                                                <Button x:Name="BtnClearVars" Classes="tool" Content="Clear all" Margin="0"/>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" Margin="2,5,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource FbTextMuted}"
                                                       Text="Name them without braces — soId, not {{soId}} — then write {{soId}} in any field."/>
                                            <DataGrid x:Name="GridVars" AutoGenerateColumns="False"
                                                      x:DataType="core:Variable"
                                                      Background="Transparent" BorderThickness="0"
                                                      GridLinesVisibility="Horizontal" FontSize="12"
                                                      CanUserResizeColumns="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}"
                                                                        Width="120"
                                                                        FontFamily="{DynamicResource FbMono}"/>
                                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}"
                                                                        Width="*"/>
                                                    <!-- Per-row delete. Clear all
                                                         is the wrong tool for
                                                         dropping one stale id. -->
                                                    <DataGridTemplateColumn Header="" Width="34"
                                                                            IsReadOnly="True"
                                                                            CanUserResize="False"
                                                                            CanUserSort="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="core:Variable">
                                                                <Button Classes="rowkill" Content="×"
                                                                        Tag="{Binding}" Click="KillVar"
                                                                        HorizontalAlignment="Center"
                                                                        ToolTip.Tip="Delete this variable"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </TabItem>

                                    <TabItem Header="History" Classes="shell">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Bottom" x:Name="BtnClearHist"
                                                    Classes="tool" Content="Clear" Margin="0,5,0,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" Margin="2,5,0,0"
                                                       Foreground="{DynamicResource FbTextMuted}"
                                                       Text="Double-click to put one back in a tab."/>
                                            <ListBox x:Name="LstHistory" Background="Transparent"
                                                     BorderThickness="0" FontSize="11.5"
                                                     FontFamily="{DynamicResource FbMono}"/>
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" x:Name="SidebarSplitter"/>

                    <Button Grid.Column="0" x:Name="BtnSidebarShow" Classes="gutter"
                            Content="▸" IsVisible="False"
                            ToolTip.Tip="Show the endpoint list"/>

                    <!-- ── REQUEST PANES ────────────────────────────── -->
                    <Grid Grid.Column="2">
                        <TabControl x:Name="Tabs" Background="{DynamicResource FbBgPrimary}" Padding="0"/>
                        <StackPanel x:Name="Empty" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" IsHitTestVisible="False"
                                    Spacing="6">
                            <TextBlock Text="&#128279;" FontSize="35" Opacity="0.35"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Pick an endpoint on the left" FontSize="15"
                                       Foreground="{DynamicResource FbTextMuted}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Each one opens in its own tab, so you can keep several side by side."
                                       FontSize="12.5" Foreground="{DynamicResource FbTextMuted}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ══ DATA ══════════════════════════════════════════
                 The query endpoint promoted to a tab of its own, because it
                 carries an editor and a schema browser and is nothing like the
                 other endpoints. It hosts a real RequestView rather than a
                 second SQL screen, so there is only one of them to maintain and
                 the endpoint still opens in the sidebar like any other. -->
            <TabItem Header="Data" x:Name="TabData" Classes="shell">
                <Grid x:Name="DataGridCols" ColumnDefinitions="300,6,*">

                    <!-- ── SCHEMA BROWSER ─────────────────────── -->
                    <Border Grid.Column="0" x:Name="SchemaBrowserPane" Background="{DynamicResource FbBgSubtle}"
                            BorderBrush="{DynamicResource FbBorder}" BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="*,6,Auto">

                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Top" Margin="10,9,10,6" Spacing="6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" x:Name="BtnSchemaRefresh"
                                                Classes="tool" Content="Refresh" Margin="0" Padding="8,2"
                                                ToolTip.Tip="Read the tables and columns from this server again"/>
                                        <Button DockPanel.Dock="Right" x:Name="BtnSchemaHide"
                                                Classes="tool" Content="Hide ◂" Padding="8,2" Margin="0,0,6,0"
                                                ToolTip.Tip="Fold the browser away and give the editor the width"/>
                                        <TextBlock Classes="label" Text="SCHEMA" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBox x:Name="TxtSchemaFilter" FontSize="13" Padding="6,4"
                                             Watermark="Find a table, or the table a column belongs to"/>
                                    <TextBlock x:Name="TxtSchemaInfo" FontSize="10.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource FbTextMuted}"/>
                                </StackPanel>

                                <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" Margin="12,6,10,10"
                                           TextWrapping="Wrap" Foreground="{DynamicResource FbTextMuted}"
                                           Text="Double-click a table or column to put it in the editor."/>

                                <TreeView x:Name="TreeSchema" BorderThickness="0"
                                          Background="Transparent" Padding="6,0">
                                    <TreeView.Styles>
                                        <!-- A group and a table both remember whether they
                                             are open; a column has no children to open. -->
                                        <Style Selector="TreeViewItem" x:DataType="core:SchemaGroup">
                                            <Setter Property="IsExpanded"
                                                    Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>
                                        </Style>
                                    </TreeView.Styles>

                                    <TreeView.DataTemplates>
                                        <TreeDataTemplate DataType="core:SchemaGroup"
                                                          ItemsSource="{Binding Items}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3">
                                                <TextBlock Text="{Binding Name}" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource FbTextMuted}"/>
                                                <TextBlock Text="{Binding CountLabel}" FontSize="10.5"
                                                           Foreground="{DynamicResource FbTextMuted}"/>
                                            </StackPanel>
                                        </TreeDataTemplate>

                                        <TreeDataTemplate DataType="core:TableNode"
                                                          ItemsSource="{Binding Columns}">
                                            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,1"
                                                        ToolTip.Tip="{Binding Hint}">
                                                <Border CornerRadius="3" Padding="5,1" MinWidth="40"
                                                        Background="{Binding IsView, Converter={StaticResource ViewFill}}">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="9.5"
                                                               FontWeight="Bold"
                                                               FontFamily="{DynamicResource FbMono}"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{Binding IsView, Converter={StaticResource ViewInk}}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           FontFamily="{DynamicResource FbMono}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CountLabel}" FontSize="10.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FbTextMuted}"/>
                                                <!-- The warning that is not visible from the name:
                                                     MySQL builds this view in full before applying
                                                     any WHERE, so filtering it is not cheap. -->
                                                <Border CornerRadius="3" Padding="5,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsHeavy}"
                                                        Background="{DynamicResource MethodDeleteBg}">
                                                    <TextBlock Text="materialises" FontSize="9.5"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource FbWarning}"/>
                                                </Border>
                                            </StackPanel>
                                        </TreeDataTemplate>

                                        <DataTemplate DataType="core:ColumnNode">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,1"
                                                       FontFamily="{DynamicResource FbMono}"
                                                       Foreground="{DynamicResource FbTextSub}"/>
                                        </DataTemplate>
                                    </TreeView.DataTemplates>
                                </TreeView>
                            </DockPanel>

                            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>

                            <!-- The same workspace panel as the Requests tab,
                                 moved here rather than duplicated: one list of
                                 variables, not two that have to be kept in step. -->
                            <Border Grid.Row="2" x:Name="WorkHostData" Height="240"
                                    Background="{DynamicResource FbBgPanel}"
                                    BorderBrush="{DynamicResource FbBorder}"
                                    BorderThickness="0,1,0,0"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" x:Name="SchemaSplitter"/>

                    <!-- The query pane itself, added in code so it is the same
                         RequestView every other endpoint uses. -->
                    <Grid Grid.Column="2" x:Name="DataHost"/>

                    <!-- The way back. A folded panel with no handle is a panel
                         that is gone, so the button that hid it leaves this
                         behind in its place. -->
                    <Button Grid.Column="0" x:Name="BtnSchemaShow" Classes="gutter"
                            Content="▸" IsVisible="False"
                            ToolTip.Tip="Show the schema browser"/>
                </Grid>
            </TabItem>

            <!-- ══ DOCUMENTATION ═════════════════════════════════════════════
                 Two documents, deliberately kept apart. One is about driving
                 this window; the other is about building an integration on the
                 API, and is a verbatim copy of the Fishbowl guide — so nothing
                 is ever added to it here. -->
            <TabItem Header="Documentation" x:Name="TabDocs" Classes="shell"
                     DockPanel.Dock="Right">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource FbBgPanel}" Padding="12,7"
                            BorderBrush="{DynamicResource FbBorder}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="0">
                                <RadioButton x:Name="DocTool" Classes="seg first" GroupName="Docs"
                                             Content="Using this tool" IsChecked="True"/>
                                <RadioButton x:Name="DocApi" Classes="seg last" GroupName="Docs"
                                             Content="Fishbowl API guide"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="BtnDocsBack" Classes="tool" Content="◂ Back" Margin="0"/>
                                <Button x:Name="BtnDocsReload" Classes="tool" Content="Reload" Margin="0"/>
                                <Button x:Name="BtnDocsOpen" Classes="tool" Content="Open in browser" Margin="0"
                                        ToolTip.Tip="Open the same page outside the tool, to print it or keep it beside the window"/>

                                <!-- ── THE OFFICIAL SOURCES ──────────────────
                                     The two guides in this tab are a copy and a
                                     commentary. These three are the originals,
                                     and one of them is generated by the server
                                     in front of you — so they open outside the
                                     tool, where a link can be followed and a
                                     page kept. -->
                                <Button x:Name="BtnDocsOfficial" Classes="tool" Content="Official docs ▾"
                                        Margin="0">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem x:Name="MnuHelpSite"
                                                      Header="Fishbowl help centre — REST API"
                                                      ToolTip.Tip="help.fishbowlinventory.com — the published article"/>
                                            <MenuItem x:Name="MnuServerDocs"
                                                      Header="This server's /apidocs"
                                                      ToolTip.Tip="The browsable reference this server generates for itself"/>
                                            <MenuItem x:Name="MnuServerDocsJson"
                                                      Header="This server's /apidocs.json"
                                                      ToolTip.Tip="The same reference as machine-readable JSON — what the endpoint catalog is built from"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBlock/>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="DocsHost"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>

    <Grid x:Name="TourHost" IsHitTestVisible="False"/>
    </Grid>
</Window>
