<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      DENSITY.

      Avalonia's Fluent theme is built for touch: its controls are 32–36px tall
      where the WPF build's are 22–26px. On a window that is mostly a form —
      three stacked panels of key/value rows, a tree of 107 endpoints, a
      response grid — that difference is not cosmetic. It is the difference
      between seeing a whole category and scrolling for it.

      Everything here narrows the stock metrics to the ones the WPF build uses.
      None of it changes colour; the palette is in Brand.axaml and the chrome in
      Chrome.axaml.
    -->

    <!-- MinHeight has to be cleared as well as Padding: the theme sets both,
         and the larger of the two wins. -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- 107 endpoints in 21 categories: four pixels a row is a category and a
         half of visible list. -->
    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="Expander">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#PART_toggle">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

</Styles>
