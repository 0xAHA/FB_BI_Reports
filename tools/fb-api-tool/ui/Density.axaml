<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      DENSITY.

      Avalonia's Fluent theme is built for touch: its controls are 32–36px tall
      where the WPF build's are 22–26px. On a window that is mostly a form —
      three stacked panels of key/value rows, a tree of 107 endpoints, a
      response grid — that difference is not cosmetic. It is the difference
      between seeing a whole category and scrolling for it.

      Everything here narrows the stock metrics to the ones the WPF build uses.
      It changes colour only where the stock one is wrong for a dense form; the
      palette is in Brand.axaml and the chrome in Chrome.axaml.
    -->

    <!-- Every style sheet pulls the palette in for itself. Avalonia resolves a
         StaticResource against the Styles that owns it, and this sheet loads
         before Chrome.axaml, so it cannot borrow Chrome's copy. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FbApiTool/Brand.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- MinHeight has to be cleared as well as Padding: the theme sets both,
         and the larger of the two wins. -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="4" />
        <!-- The theme's field border is nearly as dark as the text in it. On a
             form of two dozen boxes that reads as a grid of cages; the border
             only has to say where the box is. -->
        <Setter Property="BorderBrush" Value="{DynamicResource FbBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource FbBorderStrong}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource FbBlue}" />
    </Style>

    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource FbBorder}" />
    </Style>

    <!-- The grab area stays wide enough to hit; only the line is thin. A
         splitter that looks like a 4px bar reads as part of the layout rather
         than as the join between two halves of it. -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource FbTint}" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- 107 endpoints in 21 categories: four pixels a row is a category and a
         half of visible list. -->
    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="Expander">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#PART_toggle">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Every grid is a boxed table, not a floating list of rows. Without an
         outer rule the results ran into the pane around them and the last row
         had no bottom edge. -->
    <Style Selector="DataGrid">
        <Setter Property="BorderBrush" Value="{DynamicResource FbBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="DataGridColumnHeader">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <!-- Named explicitly rather than inherited. A grid showing data in a
             monospace face passes that face to its headers too, and the mono
             family has no bold cut — so the header quietly came out the same
             weight as the rows it labels. A header is chrome, not data. -->
        <Setter Property="FontFamily" Value="{DynamicResource FbFont}" />
        <Setter Property="Foreground" Value="{DynamicResource FbTextSub}" />
        <Setter Property="Background" Value="{DynamicResource FbBg2}" />
    </Style>
    <Style Selector="DataGridColumnHeader /template/ ContentPresenter">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- 12.5, the same as the Pretty and Raw views. The three are read one
         after another on the same response and should not change size. -->
    <Style Selector="DataGridCell">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

</Styles>
