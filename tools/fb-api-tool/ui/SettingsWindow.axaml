<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FbApiTool.Ui"
        xmlns:core="clr-namespace:FbApiTool;assembly=FbApiTool.Core"
        x:Class="FbApiTool.Ui.SettingsWindow"
        Title="Settings"
        Width="920" Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel>

        <!-- ══ HEADER ═══════════════════════════════════════════════════
             The build is here rather than inside a group, because the first
             thing anyone is asked when they report something is which build
             they are on, and hunting for it is one step too many. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource FbBrandBar}" Padding="20,13">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="TxtBuild" Foreground="{DynamicResource FbOnBrandSub}"
                           FontSize="11.5" VerticalAlignment="Center"
                           FontFamily="{DynamicResource FbMono}"
                           ToolTip.Tip="The build this window belongs to. Quote it in a bug report."/>
                <StackPanel Spacing="3">
                    <TextBlock x:Name="TxtGroupTitle" Text="Settings" Foreground="{DynamicResource FbOnBrand}"
                               FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtGroupBlurb" Foreground="{DynamicResource FbOnBrandSub}" FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ FOOTER ═══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource FbBg1}"
                BorderBrush="{DynamicResource FbBorder}" BorderThickness="0,1,0,0"
                Padding="18,12">
            <DockPanel>
                <StackPanel x:Name="ServerButtons" DockPanel.Dock="Left" Orientation="Horizontal"
                            Spacing="7" IsVisible="False">
                    <Button x:Name="BtnAdd" Classes="tool" Content="Add" Margin="0"/>
                    <Button x:Name="BtnCopyProfile" Classes="tool" Content="Duplicate" Margin="0"/>
                    <Button x:Name="BtnRemove" Classes="tool" Content="Remove" Margin="0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" x:Name="BtnDone" Classes="primary"
                        Content="Done" MinWidth="106"/>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- ══ GROUPS ═══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Left" Width="212" Background="{DynamicResource FbBgSubtle}"
                BorderBrush="{DynamicResource FbBorder}" BorderThickness="0,0,1,0">
            <ListBox x:Name="LstGroups" Background="Transparent" BorderThickness="0"
                     Padding="6,8" x:DataType="ui:SettingsGroup">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="ui:SettingsGroup">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3">
                            <TextBlock Text="{Binding Glyph}" FontSize="15"
                                       VerticalAlignment="Center" Width="20"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Hint}" FontSize="11"
                                           Foreground="{DynamicResource FbTextMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ══ PAGES ════════════════════════════════════════════════════ -->
        <Grid>

            <!-- ── SERVERS ──────────────────────────────────────────── -->
            <Grid x:Name="PageServers" Margin="16" IsVisible="False"
                  ColumnDefinitions="220,16,*">
                <ListBox Grid.Column="0" x:Name="LstProfiles" FontSize="12.5"
                         x:DataType="core:ServerProfile"
                         BorderBrush="{DynamicResource FbBorder}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="core:ServerProfile">
                            <StackPanel Spacing="1" Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BaseUrl}" FontSize="11"
                                           FontFamily="{DynamicResource FbMono}"
                                           Foreground="{DynamicResource FbTextMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Editor" IsEnabled="False" Spacing="3">
                        <TextBlock Classes="label" Text="NAME"/>
                        <TextBox x:Name="TxtName"/>

                        <TextBlock Classes="label" Text="ADDRESS" Margin="0,9,0,0"/>
                        <TextBox x:Name="TxtUrl" FontFamily="{DynamicResource FbMono}"
                                 ToolTip.Tip="http://host:2456 — the REST port, not the client port"/>
                        <TextBlock x:Name="TxtUrlNote" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FbTextMuted}"/>

                        <TextBlock Classes="label" Text="USERNAME" Margin="0,9,0,0"/>
                        <TextBox x:Name="TxtUser"
                                 ToolTip.Tip="Remembered so the sign-in box arrives filled in. The password never lives here."/>

                        <Grid ColumnDefinitions="*,12,120" Margin="0,9,0,0">
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock Classes="label" Text="INTEGRATED APP NAME"/>
                                <TextBox x:Name="TxtAppName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Classes="label" Text="APP ID"/>
                                <TextBox x:Name="TxtAppId"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource FbTextMuted}"
                                   Text="The server records these against the integration; they appear in its own Integrated Apps list."/>

                        <CheckBox x:Name="ChkProd" Margin="0,12,0,0"
                                  Content="This server holds real data"
                                  ToolTip.Tip="Every write is confirmed before it is sent"/>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource FbTextMuted}"
                                   Text="A POST, PUT or DELETE against a production server asks first. Nothing else changes."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── APPEARANCE ───────────────────────────────────────── -->
            <ScrollViewer x:Name="PageLook" IsVisible="False" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18" Spacing="4">
                    <TextBlock Classes="label" Text="THEME"/>
                    <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left"
                                Margin="0,2,0,0">
                        <RadioButton x:Name="ThemeSystem" Classes="seg first" GroupName="Theme"
                                     Content="System" IsChecked="True"/>
                        <RadioButton x:Name="ThemeLight" Classes="seg" GroupName="Theme"
                                     Content="Light"/>
                        <RadioButton x:Name="ThemeDark" Classes="seg last" GroupName="Theme"
                                     Content="Dark"/>
                    </StackPanel>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="System follows the desktop's own setting, which is what stops this being the only light window on a dark screen. It changes immediately — there is nothing to restart."/>

                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,14,0,0"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="The colours themselves are the Fishbowl palette, the same tokens the reports use. Dark is not that palette inverted: the tints behind a status pill are dimmed rather than lightened, so a strong ink still has something to be strong against."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ── REQUESTS ─────────────────────────────────────────── -->
            <ScrollViewer x:Name="PageRequests" IsVisible="False" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18" Spacing="4">
                    <TextBlock Classes="label" Text="OPEN A RESPONSE ON"/>
                    <ComboBox x:Name="CmbView" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="Auto picks the table when the response has rows in it, and the formatted view otherwise."/>

                    <CheckBox x:Name="ChkKeep" Margin="0,16,0,0"
                              Content="Keep recent data-query results"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="A query run against a live database cannot be re-run to get the same answer, which is the whole reason for writing one down."/>

                    <CheckBox x:Name="ChkLimitRows" Margin="0,16,0,0"
                              Content="Append a row limit to a plain SELECT"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="22,4,0,0">
                        <TextBlock Text="Rows" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtRowLimit" Width="90"/>
                    </StackPanel>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="Only a single SELECT with no LIMIT of its own is touched; anything else is sent exactly as written. The same switch sits above the SQL editor."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ── SESSION ──────────────────────────────────────────── -->
            <ScrollViewer x:Name="PageSession" IsVisible="False" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18" Spacing="4">
                    <CheckBox x:Name="ChkIdle" Content="Sign out when idle"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="A signed-in session holds a Fishbowl seat licence. Leaving the tool open overnight keeps that licence out of circulation, so it is handed back on its own."/>

                    <Grid ColumnDefinitions="140,16,140" Margin="22,12,0,0">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Classes="label" Text="IDLE FOR (MINUTES)"/>
                            <TextBox x:Name="TxtIdleMins"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Classes="label" Text="WARNING (SECONDS)"/>
                            <TextBox x:Name="TxtGraceSecs"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Margin="22,6,0,0"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="The warning counts down in front of you and any key or click cancels it, so a long read is never signed out from under you."/>

                    <TextBlock Classes="label" Text="PASSWORDS" Margin="0,20,0,0"/>
                    <TextBlock x:Name="TxtCreds" FontSize="12.5" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ── ENDPOINT CATALOG ─────────────────────────────────── -->
            <DockPanel x:Name="PageCatalog" IsVisible="False" Margin="22,18">
                <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,12,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock x:Name="TxtCatHead" FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtCatSub" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource FbTextMuted}"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="BtnCheck" Classes="primary"
                                Content="Check for updates" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Top" x:Name="CatActions" IsVisible="False"
                            Spacing="7" Margin="0,0,0,10">
                    <!-- The tick box IS the action, and which action depends on
                         the row: take a new endpoint, take a changed shape, drop
                         one this server does not have. Nothing said so, so the
                         answer to "where is the Remove button?" was a checkbox
                         nobody read as one. -->
                    <TextBlock FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource FbTextSub}"
                               Text="Tick what to take, then Apply. A NEW row is added to the catalog, a CHANGED row takes this server's shape, and a NOT ON SERVER row is removed from the catalog. Removals start unticked."/>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Button x:Name="BtnAll" Classes="tool" Content="All" Margin="0"/>
                        <Button x:Name="BtnNone" Classes="tool" Content="None" Margin="0"/>
                        <Button x:Name="BtnOnlyNew" Classes="tool" Content="Only new" Margin="0"
                                ToolTip.Tip="Additions only — the safe subset. Taking an endpoint this server has cannot break a form that already works."/>
                        <Button x:Name="BtnOnlyGone" Classes="tool" Content="Only removals" Margin="0"
                                ToolTip.Tip="Every endpoint this server's documentation does not list"/>
                        <TextBlock x:Name="TxtCount" FontSize="12" VerticalAlignment="Center"
                                   Margin="8,0,0,0" Foreground="{DynamicResource FbTextMuted}"/>
                        <Button x:Name="BtnApply" Classes="primary" Content="Apply" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="TxtCatNote" DockPanel.Dock="Bottom" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource FbTextMuted}"/>

                <!-- Horizontal scrolling off, so a row is bounded by the list
                     and the reason can wrap instead of running off the side. -->
                <ListBox x:Name="LstChanges" BorderThickness="1" FontSize="12"
                         x:DataType="core:CatalogChange"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderBrush="{DynamicResource FbBorder}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="core:CatalogChange">
                            <!-- The reason goes UNDER the endpoint, not beside it.
                                 Beside it, a removal's explanation — a whole
                                 sentence about why this server might not list
                                 it — was trimmed away to nothing, leaving five
                                 rows that said only "NOT ON SERVER". -->
                            <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto"
                                  Margin="0,4">
                                <CheckBox Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                          IsChecked="{Binding Apply, Mode=TwoWay}"
                                          Margin="0,0,8,0" VerticalAlignment="Top"/>

                                <Border Grid.Column="1" Grid.Row="0" CornerRadius="3" Padding="6,1"
                                        MinWidth="86" Margin="0,0,9,0" VerticalAlignment="Center"
                                        Background="{DynamicResource FbBg2}">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                               FontWeight="Bold" HorizontalAlignment="Center"
                                               Foreground="{Binding Kind, Converter={StaticResource ChangeKindBrush}}"/>
                                </Border>

                                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal"
                                            Spacing="8">
                                    <TextBlock Text="{Binding Header}" FontSize="12"
                                               FontFamily="{DynamicResource FbMono}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource FbTextSub}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding DetailText}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,2,6,0"
                                           Foreground="{DynamicResource FbTextMuted}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ── HELP AND TIPS ────────────────────────────────────── -->
            <ScrollViewer x:Name="PageHelp" IsVisible="False" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18" Spacing="4">
                    <CheckBox x:Name="ChkTips" Content="Show the guided tour when the tool starts"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="The tour points at the sidebar, the form, the variables and the SQL editor in turn. It runs once and then stays out of the way."/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                        <Button x:Name="BtnTour" Classes="tool" Content="Start the tour now" Margin="0"/>
                        <Button x:Name="BtnDocs" Classes="tool" Content="Open the documentation" Margin="0"/>
                    </StackPanel>

                    <TextBlock Classes="label" Text="RESET" Margin="0,22,0,0"/>
                    <Button x:Name="BtnReset" Classes="tool" Content="Forget saved settings"
                            HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource FbTextMuted}"
                               Text="Clears the preferences on this page and puts the tour back. Servers, variables and saved requests are left alone."/>

                    <TextBlock Classes="label" Text="BUILD" Margin="0,22,0,0"/>
                    <TextBox x:Name="TxtBuildLong" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" FontSize="12"
                             FontFamily="{DynamicResource FbMono}" Padding="0"/>
                    <TextBlock x:Name="TxtAbout" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource FbTextSub}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
