<Window x:Class="FbApiTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FbApiTool"
        Title="Fishbowl API Tool" Height="980" Width="1640"
        Icon="assets/fishbowl.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Request tabs. Same treatment as the report host's: the stock Fluent
             strip renders selected and unselected in near-identical greys, so
             the active request comes forward to white with the brand accent bar
             and a dark semibold label while the rest stay muted. -->
        <Style x:Key="ReqTab" TargetType="TabItem">
            <Setter Property="Background" Value="#E8EEF2"/>
            <Setter Property="Foreground" Value="{StaticResource FbTextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource FbBorder}" BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Accent" Height="3" VerticalAlignment="Top"
                                        Background="{StaticResource FbBlue}"
                                        CornerRadius="3,3,0,0" Visibility="Collapsed"/>
                                <ContentPresenter ContentSource="Header" Margin="11,6,8,6"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="White"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FbBorderStrong}"/>
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource FbText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource FbTint}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One endpoint in the sidebar: the verb badge carries the colour, so
             a DELETE is recognisable before the name is read. -->
        <DataTemplate DataType="{x:Type local:EndpointNode}">
            <StackPanel Orientation="Horizontal" Margin="0,1" ToolTip="{Binding ToolTip}">
                <Border Background="{Binding MethodBrush}" CornerRadius="3" Padding="5,1" MinWidth="46">
                    <TextBlock Text="{Binding Method}" Foreground="{Binding MethodInk}" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               FontFamily="{StaticResource FbMono}"/>
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="13" Margin="7,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type local:CategoryNode}" ItemsSource="{Binding Endpoints}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CountLabel}" FontSize="11" Margin="6,1,0,0"
                           Foreground="{StaticResource FbTextMuted}"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <!-- The tour overlay has to cover the brand bar too, so the whole window
         lives in a Grid and TourHost is laid over the top of it. -->
    <Grid>
    <DockPanel>

        <!-- ── BRAND / CONNECTION ─────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" x:Name="BrandBar" Background="{StaticResource FbBlue}" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Fishbowl API Tool" Foreground="White"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" x:Name="TxtBuiltFor" Foreground="#DEEAF4"
                           FontSize="12.5" VerticalAlignment="Center" Margin="9,2,0,0"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border x:Name="ChipDocs" Background="#1E7BB4" CornerRadius="10" Padding="9,2"
                            Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonUp="ChipDocs_Click"
                            ToolTip="The catalog version, and the version this server publishes. Click to review updates.">
                        <TextBlock x:Name="TxtDocsChip" Foreground="White" FontSize="11.5"/>
                    </Border>
                    <ComboBox x:Name="CmbProfile" Width="168" Margin="0,0,6,0"
                              VerticalAlignment="Center" FontSize="12.5"
                              SelectionChanged="CmbProfile_Changed"
                              ToolTip="The server to talk to. Manage the list with the button beside it."/>
                    <Button x:Name="BtnProfiles" Content="⚙" Click="BtnProfiles_Click"
                            Style="{StaticResource OnBrand}" Padding="9,4" Margin="0,0,10,0"
                            ToolTip="Settings — servers, response defaults, idle sign-out and the guided tour"/>
                    <TextBlock x:Name="TxtAuth" Foreground="White" FontSize="12.5"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="BtnAuth" Content="Connect" Click="BtnAuth_Click"
                            Style="{StaticResource OnBrand}"/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- Shown only on a profile marked production. Loud on purpose:
             this window sends real writes at real databases. -->
        <Border DockPanel.Dock="Top" x:Name="ProdBanner" Background="{StaticResource FbNegative}"
                Padding="14,5" Visibility="Collapsed">
            <TextBlock x:Name="TxtProdBanner" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Shown while the idle countdown is running. -->
        <Border DockPanel.Dock="Top" x:Name="IdleBanner" Background="{StaticResource FbWarning}"
                Padding="14,5" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Stay signed in" Click="BtnStaySignedIn_Click"
                        Style="{StaticResource OnBrand}" Padding="9,2" HorizontalAlignment="Right"/>
                <TextBlock x:Name="TxtIdle" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ── STATUS ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" Padding="12,5"
                BorderBrush="{StaticResource FbBorder}" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Always on screen, so the answer to "which build is that?"
                     never depends on opening a dialog first. -->
                <TextBlock DockPanel.Dock="Right" x:Name="TxtVersion" FontSize="11"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource FbMono}"
                           Foreground="{StaticResource FbTextMuted}"
                           ToolTip="Version, build date and a hash unique to this compilation. Settings shows the same thing in a form you can copy."/>
                <TextBlock DockPanel.Dock="Right" x:Name="TxtServerChip" FontSize="12"
                           Foreground="{StaticResource FbTextMuted}"/>
                <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="{StaticResource FbTextSub}"
                           Text="Pick an endpoint." TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Shell" BorderThickness="0" Padding="0"
                    SelectionChanged="Shell_Changed">

            <!-- The tab strip is a DockPanel rather than the stock TabPanel so
                 that Documentation can dock to the right, away from the two
                 tabs you actually work in. LastChildFill is off, or the last
                 tab would stretch across whatever space is left.
                 The template has to be replaced as well: the Fluent
                 TabControl puts its own panel in directly instead of an
                 ItemsPresenter, so ItemsPanel alone is quietly ignored. -->
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="White"
                                BorderBrush="{StaticResource FbBorder}" BorderThickness="0,0,0,1">
                            <ItemsPresenter/>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>

            <!-- ══ REQUESTS ══════════════════════════════════════════════ -->
            <TabItem Header="Requests">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── ENDPOINT SIDEBAR ──────────────────────────── -->
                    <Border Grid.Column="0" Background="#FBFCFD"
                            BorderBrush="{StaticResource FbBorder}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="80"/>
                                <RowDefinition Height="Auto"/>
                                <!-- Dragged by the splitter above it, and remembered
                                     between sessions. -->
                                <RowDefinition x:Name="RowWorkspace" Height="240" MinHeight="72"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="10,9,10,6">
                                <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged"
                                         Padding="6,4" FontSize="13"
                                         ToolTip="Filter by name, path or description"/>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <ToggleButton x:Name="TogGet" Content="GET" IsChecked="True"
                                                  Style="{StaticResource VerbFilter}" Click="Method_Toggled"
                                                  Background="{StaticResource MethodGetBg}"
                                                  Foreground="{StaticResource MethodGet}" Margin="0,0,4,0"/>
                                    <ToggleButton x:Name="TogPost" Content="POST" IsChecked="True"
                                                  Style="{StaticResource VerbFilter}" Click="Method_Toggled"
                                                  Background="{StaticResource MethodPostBg}"
                                                  Foreground="{StaticResource MethodPost}" Margin="0,0,4,0"/>
                                    <ToggleButton x:Name="TogDelete" Content="DELETE" IsChecked="True"
                                                  Style="{StaticResource VerbFilter}" Click="Method_Toggled"
                                                  Background="{StaticResource MethodDeleteBg}"
                                                  Foreground="{StaticResource MethodDelete}" Margin="0,0,9,0"/>
                                    <Button Content="&#8862;" Click="BtnExpandAll_Click" Style="{StaticResource Tool}"
                                            Padding="8,2" Margin="0" ToolTip="Expand every category"/>
                                    <Button Content="&#8863;" Click="BtnCollapseAll_Click" Style="{StaticResource Tool}"
                                            Padding="8,2" Margin="3,0,0,0" ToolTip="Collapse every category"/>
                                </StackPanel>
                            </StackPanel>

                            <TreeView Grid.Row="1" x:Name="TreeEndpoints" BorderThickness="0" Background="Transparent"
                                      MouseDoubleClick="TreeEndpoints_MouseDoubleClick"
                                      SelectedItemChanged="TreeEndpoints_SelectedItemChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2,1"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>

                            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" Background="{StaticResource FbBorder}"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                                          ToolTip="Drag to resize"/>

                                <Border Grid.Row="3" BorderBrush="{StaticResource FbBorder}"
                                        BorderThickness="0,1,0,0" Background="#F7FAFC">
                                  <ContentControl x:Name="WorkHostRequests">
                                    <TabControl x:Name="Workspace" BorderThickness="0" Background="Transparent"
                                                Padding="8,4,8,8">
                                        <TabItem Header="Saved">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                            Margin="0,5,0,0">
                                                    <Button Content="Open" Click="BtnOpenSaved_Click"
                                                            Style="{StaticResource Tool}"
                                                            ToolTip="Open this request, filled in"/>
                                                    <Button Content="Rename" Click="BtnRenameSaved_Click"
                                                            Style="{StaticResource Tool}"/>
                                                    <Button Content="Delete" Click="BtnDeleteSaved_Click"
                                                            Style="{StaticResource Tool}" Margin="0"/>
                                                </StackPanel>
                                                <ListBox x:Name="LstSaved" BorderThickness="0" Background="Transparent"
                                                         FontSize="12" MouseDoubleClick="LstSaved_DoubleClick"
                                                         ToolTip="Double-click to open a saved request">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,1">
                                                                <!-- Removing one is a per-row action, so it belongs on
                                                                     the row: selecting first and then reaching for a
                                                                     button at the bottom is two steps for a delete. -->
                                                                <Button DockPanel.Dock="Right" Content="×"
                                                                        Style="{StaticResource RowKill}"
                                                                        Click="BtnKillSaved_Click"
                                                                        Tag="{Binding}" Margin="6,0,0,0"
                                                                        ToolTip="Delete this saved request"/>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}"
                                                                           FontSize="10.5" Margin="9,0,0,0"
                                                                           FontFamily="{StaticResource FbMono}"
                                                                           Foreground="{StaticResource FbTextMuted}"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </DockPanel>
                                        </TabItem>

                                        <TabItem Header="Variables">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                            Margin="0,5,0,0">
                                                    <Button Content="+ Add" Click="BtnAddVar_Click"
                                                            Style="{StaticResource Tool}"/>
                                                    <Button Content="Remove" Click="BtnRemoveVar_Click"
                                                            Style="{StaticResource Tool}"/>
                                                    <Button Content="Clear all" Click="BtnClearVars_Click"
                                                            Style="{StaticResource Tool}" Margin="0"/>
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" Margin="2,5,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource FbTextMuted}"
                                                           Text="Name them without braces — soId, not {{soId}} — then write {{soId}} in any field. Capture a value from a response with the button under it."/>
                                                <DataGrid x:Name="GridVars" AutoGenerateColumns="False"
                                                          BorderThickness="0" Background="Transparent"
                                                          CanUserAddRows="False" FontSize="12"
                                                          GridLinesVisibility="Horizontal"
                                                          CellEditEnding="GridVars_Edited">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}"
                                                                            Width="130"
                                                                            FontFamily="{StaticResource FbMono}">
                                                            <DataGridTextColumn.HeaderStyle>
                                                                <Style TargetType="DataGridColumnHeader"
                                                                       BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                    <Setter Property="ToolTip"
                                                                            Value="The bare name, e.g. soId. Braces are how you refer to it in a field, not part of the name — they are stripped if you type them."/>
                                                                </Style>
                                                            </DataGridTextColumn.HeaderStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}"
                                                                            Width="*"/>
                                                        <!-- Wide enough for the button AND the cell padding
                                                             around it; 30 clipped the glyph. -->
                                                        <DataGridTemplateColumn Width="38">
                                                            <DataGridTemplateColumn.CellStyle>
                                                                <Style TargetType="DataGridCell"
                                                                       BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                </Style>
                                                            </DataGridTemplateColumn.CellStyle>
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="×" Style="{StaticResource RowKill}"
                                                                            Click="BtnKillVar_Click" Tag="{Binding}"
                                                                            HorizontalAlignment="Center"
                                                                            ToolTip="Remove this variable"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </TabItem>

                                        <TabItem Header="History">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Bottom" Content="Clear" Click="BtnClearHist_Click"
                                                        Style="{StaticResource Tool}" Margin="0,5,0,0"
                                                        HorizontalAlignment="Left" Padding="8,2"/>
                                                <ListBox x:Name="LstHistory" BorderThickness="0" Background="Transparent"
                                                         FontSize="12" MouseDoubleClick="LstHistory_DoubleClick"
                                                         ToolTip="Double-click to open that request again, filled in"/>
                                            </DockPanel>
                                        </TabItem>
                                    </TabControl>
                                  </ContentControl>
                                </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{StaticResource FbBorder}"/>

                    <!-- ── OPEN REQUESTS ─────────────────────────────── -->
                    <Grid Grid.Column="2">
                        <TabControl x:Name="Tabs" Background="White"
                                    BorderBrush="{StaticResource FbBorderStrong}" BorderThickness="0,1,0,0"
                                    Padding="0" ItemContainerStyle="{StaticResource ReqTab}"/>

                        <!-- Shown until the first request is opened. -->
                        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="&#128279;" FontSize="35" HorizontalAlignment="Center" Opacity="0.35"/>
                            <TextBlock Text="Pick an endpoint on the left" FontSize="15" Margin="0,10,0,0"
                                       Foreground="{StaticResource FbTextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Each one opens in its own tab, so you can keep several side by side."
                                       FontSize="12.5" Margin="0,5,0,0"
                                       Foreground="{StaticResource FbTextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ══ DATA ══════════════════════════════════════════════════
                 The query endpoint promoted to a tab of its own, because by now
                 it carries an editor, kept results and a comparison view and is
                 nothing like the other endpoints. It hosts a real RequestView
                 rather than a second SQL UI, so there is only ever one of them
                 to maintain, and the endpoint still opens in the sidebar as
                 before. -->
            <TabItem Header="Data" x:Name="TabData">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColSchema" Width="300" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="380"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── SCHEMA BROWSER ────────────────────────────── -->
                    <Border Grid.Column="0" Background="#FBFCFD"
                            BorderBrush="{StaticResource FbBorder}" BorderThickness="0,0,1,0">
                      <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="80"/>
                            <RowDefinition Height="Auto"/>
                            <!-- The same workspace panel as the Requests tab; it
                                 is moved between the two rather than duplicated,
                                 so there is one list of variables, not two that
                                 have to be kept in step. -->
                            <RowDefinition x:Name="RowWorkspaceData" Height="240" MinHeight="72"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Top" Margin="10,9,10,6">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="SCHEMA"
                                               Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                                    <Button DockPanel.Dock="Right" x:Name="BtnSchemaRefresh" Content="Refresh"
                                            Click="BtnSchemaRefresh_Click" Style="{StaticResource Tool}"
                                            Margin="0" HorizontalAlignment="Right"
                                            ToolTip="Read the tables and columns from this server again"/>
                                    <TextBlock/>
                                </DockPanel>
                                <TextBox x:Name="TxtSchemaFilter" TextChanged="TxtSchemaFilter_TextChanged"
                                         Padding="6,4" FontSize="13"
                                         ToolTip="Find a table, or the table a column belongs to"/>
                                <TextBlock x:Name="TxtSchemaInfo" FontSize="10.5" Margin="2,6,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource FbTextMuted}"/>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Bottom" FontSize="10.5" Margin="12,6,10,10"
                                       TextWrapping="Wrap" Foreground="{StaticResource FbTextMuted}"
                                       Text="Double-click a table or column to put it in the editor."/>

                            <TreeView x:Name="TreeSchema" BorderThickness="0" Background="Transparent"
                                      MouseDoubleClick="TreeSchema_DoubleClick">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Padding" Value="2,1"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>

                                <TreeView.Resources>
                                    <!-- Tables and views, kept apart. -->
                                    <HierarchicalDataTemplate DataType="{x:Type local:SchemaGroup}"
                                                              ItemsSource="{Binding Items}">
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource FbTextMuted}"/>
                                            <TextBlock Text="{Binding CountLabel}" FontSize="10.5"
                                                       Margin="6,0,0,0"
                                                       Foreground="{StaticResource FbTextMuted}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>

                                    <HierarchicalDataTemplate DataType="{x:Type local:TableNode}"
                                                              ItemsSource="{Binding Columns}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1"
                                                    ToolTip="{Binding Hint}">
                                            <Border Background="{Binding KindFill}" CornerRadius="3"
                                                    Padding="5,1" MinWidth="40">
                                                <TextBlock Text="{Binding KindLabel}" Foreground="{Binding KindInk}"
                                                           FontSize="9.5" FontWeight="Bold"
                                                           FontFamily="{StaticResource FbMono}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Margin="7,0,0,0"
                                                       FontFamily="{StaticResource FbMono}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CountLabel}" FontSize="10.5"
                                                       Margin="6,1,0,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource FbTextMuted}"/>
                                            <!-- The warning that is not visible from the name. -->
                                            <Border Background="{StaticResource MethodDeleteBg}" CornerRadius="3"
                                                    Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HeavyVisibility}">
                                                <TextBlock Text="materialises" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{StaticResource FbWarning}"/>
                                            </Border>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>

                                    <DataTemplate DataType="{x:Type local:ColumnNode}">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,1"
                                                   FontFamily="{StaticResource FbMono}"
                                                   Foreground="{StaticResource FbTextSub}"/>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </DockPanel>

                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" Background="{StaticResource FbBorder}"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                                      ToolTip="Drag to resize"/>

                        <Border Grid.Row="2" BorderBrush="{StaticResource FbBorder}"
                                BorderThickness="0,1,0,0" Background="#F7FAFC">
                            <ContentControl x:Name="WorkHostData"/>
                        </Border>
                      </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                  Background="{StaticResource FbBorder}"/>

                    <!-- The query pane itself, added in code so it is the same
                         RequestView every other endpoint uses. -->
                    <Grid Grid.Column="2" x:Name="DataHost"/>
                </Grid>
            </TabItem>

            <!-- ══ DOCUMENTATION ═════════════════════════════════════════ -->
            <TabItem Header="Documentation" x:Name="TabDocs" DockPanel.Dock="Right">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F7FAFC" Padding="12,7"
                            BorderBrush="{StaticResource FbBorder}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <!-- Two documents, deliberately kept apart. One is about
                                 driving this window; the other is about building an
                                 integration on the API, and is a verbatim copy of the
                                 Fishbowl guide — so nothing is ever added to it here. -->
                            <Border DockPanel.Dock="Left" BorderBrush="{StaticResource FbBorderStrong}"
                                    BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="DocTool" Content="Using this tool" GroupName="Docs"
                                                 Style="{StaticResource Segment}" IsChecked="True"
                                                 Click="Doc_Click"/>
                                    <RadioButton x:Name="DocApi" Content="Fishbowl API guide" GroupName="Docs"
                                                 Style="{StaticResource Segment}" Click="Doc_Click"/>
                                </StackPanel>
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Back" Click="BtnDocsBack_Click" Style="{StaticResource Tool}"/>
                                <Button Content="Reload" Click="BtnDocsHome_Click" Style="{StaticResource Tool}"/>
                                <Button Content="Open this server's API docs" Click="BtnDocsLive_Click"
                                        Style="{StaticResource Tool}" Margin="0"
                                        ToolTip="Opens /apidocs on the connected server in your browser"/>
                            </StackPanel>
                            <TextBlock/>
                        </DockPanel>
                    </Border>
                    <Grid x:Name="DocsHost"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>

    <Grid x:Name="TourHost" Panel.ZIndex="50" IsHitTestVisible="False"/>
    </Grid>
</Window>
