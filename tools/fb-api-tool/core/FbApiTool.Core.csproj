<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything the tool knows how to do, with nothing that knows how to draw.

    This is the half that survives a change of UI framework: the catalog and
    its importer, the request runner, the SQL formatter, highlighter and
    completion engine, the schema reader, variables, saved requests, kept
    results and their comparison, cURL, access rights and the idle watch.

    It targets plain net9.0 rather than net9.0-windows so that the compiler,
    not a reviewer, is what stops a Brush or a Visibility being referenced
    from here. The one Windows-specific piece left in it is CredentialStore,
    which is guarded at runtime rather than by the target framework, because
    everything around it is portable and splitting the file would be worse
    than the guard.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FbApiTool.Core</AssemblyName>
    <RootNamespace>FbApiTool</RootNamespace>
    <!-- CA1416: CredentialStore calls advapi32. The call sites check first. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- One implementation of sign-in, shared with the report host rather than
         forked: the MFA-as-a-header and app-approval rules are easy to get
         subtly wrong and must not drift between the two tools. -->
    <Compile Include="..\..\fb-report-host\FishbowlClient.cs" Link="FishbowlClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog and both guides are embedded HERE, not in the UI project,
         because Assets.cs reads them out of its own assembly. A UI that
         carries its own copy would be a second answer to "which catalog is
         this?" -->
    <EmbeddedResource Include="..\assets\catalog.json" LogicalName="FbApiTool.assets.catalog.json" />
    <EmbeddedResource Include="..\assets\guide.html" LogicalName="FbApiTool.assets.guide.html" />
    <EmbeddedResource Include="..\assets\tool-guide.built.html" LogicalName="FbApiTool.assets.tool-guide.built.html" />
  </ItemGroup>

</Project>
