<Window x:Class="FbApiTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FbApiTool"
        Title="Settings"
        Icon="assets/fishbowl.ico"
        Width="980" Height="700" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource FbBlue}" Padding="20,14">
            <DockPanel>
                <!-- The build, where it is visible from every group: the first
                     thing worth knowing about a bug is which build it is in. -->
                <Border DockPanel.Dock="Right" Background="#1E7BB4" CornerRadius="10"
                        Padding="10,3" VerticalAlignment="Top" Margin="16,0,0,0"
                        ToolTip="Version, the day this executable was built, and a hash unique to this compilation. Quote it in a bug report.">
                    <TextBlock x:Name="TxtBuild" Foreground="White" FontSize="11.5"
                               FontFamily="{StaticResource FbMono}"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Settings" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtGroupBlurb" Foreground="#DEEAF4" FontSize="13"
                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="{StaticResource FbBorder}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel x:Name="ServerButtons" DockPanel.Dock="Left" Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Button Content="Add" Click="BtnAdd_Click" Style="{StaticResource Tool}" Padding="13,5"/>
                    <Button Content="Duplicate" Click="BtnCopy_Click" Style="{StaticResource Tool}" Padding="13,5"/>
                    <Button Content="Remove" Click="BtnRemove_Click" Style="{StaticResource Tool}" Padding="13,5" Margin="0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Content="Done" Click="BtnDone_Click" IsDefault="True"
                        Style="{StaticResource Primary}" MinWidth="106"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ GROUPS ═══════════════════════════════════════════════════
                 A list rather than tabs: there will be more of these, and a
                 tab strip is the control that runs out of room first. -->
            <Border Grid.Column="0" Background="{StaticResource FbBg2}"
                    BorderBrush="{StaticResource FbBorder}" BorderThickness="0,0,1,0">
                <ListBox x:Name="LstGroups" SelectionChanged="LstGroups_Changed"
                         BorderThickness="0" Background="Transparent" Margin="0,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="15"
                                           Width="26" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Hint}" FontSize="11"
                                               Foreground="{StaticResource FbTextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,7"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent"
                                                Padding="{TemplateBinding Padding}"
                                                BorderBrush="Transparent" BorderThickness="3,0,0,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="White"/>
                                                <Setter TargetName="B" Property="BorderBrush"
                                                        Value="{StaticResource FbBlue}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="B" Property="Background"
                                                        Value="{StaticResource FbTint}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- ══ PAGES ════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1">

                <!-- ── Servers ───────────────────────────────────────────── -->
                <Grid x:Name="PageServers" Margin="16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" x:Name="LstProfiles" SelectionChanged="LstProfiles_Changed"
                             BorderBrush="{StaticResource FbBorder}" BorderThickness="1" Background="#FBFCFD"
                             FontSize="13">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding BaseUrl}" FontSize="11"
                                               FontFamily="{StaticResource FbMono}"
                                               Foreground="{StaticResource FbTextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Editor" IsEnabled="False">
                            <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtName" Margin="0,0,0,11" TextChanged="Field_Changed"/>

                            <TextBlock Text="ADDRESS" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtUrl" Margin="0,0,0,11" TextChanged="Url_Changed"
                                     FontFamily="{StaticResource FbMono}"/>

                            <TextBlock Text="USERNAME (remembered, not the password)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtUser" Margin="0,0,0,11" TextChanged="Field_Changed"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="APP NAME" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtAppName" TextChanged="Field_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="APP ID" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtAppId" TextChanged="Field_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="#E7B3BC" BorderThickness="1" Background="#FBE9EC"
                                    CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkProd" Content="This server holds real data"
                                              FontWeight="SemiBold" Click="Field_Changed"/>
                                    <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="#8A1E30"
                                               Text="The window turns red while this server is selected, and every POST, PUT, PATCH or DELETE asks for confirmation first."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── Requests ──────────────────────────────────────────── -->
                <ScrollViewer x:Name="PageRequests" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18" MaxWidth="560" HorizontalAlignment="Left">

                        <TextBlock Text="DEFAULT RESPONSE VIEW" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbView" Margin="0,0,0,4" SelectionChanged="Pref_Changed">
                            <ComboBoxItem Content="Auto — table for rows, pretty for anything else" Tag="Auto"/>
                            <ComboBoxItem Content="Pretty" Tag="Pretty"/>
                            <ComboBoxItem Content="Table" Tag="Table"/>
                            <ComboBoxItem Content="Raw" Tag="Raw"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource FieldNote}"
                                   Text="Which tab a response opens on. A data query always has rows, so Auto puts it in the table."/>

                        <CheckBox x:Name="ChkKeep" Content="Keep recent data-query results"
                                  Margin="0,18,0,0" Click="Pref_Changed"/>
                        <TextBlock Style="{StaticResource FieldNote}"
                                   Text="Kept on this machine so a query can be compared with the last time it ran. Nothing leaves the computer."/>

                        <CheckBox x:Name="ChkConfirmWrites" Content="Confirm every write to a production server"
                                  Margin="0,18,0,0" IsEnabled="False" IsChecked="True"/>
                        <TextBlock Style="{StaticResource FieldNote}"
                                   Text="Always on. Mark a server as production on the Servers page; the confirmation is per request, because a box ticked an hour ago interrupts nothing."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Session ───────────────────────────────────────────── -->
                <ScrollViewer x:Name="PageSession" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18" MaxWidth="560" HorizontalAlignment="Left">

                        <CheckBox x:Name="ChkIdle" Content="Sign out when idle" Click="Pref_Changed"/>
                        <TextBlock Style="{StaticResource FieldNote}"
                                   Text="A signed-in session holds a Fishbowl seat licence. Leaving the tool open over lunch keeps somebody else out, so it lets go on its own."/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IDLE FOR (MINUTES)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtIdleMins" TextChanged="Pref_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="THEN WARN FOR (SECONDS)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtGraceSecs" TextChanged="Pref_Changed"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldNote}" Margin="0,6,0,0"
                                   Text="A banner counts down during the warning. Any movement or keypress cancels it."/>

                        <Border Background="{StaticResource FbTint}" CornerRadius="6" Padding="12,10" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="A pasted token is never signed out" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Margin="0,5,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource FbTextSub}"
                                           Text="It belongs to whoever issued it and may still be in use elsewhere, so disconnecting here only forgets it."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Catalog ───────────────────────────────────────────── -->
                <DockPanel x:Name="PageCatalog" Visibility="Collapsed" Margin="22,18">

                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtCatHead" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtCatSub" Style="{StaticResource FieldNote}"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnCheck" Content="Check for updates"
                                    Click="BtnCheck_Click" Style="{StaticResource Primary}"
                                    VerticalAlignment="Top" MinWidth="150" Padding="12,6"/>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldNote}" Margin="0,12,0,0"
                                   Text="Everything in the sidebar is generated from this server's own /apidocs.json: the path gives the path parameters, the query list gives the form, and the field tree gives both the schema table and an editable body template. Nothing is sent anywhere — this only rewrites the local catalog."/>
                        <TextBlock Style="{StaticResource FieldNote}" Margin="0,7,0,0"
                                   Text="For an endpoint that already exists only the machine-readable parts are refreshed. Its name, its category and any note written into the catalog by hand are kept."/>

                        <StackPanel x:Name="CatActions" Orientation="Horizontal" Margin="0,12,0,0"
                                    Visibility="Collapsed">
                            <Button Content="Select all" Click="BtnAll_Click" Style="{StaticResource Tool}"/>
                            <Button Content="Select none" Click="BtnNone_Click" Style="{StaticResource Tool}"/>
                            <Button Content="Only new endpoints" Click="BtnOnlyNew_Click" Style="{StaticResource Tool}"/>
                            <TextBlock x:Name="TxtCount" VerticalAlignment="Center" Margin="10,0,0,0"
                                       FontSize="12.5" Foreground="{StaticResource FbTextMuted}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="BtnApply" Content="Apply" Click="BtnApply_Click"
                                Style="{StaticResource Primary}" MinWidth="150" Padding="12,6"
                                Visibility="Collapsed"/>
                        <Button Content="Reset to the shipped catalog" Click="BtnReset_Click"
                                Style="{StaticResource Tool}" Margin="8,0,0,0" Padding="12,6"
                                ToolTip="Throw away every applied update and go back to the catalog this build was released with."/>
                    </StackPanel>

                    <ListBox x:Name="LstChanges" BorderThickness="0" Margin="0,12,0,0"
                             HorizontalContentAlignment="Stretch" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <!-- The checkbox is the only state that matters here. -->
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CatalogChange}">
                                <Border BorderBrush="{StaticResource FbBorder}" BorderThickness="1" CornerRadius="5"
                                        Padding="11,9" Background="White">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Apply, Mode=TwoWay}"
                                                  VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding KindBrush}" CornerRadius="3" Padding="6,1">
                                                    <TextBlock Text="{Binding KindLabel}" Foreground="White"
                                                               FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Header}" FontSize="13" Margin="8,0,0,0"
                                                           FontFamily="{StaticResource FbMono}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding DetailText}" FontSize="12.5" TextWrapping="Wrap"
                                                       Foreground="{StaticResource FbTextSub}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- ── Help and tips ─────────────────────────────────────── -->
                <ScrollViewer x:Name="PageHelp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22,18" MaxWidth="560" HorizontalAlignment="Left">

                        <CheckBox x:Name="ChkTips" Content="Show the guided tour when the tool starts"
                                  Click="Pref_Changed"/>
                        <TextBlock Style="{StaticResource FieldNote}"
                                   Text="Points at each part of the window in turn and says what it is for. It runs once, then turns itself off."/>

                        <Button Content="Run the tour now" Click="BtnTour_Click"
                                Style="{StaticResource Primary}" HorizontalAlignment="Left"
                                Margin="0,14,0,0" Padding="14,6"/>

                        <TextBlock Text="DOCUMENTATION" Style="{StaticResource FieldLabel}" Margin="0,26,0,6"/>
                        <TextBlock Style="{StaticResource FieldNote}" Margin="0,0,0,10"
                                   Text="Both guides are built in and work with no connection: one for this tool, one for the Fishbowl API itself."/>
                        <Button Content="Open the documentation tab" Click="BtnDocs_Click"
                                Style="{StaticResource Tool}" HorizontalAlignment="Left" Padding="14,6"/>

                        <TextBlock Text="THIS BUILD" Style="{StaticResource FieldLabel}" Margin="0,26,0,6"/>
                        <TextBox x:Name="TxtBuildLong" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontFamily="{StaticResource FbMono}"
                                 FontSize="12.5" Margin="0,0,0,8" Padding="0"
                                 ToolTip="Select and copy this into a bug report"/>
                        <TextBlock x:Name="TxtAbout" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource FbTextSub}"/>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </DockPanel>
</Window>
