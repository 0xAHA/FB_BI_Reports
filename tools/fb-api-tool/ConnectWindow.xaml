<Window x:Class="FbApiTool.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Fishbowl"
        Width="470" SizeToContent="Height"
        Icon="assets/fishbowl.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel>

        <Border Background="{StaticResource FbBlue}" Padding="20,15">
            <StackPanel>
                <TextBlock Text="Fishbowl API Tool" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Sign in to get a token, or paste one you already have."
                           Foreground="#DEEAF4" FontSize="13" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="20,14,20,4">
            <TextBlock Text="SERVER" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtServer" Padding="6,5" Margin="0,0,0,10"/>

            <TabControl x:Name="Modes" BorderThickness="0" Margin="0,0,0,4">

                <TabItem Header="Sign in">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtUser" Padding="6,5" Margin="0,0,0,10"/>

                        <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="TxtPass" Padding="6,5" Margin="0,0,0,10"/>

                        <TextBlock Text="MFA CODE (only if the account has MFA enabled)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtMfa" Padding="6,5" Width="110" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" x:Name="BtnForget" Content="Forget"
                                    Click="BtnForget_Click" Style="{StaticResource Tool}" Margin="0"
                                    Visibility="Collapsed" HorizontalAlignment="Right"
                                    ToolTip="Remove the stored password for this server and user"/>
                            <CheckBox x:Name="ChkRemember" Content="Remember this password"
                                      Click="ChkRemember_Click"
                                      ToolTip="Kept in the Windows Credential Manager, not by this tool."/>
                        </DockPanel>
                        <TextBlock x:Name="TxtVault" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Foreground="{StaticResource FbTextMuted}"
                                   Text="Stored in the Windows Credential Manager, per user — the same vault a password manager fills. This tool keeps no password of its own."/>

                        <Expander Header="Integrated app identity" FontSize="12.5">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                           Foreground="{StaticResource FbTextSub}"
                                           Text="The first sign-in with a new name and id registers the app, and an administrator has to approve it in Settings ▸ Integrated Apps before it will work. Change these only to reuse an approval that already exists."/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="APP NAME" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtAppName" Padding="6,5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="APP ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtAppId" Padding="6,5"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Paste a token">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="BEARER TOKEN" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtToken" Padding="6,5" Margin="0,0,0,8"
                                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12.5"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FbTextSub}"
                                   Text="The token is used exactly as given and is never written to disk. Disconnecting drops it without logging the session out, because the session belongs to whoever issued it."/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Border x:Name="ErrBox" Background="#FBE9EC" BorderBrush="#E7B3BC" BorderThickness="1"
                    CornerRadius="5" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TxtErr" TextWrapping="Wrap" FontSize="12.5" Foreground="#8A1E30"/>
            </Border>
        </StackPanel>

        <Border Background="#F7F7F7" BorderBrush="{StaticResource FbBorder}" BorderThickness="0,1,0,0"
                Padding="20,12" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="TxtBusy" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource FbTextMuted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSkip" Content="Work offline" Click="BtnSkip_Click" IsCancel="True"
                            Margin="0,0,8,0" MinWidth="106" Padding="13,6"
                            ToolTip="The endpoint list and the built-in guide work without a connection."/>
                    <Button x:Name="BtnGo" Content="Connect" Click="BtnGo_Click" IsDefault="True"
                            Style="{StaticResource Primary}" MinWidth="106"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
