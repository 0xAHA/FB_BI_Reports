<Window x:Class="FbApiTool.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture a value"
        Icon="assets/fishbowl.ico"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner">
    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource FbBlue}" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Capture a value" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Foreground="#DEEAF4" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"
                           Text="Put something from this response into a variable, so the next request can use it."/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="{StaticResource FbBorder}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <CheckBox DockPanel.Dock="Left" x:Name="ChkRemember" VerticalAlignment="Center"
                          Content="Do this automatically from now on"
                          ToolTip="Runs every time this request succeeds, so a sequence keeps itself up to date."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="BtnCancel_Click" IsCancel="True"
                            Padding="13,6" Margin="0,0,8,0" MinWidth="96"/>
                    <Button x:Name="BtnOk" Content="Capture" Click="BtnOk_Click" IsDefault="True"
                            Style="{StaticResource Primary}" MinWidth="106"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,16,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="FIELD" Style="{StaticResource FieldLabel}"/>

            <ListBox Grid.Row="1" x:Name="LstPaths" SelectionChanged="LstPaths_Changed"
                     BorderBrush="{StaticResource FbBorder}" BorderThickness="1" Background="#FBFCFD"
                     FontFamily="{StaticResource FbMono}" FontSize="12.5"/>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="VALUE" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtPreview" IsReadOnly="True" Margin="0,0,0,12"
                         FontFamily="{StaticResource FbMono}" TextWrapping="Wrap"
                         MaxHeight="72" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="VARIABLE NAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtName" FontFamily="{StaticResource FbMono}"/>
                <TextBlock x:Name="TxtHint" FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource FbTextMuted}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
