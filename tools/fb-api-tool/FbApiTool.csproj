<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FbApiTool</AssemblyName>
    <RootNamespace>FbApiTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\fishbowl.ico</ApplicationIcon>
    <!-- selftest is its own project in a subfolder; without this its obj\ tree
         is globbed into this one and every AssemblyInfo attribute duplicates. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);selftest\**</DefaultItemExcludes>
    <!-- WPF0001 = Application.ThemeMode, the .NET 9 native Fluent theme. It is
         shipped behind an experimental diagnostic; the API itself is stable
         enough for an internal tool and saves taking a UI-library dependency. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <!-- ══ RELEASE ══════════════════════════════════════════════════════
         Published self-contained, so the tool runs on a machine with no
         .NET installed. That matters here: it gets handed to whoever is
         debugging a Fishbowl server, and "install a runtime first" is how a
         diagnostic tool ends up not being used.

         Not trimmed. WPF resolves controls, templates and converters by name
         at runtime, so the trimmer cannot see what is reachable and removes
         things that turn into a crash on a screen nobody opened during the
         build. The size saving is not worth that.

         Not single-file either: the catalog and both guides ship beside the
         exe on purpose — readable, diffable and replaceable, which is the
         whole point of generating the UI from a catalog. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- SelfContained is NOT set here on purpose. As a project property it
         applies to build as well as publish, which pins a runtime identifier
         on the ordinary dev build and quietly moves its output down into a
         win-x64 subfolder. build-release.ps1 passes it per publish instead. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WebView2 ships 800KB of API documentation next to its DLLs. Useful in
         an IDE, noise in a folder somebody is about to be handed. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>Fishbowl API Tool</Product>
    <Company>Fishbowl</Company>
    <Description>A desktop client for the Fishbowl Advanced REST API, generated from the server's own /apidocs.json.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The built-in documentation is a full HTML page, so it is rendered the
         same way the report host renders a report. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>

  <ItemGroup>
    <!-- One implementation of sign-in, shared with the report host rather than
         forked: the MFA-as-a-header and app-approval rules are easy to get
         subtly wrong and must not drift between the two tools. -->
    <Compile Include="..\fb-report-host\FishbowlClient.cs" Link="FishbowlClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The catalog and the API guide ship BESIDE the exe, because the catalog
         is meant to be readable, diffable and replaceable by hand.

         NEITHER tool-guide page does. The authored one is the source
         build-help.js reads, and shipping it would put a page with empty
         picture frames next to the real one. The BUILT one is generated and
         1.4 MB of inlined screenshots, so a hand-editable copy of it is not a
         feature — it is a duplicate of what is already inside the exe, which
         is unpacked on demand. -->
    <Content Include="assets\**" Exclude="assets\*.ico;assets\tool-guide*.html"
             CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="assets\fishbowl.ico" />

    <!-- ...and AGAIN inside the exe, as the fallback Assets.cs reaches for.
         Without this a single FbApiTool.exe copied somewhere on its own starts
         with no catalog at all: an empty sidebar and no documentation, which
         looks like a broken build rather than a missing folder. The logical
         names are the ones Assets.cs asks for by hand — the default naming is
         derived from the path and would not match. -->
    <EmbeddedResource Include="assets\catalog.json" LogicalName="FbApiTool.assets.catalog.json" />
    <EmbeddedResource Include="assets\guide.html" LogicalName="FbApiTool.assets.guide.html" />
    <EmbeddedResource Include="assets\tool-guide.built.html" LogicalName="FbApiTool.assets.tool-guide.built.html" />
  </ItemGroup>

</Project>
