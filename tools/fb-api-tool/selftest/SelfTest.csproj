<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FbApiToolSelfTest</AssemblyName>
    <RootNamespace>FbApiTool</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SHIPPING sources, not copies — a green run says the real catalog,
         the real importer and the real diff engine work. Only the files with no
         WPF dependency are listed; CatalogChange is deliberately partial so its
         model half compiles here without dragging the UI in. -->
    <Compile Include="Program.cs" />
    <Compile Include="..\ApiCatalog.cs" Link="ApiCatalog.cs" />
    <Compile Include="..\ApiDocsImport.cs" Link="ApiDocsImport.cs" />
    <Compile Include="..\CatalogDiff.cs" Link="CatalogDiff.cs" />
    <Compile Include="..\ApiRunner.cs" Link="ApiRunner.cs" />
    <Compile Include="..\ImportPayload.cs" Link="ImportPayload.cs" />
    <Compile Include="..\SqlFormat.cs" Link="SqlFormat.cs" />
    <Compile Include="..\SqlHighlighter.cs" Link="SqlHighlighter.cs" />
    <Compile Include="..\JsonHighlighter.cs" Link="JsonHighlighter.cs" />
    <Compile Include="..\ValueTone.cs" Link="ValueTone.cs" />
    <Compile Include="..\RowComparer.cs" Link="RowComparer.cs" />
    <Compile Include="..\QueryHistory.cs" Link="QueryHistory.cs" />
    <Compile Include="..\QueryDiff.cs" Link="QueryDiff.cs" />
    <Compile Include="..\ResultExport.cs" Link="ResultExport.cs" />
    <Compile Include="..\Variables.cs" Link="Variables.cs" />
    <Compile Include="..\VarCompletion.cs" Link="VarCompletion.cs" />
    <Compile Include="..\Profiles.cs" Link="Profiles.cs" />
    <Compile Include="..\SavedRequests.cs" Link="SavedRequests.cs" />
    <Compile Include="..\CurlFormat.cs" Link="CurlFormat.cs" />
    <Compile Include="..\AccessRights.cs" Link="AccessRights.cs" />
    <Compile Include="..\SqlContext.cs" Link="SqlContext.cs" />
    <Compile Include="..\DbSchema.cs" Link="DbSchema.cs" />
    <Compile Include="..\CredentialStore.cs" Link="CredentialStore.cs" />
    <Compile Include="..\SchemaNodes.cs" Link="SchemaNodes.cs" />
    <Compile Include="..\IdleWatch.cs" Link="IdleWatch.cs" />
    <Compile Include="..\Prefs.cs" Link="Prefs.cs" />
    <Compile Include="..\..\fb-report-host\FishbowlClient.cs" Link="FishbowlClient.cs" />
  </ItemGroup>

</Project>
