<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FbApiToolSelfTest</AssemblyName>
    <RootNamespace>FbApiTool</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SHIPPING core, not a copy — a green run says the real catalog,
         the real importer and the real diff engine work. It used to list every
         portable file by hand, which meant a new one was only covered once
         somebody remembered to add it here. -->
    <Compile Include="Program.cs" />
    <ProjectReference Include="..\core\FbApiTool.Core.csproj" />
  </ItemGroup>

</Project>
