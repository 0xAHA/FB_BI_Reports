<UserControl x:Class="FbApiTool.SqlEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="#FBFCFD" BorderBrush="{StaticResource FbBorder}" BorderThickness="1"
                CornerRadius="8" SnapsToDevicePixels="True">
            <RichTextBox x:Name="Box"
                         BorderThickness="0" Background="Transparent" Padding="9,7"
                         FontFamily="{StaticResource FbMono}" FontSize="13"
                         AcceptsReturn="True" AcceptsTab="True"
                         SpellCheck.IsEnabled="False" AutoWordSelection="False"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         CaretBrush="{StaticResource FbBlueAccent}"
                         SelectionBrush="{StaticResource FbBlue}" SelectionOpacity="0.35"
                         TextChanged="Box_TextChanged"
                         PreviewKeyDown="Box_PreviewKeyDown"
                         PreviewTextInput="Box_PreviewTextInput"
                         LostKeyboardFocus="Box_LostFocus">
                <RichTextBox.Resources>
                    <!-- A paragraph per line, so no gaps open up between them. -->
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Border>

        <!-- Completions. Placement is set in code from the caret's own
             rectangle, so the list appears under the word being typed rather
             than at a corner of the box. -->
        <Popup x:Name="Suggestions" Placement="Relative" PlacementTarget="{Binding ElementName=Box}"
               AllowsTransparency="True" StaysOpen="True" Focusable="False">
            <Border Background="White" BorderBrush="{StaticResource FbBorderStrong}" BorderThickness="1"
                    CornerRadius="6" Padding="2" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="#101010"/>
                </Border.Effect>
                <ListBox x:Name="SuggestList" BorderThickness="0" Background="Transparent"
                         MaxHeight="256" MinWidth="330" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="SuggestList_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- kind badge · name · where it lives, right-justified.
                                 The badge colour is the same language the editor
                                 itself uses: keywords purple, everything else in
                                 the brand blues. -->
                            <DockPanel MinWidth="300" Margin="0,1">
                                <Border DockPanel.Dock="Left" Background="{Binding Kind, Converter={StaticResource SqlKindFill}}"
                                        CornerRadius="3" Padding="5,1" MinWidth="34"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding KindLabel}" Foreground="{Binding Kind, Converter={StaticResource SqlKindInk}}"
                                               FontSize="9.5" FontWeight="Bold"
                                               FontFamily="{StaticResource FbMono}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}"
                                           FontSize="11" Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource FbTextMuted}"/>
                                <TextBlock Text="{Binding Text}" FontSize="13"
                                           FontFamily="{StaticResource FbMono}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background"
                                                        Value="{StaticResource FbTint2}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background"
                                                        Value="{StaticResource FbTint}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
