<Application x:Class="FbApiTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="System">
    <Application.Resources>

        <!-- ══════════════════════════════════════════════════════════════
             BRAND TOKENS — the same values as scripts/fb-styles.css, keyed by
             the same names, so this tool, the report host and the reports
             themselves cannot drift apart.
             ══════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="FbBlue"         Color="#2d9cdb"/>
        <SolidColorBrush x:Key="FbBlueAccent"   Color="#1e7bb4"/>
        <SolidColorBrush x:Key="FbBlueHover"    Color="#4FB0E4"/>
        <SolidColorBrush x:Key="FbBluePressed"  Color="#176C9E"/>

        <SolidColorBrush x:Key="FbSuccess"      Color="#1B7A46"/>
        <SolidColorBrush x:Key="FbWarning"      Color="#B26A14"/>
        <SolidColorBrush x:Key="FbNegative"     Color="#C43046"/>
        <SolidColorBrush x:Key="FbNeutral"      Color="#506872"/>
        <!-- Aliases: existing markup and code look these up by these names. -->
        <SolidColorBrush x:Key="FbGreen"        Color="#1B7A46"/>
        <SolidColorBrush x:Key="FbAmber"        Color="#B26A14"/>
        <SolidColorBrush x:Key="FbRed"          Color="#C43046"/>

        <SolidColorBrush x:Key="FbBgPrimary"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="FbBg1"          Color="#F7F7F7"/>
        <SolidColorBrush x:Key="FbBg2"          Color="#EBEEED"/>
        <SolidColorBrush x:Key="FbBg3"          Color="#E3E3E3"/>
        <SolidColorBrush x:Key="FbBg4"          Color="#C6D0D4"/>
        <SolidColorBrush x:Key="FbBorder"       Color="#E3E3E3"/>
        <SolidColorBrush x:Key="FbBorderStrong" Color="#C6D0D4"/>

        <SolidColorBrush x:Key="FbMenuBg"       Color="#0B3140"/>
        <SolidColorBrush x:Key="FbMenuBg2"      Color="#0E3646"/>

        <SolidColorBrush x:Key="FbText"         Color="#101010"/>
        <SolidColorBrush x:Key="FbTextSub"      Color="#506872"/>
        <SolidColorBrush x:Key="FbTextMuted"    Color="#8FA1A7"/>

        <SolidColorBrush x:Key="FbTint"         Color="#DEEAF4"/>
        <SolidColorBrush x:Key="FbTint2"        Color="#CBE5FB"/>

        <SolidColorBrush x:Key="AccPurple"      Color="#845EEB"/>
        <SolidColorBrush x:Key="AccPurpleBg"    Color="#D9CEF7"/>
        <SolidColorBrush x:Key="AccSage"        Color="#DBE8E1"/>

        <!-- HTTP verbs, mapped onto the brand's semantic colours rather than an
             invented palette: read is the brand blue, write is success green,
             destroy is negative red. The verb is what decides whether a call is
             safe to fire at a live server, so it is colour coded everywhere. -->
        <SolidColorBrush x:Key="MethodGet"    Color="#1e7bb4"/>
        <SolidColorBrush x:Key="MethodPost"   Color="#1B7A46"/>
        <SolidColorBrush x:Key="MethodDelete" Color="#C43046"/>
        <SolidColorBrush x:Key="MethodOther"  Color="#845EEB"/>

        <!-- The tint each verb sits on. Same treatment as the value chips in
             the response table: a tinted ground with the colour in the text,
             rather than a solid block. Two chip styles in one window read as
             two unrelated ideas. -->
        <SolidColorBrush x:Key="MethodGetBg"    Color="#DEEAF4"/>
        <SolidColorBrush x:Key="MethodPostBg"   Color="#DBE8E1"/>
        <SolidColorBrush x:Key="MethodDeleteBg" Color="#F0D7DD"/>
        <SolidColorBrush x:Key="MethodOtherBg"  Color="#D9CEF7"/>

        <!-- The font stacks fb-styles declares. WPF walks the list until it
             finds one installed, so Inter is used where present and Segoe UI
             otherwise, and the tool matches the web version on any machine that
             already has the brand font. -->
        <FontFamily x:Key="FbFont">Inter, Segoe UI Variable Text, Segoe UI, Roboto</FontFamily>
        <FontFamily x:Key="FbMono">Space Mono, Cascadia Mono, Consolas</FontFamily>

        <!-- ══════════════════════════════════════════════════════════════
             CONTROLS

             Every interactive control is templated. Left to the Fluent theme
             they come out in near-identical greys with no brand colour at all,
             which is what made half the window read as unstyled.
             ══════════════════════════════════════════════════════════════ -->

        <!-- Default button: a quiet outlined control that still picks up the
             brand blue on hover. Named styles below promote it. -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
            <Setter Property="Background" Value="{StaticResource FbBgPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FbBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbTint}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource FbBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbTint2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbBg1}"/>
                                <Setter Property="Foreground" Value="{StaticResource FbTextMuted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one action on a pane that actually does something to a server. -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource FbBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FbBlue}"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbBlueHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbBluePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbBg4}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small secondary actions that sit in a row above a pane. -->
        <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource FbTextSub}"/>
            <Setter Property="Background" Value="{StaticResource FbBg1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FbBorder}"/>
        </Style>

        <!-- Sits on the brand-blue header bar, so it inverts. -->
        <Style x:Key="OnBrand" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource FbBlueAccent}"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbTint}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbTint2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Background" Value="#7FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row's remove "×": present but never competing for attention. -->
        <Style x:Key="RowKill" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource FbTextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#F0D7DD"/>
                                <Setter Property="Foreground" Value="{StaticResource FbNegative}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Verb filters. The web tool keeps each pill in its own verb colour
             and simply fades the ones switched off, which reads much faster
             than a uniform fill: the colours already mean something everywhere
             else in the window, so the filter row uses the same language.
             Geometry matches .badge in the web stylesheet. -->
        <Style TargetType="ToggleButton" x:Key="VerbFilter">
            <Setter Property="FontFamily" Value="{StaticResource FbMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.32"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .section-card: the white panel every group of fields sits in. -->
        <Style TargetType="Border" x:Key="SectionCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FbBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <!-- The CSV / JSON pair reads as one segmented control, not two radios. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource FbTextSub}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbMenuBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbTint}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="SelectionBrush" Value="{StaticResource FbBlue}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="CaretBrush" Value="{StaticResource FbBlueAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource FbBorderStrong}" BorderThickness="1"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource FbBlueHover}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource FbBlue}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbBg1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource FbBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource FbBlueAccent}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="Foreground" Value="{StaticResource FbTextSub}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
        </Style>

        <!-- The sentence under a setting that says what it is actually for.
             A preference nobody understands is a preference nobody changes. -->
        <Style TargetType="TextBlock" x:Key="FieldNote">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource FbTextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FbTextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Code editors and the response body. Templated for the same reason
             the report host's log needed it: the Fluent TextBox repaints its
             background on focus, which on a monospace pane reads as the whole
             panel flashing white. -->
        <Style TargetType="TextBox" x:Key="CodeBox">
            <Setter Property="FontFamily" Value="{StaticResource FbMono}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="#FBFCFD"/>
            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource FbBlue}"/>
            <Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="CaretBrush" Value="{StaticResource FbBlueAccent}"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource FbBorder}" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource FbBlueHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ DATA GRIDS ═══════════════════════════════════════════════
             Both the field list and the response table. A column header has to
             read as a header — the default is the same colour as a data row,
             which on a wide result set leaves nothing to anchor to. -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="SeparatorBrush" Value="{StaticResource FbBorderStrong}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="B" Background="{StaticResource FbBg2}"
                                BorderBrush="{StaticResource FbBorderStrong}"
                                BorderThickness="0,0,1,2" SnapsToDevicePixels="True">
                            <DockPanel>
                                <!-- Which column is sorted, and which way. The stock
                                     template carries this; replacing the template
                                     silently took it away, leaving a sorted grid with
                                     nothing to say so. -->
                                <TextBlock x:Name="Arrow" DockPanel.Dock="Right"
                                           Text="&#9650;" FontSize="8" Margin="4,0,8,0"
                                           VerticalAlignment="Center" Visibility="Collapsed"
                                           Foreground="{StaticResource FbBlueAccent}"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow" Property="Text" Value="&#9650;"/>
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbTint}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Arrow" Property="Text" Value="&#9660;"/>
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbTint}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbTint2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource FbTint2}"/>
                    <Setter Property="Foreground" Value="{StaticResource FbText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Style.Triggers>
                <!-- Zebra striping is done by the grid's AlternatingRowBackground;
                     this is the hover, which is what makes a wide row readable
                     across its whole width. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource FbTint}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource FbBorder}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource FbBorder}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource FbBorder}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ColumnWidth" Value="Auto"/>
        </Style>

        <!-- ══ RESPONSE TABS ════════════════════════════════════════════
             Pretty / Raw / Table / Headers. Same treatment as the request tabs
             so the two strips are recognisably one design. -->
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource FbFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource FbTextSub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="B" Background="Transparent" Padding="13,6" Margin="0,0,3,0"
                                CornerRadius="6,6,0,0" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                                        Background="{StaticResource FbBlue}" Visibility="Collapsed"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource FbBlueAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="B" Property="Background" Value="{StaticResource FbBg1}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
