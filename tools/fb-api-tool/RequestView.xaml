<UserControl x:Class="FbApiTool.RequestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FbApiTool"
             AllowDrop="True" Drop="View_Drop" DragOver="View_DragOver"
             PreviewKeyDown="View_PreviewKeyDown">
    <Grid Background="{StaticResource FbBg1}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- ══ ENDPOINT BAR ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="10,10,10,0">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Left" x:Name="BadgeMethod" Background="{StaticResource MethodGetBg}"
                            CornerRadius="3" Padding="11,4" VerticalAlignment="Center" MinWidth="66">
                        <TextBlock x:Name="TxtMethod" Foreground="{StaticResource MethodGet}"
                                   FontWeight="Bold" FontSize="12.5"
                                   FontFamily="{StaticResource FbMono}" HorizontalAlignment="Center"/>
                    </Border>
                    <Button DockPanel.Dock="Right" x:Name="BtnSend" Content="Send"
                            Style="{StaticResource Primary}" Click="BtnSend_Click" MinWidth="100" Margin="8,0,0,0"
                            ToolTip="Enter sends from any field. Inside the editors, Ctrl+Enter."/>
                    <Button DockPanel.Dock="Right" Content="Copy as ▾" Click="BtnCopyAs_Click"
                            Style="{StaticResource Tool}" Margin="8,0,0,0">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="URL" Click="MnuCopyUrl_Click"/>
                                <MenuItem Header="cURL command" Click="MnuCopyCurl_Click"
                                          ToolTip="For pasting into a ticket. The token is replaced with a placeholder."/>
                                <MenuItem Header="runRestApiAsync call (BI report)" Click="MnuCopyBiReport_Click"/>
                                <Separator/>
                                <MenuItem Header="Fill in from a cURL command" Click="MnuPasteCurl_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="Save" Click="BtnSaveRequest_Click"
                            Style="{StaticResource Tool}" Margin="8,0,0,0"
                            ToolTip="Keep this request by name, with its {{variables}} intact"/>
                    <Button DockPanel.Dock="Right" x:Name="BtnRevertUrl" Content="Revert URL"
                            Style="{StaticResource Tool}" Margin="8,0,0,0" Visibility="Collapsed"
                            Click="BtnRevertUrl_Click"
                            ToolTip="Go back to the URL built from the fields below"/>
                    <TextBox x:Name="TxtUrl" Margin="10,0,0,0"
                             FontFamily="{StaticResource FbMono}" FontSize="12.5"
                             Padding="8,5" VerticalContentAlignment="Center"
                             TextChanged="TxtUrl_TextChanged"
                             ToolTip="Editable. Type over it to send something the form cannot express; Revert URL puts the fields back in charge."/>
                </DockPanel>
                <TextBlock x:Name="TxtEpDesc" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource FbTextSub}"/>
                <Border x:Name="ChipRight" CornerRadius="3" Padding="7,2" Margin="0,7,0,0"
                        HorizontalAlignment="Left" Visibility="Collapsed"
                        Background="{StaticResource FbBg2}">
                    <TextBlock x:Name="TxtRight" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource FbTextSub}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══ REQUEST ═══════════════════════════════════════════════════
             Two columns, as in the web tool: the form on the left, whatever is
             being composed on the right. The field list sits UNDER the body
             editor in that right column rather than in a tab of its own —
             writing a body while reading which fields are required is the main
             thing anyone does here, and separating them makes it a memory
             exercise. -->
        <Grid Grid.Row="1" Margin="10,9,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="290"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: the form ───────────────────────────────────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <Border x:Name="SecPath" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="PATH PARAMETERS" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="PanelPath"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SecQuery" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="QUERY PARAMETERS" Style="{StaticResource FieldLabel}"
                                           DockPanel.Dock="Left" Margin="0,3,0,0"/>
                                <Button DockPanel.Dock="Right" Content="+ Add" Click="BtnAddQuery_Click"
                                        Style="{StaticResource Tool}" Margin="0" Padding="9,2"
                                        HorizontalAlignment="Right"/>
                                <TextBlock/>
                            </DockPanel>
                            <StackPanel x:Name="PanelQuery"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SecHeaders" Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="CUSTOM HEADERS" Style="{StaticResource FieldLabel}"
                                           DockPanel.Dock="Left" Margin="0,3,0,0"/>
                                <Button DockPanel.Dock="Right" Content="+ Add" Click="BtnAddHeader_Click"
                                        Style="{StaticResource Tool}" Margin="0" Padding="9,2"
                                        HorizontalAlignment="Right"/>
                                <TextBlock/>
                            </DockPanel>
                            <TextBlock FontSize="11.5" Margin="0,0,0,7" TextWrapping="Wrap"
                                       Foreground="{StaticResource FbTextMuted}"
                                       Text="Added for you: Authorization: Bearer …  ·  Content-Type"/>
                            <StackPanel x:Name="PanelHeaders"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- ── RIGHT: body, then fields ─────────────────────────── -->
            <Border Grid.Column="2" x:Name="SecBody" Style="{StaticResource SectionCard}" Margin="0,0,0,9">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" x:Name="TxtBodyLabel" Text="REQUEST BODY"
                                   Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtContentType" Text="application/json" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontFamily="{StaticResource FbMono}"
                                       Foreground="{StaticResource FbTextMuted}"/>
                            <Button Content="Format" Click="BtnFormatBody_Click" Style="{StaticResource Tool}"/>
                            <Button Content="Reset" Click="BtnResetBody_Click" Style="{StaticResource Tool}"
                                    ToolTip="Put the documented template back"/>
                            <Button Content="Copy" Click="BtnCopyBody_Click" Style="{StaticResource Tool}"/>
                            <Button x:Name="BtnSchemaToggle" Content="Fields &#9662;" Click="BtnSchemaToggle_Click"
                                    Style="{StaticResource Tool}" Margin="0"
                                    Foreground="{StaticResource FbBlueAccent}"
                                    Background="{StaticResource FbTint}"
                                    BorderBrush="{StaticResource FbTint2}"/>
                        </StackPanel>
                        <TextBlock/>
                    </DockPanel>

                    <!-- The field list, under the editor exactly as the web tool
                         has it, so the two are read together. -->
                    <DockPanel DockPanel.Dock="Bottom" x:Name="SchemaPane" MaxHeight="240" Margin="0,9,0,0">
                        <TextBlock DockPanel.Dock="Top" x:Name="TxtSchemaCount" Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,5"/>
                        <Border BorderBrush="{StaticResource FbBorder}" BorderThickness="1" CornerRadius="8"
                                ClipToBounds="True">
                            <DataGrid x:Name="GridSchema" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" BorderThickness="0" FontSize="12"
                                      CanUserSortColumns="False" Background="#FBFCFD"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="ToolTip" Value="{Binding Description}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="Auto"
                                                        FontFamily="{StaticResource FbMono}"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto"/>
                                    <DataGridTextColumn Header="Req" Binding="{Binding RequiredLabel}" Width="Auto"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>

                    <TextBox x:Name="TxtBody" Style="{StaticResource CodeBox}"/>
                </DockPanel>
            </Border>

            <!-- ══ SQL ═══════════════════════════════════════════════════
                 /api/data-query carries its whole statement in a query
                 parameter. Left as an ordinary parameter row it is a one-line
                 box you cannot read a join in, so it gets the right column and
                 a real editor instead. -->
            <Border Grid.Column="2" x:Name="SecSql" Style="{StaticResource SectionCard}"
                    Margin="0,0,0,9" Visibility="Collapsed">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="SQL QUERY" Style="{StaticResource FieldLabel}"
                                   Margin="0,4,0,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="ChkKeep" Content="Keep results" Click="ChkKeep_Click"
                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                      ToolTip="Store each result on this machine so it can be reviewed and compared later."/>
                            <Button x:Name="BtnSaved" Content="Saved" Click="BtnSaved_Click"
                                    Style="{StaticResource Tool}"
                                    ToolTip="Show the results kept so far"/>
                            <Button Content="Format SQL" Click="BtnFormatSql_Click" Style="{StaticResource Tool}"
                                    ToolTip="Break the statement onto clause lines"/>
                            <Button Content="Copy" Click="BtnCopySql_Click" Style="{StaticResource Tool}"/>
                            <Button Content="Clear" Click="BtnClearSql_Click" Style="{StaticResource Tool}" Margin="0"/>
                        </StackPanel>
                        <TextBlock/>
                    </DockPanel>
                    <!-- Kept results. A query run against a live database
                         cannot be re-run to get the same answer, which is the
                         whole reason for writing it down. -->
                    <DockPanel DockPanel.Dock="Bottom" x:Name="SavedPane" Margin="0,9,0,0"
                               MaxHeight="190" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                            <TextBlock DockPanel.Dock="Left" x:Name="TxtSavedCount"
                                       Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Restore query" Click="BtnRestoreRun_Click"
                                        Style="{StaticResource Tool}"
                                        ToolTip="Put the selected run&apos;s SQL back in the editor"/>
                                <Button Content="Compare" Click="BtnCompareRun_Click"
                                        Style="{StaticResource Tool}"
                                        ToolTip="Compare the selected run with what is in the response pane now"/>
                                <Button Content="Rename" Click="BtnRenameRun_Click" Style="{StaticResource Tool}"/>
                                <Button Content="Delete" Click="BtnDeleteRun_Click" Style="{StaticResource Tool}"/>
                                <Button Content="Clear all" Click="BtnClearRuns_Click" Style="{StaticResource Tool}" Margin="0"/>
                            </StackPanel>
                            <TextBlock/>
                        </DockPanel>
                        <ListBox x:Name="LstRuns" BorderBrush="{StaticResource FbBorder}" BorderThickness="1"
                                 Background="#FBFCFD" FontSize="12"
                                 MouseDoubleClick="LstRuns_DoubleClick"
                                 ToolTip="Double-click to load a kept result back into the response pane">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding When}" FontSize="11"
                                                   FontFamily="{StaticResource FbMono}" Margin="0,0,9,0"
                                                   Foreground="{StaticResource FbTextMuted}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" FontSize="11"
                                                   Margin="9,0,0,0" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource FbTextMuted}"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom" Margin="2,7,0,0" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource FbTextMuted}"
                               Text="Sent as ?query= · SELECT only · use Fishbowl table and column names"/>
                    <local:SqlEditor x:Name="TxtSql"
                                     ToolTip="Ctrl+Enter sends. Enter makes a new line."/>
                </DockPanel>
            </Border>

            <!-- ══ IMPORT ════════════════════════════════════════════════
                 Takes the right column for /api/import/{name}: the payload is a
                 spreadsheet, not a JSON object, and the columns it needs come
                 from the matching export endpoint rather than from the docs. -->
            <Border Grid.Column="2" x:Name="SecImport" Style="{StaticResource SectionCard}"
                    Margin="0,0,0,9" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock DockPanel.Dock="Left" Text="IMPORT TYPE" Style="{StaticResource FieldLabel}"
                                       Margin="0,7,10,0"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border BorderBrush="{StaticResource FbBorderStrong}" BorderThickness="1"
                                        CornerRadius="6" Margin="8,0,0,0" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="FmtCsv" Content="CSV / Text" GroupName="ImportFmt"
                                                     Style="{StaticResource Segment}" Click="Fmt_Click" IsChecked="True"/>
                                        <RadioButton x:Name="FmtJson" Content="JSON" GroupName="ImportFmt"
                                                     Style="{StaticResource Segment}" Click="Fmt_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <ComboBox x:Name="CmbImportName" IsEditable="True" FontSize="13" Padding="7,4"
                                      SelectionChanged="CmbImportName_SelectionChanged"
                                      PreviewMouseLeftButtonDown="CmbImportName_Click"
                                      ToolTip="The server accepts only these names, exactly as spelled."/>
                        </DockPanel>

                        <Border x:Name="DropZone" BorderBrush="{StaticResource FbBlue}" BorderThickness="1.4"
                                CornerRadius="8" Padding="14,11" Margin="0,0,0,9"
                                Background="{StaticResource FbBg1}"
                                Cursor="Hand" MouseLeftButtonUp="DropZone_Click">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#128228;" FontSize="16" Margin="0,0,9,0"/>
                                <Button DockPanel.Dock="Right" x:Name="BtnClearFile" Content="Clear"
                                        Visibility="Collapsed" Click="BtnClearFile_Click"
                                        Style="{StaticResource Tool}" Margin="0" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtDrop" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{StaticResource FbTextSub}"
                                           Text="Drop a .csv, .txt or .json file here, or click to browse"/>
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,5">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnFetchHeaders" Content="Fetch headers" Click="BtnFetchHeaders_Click"
                                        Style="{StaticResource Tool}"
                                        ToolTip="Ask the server for this type's column headers and lay out a template row"/>
                                <Button Content="Clear" Click="BtnClearFile_Click" Style="{StaticResource Tool}" Margin="0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtImportHint" Style="{StaticResource FieldLabel}"
                                       Margin="0,5,10,0" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>

                    <TextBox x:Name="TxtImport" Style="{StaticResource CodeBox}"/>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- ══ RESPONSE ══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Margin="10,0,10,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                    <Border DockPanel.Dock="Left" x:Name="BadgeStatus" CornerRadius="3" Padding="10,3"
                            Background="{StaticResource FbTextMuted}" Visibility="Collapsed">
                        <TextBlock x:Name="TxtRespStatus" Foreground="White" FontWeight="Bold" FontSize="12"
                                   FontFamily="{StaticResource FbMono}"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Left" x:Name="TxtRespMeta" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource FbTextSub}"/>
                    <TextBlock DockPanel.Dock="Left" x:Name="TxtCaptures" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               FontFamily="{StaticResource FbMono}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource AccPurple}"
                               ToolTip="Captured automatically each time this request succeeds"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="OPENS ON" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,2,6,0"/>
                        <ComboBox x:Name="CmbDefaultView" Width="104" Padding="7,2" Margin="0,0,10,0"
                                  SelectionChanged="CmbDefaultView_Changed"
                                  ToolTip="Which tab a response opens on. Auto picks the table for a query and Pretty for everything else."/>
                        <Button Content="Capture…" Click="BtnCapture_Click" Style="{StaticResource Tool}"
                                ToolTip="Put a value from this response into a variable the next request can use"/>
                        <Button Content="Copy" Click="BtnCopyResp_Click" Style="{StaticResource Tool}"/>
                        <Button Content="Save…" Click="BtnSaveResp_Click" Style="{StaticResource Tool}" Margin="0"/>
                    </StackPanel>
                    <TextBlock/>
                </DockPanel>

                <TabControl x:Name="RespTabs" BorderThickness="0" Background="Transparent">
                    <TabItem Header="Pretty">
                        <local:JsonView x:Name="TxtPretty"/>
                    </TabItem>
                    <TabItem Header="Raw">
                        <TextBox x:Name="TxtRaw" Style="{StaticResource CodeBox}" IsReadOnly="True" TextWrapping="Wrap"/>
                    </TabItem>
                    <TabItem Header="Table">
                        <Border BorderBrush="{StaticResource FbBorder}" BorderThickness="1" CornerRadius="8"
                                ClipToBounds="True">
                            <DataGrid x:Name="GridResp" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" FontSize="12.5" GridLinesVisibility="All"
                                      Sorting="GridResp_Sorting"/>
                        </Border>
                    </TabItem>
                    <TabItem Header="Headers">
                        <Border BorderBrush="{StaticResource FbBorder}" BorderThickness="1" CornerRadius="8"
                                ClipToBounds="True">
                            <DataGrid x:Name="GridHeaders" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" FontSize="12.5" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Header" Binding="{Binding Key}" Width="290"
                                                        FontFamily="{StaticResource FbMono}"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- Variable completion. One popup for the whole pane, re-anchored to
             whichever field is being typed in. -->
        <Popup x:Name="VarPopup" Placement="Relative" AllowsTransparency="True"
               StaysOpen="True" Focusable="False">
            <Border Background="White" BorderBrush="{StaticResource FbBorderStrong}" BorderThickness="1"
                    CornerRadius="6" Padding="2" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="#101010"/>
                </Border.Effect>
                <ListBox x:Name="VarList" BorderThickness="0" Background="Transparent"
                         MaxHeight="220" MinWidth="300" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel MinWidth="272" Margin="0,1">
                                <Border DockPanel.Dock="Left" Background="{StaticResource FbTint}"
                                        CornerRadius="3" Padding="5,1" MinWidth="34"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="var" Foreground="{StaticResource FbBlueAccent}"
                                               FontSize="9.5" FontWeight="Bold"
                                               FontFamily="{StaticResource FbMono}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Preview}"
                                           FontSize="11" Margin="14,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource FbTextMuted}"/>
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           FontFamily="{StaticResource FbMono}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Foreground" Value="{StaticResource FbText}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background"
                                                        Value="{StaticResource FbTint2}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background"
                                                        Value="{StaticResource FbTint}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
