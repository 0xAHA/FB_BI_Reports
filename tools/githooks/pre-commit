#!/bin/sh
# Refresh the build stamp of every staged report / shared asset (see
# tools/stamp/stamp.js) and re-stage it, so a commit never records a report
# whose stamp doesn't match its content.
#
# Enable once per clone:   git config core.hooksPath tools/githooks
exec node "$(git rev-parse --show-toplevel)/tools/stamp/stamp.js" --staged
