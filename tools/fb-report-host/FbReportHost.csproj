<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FbReportHost</AssemblyName>
    <RootNamespace>FbReportHost</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- selftest is its own project in a subfolder; without this its obj\ tree
         is globbed into this one and every AssemblyInfo attribute duplicates. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);selftest\**</DefaultItemExcludes>
    <!-- The bridge is exposed to JS as a COM host object, so the assembly has
         to be COM-visible at the type level (each type opts in individually). -->
    <EnableComHosting>false</EnableComHosting>
    <!-- WPF0001 = Application.ThemeMode, the .NET 9 native Fluent theme. It is
         shipped behind an experimental diagnostic; the API itself is stable
         enough for an internal tool and saves taking a UI-library dependency. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>

  <ItemGroup>
    <!-- Injected into every document before the report's own script runs. -->
    <EmbeddedResource Include="bridge.js" />
  </ItemGroup>

</Project>
