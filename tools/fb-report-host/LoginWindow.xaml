<Window x:Class="FbReportHost.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Fishbowl"
        Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="0">

        <Border Background="{StaticResource FbBlue}" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Fishbowl BI — Report Host" Foreground="White"
                           FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="A connection is required — every report reads live Fishbowl data."
                           Foreground="#DEEAF4" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="20,16,20,6">
            <TextBlock Text="Server" FontSize="11" Foreground="{StaticResource FbTextSub}" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtServer" Text="http://localhost:2456" Padding="6,5" Margin="0,0,0,10"/>

            <TextBlock Text="Username" FontSize="11" Foreground="{StaticResource FbTextSub}" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtUser" Padding="6,5" Margin="0,0,0,10"/>

            <TextBlock Text="Password" FontSize="11" Foreground="{StaticResource FbTextSub}" Margin="0,0,0,3"/>
            <PasswordBox x:Name="TxtPass" Padding="6,5" Margin="0,0,0,10"/>

            <TextBlock Text="MFA code (only if your account has MFA enabled)"
                       FontSize="11" Foreground="{StaticResource FbTextSub}" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtMfa" Padding="6,5" Width="110" HorizontalAlignment="Left"/>

            <Border x:Name="ErrBox" Background="#FBE9EC" BorderBrush="#E7B3BC" BorderThickness="1"
                    CornerRadius="5" Padding="10,8" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TxtErr" TextWrapping="Wrap" FontSize="11.5" Foreground="#8A1E30"/>
            </Border>
        </StackPanel>

        <Border Background="#F7F7F7" BorderBrush="{StaticResource FbBorder}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="TxtBusy" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource FbTextMuted}" Text=""/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnExit" Content="Exit" Click="BtnExit_Click"
                            Padding="12,5" Margin="0,0,8,0" MinWidth="96"
                            ToolTip="Close the Report Host"/>
                    <Button x:Name="BtnGo" Content="Sign in" Click="BtnGo_Click" IsDefault="True"
                            Padding="12,5" MinWidth="96"
                            Background="{StaticResource FbBlue}" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
