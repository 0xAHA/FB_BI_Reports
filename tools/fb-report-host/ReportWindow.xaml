<Window x:Class="FbReportHost.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FbReportHost"
        Title="Report" Height="860" Width="1380"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" Padding="10,4"
                BorderBrush="#E3E3E3" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" FontSize="11" Foreground="#506872"
                       TextTrimming="CharacterEllipsis" Text=""/>
        </Border>
        <local:ReportView x:Name="View"/>
    </DockPanel>
</Window>
