<Window x:Class="FbReportHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FbReportHost"
        Title="Fishbowl BI — Report Host" Height="920" Width="1560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Small square icon buttons for the pane's own toolbar, so the whole
             command set lives with the tree rather than on a window-wide strip. -->
        <Style TargetType="Button" x:Key="PaneTool">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Report tabs. The stock Fluent tab strip renders selected and
             unselected in near-identical greys, which makes the active report
             genuinely hard to spot once three or four are open. This gives the
             selected tab the three cues a tab strip needs: it comes forward to
             white, it carries the brand accent bar, and its label goes dark and
             semibold while the rest stay muted. -->
        <Style x:Key="ReportTab" TargetType="TabItem">
            <Setter Property="Background" Value="#E8EEF2"/>
            <Setter Property="Foreground" Value="{StaticResource FbTextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource FbBorder}" BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Accent" Height="3" VerticalAlignment="Top"
                                        Background="{StaticResource FbBlue}"
                                        CornerRadius="3,3,0,0" Visibility="Collapsed"/>
                                <ContentPresenter ContentSource="Header" Margin="13,7,10,7"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="White"/>
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource FbBorderStrong}"/>
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource FbText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{StaticResource FbTint}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          The log box, templated from scratch.

          The Fluent TextBox repaints its background on focus — a near-white
          fill meant for a light form. On the log panel that turned the whole
          box white behind pale grey text the moment you clicked it, which read
          as "everything got highlighted". TemplateBinding the background is
          not enough to stop it, so the template goes, leaving nothing but the
          content host. Selection colours are set explicitly for the same
          reason: the system highlight brush is near-white on this ground.
        -->
        <Style TargetType="TextBox" x:Key="LogBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CaretBrush" Value="#8FD0E8"/>
            <Setter Property="SelectionBrush" Value="#2d9cdb"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Setter Property="SelectionOpacity" Value="0.6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Background="Transparent" Padding="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text buttons for the log panel: the pane toolbar style is sized for
             glyphs and coloured for a light background. -->
        <Style TargetType="Button" x:Key="LogTool">
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Foreground" Value="#DCE9EF"/>
            <Setter Property="Background" Value="#1B5063"/>
            <Setter Property="BorderBrush" Value="#2B6F87"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A6C84"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14414F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:LibraryNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0" FontSize="12"/>
                <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ── BRAND / ACCOUNT ───────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource FbBlue}" Padding="14,9">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Fishbowl BI" Foreground="White"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="Report Host" Foreground="#DEEAF4"
                           FontSize="12" VerticalAlignment="Center" Margin="8,1,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="TxtAuth" Text="" Foreground="White"
                               FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="BtnAuth" Content="Sign out" Click="BtnAuth_Click"
                            Padding="10,3" Background="White"
                            Foreground="{StaticResource FbBlueAccent}" BorderThickness="0"/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- ── STATUS ────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" Padding="12,5"
                BorderBrush="{StaticResource FbBorder}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" FontSize="11" Foreground="{StaticResource FbTextSub}"
                       Text="Import or open a report." TextTrimming="CharacterEllipsis"/>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="RowLog" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <!-- Collapsed rail -->
                <ColumnDefinition x:Name="ColRail" Width="0"/>
                <ColumnDefinition x:Name="ColTree" Width="290" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── COLLAPSED RAIL ────────────────────────────────────── -->
            <Border Grid.Row="0" Grid.Column="0" x:Name="RailPane" Visibility="Collapsed"
                    Background="#F3F6F8" BorderBrush="{StaticResource FbBorder}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <Button Style="{StaticResource PaneTool}" Content="&#187;" Margin="2,6,2,2"
                            Click="BtnExpandRail_Click" ToolTip="Show the library"/>
                    <Button Style="{StaticResource PaneTool}" x:Name="BtnRailPin" Content="&#128204;"
                            Margin="2,0,2,6" Click="BtnPin_Click"
                            ToolTip="Pin the library open"/>
                    <TextBlock Text="LIBRARY" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource FbTextMuted}"
                               HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ── LIBRARY PANE ──────────────────────────────────────── -->
            <Border Grid.Row="0" Grid.Column="1" x:Name="TreePane"
                    BorderBrush="{StaticResource FbBorder}" BorderThickness="0,0,1,0"
                    Background="#FBFCFD">
                <DockPanel>

                    <!-- title + pin / collapse -->
                    <DockPanel DockPanel.Dock="Top" Margin="10,7,4,2">
                        <TextBlock DockPanel.Dock="Left" Text="LIBRARY" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource FbTextMuted}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PaneTool}" x:Name="BtnPin" Content="&#128204;"
                                    Click="BtnPin_Click"
                                    ToolTip="Pinned: stay open. Unpinned: collapse after opening a report."/>
                            <Button Style="{StaticResource PaneTool}" Content="&#171;"
                                    Click="BtnCollapseRail_Click" ToolTip="Collapse the library"/>
                        </StackPanel>
                        <TextBlock/>
                    </DockPanel>

                    <!-- the pane's own command bar -->
                    <Border DockPanel.Dock="Top" Padding="8,3,8,5"
                            BorderBrush="{StaticResource FbBorder}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PaneTool}" Content="&#128229;"
                                    Click="BtnImport_Click" ToolTip="Import reports into the selected folder"/>
                            <Button Style="{StaticResource PaneTool}" Content="&#128193;"
                                    Click="BtnNewFolder_Click" ToolTip="New folder"/>
                            <Button Style="{StaticResource PaneTool}" Content="&#128194;"
                                    Click="BtnOpen_Click" ToolTip="Open a file where it sits, without importing"/>
                            <Separator Width="1" Margin="4,3" Background="{StaticResource FbBorder}"/>
                            <Button Style="{StaticResource PaneTool}" Content="&#8862;"
                                    Click="BtnExpandAll_Click" ToolTip="Expand every folder"/>
                            <Button Style="{StaticResource PaneTool}" Content="&#8863;"
                                    Click="BtnCollapseAll_Click" ToolTip="Collapse every folder"/>
                            <Separator Width="1" Margin="4,3" Background="{StaticResource FbBorder}"/>
                            <Button Style="{StaticResource PaneTool}" Content="&#128260;"
                                    Click="MnuRefresh_Click" ToolTip="Refresh the library from disk"/>
                            <Button Style="{StaticResource PaneTool}" x:Name="BtnShared" Content="&#128279;"
                                    Click="BtnShared_Click" ToolTip="Shared assets (fb-lib, fb-styles, …)"/>
                            <Button Style="{StaticResource PaneTool}" Content="&#128172;"
                                    Click="BtnLog_Click" ToolTip="Show or hide the bridge call log"/>
                        </StackPanel>
                    </Border>

                    <!-- description, pinned to the bottom of the pane -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource FbBorder}"
                            BorderThickness="0,1,0,0" Background="#F7FAFC" Padding="10,7"
                            MinHeight="92">
                        <StackPanel>
                            <TextBlock Text="DESCRIPTION" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{StaticResource FbTextMuted}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtDescName" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource FbText}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtDescKind" FontSize="10.5"
                                       Foreground="{StaticResource FbTextMuted}" Margin="0,1,0,4"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtDescBody" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource FbTextSub}"
                                           Text="Select a report to see its description."/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent"
                              AllowDrop="True"
                              MouseDoubleClick="Tree_MouseDoubleClick"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="Tree_PreviewMouseMove"
                              DragOver="Tree_DragOver"
                              Drop="Tree_Drop"
                              DragLeave="Tree_DragLeave">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="2,1"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="TreeMenu" Opened="TreeMenu_Opened">
                                <MenuItem x:Name="MnuOpen" Header="Open" Click="MnuOpen_Click"/>
                                <MenuItem x:Name="MnuPopOut" Header="Open in a new window" Click="MnuPopOut_Click"/>
                                <Separator/>
                                <MenuItem x:Name="MnuImportHere" Header="Import report into this folder…"
                                          Click="MnuImportHere_Click"/>
                                <MenuItem Header="New folder here" Click="BtnNewFolder_Click"/>
                                <Separator/>
                                <MenuItem Header="Rename…" Click="MnuRename_Click"/>
                                <MenuItem Header="Delete" Click="MnuDelete_Click"/>
                                <Separator/>
                                <MenuItem Header="Show in Explorer" Click="BtnReveal_Click"/>
                                <Separator/>
                                <MenuItem Header="Expand all folders" Click="BtnExpandAll_Click"/>
                                <MenuItem Header="Collapse all folders" Click="BtnCollapseAll_Click"/>
                                <MenuItem Header="Refresh" Click="MnuRefresh_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="2" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource FbBorder}" x:Name="TreeSplitter"/>

            <TabControl Grid.Row="0" Grid.Column="3" x:Name="Tabs"
                        Background="White" BorderBrush="{StaticResource FbBorderStrong}"
                        BorderThickness="0,1,0,0" Padding="0"
                        ItemContainerStyle="{StaticResource ReportTab}"/>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="4" Height="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource FbBorder}" x:Name="LogSplitter" Visibility="Collapsed"/>

            <Border Grid.Row="2" Grid.ColumnSpan="4" Background="#0B3140">
                <DockPanel>

                    <Border DockPanel.Dock="Top" Background="#0E3B4D" Padding="10,4,6,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="BRIDGE CALL LOG" FontSize="10"
                                       FontWeight="Bold" Foreground="#7FA8B8" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Style="{StaticResource LogTool}" Content="Copy"
                                        Click="BtnLogCopy_Click"
                                        ToolTip="Copy the log to the clipboard — the selection if you have made one, otherwise all of it"/>
                                <Button Style="{StaticResource LogTool}" Content="Clear"
                                        Click="BtnLogClear_Click" ToolTip="Empty the log"/>
                                <Button Style="{StaticResource LogTool}" Content="Hide"
                                        Click="BtnLog_Click" ToolTip="Hide the log panel"/>
                            </StackPanel>
                            <TextBlock/>
                        </DockPanel>
                    </Border>

                    <!-- The TextBox does its own scrolling. Wrapping it in a
                         ScrollViewer gave it unbounded height, which both broke
                         ScrollToEnd and let the ScrollViewer swallow the click:
                         the box then saw focus arrive as though from the
                         keyboard and selected the whole log, with no later click
                         reaching it to clear the selection. -->
                    <TextBox x:Name="TxtLog" Style="{StaticResource LogBox}"
                             IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             TextWrapping="NoWrap" AcceptsReturn="True" Margin="10,7"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="BtnLogCopy_Click"/>
                                <MenuItem Header="Select all" Click="MnuLogSelectAll_Click"/>
                                <Separator/>
                                <MenuItem Header="Clear log" Click="BtnLogClear_Click"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
