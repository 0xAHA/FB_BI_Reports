<UserControl x:Class="FbReportHost.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="8,5"
                BorderBrush="#E3E3E3" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="Reload" Click="BtnReload_Click"
                        Padding="9,3" Margin="0,0,5,0"
                        ToolTip="Re-read from disk and re-expand the shared assets"/>
                <Button DockPanel.Dock="Left" Content="DevTools" Click="BtnDevTools_Click"
                        Padding="9,3" Margin="0,0,5,0"/>
                <Button DockPanel.Dock="Left" x:Name="BtnPopOut" Content="Pop out"
                        Click="BtnPopOut_Click" Padding="9,3" Margin="0,0,5,0"
                        ToolTip="Open this report in its own window"/>
                <TextBlock x:Name="TxtTitle" VerticalAlignment="Center" Margin="6,0,0,0"
                           FontSize="11" Foreground="#506872"
                           TextTrimming="CharacterEllipsis" Text="No report open"/>
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="Web" Grid.Row="1"/>
    </Grid>
</UserControl>
