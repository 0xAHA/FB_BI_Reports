<Window x:Class="FbReportHost.ImportConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="That report is already here"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel>

        <Border Background="{StaticResource FbBlue}" Padding="20,14">
            <StackPanel>
                <TextBlock Text="That report is already here" Foreground="White"
                           FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtWhere" Foreground="#DEEAF4" FontSize="11.5"
                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="20,16,20,4">
            <TextBlock x:Name="TxtFile" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{StaticResource FbText}" TextWrapping="Wrap"/>

            <!-- Which copy is newer is the whole question, so put both side by
                 side rather than making the user go and look. -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F5F7F9" BorderBrush="{StaticResource FbBorder}"
                        BorderThickness="1" CornerRadius="5" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="ALREADY IN THE LIBRARY" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{StaticResource FbTextMuted}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtExistingName" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource FbText}"/>
                        <TextBlock x:Name="TxtExistingMeta" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{StaticResource FbTextSub}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F2F9F5" BorderBrush="#CBE3D5"
                        BorderThickness="1" CornerRadius="5" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="BEING IMPORTED" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{StaticResource FbTextMuted}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtIncomingName" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource FbText}"/>
                        <TextBlock x:Name="TxtIncomingMeta" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{StaticResource FbTextSub}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="TxtHint" FontSize="11.5" Margin="0,11,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource FbTextSub}"/>

            <CheckBox x:Name="ChkAll" Margin="0,13,0,0" FontSize="11.5"
                      Visibility="Collapsed"
                      Content="Do the same for the remaining files"/>
        </StackPanel>

        <Border Background="#F7F7F7" BorderBrush="{StaticResource FbBorder}" BorderThickness="0,1,0,0"
                Padding="20,12" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" x:Name="BtnCancel" Content="Cancel"
                        Click="BtnCancel_Click" IsCancel="True" Padding="12,5" MinWidth="86"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSkip" Content="Skip" Click="BtnSkip_Click"
                            Padding="12,5" Margin="0,0,8,0" MinWidth="96"
                            ToolTip="Leave the library as it is and import nothing for this file."/>
                    <Button x:Name="BtnKeep" Content="Keep both" Click="BtnKeep_Click"
                            Padding="12,5" Margin="0,0,8,0" MinWidth="106"
                            ToolTip="Import it alongside, with a number added to the name."/>
                    <Button x:Name="BtnOverwrite" Content="Replace" Click="BtnOverwrite_Click"
                            IsDefault="True" Padding="12,5" MinWidth="106"
                            Background="{StaticResource FbBlue}" Foreground="White" BorderThickness="0"
                            ToolTip="Replace the copy in the library with the one being imported."/>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
