<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FbHostSelfTest</AssemblyName>
    <RootNamespace>FbReportHost</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same sources the WPF host uses. None of them touch WPF, so they
         compile into a console harness unchanged - the test exercises the
         shipping code, not a copy of it. -->
    <Compile Include="Program.cs" />
    <Compile Include="..\FishbowlClient.cs" />
    <Compile Include="..\FishbowlBridge.cs" />
    <Compile Include="..\ReportLoader.cs" />
    <Compile Include="..\Library.cs" />
  </ItemGroup>
</Project>
